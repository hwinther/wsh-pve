# wisp-netbsd kernel for sparc32 (sun4m: SS-5, SS-10, SS-20 and the other sun4m machines QEMU
# has): the ttya console, the timers and the power register, a memory-disk root with PID 1 and
# nothing else. From GENERIC and INSTALL; build.sh sets MEMORY_DISK_ROOT_SIZE to fit the image.

include 	"arch/sparc/conf/std.sparc"

maxusers	2
makeoptions	COPTS="-Os"

options 	SUN4M

options 	MEMORY_DISK_HOOKS
options 	MEMORY_DISK_IS_ROOT
options 	MEMORY_DISK_SERVER=0
options 	MEMORY_DISK_ROOT_SIZE=WISP_MD_BLOCKS
pseudo-device	md

file-system	FFS
options 	FFS_NO_SNAPSHOT

config		netbsd	root on ? type ?

mainbus0	at root
cpu0		at mainbus0
obio0		at mainbus0
iommu0		at mainbus0
sbus0		at iommu0

auxreg0		at obio0
power0		at obio0
clock0		at obio0
memreg0		at obio0
timer0		at obio0

zs0		at obio0
zstty0		at zs0 channel 0	# ttya, the console
zstty1		at zs0 channel 1	# ttyb
