Mix DMX sound effects into non-blocking little-endian OSS stereo output.

--- a/fbdoom/Makefile
+++ b/fbdoom/Makefile
@@ -18,6 +18,7 @@
 #CFLAGS+=-fsanitize=address
 OBJS+=$(OBJDIR)/i_video_fbdev.o
 OBJS+=$(OBJDIR)/i_input_tty.o
+OBJS+=$(OBJDIR)/i_oss.o
 
