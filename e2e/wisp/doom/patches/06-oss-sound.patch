 CFLAGS+=-ggdb3 -Os
--- a/fbdoom/i_sound.c
+++ b/fbdoom/i_sound.c
@@ -63,6 +63,7 @@
 // Sound modules
 
 extern void I_InitTimidityConfig(void);
+extern sound_module_t sound_oss_module;
 extern sound_module_t sound_sdl_module;
 extern sound_module_t sound_pcsound_module;
 extern music_module_t music_sdl_module;
@@ -94,6 +95,8 @@
