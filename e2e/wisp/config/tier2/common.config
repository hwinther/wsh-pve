# Tier 2 (kernel-t2), every architecture: on top of common.config and <arch>.config.
# Disks: the block layer, SCSI disks and devtmpfs (PID 1 mounts it on /dev for the disk nodes).
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_DEVTMPFS=y
# Network: packet sockets (PID 1 builds its ARP and ICMP frames itself, no IP stack) and Ethernet
# drivers.
CONFIG_NET=y
CONFIG_PACKET=y
# CONFIG_INET is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# Off again what those turn on by default and the checks don't use, to keep the kernel small.
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
CONFIG_PARTITION_ADVANCED=y
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_SUN_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_SWAP is not set
