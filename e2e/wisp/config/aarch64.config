# QEMU virt supplies the PL011, GIC, generic timer and PSCI through its device tree.
CONFIG_ARM64_4K_PAGES=y
CONFIG_OF=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y
# SMP is mandatory on arm64. Limit the guest to the largest test profile.
CONFIG_SMP=y
CONFIG_NR_CPUS=4
