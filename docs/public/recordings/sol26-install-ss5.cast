[21.548762, "o", "\u001b[?1h\u001b="]
[21.676753, "o", "\u001b(B\u001b)0\u001b[m\u000f\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fSolaris Interactive Installation \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fYou'll be using the initial option for installing Solaris software on the\n\r  system. The initial option overwrites the system's disks when the new\n\r  Solaris software is installed.\n\n\r  On the following screens, you can accept the defaults or you can customize\n\r  how Solaris software will be installed by:\n\n\u001b[36D- Allocating space for diskless clients or AutoClient systems\n\u001b[61D- Selecting the type of Solaris software to install\n\u001b[51D- Selecting disks to hold software you've selected\n\u001b[50D- Specifying how file systems are laid out on the disks\n\n\r  After completing these tasks, a summary of your selections (called a\n\r  profile) will be displayed.\u001b[7B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[4C\u001b[0m\u000fF2_Continue    F5_Exit    F6_Help\r"]
[22.012602, "m", "18. Solaris Interactive Installation"]
[22.030318, "o", "\u001b[0;1;7m\u000f \u001b[0m\u000f    Esc-2_Continue    Esc-5_Exit    Esc-6_Help\u001b[K\r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fAllocate Client Services? \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fDo you want to allocate space for diskless clients and/or AutoClient\n\r  systems?\u001b[19B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue   Esc-3_Go Back   Esc-4_Allocate   Esc-5_Exit   Esc-6_Help  "]
[22.36511, "m", "19. Allocate Client Services?"]
[22.378479, "o", "\r    Esc-2_Continue   Esc-3_Go Back   Esc-4_Allocate   Esc-5_Exit   Esc-6_Help  \u001b[2A\r  \u001b[0;1;7m\u000f Please wait ... \n\n\u001b[60C\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fSelect Languages \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fSelect the languages you want for displaying the user interface after\n\r  Solaris software is installed. English is automatically installed by\n\r  default.\n\n\u001b[10C[\u001b[0;1;7m\u000f ]\u001b[2C\u001b[0m\u000fFrench\n\u001b[11D[ ]  German\n\u001b[11D[ ]  Italian\n\u001b[12D[ ]  Spanish\n\u001b[12D[ ]  Swedish\u001b[12B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[5C\u001b[0m\u000fEsc-2_Continue    Esc-3_Go Back    Esc-5_Exit    Esc-6_Help\u001b[17A\u001b[44D"]
[22.714875, "m", "20. Select Languages"]
[22.730215, "o", "\u001b[17B\r     Esc-2_Continue    Esc-3_Go Back    Esc-5_Exit    Esc-6_Help\u001b[K\u001b[17A\u001b[44D\u001b[15B\r  \u001b[0;1;7m\u000f Please wait ... \n\n\u001b[60C"]
[22.86271, "o", "\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fSelect Software \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fSelect the Solaris software to install on the system.\n\n\r  NOTE: After selecting a software group, you can add or remove software by\n\r  customizing it. However, this requires understanding of software\n\r  dependencies and how Solaris software is packaged.\n\n\u001b[46D[ ]  Entire Distribution plus OEM support .. 720.00 MB\n\u001b[54D[ ]  Entire Distribution ................... 701.00 MB\n\u001b[54D[ ]  Developer System Support .............. 632.00 MB\n\u001b[54D[\u001b[0;1;7m\u000fX]\u001b[2C\u001b[0m\u000fEnd User System Support ............... 373.00 MB (F4 to Customize)\n\u001b[72D[ ]  Core System Support ................... 181.00 MB\u001b[10B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue   Esc-3_Go Back   Esc-4_Customize   Esc-5_Exit   Esc-6_Help\u001b[12A\u001b[72D"]
[23.198003, "m", "21. Select Software"]
[23.211891, "o", "\u001b[12B\r    Esc-2_Continue   Esc-3_Go Back   Esc-4_Customize   Esc-5_Exit   Esc-6_Help \u001b[12A\u001b[73D\u001b[10B\r  \u001b[0;1;7m\u000f Please wait ... \n\n\u001b[60C"]
[23.256695, "o", "\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fSelect Disks \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn this screen you must select the disks for installing Solaris software.\n\r  Start by looking at the Suggested Minimum field; this value is the\n\r  approximate space needed to install the software you've selected. Keep\n\r  selecting disks until the Total Selected value exceeds the Suggested Minimum\n\r  value.\n\n    Disk Device (Size)\u001b[8CAvailable Space\n\u001b[45D=============================================\n\u001b[45D[\u001b[0;1;7m\u000fX]\u001b[C\u001b[0m\u000fc0t3d0   (2775 MB) boot disk\u001b[6C2775 MB  (F4 to edit)\n\n\u001b[39DTotal Selected:   2775 MB\n\u001b[28DSuggested Minimum:    209 MB\u001b[9B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[5C\u001b[0m\u000fEsc-2_Continue    Esc-3_Go Back    Esc-4_Edit    Esc-5_Exit    Esc-6_Help\u001b[13A\u001b[70D"]
[23.592545, "m", "22. Select Disks"]
[23.609057, "o", "\u001b[13B\r     Esc-2_Continue    Esc-3_Go Back    Esc-4_Edit    Esc-5_Exit    Esc-6_Help \u001b[13A\u001b[71D"]
[23.630444, "o", "\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fPreserve Data? \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fDo you want to preserve existing data? At least one of the disks you've\n\r  selected for installing Solaris software has file systems or unnamed slices\n\r  that you may want to save.\u001b[18B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[3C\u001b[0m\u000fEsc-2_Continue   Esc-3_Go Back   Esc-4_Preserve   Esc-5_Exit   Esc-6_Help\r"]
[23.965149, "m", "23. Preserve Data?"]
[23.97686, "o", "\u001b[0;1;7m\u000f \u001b[0m\u000f   Esc-2_Continue   Esc-3_Go Back   Esc-4_Preserve   Esc-5_Exit   Esc-6_Help  \r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fAutomatically Layout File Systems? \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fDo you want to use auto-layout to automatically layout file systems?\n\r  Manually laying out file systems requires advanced system administration\n\r  skills.\u001b[18B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[2C\u001b[0m\u000fEsc-2_Auto Layout  Esc-3_Go Back  Esc-4_Manual Layout  Esc-5_Exit  Esc-6_Hel\r"]
[24.312916, "m", "24. Automatically Layout File Systems?"]
[24.326698, "o", "\u001b[0;1;7m\u000f \u001b[0m\u000f  Esc-2_Auto Layout  Esc-3_Go Back  Esc-4_Manual Layout  Esc-5_Exit  Esc-6_Hel\r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fAutomatically Layout File Systems \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn this screen you must select all the file systems you want auto-layout to\n\r  create, or accept the default file systems shown.\n\n\r  NOTE: For small disks, it may be necessary for auto-layout to break up some\n\r  of the file systems you request into smaller file systems to fit the\n\r  available disk space. So, after auto-layout completes, you may find file\n\r  systems in the layout that you did not select from the list below.\n\n\u001b[56DFile Systems for Auto-layout\n\u001b[28D========================================\n\u001b[40D[X]  /\n\u001b[6D[ ]  /opt\n\u001b[9D[\u001b[0;1;7m\u000fX]\u001b[2C\u001b[0m\u000f/usr\n\u001b[9D[ ]  /usr/openwin\n\u001b[17D[ ]  /var\n\u001b[9D[X]  swap\n\n\n\n\n\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[5C\u001b[0m\u000fEsc-2_Continue    Esc-5_Cancel    Esc-6_Help\u001b[9A\u001b[37D"]
[24.666452, "m", "25. Automatically Layout File Systems"]
[24.681833, "o", "\u001b[9B\r     Esc-2_Continue    Esc-5_Cancel    Esc-6_Help\u001b[K\u001b[9A\u001b[37D\u001b[7B\r  \u001b[0;1;7m\u000f Please wait ... \n\n\u001b[60C"]
[25.01591, "o", "\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fFile System and Disk Layout \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fThe summary below is your current file system and disk layout, based on the\n\r  information you've supplied.\n\n\r  NOTE: If you choose to customize, you should understand file systems, their\n\r  intended purpose on the disk, and how changing them may affect the operation\n\r  of the system.\n\n\u001b[8DFile system/Mount point\u001b[11CDisk/Slice\u001b[13CSize\n\u001b[61D=============================================================\n\u001b[61D/\u001b[0;1;7m\u000f                                 c0t3d0s0              85 MB\n\u001b[61D\u001b[0m\u000fswap\u001b[30Cc0t3d0s1\u001b[13C149 MB\n\u001b[61Doverlap\u001b[27Cc0t3d0s2\u001b[12C2775 MB\n\u001b[61D/usr\u001b[30Cc0t3d0s6\u001b[13C243 MB\n\u001b[61D/export/home\u001b[22Cc0t3d0s7\u001b[12C2297 MB\u001b[7B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue   Esc-3_Go Back   Esc-4_Customize   Esc-5_Exit   Esc-6_Help\u001b[12A\u001b[70D"]
[25.350897, "m", "26. File System and Disk Layout"]
[25.366559, "o", "\u001b[12B\r    Esc-2_Continue   Esc-3_Go Back   Esc-4_Customize   Esc-5_Exit   Esc-6_Help \u001b[12A\u001b[71D"]
[25.435386, "o", "\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fMount Remote File Systems? \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fDo you want to mount software from a remote file server? This may be\n\r  necessary if you had to remove software because of disk space problems.\u001b[19B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[2C\u001b[0m\u000fEsc-2_Continue  Esc-3_Go Back  Esc-4_Remote Mounts  Esc-5_Exit  Esc-6_Help\r"]
[25.769907, "m", "27. Mount Remote File Systems?"]
[25.783448, "o", "\u001b[0;1;7m\u000f \u001b[0m\u000f  Esc-2_Continue  Esc-3_Go Back  Esc-4_Remote Mounts  Esc-5_Exit  Esc-6_Help  \r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fProfile \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fThe information shown below is your profile for installing Solaris software.\n\r  It reflects the choices you've made on previous screens.\n\n\r  ============================================================================\n\n\u001b[62DInstallation Option: Initial\n\u001b[20DBoot Device: c0t3d0s0\n\u001b[25DClient Services: None\n\u001b[14DSoftware: Solaris 2.6, End User System Support\n\n\u001b[65DFile System and Disk Layout: /\u001b[19Cc0t3d0s0   85 MB\n\u001b[36Dswap\u001b[16Cc0t3d0s1  149 MB\n\u001b[36D/usr\u001b[16Cc0t3d0s6  243 MB\n\u001b[36D/export/home\u001b[8Cc0t3d0s7 2297 MB\u001b[7B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[5C\u001b[0m\u000fEsc-2_Continue    Esc-4_Change    Esc-5_Exit    Esc-6_Help\u001b[2A\r\n\n\u001b[0;1;7m\u000f \b"]
[26.121168, "m", "28. Profile"]
[26.13654, "o", " \u001b[0m\u000f    Esc-2_Continue    Esc-4_Change    Esc-5_Exit    Esc-6_Help\u001b[K\r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fReboot After Installation? \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fAfter Solaris software is installed, the system must be rebooted. You can\n\r  choose to have the system automatically reboot, or you can choose to\n\r  manually reboot the system if you want to run scripts or do other\n\r  customizations before the reboot.  You can manually reboot a system by using\n\r  the reboot(1M) command.\n\n\n\u001b[13D[\u001b[0;1;7m\u000fX]\u001b[C\u001b[0m\u000fAuto Reboot\n\u001b[15D[ ] Manual Reboot\u001b[12B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[5C\u001b[0m\u000fEsc-2_Begin Installation    Esc-5_Cancel\u001b[14A\u001b[33D"]
[26.473022, "m", "29. Reboot After Installation?"]
