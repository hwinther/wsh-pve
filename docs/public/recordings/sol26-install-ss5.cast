[18.522119, "o", "[\u001b[0;1;7m\u000fX\n\n\n\b\u001b[0m\u000f \u001b[3A\b\b\u001b[8B\r    Esc-2_Continue    Esc-6_Help\u001b[K\u001b[8A\u001b[26D\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fTime Zone \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000f> To make a selection, use the arrow keys to highlight the option and\n\u001b[67Dpress Return to mark it [X].\n\n\n\u001b[26DTime zones\n\u001b[10D\u001b[0m\u000eqqqqqqqqqqqqqqqqqq\n\u001b[18D\u001b[0m\u000f[\u001b[0;1;7m\u000f ]\u001b[C\u001b[0m\u000fGreat Britain\n\u001b[17D[ ] Ireland\n\u001b[11D[ ] Iceland\n\u001b[11D[ ] Poland\n\u001b[10D[ ] Western Europe\n\u001b[18D[ ] Middle Europe\n\u001b[17D[ ] Eastern Europe\u001b[8B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue    Esc-5_Cancel    Esc-6_Help\u001b[15A\u001b[42D"]
