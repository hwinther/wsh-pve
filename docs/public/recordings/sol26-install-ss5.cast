[17.394619, "o", "\u001b[?1h\u001b=\u001b(B\u001b)0\u001b[m\u000f\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fSubnets \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn this screen you must specify whether this system is part of a subnet.  If\n\r  you specify incorrectly, the system will have problems communicating on the\n\r  network after you reboot.\n\n\r  > To make a selection, use the arrow keys to highlight the option and\n\u001b[67Dpress Return to mark it [X].\n\n\n\u001b[26DSystem part of a subnet\n\u001b[23D\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqq\n\u001b[23D\u001b[0m\u000f[ ] Yes\n\u001b[7D[\u001b[0;1;7m\u000fX]\u001b[C\u001b[0m\u000fNo\u001b[9B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue    Esc-6_Help\u001b[10A\u001b[26D"]
[17.747629, "m", "13. Subnets"]
[17.761913, "o", "\u001b[10B\r    Esc-2_Continue    Esc-6_Help\u001b[K\u001b[10A\u001b[26D\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fTime Zone \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn this screen you must specify your default time zone.  You can specify a\n\r  time zone in three ways:  select one of the geographic regions from the\n\r  list, select other - offset from GMT, or other - specify time zone file.\n\n\r  > To make a selection, use the arrow keys to highlight the option and\n\u001b[67Dpress Return to mark it [X].\n\n\n\u001b[26DRegions\n\u001b[7D\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\n\u001b[38D\u001b[0m\u000f^   [ ] Asia, Western\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[ ] Australia / New Zealand\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[ ] Canada\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[ ] Europe\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[ ] Mexico\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[ ] South America\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[\u001b[0;1;7m\u000fX]\u001b[C\u001b[0m\u000fUnited States\n\r  \u001b[0m\u000ex\u001b[3C\u001b[0m\u000f[ ] other - offset from GMT\n\r  -   [ ] other - specify time zone file\n\n\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue    Esc-6_Help\u001b[5A\u001b[26D"]
[18.106802, "m", "14. Time Zone"]
