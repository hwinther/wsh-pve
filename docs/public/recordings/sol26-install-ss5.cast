[13.692547, "o", "\u001b[?1h\u001b="]
[13.724296, "o", "\u001b(B\u001b)0\u001b[m\u000f\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fThe Solaris Installation Program \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fThe Solaris installation program is divided into a series of short sections\n\r  where you'll be prompted to provide information for the installation. At\n\r  the end of each section, you'll be able to change the selections you've\n\r  made before continuing.\n\n\r  About navigation...\n\u001b[13D- The mouse cannot be used\n\u001b[26D- If your keyboard does not have function keys, or they do not\n\u001b[60Drespond, press ESC; the legend at the bottom of the screen\n\u001b[58Dwill change to show the ESC keys to use for navigation.\u001b[11B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[3C\u001b[0m\u000fF2_Continue    F6_Help\r"]
[14.060185, "m", "5. The Solaris Installation Program"]
[14.075259, "o", "    Esc-2_Continue    Esc-6_Help\u001b[K\r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fIdentify This System \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn the next screens, you must identify this system as networked or\n\r  non-networked, and set the default time zone and date/time.\n\n\r  If this system is networked, the software will try to find the information\n\r  it needs to identify your system; you will be prompted to supply any\n\r  information it cannot find.\n\n\r  > To begin identifying this system, press F2.\u001b[13B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[3C\u001b[0m\u000fEsc-2_Continue    Esc-6_Help\r"]
[14.412909, "m", "6. Identify This System"]
[14.426542, "o", "    Esc-2_Continue    Esc-6_Help\u001b[K\r\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fHost Name \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn this screen you must enter your host name, which identifies this system\n\r  on the network.  The name must be unique within your domain; creating a\n\r  duplicate host name will cause problems on the network after you install\n\r  Solaris.\n\n\r  A host name must be at least two characters; it can contain letters, digits,\n\r  and minus signs (-).\n\n\n\u001b[18DHost name: \u001b[0;1;7m\u000f                                \u001b[11B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue    Esc-6_Help\u001b[12A\u001b[17D"]
[14.764575, "m", "7. Host Name"]
[14.779062, "o", "\u001b[0;1;7m\u000fso"]
[14.80893, "o", "la"]
[14.838925, "o", "r"]
[14.858926, "o", "i"]
[14.879264, "o", "s\u001b[12B\r\u001b[0m\u000f    Esc-2_Continue    Esc-6_Help\u001b[K\u001b[12A\u001b[10D\u001b[7Dsolaris\u001b[K\u001b[9B\r  \u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fNetwork Connectivity \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fSpecify Yes if the system is connected to the networkby one of the Solaris\n\r  or vendor network/communicationEthernet cards that are supported on the\n\r  Solaris CD.See your hardware documentation for the current listof supported\n\r  cards.\n\r  Specify No if the system is connected to anetwork/communication card that is\n\r  not supported onthe Solaris CD, and follow the instructions listedunder\n\r  Help.\n\n\n\bNetworked\n\u001b[9D\u001b[0m\u000eqqqqqqqqq\n\u001b[9D\u001b[0m\u000f[\u001b[0;1;7m\u000fX]\u001b[C\u001b[0m\u000fYes\n\u001b[7D[ ] No\u001b[8B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue    Esc-6_Help\u001b[10A\u001b[26D"]
[15.227015, "m", "8. Network Connectivity"]
[15.242101, "o", "\u001b[10B\r    Esc-2_Continue    Esc-6_Help\u001b[K\u001b[10A\u001b[26D\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fIP Address \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000fOn this screen you must enter the Internet Protocol (IP) address for this\n\r  system.  It must be unique and follow your site's address conventions, or a\n\r  system/network failure could result.\n\n\r  IP addresses contain four sets of numbers separated by periods (for example\n\r  129.200.9.1).\n\n\n\u001b[11DIP address: \u001b[0;1;7m\u000f               \u001b[12B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[4C\u001b[0m\u000fEsc-2_Continue    Esc-6_Help\u001b[13A\u001b[16D"]
