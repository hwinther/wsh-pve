[19.549684, "o", "\u001b[CX\b\b\u001b[10B\r\u001b[0m\u000f    Esc-2_Continue    Esc-5_Cancel    Esc-6_Help\u001b[K\u001b[10A\u001b[42D\u001b[8B\r  \u001b[0;1;7m\u000fPlease wait...\n\n\u001b[63C"]
[19.601652, "o", "\u001b[2A\u001b[77D\u001b[K\n\n\r \b\u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fDate and Time \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000f> Accept the default date and time or enter\n\u001b[41Dnew values.\n\n\r  Date and time: 11/15/26 23:26\n\n\u001b[27DYear   (4 digits) : 2026\n\u001b[24DMonth  (1-12)     : 11\n\u001b[22DDay    (1-31)     : 15\n\u001b[22DHour   (0-23)     : 23\n\u001b[22DMinute (0-59)     : 26\u001b[6A23:26\n\n\u001b[7D\u001b[0;1;7m\u000f2026\u001b[15B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0m\u000f    Esc-2_Continue    Esc-6_Help\u001b[K\u001b[16A\u001b[8D"]
[19.942396, "m", "16. Date and Time"]
[19.956427, "o", "\u001b[16B\r    Esc-2_Continue    Esc-6_Help\u001b[K\u001b[16A\u001b[8D2026\u001b[13B\r  \u001b[H\u001b[J\u001b[0m\u000eq\u001b[C\u001b[0m\u000fConfirm Information \u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\n\u001b[2C\u001b[0m\u000f> Confirm the following information.  If it is correct, press F2;\n\u001b[63Dto change any information, press F4.\n\n\n\u001b[36DSystem part of a subnet: No\n\u001b[13DTime zone: MET\n\u001b[18DDate and time: 11/15/26 23:26:00\u001b[2A\u001b[15D\u001b[16B\r\u001b[0m\u000eqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq\r\n\u001b[0;1;7m\u000f \u001b[0m\u000f   Esc-2_Continue    Esc-4_Change    Esc-6_Help\u001b[K\r"]
