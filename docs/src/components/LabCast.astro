---
// A terminal recording (asciinema v2 cast) made by the sparc lab, in the asciinema player
// (asciinema-player, Apache-2.0); its step markers show as chapters on the progress bar.
//
// The casts aren't in git: they are assets of the `media` release, which repo-update.yml copies into
// the Pages site as /recordings/ (locally: `npm run fetch-media`). Where the file isn't there (a fork,
// a local build without it, a deploy that couldn't fetch the release) a short note takes the
// player's place.
interface Props {
  src: string; // e.g. /recordings/sol26-install-ss5.cast
  caption?: string;
  poster?: string; // the frame shown before playing, e.g. "npt:0:30"
  speed?: number;
}

const { src, caption, poster = "npt:0:2", speed = 1 } = Astro.props;
const release = "https://github.com/hwinther/wsh-pve/releases/tag/media";
---

<figure class="lab-cast not-content">
  <div class="lab-cast-player" data-src={src} data-poster={poster} data-speed={speed} data-release={release}>
    <noscript><a href={src}>{src}</a> (an asciinema recording)</noscript>
  </div>
  {
    caption && (
      <figcaption>
        {caption}
        <span class="lab-cast-file">
          (<a href={src} download>cast file</a>)
        </span>
      </figcaption>
    )
  }
</figure>

<script>
  import { create } from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  function missing(el: HTMLElement) {
    el.classList.add("lab-media-missing");
    el.textContent = "This recording isn't available on this copy of the site. It is an asset of the ";
    const a = document.createElement("a");
    a.href = el.dataset.release!;
    a.textContent = "media release";
    el.append(a, ".");
    el.closest("figure")?.querySelector(".lab-cast-file")?.remove();
  }

  for (const el of document.querySelectorAll<HTMLElement>(".lab-cast-player")) {
    fetch(el.dataset.src!)
      .then((r) => (r.ok ? r.text() : Promise.reject(new Error(`HTTP ${r.status}`))))
      .then((text) => {
        if (!text.startsWith("{")) throw new Error("not a cast"); // e.g. a 404 page served as 200
        create({ data: text }, el, {
          fit: "width",
          poster: el.dataset.poster,
          speed: Number(el.dataset.speed) || 1,
          terminalFontSize: "small",
        });
      })
      .catch(() => missing(el));
  }
</script>

<style>
  .lab-cast {
    margin: 1.5rem 0;
  }
  .lab-cast figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }
  :global(.lab-media-missing) {
    padding: 1rem;
    border: 1px dashed var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
