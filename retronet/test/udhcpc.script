#!/bin/sh
# busybox udhcpc hook: apply the lease the gateway hands out (address, router, DNS).
case "$1" in
  deconfig)
    ip -4 addr flush dev "$interface"
    ip link set "$interface" up
    ;;
  bound|renew)
    ip -4 addr flush dev "$interface"
    ip -4 addr add "$ip/${mask:-24}" dev "$interface"
    ip -4 route flush default 2>/dev/null
    for r in $router; do ip -4 route add default via "$r" dev "$interface"; break; done
    : > /etc/resolv.conf
    for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
    [ -n "$domain" ] && echo "search $domain" >> /etc/resolv.conf
    echo "lease: ip=$ip mask=$mask router=$router dns=$dns domain=$domain" > /tmp/lease
    ;;
esac
exit 0
