#!/usr/bin/make -f
# The build tree is assembled by packages/wsh-gst-qemu-dbus/build.sh: this directory's source
# (meson.build, src/), this debian/ and a generated debian/changelog. meson builds the plugin and
# qemu-dbus-input; the version they report is the package's.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dpackage_version=$(DEB_VERSION_UPSTREAM)

# The plugin and the bridge need a running QEMU; packages/wsh-gst-qemu-dbus/test.sh tests them
override_dh_auto_test:
