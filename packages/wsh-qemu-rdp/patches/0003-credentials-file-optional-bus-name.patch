+// The credentials file: the user name on the first line, the password on the second (taken as it
+// is, but for the line end)
+fn read_credentials(path: &std::path::Path) -> Result<Credentials, Error> {
+    let text = std::fs::read_to_string(path)
+        .map_err(|e| anyhow::anyhow!("Can't read the credentials file {path:?}: {e}"))?;
+    let mut lines = text.lines();
+    let username = lines.next().unwrap_or_default().trim();
+    let password = lines.next().unwrap_or_default();
+    if username.is_empty() || password.is_empty() {
+        bail!(
+            "The credentials file {path:?} needs the user name on the first line and the password on the second"
+        );
+    }
+    Ok(Credentials {
+        username: username.into(),
+        password: password.into(),
+        domain: None,
+    })
+}
