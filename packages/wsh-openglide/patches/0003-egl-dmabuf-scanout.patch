     if (egl_pbuf != EGL_NO_SURFACE)
         eglDestroySurface(egl_dpy, egl_pbuf);
-    eglTerminate(egl_dpy);
+    // No eglTerminate: the display is the process's one (an EGL platform display is the same
+    // handle for every caller), which the host program may use too (QEMU's egl-headless and
+    // dbus,gl=on displays on Mesa's surfaceless platform, qemu-3dfx's MESA GL pass-through), and
+    // terminating it would destroy their contexts. The next window's eglInitialize is a no-op.
     egl_dpy = EGL_NO_DISPLAY;
     egl_ctx = EGL_NO_CONTEXT;
     egl_pbuf = EGL_NO_SURFACE;
@@ -364,4 +378,447 @@ extern "C" int getOffscreenFrame(void *dst, int width, int height, int stride)
     return 1;
 }
 
+//*************************************************
+//* dmabuf scanout: instead of reading every frame back to the CPU, the host program can ask for
+//* buffers it shares with its display as dmabufs (getOffscreenDmabufAt, once per window and
+//* buffer), and then have each frame copied into one of them on the GPU (getOffscreenScanoutAt).
+//* There are two, renderbuffers of the window's size besides the back and front buffers, each
+//* exported through EGL_MESA_image_dma_buf_export (Mesa's llvmpipe exports through /dev/udmabuf,
+//* a GPU driver through its render node), so that the host program can copy a frame into one
+//* while its display still reads the other (double buffering); getOffscreenDmabuf and
+//* getOffscreenScanout are buffer 0 (the one buffer before). The copy is a framebuffer blit of the
+//* front buffer, unscaled and unflipped (llvmpipe then copies memory), so the rows are in OpenGL's
+//* order, bottom up: the display is told so (QEMU's y0_top). Buffers of their own, not the front
+//* buffer itself, so that the next swap can't change a frame the display still reads. While a
+//* gamma ramp is set the copy is a shader pass instead (scan_gamma: the front buffer through a
+//* 256-entry lookup per channel, the same lookup as getOffscreenFrame applies), in the same rows;
+//* only if that pass can't be had is the copy refused, and the host program reads that frame back
+//* with getOffscreenFrame.
+//*************************************************
+#define SCAN_BUFFERS 2
+static GLuint fbo_scan[SCAN_BUFFERS], rb_scan[SCAN_BUFFERS];
+static EGLImageKHR scan_img[SCAN_BUFFERS] = { EGL_NO_IMAGE_KHR, EGL_NO_IMAGE_KHR };
+
+//*************************************************
+//* The GL work so far finished, before another context or the display reads its result: an EGL
+//* fence (EGL_KHR_fence_sync) waited on, else glFinish. Same rendering context, same thread.
+//* Where the reader is a context of ours (the gamma pass's), it can wait for the frame in its own
+//* GL stream instead (EGL_KHR_wait_sync, wait_sync_begin/wait_sync_end): on a GPU, not with Mesa's
+//* software renderers, which don't all wait in the stream; QEMU_3DFX_WAIT_SYNC=1 or 0 in the
+//* environment decides instead.
+//*************************************************
+static PFNEGLCREATESYNCKHRPROC pCreateSyncKHR;
+static PFNEGLCLIENTWAITSYNCKHRPROC pClientWaitSyncKHR;
+static PFNEGLDESTROYSYNCKHRPROC pDestroySyncKHR;
+static PFNEGLWAITSYNCKHRPROC pWaitSyncKHR;
+static bool wait_sync;
+
+static void fence_init(void)
+{
+    const char *ext = eglQueryString(egl_dpy, EGL_EXTENSIONS), *env = getenv("QEMU_3DFX_WAIT_SYNC");
+    const char *r = (const char *) glGetString(GL_RENDERER);
+    bool soft = !r || strstr(r, "llvmpipe") || strstr(r, "softpipe");
+
+    if (has_ext(ext, "EGL_KHR_fence_sync")) {
+        pCreateSyncKHR = (PFNEGLCREATESYNCKHRPROC) eglGetProcAddress("eglCreateSyncKHR");
+        pClientWaitSyncKHR = (PFNEGLCLIENTWAITSYNCKHRPROC) eglGetProcAddress("eglClientWaitSyncKHR");
+        pDestroySyncKHR = (PFNEGLDESTROYSYNCKHRPROC) eglGetProcAddress("eglDestroySyncKHR");
+    }
+    fence_state = (pCreateSyncKHR && pClientWaitSyncKHR && pDestroySyncKHR)? 1:-1;
+    pWaitSyncKHR = (fence_state > 0 && has_ext(ext, "EGL_KHR_wait_sync"))?
+        (PFNEGLWAITSYNCKHRPROC) eglGetProcAddress("eglWaitSyncKHR"):NULL;
+    wait_sync = pWaitSyncKHR && (env? !strcmp(env, "1"):!soft);
+    fprintf(stderr, "Info: EGL offscreen: the scanout copies are finished with %s%s\n",
+        (fence_state > 0)? "an EGL fence (EGL_KHR_fence_sync)":"glFinish (no EGL_KHR_fence_sync)",
+        wait_sync? "; the gamma pass waits for the frame in the GL stream (EGL_KHR_wait_sync)":"");
+}
+
+/* Before the gamma pass, in OpenGLide's context: a fence after its frame, flushed, for the
+ * pass's context to wait on (wait_sync_end), or the frame finished on the CPU (EGL_NO_SYNC_KHR) */
+static EGLSyncKHR wait_sync_begin(void);
+
+/* With the pass's context current: its GL stream waits for the fence, which goes */
+static void wait_sync_end(EGLSyncKHR sync)
+{
+    if (sync == EGL_NO_SYNC_KHR)
+        return;
+    if (pWaitSyncKHR(egl_dpy, sync, 0) != EGL_TRUE)
+        pClientWaitSyncKHR(egl_dpy, sync, 0, EGL_FOREVER_KHR);
+    pDestroySyncKHR(egl_dpy, sync);
+}
+
+static void finish_gl(void)
+{
+    if (!fence_state)
+        fence_init();
+    if (fence_state > 0) {
+        EGLSyncKHR sync = pCreateSyncKHR(egl_dpy, EGL_SYNC_FENCE_KHR, NULL);
+        if (sync != EGL_NO_SYNC_KHR) {
+            EGLint r = pClientWaitSyncKHR(egl_dpy, sync, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, EGL_FOREVER_KHR);
+            pDestroySyncKHR(egl_dpy, sync);
+            if (r == EGL_CONDITION_SATISFIED_KHR)
+                return;
+        }
+    }
+    glFinish();
+}
+
+static EGLSyncKHR wait_sync_begin(void)
+{
+    EGLSyncKHR sync = EGL_NO_SYNC_KHR;
+
+    if (!fence_state)
+        fence_init();
+    if (wait_sync)
+        sync = pCreateSyncKHR(egl_dpy, EGL_SYNC_FENCE_KHR, NULL);
+    if (sync != EGL_NO_SYNC_KHR)
+        glFlush();
+    else
+        finish_gl();
+    return sync;
+}
+
+//*************************************************
+//* Gamma in the scanout copy. The pass runs in a context of its own (gamma_ctx), which shares
+//* OpenGLide's objects (the front buffer and the scanout buffer are renderbuffers) but has its own
+//* state, so none of OpenGLide's (bound textures and units, enables, blend, depth, viewport,
+//* client arrays) has to be saved and put back; it costs two eglMakeCurrent per frame with a ramp,
+//* and finishing OpenGLide's rendering first, as another context reads it. The front buffer is
+//* copied into a texture, then a triangle over the whole scanout buffer is drawn through a 256x1
+//* lookup texture (a GLSL 1.20 shader, mesapt's in qemu-3dfx), unflipped: the rows stay bottom up.
+//*************************************************
+#define SHADER_FUNCS(X) \
+    X(void, ActiveTexture, (GLenum)) \
+    X(void, AttachShader, (GLuint, GLuint)) \
+    X(void, BindAttribLocation, (GLuint, GLuint, const char *)) \
+    X(void, CompileShader, (GLuint)) \
+    X(GLuint, CreateProgram, (void)) \
+    X(GLuint, CreateShader, (GLenum)) \
+    X(void, DeleteProgram, (GLuint)) \
+    X(void, DeleteShader, (GLuint)) \
+    X(void, EnableVertexAttribArray, (GLuint)) \
+    X(void, GetProgramiv, (GLuint, GLenum, GLint *)) \
+    X(GLint, GetUniformLocation, (GLuint, const char *)) \
+    X(void, LinkProgram, (GLuint)) \
+    X(void, ShaderSource, (GLuint, GLsizei, const char *const *, const GLint *)) \
+    X(void, Uniform1i, (GLint, GLint)) \
+    X(void, UseProgram, (GLuint)) \
+    X(void, VertexAttribPointer, (GLuint, GLint, GLenum, GLboolean, GLsizei, const void *))
+SHADER_FUNCS(FBO_DECL)
+
+#define E_FRAGMENT_SHADER 0x8B30
+#define E_VERTEX_SHADER   0x8B31
+#define E_LINK_STATUS     0x8B82
+#define E_TEXTURE0        0x84C0
+#define E_CLAMP_TO_EDGE   0x812F
+
+static EGLContext gamma_ctx = EGL_NO_CONTEXT;
+static GLuint gamma_read_fbo, gamma_draw_fbo[SCAN_BUFFERS], gamma_prog, gamma_tex[2]; /* frame, lookup */
+static bool gamma_failed;
+
+static void destroy_gamma_ctx(void)
+{
+    // the program and textures are shared objects: deleted with OpenGLide's context current
+    if (gamma_prog && egl_ctx != EGL_NO_CONTEXT && eglGetCurrentContext() == egl_ctx) {
+        pDeleteProgram(gamma_prog);
+        glDeleteTextures(2, gamma_tex);
+    }
+    if (gamma_ctx != EGL_NO_CONTEXT)
+        eglDestroyContext(egl_dpy, gamma_ctx);
+    gamma_ctx = EGL_NO_CONTEXT;
+    gamma_read_fbo = gamma_draw_fbo[0] = gamma_draw_fbo[1] = gamma_prog = gamma_tex[0] = gamma_tex[1] = 0;
+    gamma_failed = false;
+}
+
+/* With gamma_ctx current: its read framebuffer, the program and the textures; false when they
+ * can't be had */
+static bool gamma_init(void)
+{
+#define SHADER_LOAD(ret, name, args) \
+    p##name = (ret (*) args) eglGetProcAddress("gl" #name); \
+    if (!p##name) { fprintf(stderr, "Error: EGL offscreen: no gl%s for the gamma pass\n", #name); return false; }
+    SHADER_FUNCS(SHADER_LOAD)
+    /* a triangle over the whole viewport; t: the texel centres of the frame, unflipped */
+    static const char *vs =
+        "#version 120\n"
+        "attribute vec2 p;\n"
+        "varying vec2 t;\n"
+        "void main() { t = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }\n";
+    /* an 8-bit channel value v as the centre of lut's texel v */
+    static const char *fs =
+        "#version 120\n"
+        "uniform sampler2D frame, lut;\n"
+        "varying vec2 t;\n"
+        "void main() {\n"
+        "    vec3 c = texture2D(frame, t).rgb * (255.0 / 256.0) + (0.5 / 256.0);\n"
+        "    gl_FragColor = vec4(texture2D(lut, vec2(c.r, 0.5)).r,\n"
+        "        texture2D(lut, vec2(c.g, 0.5)).g, texture2D(lut, vec2(c.b, 0.5)).b, 1.0);\n"
+        "}\n";
+    static const GLfloat tri[] = { -1, -1, 3, -1, -1, 3 };
+    GLuint sh[2];
+    GLint linked = 0;
+
+    pGenFramebuffers(1, &gamma_read_fbo);
+    pBindFramebuffer(E_READ_FRAMEBUFFER, gamma_read_fbo);
+    pFramebufferRenderbuffer(E_READ_FRAMEBUFFER, E_COLOR_ATTACHMENT0, E_RENDERBUFFER, rb_color[1]);
+    glReadBuffer(E_COLOR_ATTACHMENT0);
+    if (pCheckFramebufferStatus(E_READ_FRAMEBUFFER) != E_FRAMEBUFFER_COMPLETE) {
+        fprintf(stderr, "Error: EGL offscreen: the gamma pass's read framebuffer is incomplete\n");
+        return false;
+    }
+    gamma_prog = pCreateProgram();
+    sh[0] = pCreateShader(E_VERTEX_SHADER);
+    sh[1] = pCreateShader(E_FRAGMENT_SHADER);
+    pShaderSource(sh[0], 1, &vs, NULL);
+    pShaderSource(sh[1], 1, &fs, NULL);
+    for (int i = 0; i < 2; i++) {
+        pCompileShader(sh[i]);
+        pAttachShader(gamma_prog, sh[i]);
+        pDeleteShader(sh[i]);
+    }
+    pBindAttribLocation(gamma_prog, 0, "p");
+    pLinkProgram(gamma_prog);
+    pGetProgramiv(gamma_prog, E_LINK_STATUS, &linked);
+    if (!linked) {
+        fprintf(stderr, "Error: EGL offscreen: the gamma pass's shader doesn't link\n");
+        return false;
+    }
+    /* the program, the textures and the triangle stay bound: nothing else draws in gamma_ctx */
+    pUseProgram(gamma_prog);
+    pUniform1i(pGetUniformLocation(gamma_prog, "frame"), 0);
+    pUniform1i(pGetUniformLocation(gamma_prog, "lut"), 1);
+    glGenTextures(2, gamma_tex);
+    for (int i = 0; i < 2; i++) {
+        pActiveTexture(E_TEXTURE0 + i);
+        glBindTexture(GL_TEXTURE_2D, gamma_tex[i]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, E_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, E_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, i? 256:fbo_w, i? 1:fbo_h, 0, GL_RGBA,
+                     GL_UNSIGNED_BYTE, NULL);
+    }
+    pVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, tri);
+    pEnableVertexAttribArray(0);
+    glViewport(0, 0, fbo_w, fbo_h);
+    gamma_lut_dirty = true;
+    return true;
+}
+
+/* With gamma_ctx current: the framebuffer of scanout buffer i (made the first time) bound for
+ * drawing; false when it is incomplete */
+static bool gamma_draw_target(int i)
+{
+    if (!gamma_draw_fbo[i]) {
+        pGenFramebuffers(1, &gamma_draw_fbo[i]);
+        pBindFramebuffer(E_DRAW_FRAMEBUFFER, gamma_draw_fbo[i]);
+        pFramebufferRenderbuffer(E_DRAW_FRAMEBUFFER, E_COLOR_ATTACHMENT0, E_RENDERBUFFER, rb_scan[i]);
+        glDrawBuffer(E_COLOR_ATTACHMENT0);
+        if (pCheckFramebufferStatus(E_DRAW_FRAMEBUFFER) != E_FRAMEBUFFER_COMPLETE) {
+            fprintf(stderr, "Error: EGL offscreen: the gamma pass's framebuffer %d is incomplete\n", i);
+            return false;
+        }
+    }
+    pBindFramebuffer(E_DRAW_FRAMEBUFFER, gamma_draw_fbo[i]);
+    return true;
+}
+
+/* The front buffer into scanout buffer i through the gamma ramp, finished; called with
+ * OpenGLide's context current, which it is again after. false: read this frame back */
+static bool scan_gamma(int i)
+{
+    bool ok = false;
+    EGLSyncKHR sync;
+
+    if (gamma_failed)
+        return false;
+    if (gamma_ctx == EGL_NO_CONTEXT) {
+        gamma_ctx = eglCreateContext(egl_dpy, egl_cfg, egl_ctx, NULL);
+        if (gamma_ctx == EGL_NO_CONTEXT) {
+            fprintf(stderr, "Error: EGL offscreen: no context for the gamma pass (0x%04x), frames with "
+                "a gamma ramp are read back\n", eglGetError());
+            gamma_failed = true;
+            return false;
+        }
+    }
+    sync = wait_sync_begin();  // OpenGLide's frame done before gamma_ctx reads it
+    if (!eglMakeCurrent(egl_dpy, egl_pbuf, egl_pbuf, gamma_ctx)) {
+        if (sync != EGL_NO_SYNC_KHR)
+            pDestroySyncKHR(egl_dpy, sync);
+        eglMakeCurrent(egl_dpy, egl_pbuf, egl_pbuf, egl_ctx);
+        return false;
+    }
+    wait_sync_end(sync);
+    if ((!gamma_prog && !gamma_init()) || !gamma_draw_target(i)) {
+        fprintf(stderr, "Info: EGL offscreen: no gamma pass, frames with a gamma ramp are read back\n");
+        gamma_failed = true;
+        goto out;
+    }
+    pActiveTexture(E_TEXTURE0 + 1);
+    if (gamma_lut_dirty) {
+        unsigned char lut[256 * 4];
+        for (int i = 0; i < 256; i++) {
+            lut[i * 4] = gamma_lut[0][i];
+            lut[i * 4 + 1] = gamma_lut[1][i];
+            lut[i * 4 + 2] = gamma_lut[2][i];
+            lut[i * 4 + 3] = 0xff;
+        }
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 256, 1, GL_RGBA, GL_UNSIGNED_BYTE, lut);
+        gamma_lut_dirty = false;
+    }
+    pActiveTexture(E_TEXTURE0);
+    glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, fbo_w, fbo_h);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    finish_gl();  // the display reads the scanout buffer at once
+    ok = true;
+out:
+    eglMakeCurrent(egl_dpy, egl_pbuf, egl_pbuf, egl_ctx);
+    return ok;
+}
+
+/* Scanout buffer i, with OpenGLide's context current */
+static void destroy_scan_buffer(int i)
+{
+    if (scan_img[i] != EGL_NO_IMAGE_KHR) {
+        PFNEGLDESTROYIMAGEKHRPROC destroyImage =
+            (PFNEGLDESTROYIMAGEKHRPROC) eglGetProcAddress("eglDestroyImageKHR");
+        if (destroyImage)
+            destroyImage(egl_dpy, scan_img[i]);
+        scan_img[i] = EGL_NO_IMAGE_KHR;
+    }
+    if (fbo_scan[i])
+        pDeleteFramebuffers(1, &fbo_scan[i]);
+    if (rb_scan[i])
+        pDeleteRenderbuffers(1, &rb_scan[i]);
+    fbo_scan[i] = rb_scan[i] = 0;
+}
+
+static void destroy_scanout(void)
+{
+    destroy_gamma_ctx();
+    for (int i = 0; i < SCAN_BUFFERS; i++)
+        destroy_scan_buffer(i);
+}
+
+//*************************************************
+//* Scanout buffer i (0 or 1) as a dmabuf: one plane, its file descriptor (the caller's to close),
+//* the bytes from one row to the next, the offset of the first, the DRM fourcc and format modifier.
+//* Called on the thread that opened the Glide window, while it is open. Returns 1, or 0 when the
+//* EGL display can't export (no EGL_MESA_image_dma_buf_export, or llvmpipe without /dev/udmabuf).
+//*************************************************
+extern "C" int getOffscreenDmabufAt(int i, int *fd, int *stride, int *offset, unsigned int *fourcc,
+                                    unsigned long *modifier)
+{
+    const char *ext;
+    PFNEGLCREATEIMAGEKHRPROC createImage;
+    PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC exportQuery;
+    PFNEGLEXPORTDMABUFIMAGEMESAPROC exportImage;
+    int fmt = 0, planes = 0;
+    EGLuint64KHR mod = 0;
+    EGLint pitch = 0, off = 0;
+    int f = -1;
+
+    if (!fbo || i < 0 || i >= SCAN_BUFFERS)
+        return 0;
+    ext = eglQueryString(egl_dpy, EGL_EXTENSIONS);
+    if (!has_ext(ext, "EGL_MESA_image_dma_buf_export") || !has_ext(ext, "EGL_KHR_gl_renderbuffer_image")) {
+        fprintf(stderr, "Info: EGL offscreen: this EGL display exports no dmabuf "
+            "(EGL_MESA_image_dma_buf_export; llvmpipe needs /dev/udmabuf)\n");
+        return 0;
+    }
+    createImage = (PFNEGLCREATEIMAGEKHRPROC) eglGetProcAddress("eglCreateImageKHR");
+    exportQuery = (PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC) eglGetProcAddress("eglExportDMABUFImageQueryMESA");
+    exportImage = (PFNEGLEXPORTDMABUFIMAGEMESAPROC) eglGetProcAddress("eglExportDMABUFImageMESA");
+    if (!createImage || !exportQuery || !exportImage)
+        return 0;
+
+    if (!fbo_scan[i]) {
+        pGenFramebuffers(1, &fbo_scan[i]);
+        pGenRenderbuffers(1, &rb_scan[i]);
+        pBindRenderbuffer(E_RENDERBUFFER, rb_scan[i]);
+        pRenderbufferStorage(E_RENDERBUFFER, GL_RGBA8, fbo_w, fbo_h);
+        pBindRenderbuffer(E_RENDERBUFFER, 0);
+        pBindFramebuffer(E_FRAMEBUFFER, fbo_scan[i]);
+        pFramebufferRenderbuffer(E_FRAMEBUFFER, E_COLOR_ATTACHMENT0, E_RENDERBUFFER, rb_scan[i]);
+        GLenum status = pCheckFramebufferStatus(E_FRAMEBUFFER);
+        if (status == E_FRAMEBUFFER_COMPLETE) {
+            glClearColor(0, 0, 0, 0);
+            glClear(GL_COLOR_BUFFER_BIT);
+        }
+        pBindFramebuffer(E_FRAMEBUFFER, fbo);
+        if (status != E_FRAMEBUFFER_COMPLETE) {
+            fprintf(stderr, "Error: EGL offscreen: scanout framebuffer incomplete (0x%04x)\n", status);
+            destroy_scan_buffer(i);
+            return 0;
+        }
+        glFinish();
+        scan_img[i] = createImage(egl_dpy, egl_ctx, EGL_GL_RENDERBUFFER_KHR,
+                                  (EGLClientBuffer)(uintptr_t) rb_scan[i], NULL);
+        if (scan_img[i] == EGL_NO_IMAGE_KHR) {
+            fprintf(stderr, "Error: EGL offscreen: eglCreateImage of the scanout buffer 0x%04x\n", eglGetError());
+            destroy_scan_buffer(i);
+            return 0;
+        }
+    }
+    if (!exportQuery(egl_dpy, scan_img[i], &fmt, &planes, &mod) || planes != 1 ||
+        !exportImage(egl_dpy, scan_img[i], &f, &pitch, &off) || f < 0) {
+        fprintf(stderr, "Error: EGL offscreen: the scanout buffer can't be exported as a dmabuf "
+            "(planes %d, fd %d, 0x%04x)\n", planes, f, eglGetError());
+        if (f >= 0)
+            close(f);
+        destroy_scan_buffer(i);
+        return 0;
+    }
+    *fd = f;
+    *stride = pitch;
+    *offset = off;
+    *fourcc = (unsigned int) fmt;
+    *modifier = (unsigned long) mod;
+    return 1;
+}
+
+extern "C" int getOffscreenDmabuf(int *fd, int *stride, int *offset, unsigned int *fourcc,
+                                  unsigned long *modifier)
+{
+    return getOffscreenDmabufAt(0, fd, stride, offset, fourcc, modifier);
+}
+
+//*************************************************
+//* The front buffer (what a window would show) into scanout buffer i, finished, so that the
+//* display can read it from another context (and thread) at once; the other buffer isn't touched.
+//* Called on the thread that opened the Glide window. With a gamma ramp set the copy applies it
+//* (scan_gamma). Returns 1, or 0 when there is no such scanout buffer, or a ramp is set and the
+//* gamma pass can't be had (the caller then reads the frame back with getOffscreenFrame, which
+//* applies the ramp).
+//*************************************************
+extern "C" int getOffscreenScanoutAt(int i)
+{
+    GLint read_buf;
+    GLboolean scissor;
+
+    if (!fbo || i < 0 || i >= SCAN_BUFFERS || !fbo_scan[i] || (gamma_on && gamma_failed))
+        return 0;
+    RenderDrawTriangles();
+    if (gamma_on)
+        return scan_gamma(i)? 1:0;
+    glGetIntegerv(GL_READ_BUFFER, &read_buf);
+    scissor = glIsEnabled(GL_SCISSOR_TEST);
+    if (scissor)
+        glDisable(GL_SCISSOR_TEST);
+    glReadBuffer(FBO_FRONT);
+    pBindFramebuffer(E_DRAW_FRAMEBUFFER, fbo_scan[i]);
+    pBlitFramebuffer(0, 0, fbo_w, fbo_h, 0, 0, fbo_w, fbo_h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    pBindFramebuffer(E_DRAW_FRAMEBUFFER, fbo);
+    glReadBuffer(read_buf);
+    if (scissor)
+        glEnable(GL_SCISSOR_TEST);
+    finish_gl();
+    return 1;
+}
+
+extern "C" int getOffscreenScanout(void)
+{
+    return getOffscreenScanoutAt(0);
+}
+
 #endif // !C_USE_SDL && !WIN32
