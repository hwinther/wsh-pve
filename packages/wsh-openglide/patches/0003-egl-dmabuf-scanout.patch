+static EGLConfig egl_cfg;
 static GLuint fbo, rb_color[2], rb_depth;
 static int fbo_w, fbo_h;
+static void destroy_scanout(void);
+static void destroy_gamma_ctx(void);
+static int fence_state; /* finish_gl: 0 not decided yet, 1 an EGL fence, -1 glFinish */
 
 static bool has_ext(const char *list, const char *ext)
 {
@@ -162,12 +168,13 @@ static bool create_fbo(int width, int height)
 //* program reads (getOffscreenFrame), on the CPU, only while it isn't the identity.
