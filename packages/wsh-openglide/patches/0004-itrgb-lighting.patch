+// Draw the saved triangles first .. first + count - 1, with the texture coordinates on the second
+// texture unit too when two_tex
+static void RenderDrawRange( long first, long count, bool two_tex )
+{
+    if ( InternalConfig.EXT_vertex_array )
+    {
+        glDrawArrays( GL_TRIANGLES, first * 3, count * 3 );
+    }
+    else
+    {
+        glBegin( GL_TRIANGLES );
+        for ( long i = first; i < first + count; i++ )
+        {
+            glColor4fv( &OGLRender.TColor[ i ].ar );
+            p_glSecondaryColor3fvEXT( &OGLRender.TColor2[ i ].ar );
+            p_glFogCoordfEXT( OGLRender.TFog[ i ].af );
+            glTexCoord4fv( &OGLRender.TTexture[ i ].as );
+            if ( two_tex )
