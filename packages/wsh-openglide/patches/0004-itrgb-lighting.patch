+        glColor3fv( &OGLRender.TColor[ i ].cr );
+        p_glSecondaryColor3fvEXT( &OGLRender.TColor2[ i ].cr );
+        p_glFogCoordfEXT( OGLRender.TFog[ i ].cf );
+        glTexCoord4fv( &OGLRender.TTexture[ i ].cs );
