+
+// The saved triangles, through the chroma-key path or not. With grAlphaControlsITRGBLighting (itrgb),
+// each run of triangles that share the colour with the constant as local (TColorAlt) is drawn with
+// that colour as the texture environment's constant: RenderITRGBBegin() set the units up to pick it
+// or the vertex colour per texel.
+static void RenderDrawAll( bool chroma, bool two_tex, bool itrgb )
+{
+    long first = 0;
+
+    while ( first < OGLRender.NumberOfTriangles )
+    {
+        long count = OGLRender.NumberOfTriangles - first;
+
+        if ( itrgb )
+        {
+            const TColorStruct *c = &OGLRender.TColorAlt[ first ];
+            GLfloat env[ 4 ] = { c->ar, c->ag, c->ab, 1.0f };
+
+            for ( count = 1; first + count < OGLRender.NumberOfTriangles; count++ )
+            {
+                const TColorStruct *n = &OGLRender.TColorAlt[ first + count ];
+                if ( ( n->ar != c->ar ) || ( n->ag != c->ag ) || ( n->ab != c->ab ) )
+                {
+                    break;
+                }
+            }
+            for ( int i = 0; i < 3; i++ )
+            {
+                env[ i ] = ( env[ i ] < 0.0f ) ? 0.0f : ( ( env[ i ] > 1.0f ) ? 1.0f : env[ i ] );
+            }
+            glTexEnvfv( GL_TEXTURE_ENV, GL_TEXTURE_ENV_COLOR, env );
+        }
+        if ( chroma )
+        {
+            RenderDrawRangeChroma( first, count, two_tex );
+        }
+        else
+        {
+            RenderDrawRange( first, count, two_tex );
+        }
+        first += count;
+    }
+}
