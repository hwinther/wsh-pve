new file mode 100644
index 0000000..f3237c2
--- /dev/null
+++ b/openglide/platform/linux/egl.cpp
@@ -0,0 +1,367 @@
+//**************************************************************
+//*            OpenGLide - Glide to OpenGL Wrapper
+//*
+//*   Offscreen rendering through EGL, for a host without an X
+//*   server: a desktop OpenGL context on an EGL display with no
+//*   window (Mesa's surfaceless platform, an EGL device, or the
+//*   default display), rendering into a framebuffer object whose
+//*   two colour attachments stand in for Glide's back and front
+//*   buffers. The host program (qemu-3dfx) asks for it with
+//*   setConfig(WRAPPER_FLAG_OFFSCREEN) and reads each frame with
+//*   getOffscreenFrame().
+//*
+//*         OpenGLide is OpenSource under LGPL license
+//*      EGL offscreen platform: Copyright 2026 WsHosting ENK
+//**************************************************************
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#if !defined C_USE_SDL && !defined WIN32
+
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+#include "GlOgl.h"
+#include "GLRender.h"
+
+#include "platform/openglext.h"
+#include "platform/window.h"
+#include "platform/linux/egl.h"
+
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+
+/* GL 3.0 / ARB_framebuffer_object entry points, looked up at run time (libGL's headers declare
+ * them only with GL_GLEXT_PROTOTYPES, and the library must not need a newer libGL to load) */
+#define FBO_FUNCS(X) \
+    X(void, GenFramebuffers, (GLsizei, GLuint *)) \
+    X(void, DeleteFramebuffers, (GLsizei, const GLuint *)) \
+    X(void, BindFramebuffer, (GLenum, GLuint)) \
+    X(void, GenRenderbuffers, (GLsizei, GLuint *)) \
+    X(void, DeleteRenderbuffers, (GLsizei, const GLuint *)) \
+    X(void, BindRenderbuffer, (GLenum, GLuint)) \
+    X(void, RenderbufferStorage, (GLenum, GLenum, GLsizei, GLsizei)) \
+    X(void, FramebufferRenderbuffer, (GLenum, GLenum, GLenum, GLuint)) \
+    X(GLenum, CheckFramebufferStatus, (GLenum)) \
+    X(void, BlitFramebuffer, (GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLbitfield, GLenum))
+#define FBO_DECL(ret, name, args) static ret (*p##name) args;
+FBO_FUNCS(FBO_DECL)
+
+#define E_FRAMEBUFFER          0x8D40
+#define E_RENDERBUFFER         0x8D41
+#define E_READ_FRAMEBUFFER     0x8CA8
+#define E_DRAW_FRAMEBUFFER     0x8CA9
+#define E_COLOR_ATTACHMENT0    0x8CE0
+#define E_COLOR_ATTACHMENT1    0x8CE1
+#define E_DEPTH_STENCIL_ATTACHMENT 0x821A
+#define E_DEPTH24_STENCIL8     0x88F0
+#define E_FRAMEBUFFER_COMPLETE 0x8CD5
+#ifndef GL_BGRA
+#define GL_BGRA                0x80E1
+#endif
+#ifndef GL_UNSIGNED_INT_8_8_8_8_REV
+#define GL_UNSIGNED_INT_8_8_8_8_REV 0x8367
+#endif
+
+/* The back buffer is attachment 0, the front buffer attachment 1 */
+#define FBO_BACK  E_COLOR_ATTACHMENT0
+#define FBO_FRONT E_COLOR_ATTACHMENT1
+
+static EGLDisplay egl_dpy = EGL_NO_DISPLAY;
+static EGLContext egl_ctx = EGL_NO_CONTEXT;
+static EGLSurface egl_pbuf = EGL_NO_SURFACE;
+static GLuint fbo, rb_color[2], rb_depth;
+static int fbo_w, fbo_h;
+
+static bool has_ext(const char *list, const char *ext)
+{
+    size_t n = strlen(ext);
+    for (const char *p = list; p && (p = strstr(p, ext)); p += n)
+        if ((p == list || p[-1] == ' ') && (p[n] == ' ' || p[n] == '\0'))
+            return true;
+    return false;
+}
+
+/* The EGL display: Mesa's surfaceless platform when the client library has it (it needs no
+ * window system: a render node, or llvmpipe), else the first EGL device, else the default */
+static EGLDisplay open_display(const char **which)
+{
+    const char *cext = eglQueryString(EGL_NO_DISPLAY, EGL_EXTENSIONS);
+    PFNEGLGETPLATFORMDISPLAYEXTPROC getPlatformDisplay = NULL;
+    EGLDisplay d = EGL_NO_DISPLAY;
+
+    if (has_ext(cext, "EGL_EXT_platform_base"))
+        getPlatformDisplay = (PFNEGLGETPLATFORMDISPLAYEXTPROC) eglGetProcAddress("eglGetPlatformDisplayEXT");
+    if (getPlatformDisplay && has_ext(cext, "EGL_MESA_platform_surfaceless")) {
+        d = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, NULL);
+        *which = "surfaceless";
+    }
+    if (d == EGL_NO_DISPLAY && getPlatformDisplay && has_ext(cext, "EGL_EXT_platform_device")) {
+        PFNEGLQUERYDEVICESEXTPROC queryDevices =
+            (PFNEGLQUERYDEVICESEXTPROC) eglGetProcAddress("eglQueryDevicesEXT");
+        EGLDeviceEXT dev;
+        EGLint n = 0;
+        if (queryDevices && queryDevices(1, &dev, &n) && n > 0) {
+            d = getPlatformDisplay(EGL_PLATFORM_DEVICE_EXT, dev, NULL);
+            *which = "device";
+        }
+    }
+    if (d == EGL_NO_DISPLAY) {
+        d = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+        *which = "default";
+    }
+    return d;
+}
+
+static bool create_fbo(int width, int height)
+{
+#define FBO_LOAD(ret, name, args) \
+    p##name = (ret (*) args) eglGetProcAddress("gl" #name); \
+    if (!p##name) { fprintf(stderr, "Error: EGL offscreen: no gl%s\n", #name); return false; }
+    FBO_FUNCS(FBO_LOAD)
+
+    fbo_w = width;
+    fbo_h = height;
+    pGenFramebuffers(1, &fbo);
+    pBindFramebuffer(E_FRAMEBUFFER, fbo);
+    pGenRenderbuffers(2, rb_color);
+    pGenRenderbuffers(1, &rb_depth);
+    for (int i = 0; i < 2; i++) {
+        pBindRenderbuffer(E_RENDERBUFFER, rb_color[i]);
+        pRenderbufferStorage(E_RENDERBUFFER, GL_RGBA8, width, height);
+        pFramebufferRenderbuffer(E_FRAMEBUFFER, E_COLOR_ATTACHMENT0 + i, E_RENDERBUFFER, rb_color[i]);
+    }
+    pBindRenderbuffer(E_RENDERBUFFER, rb_depth);
+    pRenderbufferStorage(E_RENDERBUFFER, E_DEPTH24_STENCIL8, width, height);
+    pFramebufferRenderbuffer(E_FRAMEBUFFER, E_DEPTH_STENCIL_ATTACHMENT, E_RENDERBUFFER, rb_depth);
+    pBindRenderbuffer(E_RENDERBUFFER, 0);
+
+    GLenum status = pCheckFramebufferStatus(E_FRAMEBUFFER);
+    if (status != E_FRAMEBUFFER_COMPLETE) {
+        fprintf(stderr, "Error: EGL offscreen: framebuffer incomplete (0x%04x)\n", status);
+        return false;
+    }
+    /* both buffers start black, as a fresh window does */
+    glDrawBuffer(FBO_FRONT);
+    glClearColor(0, 0, 0, 0);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glDrawBuffer(FBO_BACK);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+    glReadBuffer(FBO_BACK);
+    return true;
+}
+
+//*************************************************
+//* Gamma offscreen: there is no X server to set a gamma ramp on, so the ramp the game sets
+//* (grGammaCorrectionValue, grLoadGammaTable) is kept here and applied to each frame the host
+//* program reads (getOffscreenFrame), on the CPU, only while it isn't the identity.
+//*************************************************
+static unsigned char gamma_lut[3][256];
+static bool gamma_on;
+
+static void gamma_ramp(const unsigned short *r, const unsigned short *g, const unsigned short *b)
+{
+    const unsigned short *ramp[3] = { r, g, b };
+    gamma_on = false;
+    for (int c = 0; c < 3; c++)
+        for (int i = 0; i < 256; i++) {
+            gamma_lut[c][i] = (unsigned char)(ramp[c]? (ramp[c][i] >> 8):i);
+            gamma_on |= (gamma_lut[c][i] != i);
+        }
+}
+
+/* As SetGamma() computes it for an X ramp (sst1InitGammaRGB), here for 256 entries */
+void EGLSetGamma(float value)
+{
+    unsigned short ramp[256];
+    for (int i = 0; i < 256; i++) {
+        int v = (int)((255.0 * pow((double)i / 255.0, 1.0 / value)) + 0.5);
+        ramp[i] = (unsigned short)((v << 8) | v);
+    }
+    gamma_ramp(ramp, ramp, ramp);
+}
+
+void EGLSetGammaTable(const unsigned short *r, const unsigned short *g, const unsigned short *b)
+{
+    gamma_ramp(r, g, b);
+}
+
+void EGLGetGammaTable(unsigned short *r, unsigned short *g, unsigned short *b)
+{
+    for (int i = 0; i < 256; i++) {
+        r[i] = (unsigned short)((gamma_lut[0][i] << 8) | i);
+        g[i] = (unsigned short)((gamma_lut[1][i] << 8) | i);
+        b[i] = (unsigned short)((gamma_lut[2][i] << 8) | i);
+    }
+}
+
+bool EGLInitialiseWindow(int width, int height)
+{
+    const char *which = "";
+    EGLint major, minor, n = 0;
+    EGLConfig cfg;
+    static const EGLint cfg_attr[] = {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8,
+        EGL_NONE
+    };
+
+    egl_dpy = open_display(&which);
+    if (egl_dpy == EGL_NO_DISPLAY || !eglInitialize(egl_dpy, &major, &minor)) {
+        fprintf(stderr, "Error: EGL offscreen: no EGL display (%s, 0x%04x)\n", which, eglGetError());
+        egl_dpy = EGL_NO_DISPLAY;
+        return false;
+    }
+    if (!eglBindAPI(EGL_OPENGL_API) || !eglChooseConfig(egl_dpy, cfg_attr, &cfg, 1, &n) || n < 1) {
+        fprintf(stderr, "Error: EGL offscreen: no desktop OpenGL config on the %s display\n", which);
+        EGLFinaliseWindow();
+        return false;
+    }
+    /* No version or profile asked for: a compatibility context, which OpenGLide's fixed-function
+     * rendering needs */
+    egl_ctx = eglCreateContext(egl_dpy, cfg, EGL_NO_CONTEXT, NULL);
+    if (egl_ctx == EGL_NO_CONTEXT) {
+        fprintf(stderr, "Error: EGL offscreen: eglCreateContext 0x%04x\n", eglGetError());
+        EGLFinaliseWindow();
+        return false;
+    }
+    /* Without EGL_KHR_surfaceless_context, a 1x1 pbuffer to make the context current on; the
+     * rendering goes into the framebuffer object either way */
+    if (!has_ext(eglQueryString(egl_dpy, EGL_EXTENSIONS), "EGL_KHR_surfaceless_context")) {
+        static const EGLint pb_attr[] = { EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE };
+        egl_pbuf = eglCreatePbufferSurface(egl_dpy, cfg, pb_attr);
+    }
+    if (!eglMakeCurrent(egl_dpy, egl_pbuf, egl_pbuf, egl_ctx)) {
+        fprintf(stderr, "Error: EGL offscreen: eglMakeCurrent 0x%04x\n", eglGetError());
+        EGLFinaliseWindow();
+        return false;
+    }
+    if (!create_fbo(width, height)) {
+        EGLFinaliseWindow();
+        return false;
+    }
+    fprintf(stderr, "Info: EGL offscreen %dx%d, EGL %d.%d on the %s display, %s\n",
+        width, height, major, minor, which, (const char *) glGetString(GL_RENDERER));
+    UserConfig.PrecisionFix = false;
+    gamma_ramp(NULL, NULL, NULL);
+    return true;
+}
+
+void EGLFinaliseWindow(void)
+{
+    if (egl_dpy == EGL_NO_DISPLAY)
+        return;
+    if (egl_ctx != EGL_NO_CONTEXT && eglGetCurrentContext() == egl_ctx) {
+        if (fbo) {
+            pBindFramebuffer(E_FRAMEBUFFER, 0);
+            pDeleteFramebuffers(1, &fbo);
+            pDeleteRenderbuffers(2, rb_color);
+            pDeleteRenderbuffers(1, &rb_depth);
+        }
+        eglMakeCurrent(egl_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+    if (egl_ctx != EGL_NO_CONTEXT)
+        eglDestroyContext(egl_dpy, egl_ctx);
+    if (egl_pbuf != EGL_NO_SURFACE)
+        eglDestroySurface(egl_dpy, egl_pbuf);
+    eglTerminate(egl_dpy);
+    egl_dpy = EGL_NO_DISPLAY;
+    egl_ctx = EGL_NO_CONTEXT;
+    egl_pbuf = EGL_NO_SURFACE;
+    fbo = rb_color[0] = rb_color[1] = rb_depth = 0;
+    fbo_w = fbo_h = 0;
+}
+
+/* GL_BACK and GL_FRONT name the framebuffer object's attachments */
+GLenum EGLBuffer(GLenum buffer)
+{
+    switch (buffer) {
+    case GL_BACK:
+        return FBO_BACK;
+    case GL_FRONT:
+        return FBO_FRONT;
+    default:
+        return buffer;
+    }
+}
+
+/* Glide's swap: the back buffer is copied to the front (the back keeps its contents, as with
+ * OpenGLide's GLX copy method) */
+void EGLSwapBuffers(void)
+{
+    GLint read_buf, draw_buf;
+    GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+
+    if (!fbo)
+        return;
+    glGetIntegerv(GL_READ_BUFFER, &read_buf);
+    glGetIntegerv(GL_DRAW_BUFFER, &draw_buf);
+    if (scissor)
+        glDisable(GL_SCISSOR_TEST);
+    glReadBuffer(FBO_BACK);
+    glDrawBuffer(FBO_FRONT);
+    pBlitFramebuffer(0, 0, fbo_w, fbo_h, 0, 0, fbo_w, fbo_h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glReadBuffer(read_buf);
+    glDrawBuffer(draw_buf);
+    if (scissor)
+        glEnable(GL_SCISSOR_TEST);
+}
+
+ExtFn EGLGetProcAddress(const char *name)
+{
+    return (ExtFn) eglGetProcAddress(name);
+}
+
+//*************************************************
+//* The host program's read of the front buffer (what a window would show): width x height
+//* pixels, 4 bytes each, B G R X in memory (pixman's x8r8g8b8 on a little-endian host), rows
+//* bottom up (OpenGL's order) with stride bytes from one row to the next. Called on the thread
+//* that opened the Glide window. Returns 0 when there is no offscreen window or the size differs
+//* from the window's (the caller asks getOffscreenSize() first), else 1.
+//*************************************************
+extern "C" int getOffscreenSize(int *width, int *height)
+{
+    if (!fbo)
+        return 0;
+    *width = fbo_w;
+    *height = fbo_h;
+    return 1;
+}
+
+extern "C" int getOffscreenFrame(void *dst, int width, int height, int stride)
+{
+    GLint read_buf, pack_row, pack_align;
+
+    if (!fbo || width != fbo_w || height != fbo_h || (stride & 3) || stride < width * 4)
+        return 0;
+    RenderDrawTriangles();
+    glGetIntegerv(GL_READ_BUFFER, &read_buf);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &pack_align);
+    glReadBuffer(FBO_FRONT);
+    glPixelStorei(GL_PACK_ROW_LENGTH, stride / 4);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, width, height, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, dst);
+    glPixelStorei(GL_PACK_ROW_LENGTH, pack_row);
+    glPixelStorei(GL_PACK_ALIGNMENT, pack_align);
+    glReadBuffer(read_buf);
+    if (gamma_on) {
+        for (int y = 0; y < height; y++) {
+            unsigned char *p = (unsigned char *) dst + (size_t) y * stride;
+            for (int x = 0; x < width * 4; x += 4) {
+                p[x] = gamma_lut[2][p[x]];
+                p[x + 1] = gamma_lut[1][p[x + 1]];
+                p[x + 2] = gamma_lut[0][p[x + 2]];
+            }
+        }
+    }
+    return 1;
+}
+
+#endif // !C_USE_SDL && !WIN32
