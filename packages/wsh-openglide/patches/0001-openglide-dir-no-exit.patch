diff --git a/openglide/platform/linux/library.cpp b/openglide/platform/linux/library.cpp
index ea02e63..d2dd746 100644
--- a/openglide/platform/linux/library.cpp
+++ b/openglide/platform/linux/library.cpp
@@ -19,10 +19,9 @@ class InitLibrary
 public:
     InitLibrary( )
     {
-        if ( !ClearAndGenerateLogFile( ) )
-        {
-            exit( 0 );
-        }
+        // Without a writable log the library still works (GlideMsg() and Error() skip a file they
+        // can't open). Ending the process here ended QEMU, and the VM with it, with status 0.
+        ClearAndGenerateLogFile( );
         InitMainVariables( );            
     }
     ~InitLibrary( )
