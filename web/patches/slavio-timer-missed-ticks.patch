slavio_timer: make up for limit matches the host ran late

Browser SPARC only (web/scripts/build-qemu.sh applies web/patches/*.patch after the wsh series,
to the WebAssembly build and to the native build that makes the snapshot). Not part of pve-qemu.

Linux on sun4m keeps time by counting the system timer's level-10 interrupts: its clocksource
(timer_cs in arch/sparc/kernel/time_32.c) is the number of interrupts handled times the period,
plus the counter. The timer is a ptimer on QEMU_CLOCK_VIRTUAL, which follows the host clock, and
its callback runs in the main loop. When the main loop wakes up late, the ptimer runs every period
it missed back to back; the first sets the reached bit and raises the interrupt, the others find
it still pending and are lost, so the guest sees one tick where several passed.

Natively the main loop wakes on time. In the browser it sleeps in poll(), which Emscripten proxies
to the page's main thread, and the timeout is a setTimeout() there: any work on the page's thread
(the terminal, the browser itself) delays it, often by more than the 10 ms period, and the guest's
clock falls behind (about 3x in the measurements that found it; nearly stopped with the page's
thread kept busy).

The fix counts the matches that find the interrupt pending and raises it again each time the guest
clears it by reading the limit register, so a late host delivers the ticks in a burst instead of
dropping them. The backlog is capped at a minute; writing the limit or the mode clears it. The
count travels in a subsection that is only sent when it is not zero.

--- a/hw/timer/slavio_timer.c
+++ b/hw/timer/slavio_timer.c
@@ -57,6 +57,8 @@
     /* processor only */
     uint32_t run;
     uint64_t limit;
+    /* limit matches while the interrupt of an earlier one was still pending */
+    uint32_t missed;
 } CPUTimerState;
 
 #define TYPE_SLAVIO_TIMER "slavio_timer"
@@ -121,6 +123,19 @@
     t->counthigh = count >> 32;
 }
 
+/*
+ * At most a minute of missed limit matches is made up for: a longer
+ * backlog (a host that stopped running the machine) is dropped as before.
+ */
+#define TIMER_MAX_BACKLOG_NS 60000000000ULL
+
+static uint32_t slavio_timer_max_missed(CPUTimerState *t)
+{
+    uint64_t period_ns = (t->limit >> 9) * TIMER_PERIOD;
+
+    return period_ns ? MIN(TIMER_MAX_BACKLOG_NS / period_ns, UINT32_MAX) : 0;
+}
+
 // timer callback
 static void slavio_timer_irq(void *opaque)
 {
@@ -130,14 +145,26 @@
 
     slavio_timer_get_out(t);
     trace_slavio_timer_irq(t->counthigh, t->count);
-    /* if limit is 0 (free-run), there will be no match */
-    if (t->limit != 0) {
-        t->reached = TIMER_REACHED;
-    }
     /* there is no interrupt if user timer or free-run */
     if (!slavio_timer_is_user(tc) && t->limit != 0) {
+        /*
+         * A match while the last one is still pending: the host ran this
+         * timer late (several periods at once). Count it and raise the
+         * interrupt again when the guest clears the pending one, so that
+         * a guest counting ticks keeps time.
+         */
+        if (t->reached) {
+            if (t->missed < slavio_timer_max_missed(t)) {
+                t->missed++;
+            }
+            return;
+        }
         qemu_irq_raise(t->irq);
     }
+    /* if limit is 0 (free-run), there will be no match */
+    if (t->limit != 0) {
+        t->reached = TIMER_REACHED;
+    }
 }
 
