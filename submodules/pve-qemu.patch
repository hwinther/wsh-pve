diff --git a/debian/patches/wsh/0128-hw-audio-cs4231-drop-what-the-apc-took-past-the-code.patch b/debian/patches/wsh/0128-hw-audio-cs4231-drop-what-the-apc-took-past-the-code.patch
new file mode 100644
index 0000000..36ac1e2
--- /dev/null
+++ b/debian/patches/wsh/0128-hw-audio-cs4231-drop-what-the-apc-took-past-the-code.patch
@@ -0,0 +1,423 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/audio/cs4231: drop what the apc took past the codec on a
+ stop
+
+The APC takes its samples up to 50 ms ahead of the codec's clock, and
+the model wrote them into the audiodev as it took them. "play out the
+last samples when playback stops" then kept the voice on after a stop,
+so that everything taken was heard. That is right at the end of a
+sound, when the pipe runs empty and PMI comes, as under SunOS and
+Solaris. It is wrong when the driver stops in the middle of a buffer:
+Linux (snd-sun-cs4231) stops when its last period has played, by
+zeroing the counts and turning the DMA off, and by then the APC has
+taken up to 50 ms of the next period of its ring, old samples. They
+reached the audiodev: on an SS-5 with Linux 7.3.4, a 1000 ms tone was
+followed by ~150 frames of an earlier part of the tone, 36 ms later.
+The samples were already in the audiodev when the stop came (with a
+wav audiodev most of them were in the file), so they cannot be taken
+back there.
+
+What the APC takes now goes into a FIFO in the model, converted, and
+from there to the audiodev when the codec clock gets to it
+(cs_play_out(), at each audio callback). The take-ahead itself is
+unchanged: the APC's address and count, PI, PD, PM and PMI move as
+before. When the pipe runs empty the FIFO is still played to its end,
+with the voice on for 200 ms as before. When the driver stops the DMA
+(PDMA_GO cleared, or the count zeroed while playback ran),
+cs_play_drop() drops what lies past the codec's position, and the
+codec's end moves to now: the real chip has a FIFO of a few samples
+and never plays them either. At a stop after PMI the codec is past
+everything taken, and nothing is dropped. A pause (PPAUSE) or PEN off
+drops nothing: SunOS 4.1.4 pauses and turns PEN off as soon as the APC
+shows the pipe empty, which is when it has taken the last buffer, up to
+50 ms before the codec has played it (dropping there cut a 5 ms sound
+after 3 ms), and after a pause the APC goes on from its address. A
+format change empties the FIFO.
+
+The playback address and count registers now read as the codec's
+position: what the APC has taken from the current buffer past the
+codec is subtracted from the address and added to the count
+(cs_play_back()). Linux takes its playback position from the address
+and finishes a drain when that passes the end of its data; read 50 ms
+ahead, it sometimes stopped at the interrupt for its last period, and
+the drop then cut the last 22 ms of the tone. The registers are written
+as before.
+
+A new vmstate subsection "cs4231/fifo" carries the FIFO, the codec's
+end (play_end) and what was taken from the current buffer, and is sent
+only while the FIFO holds samples, so older streams load and streams
+without it load as before. Without it, after a migration 20 ms into a
+100 ms buffer, the destination's address and count read the APC's
+position instead of the codec's (560 bytes further on), the codec
+started again at once, PMI came 10 ms after the migration instead of
+80, and the samples taken ahead were lost (240 of 640 frames reached
+the audiodev). Before this change the same migration also lost 187
+frames and gave PMI 43 ms early: the samples were in the audiodev then.
+
+Tested in a sparc-softmmu build on Linux: sun4m-cs4231-test passes
+with the cases of the next commit, which fail without this change
+(mid-stop: 720 frames in the wav file where the codec had played 320;
+migrate-fifo: the address read 0xff0002d1 instead of 0xff0000a1). On an SS-5
+with OpenBIOS "intr" 0x39 an unmodified Linux 7.3.4 plays 1000 ms of
+440 Hz followed by 22 ms of the silence it pads its last period with
+(five runs), then at most 110 frames (2.5 ms; none in one run, 8 to 15
+in three) that the codec plays between the period's interrupt and
+Linux's stop under TCG. Before: 36 ms of silence and 153-154 frames of
+old samples. SunOS 4.1.4 and Solaris 2.6 still play 2.56 s of u-law
+and a 40-byte sound after it without a gap.
+---
+ hw/audio/cs4231.c | 191 +++++++++++++++++++++++++++++++++++++++-------
+ 1 file changed, 165 insertions(+), 26 deletions(-)
+
+diff --git a/hw/audio/cs4231.c b/hw/audio/cs4231.c
+index 9edab14..19bd06a 100644
+--- a/hw/audio/cs4231.c
++++ b/hw/audio/cs4231.c
+@@ -44,10 +44,18 @@
+  * FIFO, and SunOS loads the next buffer only after PI, so taking a whole
+  * buffer at once would leave the pipe empty.
+  *
+- * Because the samples are taken that far ahead, the voice stays on for
+- * CS_DRAIN_NS after playback stops, at the end of the last buffer or when
+- * the driver turns the DMA off, so that the audiodev still plays what was
+- * taken: turning it off at once drops the last 50 ms of every sound.
++ * What the APC has taken waits in the model's FIFO and goes to the
++ * audiodev when the codec clock gets to it. At the end of the last buffer
++ * (the pipe ran empty, PMI) all of it is still played: the voice stays on
++ * for CS_DRAIN_NS after playback stops, and turning it off at once would
++ * drop the last 50 ms of every sound. When the driver stops the DMA
++ * before the codec got there (it turns PDMA_GO off or zeroes the count),
++ * what lies past the codec's position is dropped, as on the real chip,
++ * whose FIFO holds a few samples: Linux stops when its last period has
++ * played, with the APC up to 50 ms into the next period of its ring, and
++ * those old samples must not be heard. A pause or PEN off drops nothing:
++ * SunOS pauses and turns PEN off as soon as the pipe shows empty, which
++ * is when the APC has taken the last buffer, not when it has been played.
+  *
+  * The interrupts are not raised when the samples are taken but when the
+  * codec clock gets to that point, as on the real chip: PI when the
+@@ -91,6 +99,7 @@
+ 
+ #define CS_SIZE 0x40
+ #define CS_DRAIN_NS (200 * SCALE_MS)   /* well past the 50 ms taken ahead */
++#define CS_FIFO 16384                   /* bytes: > 50 ms at 48 kHz stereo */
+ #define CS_REGS 16
+ #define CS_DREGS 32
+ #define CS_MAXDREG (CS_DREGS - 1)
+@@ -178,6 +187,9 @@ struct CSState {
+     uint64_t play_units;    /* taken since play_start */
+     int64_t play_drain;     /* the voice stays on until then */
+     int64_t play_end;       /* what was taken has been played by then */
++    int16_t fifo[CS_FIFO / 2];  /* taken, converted, not yet played */
++    uint32_t fifo_len;      /* bytes in fifo; it ends at play_end */
++    uint32_t buf_taken;     /* bytes taken from the current buffer */
+     int64_t pi_at;          /* PI is due then, or -1 */
+     int64_t pmi_at;         /* PMI is due then, or -1 */
+     QEMUTimer *irq_timer;   /* raises them when they are due */
+@@ -331,6 +343,7 @@ static void cs_play_next(CSState *s)
+     if (s->play_next) {
+         s->regs[CS_PVA] = s->regs[CS_PNVA];
+         s->regs[CS_PC] = s->regs[CS_PNC];
++        s->buf_taken = 0;
+         s->play_next = false;
+         /* loaded before the pipe ran empty: no PMI, the PI then */
+         s->pmi_at = -1;
+@@ -461,11 +474,10 @@ static void cs_convert(CSState *s, const uint8_t *in, int16_t *out,
+     }
+ }
+ 
+-/* Feed the audiodev, which has room for room bytes, from the DMA buffers. */
+-static void cs_play_feed(CSState *s, uint32_t room, int64_t now)
++/* Take samples from the DMA buffers into the FIFO */
++static void cs_play_feed(CSState *s, int64_t now)
+ {
+     uint8_t in[1024];
+-    int16_t out[2048];
+     uint32_t unit_in, unit_out;
+     uint64_t rate, due, budget;
+     int64_t ahead;
+@@ -498,25 +510,21 @@ static void cs_play_feed(CSState *s, uint32_t room, int64_t now)
+             /* a partial sample at the end of a buffer: skip it */
+             s->regs[CS_PVA] += pc;
+             s->regs[CS_PC] = 0;
++            s->buf_taken += pc;
+         } else {
+-            units = MIN(pc / unit_in, room / unit_out);
++            units = MIN(pc / unit_in, (CS_FIFO - s->fifo_len) / unit_out);
+             units = MIN(units, sizeof(in) / unit_in);
+-            units = MIN(units, sizeof(out) / unit_out);
+             units = MIN(units, budget);
+             if (units == 0) {
+                 break;
+             }
+             dma_memory_read(cs_dma_as(s), s->regs[CS_PVA], in,
+                             units * unit_in, MEMTXATTRS_UNSPECIFIED);
+-            cs_convert(s, in, out, units);
+-            units = audio_be_write(s->audio_be, s->voice, out,
+-                                   units * unit_out) / unit_out;
+-            if (units == 0) {
+-                break;
+-            }
++            cs_convert(s, in, s->fifo + s->fifo_len / 2, units);
++            s->fifo_len += units * unit_out;
+             s->regs[CS_PVA] += units * unit_in;
+             s->regs[CS_PC] -= units * unit_in;
+-            room -= units * unit_out;
++            s->buf_taken += units * unit_in;
+             budget -= units;
+             s->play_units += units;
+             s->play_end = s->play_start +
+@@ -532,20 +540,84 @@ static void cs_play_feed(CSState *s, uint32_t room, int64_t now)
+     }
+ }
+ 
++/* Units in the FIFO that the codec has not got to yet */
++static uint32_t cs_fifo_ahead(CSState *s, int64_t now, uint32_t unit_out)
++{
++    uint64_t ahead;
++
++    if (s->play_end <= now) {
++        return 0;
++    }
++    ahead = muldiv64(s->play_end - now, cs_play_rate(s),
++                     NANOSECONDS_PER_SECOND);
++    return MIN(ahead, s->fifo_len / unit_out);
++}
++
++/* Give the audiodev, which has room for room bytes, what the codec plays */
++static void cs_play_out(CSState *s, uint32_t room, int64_t now)
++{
++    uint32_t unit_in, unit_out, units, len;
++
++    cs_play_units(s, &unit_in, &unit_out);
++    units = s->fifo_len / unit_out - cs_fifo_ahead(s, now, unit_out);
++    len = MIN(units, room / unit_out) * unit_out;
++    if (len == 0) {
++        return;
++    }
++    len = audio_be_write(s->audio_be, s->voice, s->fifo, len);
++    len -= len % unit_out;
++    s->fifo_len -= len;
++    memmove(s->fifo, s->fifo + len / 2, s->fifo_len);
++}
++
++/*
++ * The driver stopped playback before the codec got to the end of what
++ * the APC took: drop what lies past the codec's position.
++ */
++static void cs_play_drop(CSState *s, int64_t now)
++{
++    uint32_t unit_in, unit_out;
++
++    cs_play_units(s, &unit_in, &unit_out);
++    s->fifo_len -= cs_fifo_ahead(s, now, unit_out) * unit_out;
++    s->play_end = MIN(s->play_end, now);
++}
++
++/*
++ * Bytes of the current buffer that the APC has taken but the codec has
++ * not got to: the address and count registers read as the codec's
++ * position, as on the real chip with its small FIFO. Linux takes its
++ * playback position from the address, and finishes a drain when that
++ * passes the end of its data; read 50 ms ahead it stopped in the middle
++ * of its last period.
++ */
++static uint32_t cs_play_back(CSState *s)
++{
++    uint32_t unit_in, unit_out;
++    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
++
++    if (!s->voice) {
++        return 0;
++    }
++    cs_play_units(s, &unit_in, &unit_out);
++    return MIN(cs_fifo_ahead(s, now, unit_out) * unit_in, s->buf_taken);
++}
++
+ /* The audiodev has room for avail bytes */
+ static void cs_audio_callback(void *opaque, int avail)
+ {
+     CSState *s = opaque;
+     int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+ 
+-    if (!s->play_running) {
+-        /* stopped: the voice is on only to play out the last samples */
+-        if (now >= s->play_drain) {
+-            audio_be_set_active_out(s->audio_be, s->voice, false);
+-        }
+-        return;
++    if (s->play_running) {
++        cs_play_feed(s, now);
++    }
++    cs_play_out(s, MAX(avail, 0), now);
++    /* stopped: the voice is on only to play out the last samples */
++    if (!s->play_running && now >= s->play_drain) {
++        s->fifo_len = 0;
++        audio_be_set_active_out(s->audio_be, s->voice, false);
+     }
+-    cs_play_feed(s, MAX(avail, 0), now);
+ }
+ 
+ /* DAC attenuation is 1.5 dB a step; the mixer wants 0-255 */
+@@ -579,14 +651,20 @@ static void cs_play_setup(CSState *s)
+     static const int divide[8] = { 3072, 1536, 896, 768, 448, 384, 512, 2560 };
+     uint8_t val = s->dregs[CS_PFMT];
+     struct audsettings as;
++    int fmt;
+ 
+     as.freq = ((val & 1) ? 16934400 : 24576000) / divide[(val >> 1) & 7];
+     as.nchannels = (val & 0x10) ? 2 : 1;
+     as.fmt = AUDIO_FORMAT_S16;
+     as.big_endian = HOST_BIG_ENDIAN;
