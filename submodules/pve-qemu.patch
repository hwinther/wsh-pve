diff --git a/debian/patches/wsh/0152-tests-qtest-test-repeated-reads-of-the-sun4m-counter.patch b/debian/patches/wsh/0152-tests-qtest-test-repeated-reads-of-the-sun4m-counter.patch
new file mode 100644
index 0000000..191187e
--- /dev/null
+++ b/debian/patches/wsh/0152-tests-qtest-test-repeated-reads-of-the-sun4m-counter.patch
@@ -0,0 +1,206 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test repeated reads of the sun4m counters
+
+On SS-600MP, with the qtest clock standing still between steps: a
+second read of the free-running system counter is one tick more,
+further reads go up to 16 ticks ahead and then hold, after a step of 4
+ticks the next read is one more, after a long step the clock's value,
+and a limit write resets it (read 0); a processor counter read twice
+and again after a limit write without reset moves one tick each time;
+the user timer read MSW then LSW moves once per pair, the LSW alone
+moves too, and stopped it holds; a counter with a 64-tick limit reads
+the same twice. On SS-10, which doesn't have the read-ahead, the system
+counter, a processor counter and the user timer read the same value
+twice in the same tick. 5 new cases, 11 in all; read-ahead-system fails
+without the previous patch.
+---
+ tests/qtest/sun4m-slavio-timer-test.c | 151 ++++++++++++++++++++++++++
+ 1 file changed, 151 insertions(+)
+
+diff --git a/tests/qtest/sun4m-slavio-timer-test.c b/tests/qtest/sun4m-slavio-timer-test.c
+index a0c7e8c..4238218 100644
+--- a/tests/qtest/sun4m-slavio-timer-test.c
++++ b/tests/qtest/sun4m-slavio-timer-test.c
+@@ -8,6 +8,16 @@
+  * (bit 31 of the MSW) once the counter wraps. QEMU kept only the bits
+  * of the CPUs it has, and its user timer never expired from the limit.
+  *
++ * The PROM also reads a running counter twice with a few instructions
++ * between and wants the second value greater, which holds on the board,
++ * where a read takes longer than the 500 ns tick. A QEMU read takes no
++ * virtual time: a read with no tick since the last one returns one tick
++ * more, at most 16 ticks ahead of the clock, never less than the read
++ * before, and not on counters with a short limit. Only the SS-600MP has
++ * that; on the other machines (SS-10 here) a read returns the counter as
++ * it is. The qtest clock stands still between steps, so every repeated
++ * read here is in the same tick.
++ *
+  * SPDX-License-Identifier: GPL-2.0-or-later
+  */
+ 
+@@ -18,11 +28,15 @@
+ #define CPU0_MSW        (COUNTER_BASE + 0x0)    /* user mode: counter MSW */
+ #define CPU0_LSW        (COUNTER_BASE + 0x4)    /* user mode: counter LSW */
+ #define CPU0_RUN        (COUNTER_BASE + 0xc)    /* user mode: start/stop */
++#define CPU0_COUNTER    (COUNTER_BASE + 0x4)    /* counter mode: counter */
++#define CPU0_NORST      (COUNTER_BASE + 0x8)    /* limit, no counter reset */
+ #define SYS_LIMIT       (COUNTER_BASE + 0x10000)
+ #define SYS_COUNTER     (COUNTER_BASE + 0x10004)
+ #define TIMER_CONFIG    (COUNTER_BASE + 0x10010)
+ 
+ #define TICK_NS         500
++#define TICK            0x200   /* one tick in the counter (bits 31-9) */
++#define READ_AHEAD      16      /* ticks a read may run ahead of the clock */
+ #define LIMIT_BIT       0x80000000u
+ 
+ static void test_config_bits(const void *data)
+@@ -108,6 +122,131 @@ static void test_system_limit(const void *data)
+     qtest_quit(qts);
+ }
+ 
++/* Repeated reads of the free-running system counter: one tick more each */
++static void test_read_ahead_system(const void *data)
++{
++    const char *machine = data;
++    QTestState *qts = qtest_initf("-machine %s", machine);
++    uint32_t first, prev, v;
++    int i;
++
++    qtest_writel(qts, SYS_LIMIT, 0);            /* free-run, counter reset */
++    qtest_clock_step(qts, 100 * TICK_NS);
++    first = qtest_readl(qts, SYS_COUNTER);
++    g_assert_cmphex(first, ==, 100 * TICK);     /* the first read: the clock */
++    g_assert_cmphex(qtest_readl(qts, SYS_COUNTER), ==, first + TICK);
++
++    /* up to READ_AHEAD ticks ahead, then it holds */
++    prev = first + TICK;
++    for (i = 0; i < 2 * READ_AHEAD; i++) {
++        v = qtest_readl(qts, SYS_COUNTER);
++        g_assert_cmphex(v, >=, prev);
++        g_assert_cmphex(v, <=, first + READ_AHEAD * TICK);
++        prev = v;
++    }
++    g_assert_cmphex(prev, ==, first + READ_AHEAD * TICK);
++
++    /* the clock catches up: the counter as it is, never less */
++    qtest_clock_step(qts, 4 * TICK_NS);
++    g_assert_cmphex(qtest_readl(qts, SYS_COUNTER), ==,
++                    first + (READ_AHEAD + 1) * TICK);
++    qtest_clock_step(qts, 1000 * TICK_NS);
++    g_assert_cmphex(qtest_readl(qts, SYS_COUNTER), ==, first + 1004 * TICK);
++
++    /* a limit write resets the counter: no read ahead of the reset */
++    qtest_writel(qts, SYS_LIMIT, 0);
++    g_assert_cmphex(qtest_readl(qts, SYS_COUNTER), ==, 0);
++    qtest_quit(qts);
++}
++
++/* As the PROM does it: read, write the limit without a reset, read */
++static void test_read_ahead_processor(const void *data)
++{
++    const char *machine = data;
++    QTestState *qts = qtest_initf("-machine %s", machine);
++    uint32_t a, b;
++
++    qtest_clock_step(qts, 10 * TICK_NS);
++    a = qtest_readl(qts, CPU0_COUNTER);
++    b = qtest_readl(qts, CPU0_COUNTER);
++    g_assert_cmphex(b, ==, a + TICK);
++    qtest_writel(qts, CPU0_NORST, 0x7ffffe00);
++    g_assert_cmphex(qtest_readl(qts, CPU0_COUNTER), ==, b + TICK);
++    qtest_quit(qts);
++}
++
++/*
++ * The user timer read with ldd (MSW, then LSW) moves on once per pair;
++ * stopped, it holds.
++ */
++static void test_read_ahead_user(const void *data)
++{
++    const char *machine = data;
++    QTestState *qts = qtest_initf("-machine %s", machine);
++    uint64_t a;
++
++    qtest_writel(qts, TIMER_CONFIG, 1);         /* CPU 0: user timer */
++    qtest_writel(qts, CPU0_RUN, 0);
++    user_set(qts, 0x0000000100000000ULL);
++    g_assert_cmphex(user_count(qts), ==, 0x0000000100000000ULL);
++    g_assert_cmphex(user_count(qts), ==, 0x0000000100000000ULL);
++
++    qtest_writel(qts, CPU0_RUN, 1);
++    qtest_clock_step(qts, 4 * TICK_NS);
++    a = user_count(qts);
++    g_assert_cmphex(a, ==, 0x0000000100000000ULL + 4 * TICK);
++    g_assert_cmphex(user_count(qts), ==, a + TICK);
++    g_assert_cmphex(user_count(qts), ==, a + 2 * TICK);
++    /* the LSW alone moves on too */
++    g_assert_cmphex(qtest_readl(qts, CPU0_LSW), ==, (uint32_t)a + 3 * TICK);
++
++    /* stopped: it holds what was read last */
++    qtest_writel(qts, CPU0_RUN, 0);
++    g_assert_cmphex(user_count(qts), ==, a + 3 * TICK);
++    g_assert_cmphex(user_count(qts), ==, a + 3 * TICK);
++    qtest_quit(qts);
++}
++
++/* Not on the SS-10: two reads in the same tick return the same value */
++static void test_no_read_ahead(void)
++{
++    QTestState *qts = qtest_init("-machine SS-10");
++    uint32_t v;
++    uint64_t u;
++
++    qtest_writel(qts, SYS_LIMIT, 0);
++    qtest_clock_step(qts, 100 * TICK_NS);
++    v = qtest_readl(qts, SYS_COUNTER);
++    g_assert_cmphex(v, ==, 100 * TICK);
++    g_assert_cmphex(qtest_readl(qts, SYS_COUNTER), ==, v);
++    v = qtest_readl(qts, CPU0_COUNTER);
++    g_assert_cmphex(qtest_readl(qts, CPU0_COUNTER), ==, v);
++
++    qtest_writel(qts, TIMER_CONFIG, 1);         /* CPU 0: user timer */
++    qtest_writel(qts, CPU0_RUN, 1);
++    user_set(qts, 0x0000000100000000ULL);
++    qtest_clock_step(qts, 4 * TICK_NS);
++    u = user_count(qts);
++    g_assert_cmphex(u, ==, 0x0000000100000000ULL + 4 * TICK);
++    g_assert_cmphex(user_count(qts), ==, u);
++    qtest_quit(qts);
++}
++
++/* A counter with a short limit: no read ahead, a wrap stays a wrap */
++static void test_read_ahead_short_limit(const void *data)
++{
++    const char *machine = data;
++    QTestState *qts = qtest_initf("-machine %s", machine);
++    uint32_t a;
++
++    qtest_writel(qts, SYS_LIMIT, 0x8000);       /* 64 ticks: too short */
++    qtest_clock_step(qts, 4 * TICK_NS);
++    a = qtest_readl(qts, SYS_COUNTER);
++    g_assert_cmphex(a, ==, 4 * TICK);
++    g_assert_cmphex(qtest_readl(qts, SYS_COUNTER), ==, a);
++    qtest_quit(qts);
++}
++
+ int main(int argc, char **argv)
+ {
+     static const char *machines[] = { "SS-600MP", "SS-10" };
+@@ -128,5 +267,17 @@ int main(int argc, char **argv)
+         qtest_add_data_func(sys, machines[i], test_system_limit);
+     }
+ 
++    /* the read-ahead is the SS-600MP's */
++    qtest_add_data_func("sun4m-slavio-timer/SS-600MP/read-ahead-system",
++                        "SS-600MP", test_read_ahead_system);
++    qtest_add_data_func("sun4m-slavio-timer/SS-600MP/read-ahead-processor",
++                        "SS-600MP", test_read_ahead_processor);
++    qtest_add_data_func("sun4m-slavio-timer/SS-600MP/read-ahead-user",
++                        "SS-600MP", test_read_ahead_user);
++    qtest_add_data_func("sun4m-slavio-timer/SS-600MP/read-ahead-short-limit",
++                        "SS-600MP", test_read_ahead_short_limit);
++    qtest_add_func("sun4m-slavio-timer/SS-10/no-read-ahead",
++                   test_no_read_ahead);
++
+     return g_test_run();
+ }
diff --git a/debian/patches/wsh/0153-hw-sparc-sun4m-keep-the-SS-600MP-IOMMU-s-base-slot-a.patch b/debian/patches/wsh/0153-hw-sparc-sun4m-keep-the-SS-600MP-IOMMU-s-base-slot-a.patch
new file mode 100644
index 0000000..49fe8ff
--- /dev/null
+++ b/debian/patches/wsh/0153-hw-sparc-sun4m-keep-the-SS-600MP-IOMMU-s-base-slot-a.patch
@@ -0,0 +1,188 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: keep the SS-600MP IOMMU's base, slot and TLB
+ data bits
+
+Sun's SPARCserver 600MP boot PROM tests the IOMMU's registers with
+0x5a5a5a5a and 0xa5a5a5a5 and wants back the bits the 600MP's IOMMU
+keeps (progress 0xad and 0xaf of its power-on self test, a loop on
+error otherwise):
+
+- each SBus slot configuration register (0x1010-0x101c): bits 17-15 and
+  3-0, mask 0x0003800f, written with one pattern while the next slot
+  gets the other; QEMU kept 0x00010003 (SA30, BA8, bypass). Bits 16 and
+  2-0 are SA30, BA16, BA8 and bypass as Linux's iommu_32.h names them;
+  what 17, 15 and 3 do isn't known, and nothing in QEMU acts on any of
+  these bits.
+- the page table base register (0x0004): bits 31-10 (physical address
+  bits 35-14, NetBSD's IOMMU_BAR_IBA 0xfffffc00); QEMU kept 0x07fffc00, the
+  microSPARC-II's 31-bit physical address. iommu_page_get_flags() now
+  widens the register before shifting it, so the upper bits reach the
+  physical address.
+- the TLB data entries (0x200-0x23c, reached with the diagnostic access
+  bit of the control register set, NetBSD's IOMMU_CTL_DE): all but bits 6-3 and 0, mask 0xffffff86,
+  the page, cacheable, writable and valid bits of an IOPTE; QEMU kept
+  all 32. The TLB tags (0x100-0x13c) keep all bits, as before. QEMU has
+  no IOMMU TLB; these are storage that only the PROM's tests read.
+
+New properties base-mask, sbcfg-mask and tlb-data-mask on the
+sun4m-iommu device, defaulting to the old behaviour, and hwdef fields
+that only the SS-600MP sets. The other machines are unchanged. No new
+state.
+---
+ hw/sparc/sun4m.c               | 31 ++++++++++++++++++++++++++++++-
+ hw/sparc/sun4m_iommu.c         | 23 ++++++++++++++++++++---
+ include/hw/sparc/sun4m_iommu.h |  3 +++
+ 3 files changed, 53 insertions(+), 4 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index cc1c8b8..b928dd8 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -112,6 +112,9 @@ struct sun4m_hwdef {
+     uint64_t max_ram;   /* if set: the RAM the memory controller takes */
+     uint32_t ecc_version;
+     uint32_t iommu_version;
++    uint32_t iommu_base_mask;   /* if set: the bits the base register keeps */
++    uint32_t iommu_sbcfg_mask;  /* if set: the bits the slot registers keep */
++    uint32_t iommu_tlb_data_mask; /* if set: the bits its TLB data keeps */
+     uint16_t machine_id;
+     uint8_t nvram_machine_id;
+     bool timer_read_ahead;      /* a counter read moves on (slavio_timer) */
+@@ -298,13 +301,24 @@ static unsigned long sun4m_load_kernel(const char *kernel_filename,
+     return kernel_size;
+ }
+ 
+-static void *iommu_init(hwaddr addr, uint32_t version, qemu_irq irq)
++static void *iommu_init(hwaddr addr, uint32_t version, uint32_t base_mask,
++                        uint32_t sbcfg_mask, uint32_t tlb_data_mask,
++                        qemu_irq irq)
+ {
+     DeviceState *dev;
+     SysBusDevice *s;
+ 
+     dev = qdev_new(TYPE_SUN4M_IOMMU);
+     qdev_prop_set_uint32(dev, "version", version);
++    if (base_mask) {
++        qdev_prop_set_uint32(dev, "base-mask", base_mask);
++    }
++    if (sbcfg_mask) {
++        qdev_prop_set_uint32(dev, "sbcfg-mask", sbcfg_mask);
++    }
++    if (tlb_data_mask) {
++        qdev_prop_set_uint32(dev, "tlb-data-mask", tlb_data_mask);
++    }
+     s = SYS_BUS_DEVICE(dev);
+     sysbus_realize_and_unref(s, &error_fatal);
+     sysbus_connect_irq(s, 0, irq);
+@@ -1030,6 +1044,8 @@ static void sun4m_hw_init(MachineState *machine)
+     }
+ 
+     iommu = iommu_init(hwdef->iommu_base, hwdef->iommu_version,
++                       hwdef->iommu_base_mask, hwdef->iommu_sbcfg_mask,
++                       hwdef->iommu_tlb_data_mask,
+                        slavio_irq[30]);
+ 
+     if (hwdef->iommu_pad_base) {
+@@ -1477,6 +1493,19 @@ static void ss600mp_class_init(ObjectClass *oc, const void *data)
+          */
+         .timer_read_ahead = true,
+         .iommu_version = 0x01000000,
++        /*
++         * Its IOMMU keeps all of the page table base address (bits 31-10,
++         * physical address bits 35-14, NetBSD's IOMMU_BAR_IBA) and bits
++         * 17-15 and 3-0 of each SBus slot's configuration register. The
++         * boot PROM writes 0x5a5a5a5a and 0xa5a5a5a5 to them and wants
++         * these bits back; the default masks are the microSPARC-II's (a
++         * 31-bit physical address) and the bits Linux names (SA30, BA8,
++         * bypass). Nothing in QEMU acts on bits 17, 15 and 3 of the slot
++         * registers.
++         */
++        .iommu_base_mask = 0xfffffc00,
++        .iommu_sbcfg_mask = 0x0003800f,
++        .iommu_tlb_data_mask = 0xffffff86,
+         .max_mem = 0xf00000000ULL,
+     };
+ 
+diff --git a/hw/sparc/sun4m_iommu.c b/hw/sparc/sun4m_iommu.c
