+  */
+ 
+@@ -32,6 +38,9 @@
+ #define RAM_NRUNNABLE   0x824ULL        /* disp_t at RAM_WORD, + 0x24 */
+ #define RAM_CPU         0x840ULL        /* cpu_disp at + 0 */
+ #define RAM_IDLE_CPU    0x848ULL
++#define RAM_TI          0x860ULL        /* Linux's thread_info: %g6 */
++#define RAM_TI_FLAGS    0x868ULL        /* its flags, TIF_NEED_RESCHED 8 */
++#define RAM_TLB_TYPE    0x870ULL        /* Linux's tlb_type: 1, spitfire */
+ 
+ /* PROM: reset at + 0x20, code at + 0x400, trap table at + 0x8000 */
+ #define PROM_BASE_HI    0x1fff0000      /* << 12 = 0x1fff0000000 */
+@@ -44,7 +53,9 @@
+ 
+ #define NOP             0x01000000
+ 
+-enum { NETBSD, OPENBSD, SOLARIS, TRIBBLIX };
++enum { NETBSD, OPENBSD, SOLARIS, TRIBBLIX, SOLARIS7, LINUX73, LINUX61, LINUX70 };
++
++#define IS_LINUX(k)     ((k) >= LINUX73)
+ 
+ static uint32_t call_to(int from, int to)
+ {
+@@ -64,6 +75,18 @@ static uint32_t bpcc_xcc_to(int cond, int from, int to)
+            ((to - from) & 0x7ffff);
+ }
+ 
++/* BPcc on %icc with cond, predicted not taken */
++static uint32_t bpcc_icc_to(int cond, int from, int to)
++{
++    return (cond << 25) | (1 << 22) | ((to - from) & 0x7ffff);
++}
++
++/* BPcc on %xcc with cond, predicted not taken */
++static uint32_t bpcc_xcc_pn_to(int cond, int from, int to)
++{
++    return (cond << 25) | (1 << 22) | (2 << 20) | ((to - from) & 0x7ffff);
++}
++
+ /* brnz %o0 */
+ static uint32_t brnz_o0_to(int from, int to)
+ {
+@@ -90,11 +113,119 @@ typedef struct IdleCase {
+ #define PS_PEF_PRIV_IE  0x16
+ #define PS_PEF_PRIV     0x14
+ 
++/*
++ * The sun4v branch of Linux's arch_cpu_idle() at p[0], from word index
++ * at; never taken here (tlb_type is 1). Returns its length.
++ */
++static int write_linux_sun4v(uint32_t *p, int at, bool pil14)
++{
++    int n = 0;
++
++    p[n++] = 0x91902000;                /* wrpr %g0, 0, %pil */
++    p[n++] = 0x83518000;                /* rdpr %pstate, %g1 */
++    p[n++] = 0x82286002;                /* andn %g1, 2, %g1 */
++    p[n++] = 0x8d904000;                /* wrpr %g1, %pstate */
++    p[n++] = 0xc259a008;                /* ldx [%g6 + 8], %g1 */
++    p[n++] = 0x80886008;                /* btst 8, %g1 */
++    p[n] = bpcc_xcc_pn_to(BNE, at + n, at + n + 4); n++;
++    p[n++] = NOP;
++    p[n] = call_to(at + n, FUNC + 3); n++;      /* sun4v_cpu_yield */
++    p[n++] = NOP;
++    p[n++] = 0x83518000;                /* rdpr %pstate, %g1 */
++    p[n++] = 0x82106002;                /* or %g1, 2, %g1 */
++    p[n++] = 0x8d904000;                /* wrpr %g1, %pstate */
++    if (pil14) {
++        p[n++] = 0x9190200e;            /* wrpr %g0, 14, %pil */
++    }
