++    n = 0;
++    a[n++] = 0x9de3bf50;                /* save %sp, -176, %sp */
++    a[n++] = 0x03000002;                /* sethi %hi(0x800), %g1 */
++    a[n++] = 0xc2006070;                /* ld [%g1 + 0x70], %g1 tlb_type */
++    a[n++] = 0x80a06003;                /* cmp %g1, 3 (hypervisor) */
++    switch (k) {
