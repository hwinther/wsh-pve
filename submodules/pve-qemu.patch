+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-mmu-ctx-ifetch-test.c b/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
+new file mode 100644
+index 0000000000..b4fcbd042c
+--- /dev/null
++++ b/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
+@@ -0,0 +1,207 @@
++/*
++ * QTest: an instruction fetch across a context switch on sun4m
++ *
++ * Solaris 2.1 (srmmu_mmu_flushctx) switches the SRMMU context register to
++ * a context whose level 1 table doesn't map the kernel yet, flushes that
++ * context and switches back, with traps disabled and all in one page of
++ * kernel text. The CPU goes on executing the instructions in that page.
++ * QEMU flushes its TLB on the context change, and the next instruction
++ * fetch walks the new context's tables. With traps disabled that fetch
++ * used to go to an unassigned address and stop QEMU ("Trap 0x21 while
++ * interrupts disabled, Error state").
++ *
++ * The page tables, two trap tables and the test code: context 0 maps the
++ * boot PROM at virtual 0 and RAM from 0 at virtual 0x01000000; context 1
++ * maps only RAM from 0x01000000 at virtual 0x01000000, so a store through
++ * the same virtual address shows which context made it. The PROM turns
++ * the MMU on in context 0, switches to context 1, stores a marker, flushes
++ * the context, stores another, switches back to context 0 and enables
++ * traps. With traps disabled it must run to the end and both markers must
++ * land in context 1's RAM. With traps enabled the first fetch in context 1
++ * must still take an instruction access exception.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++#define CTX1_RAM        0x01000000ULL   /* context 1's RAM (physical) */
++#define VA_RAM          0x01000000u     /* virtual address of RAM, both */
++#define CTX_TABLE       0x2000ULL
++#define CTX0_L1         0x3000ULL
++#define CTX1_L1         0x3400ULL
++#define TRAP_TABLE      0x4000u         /* offset of the trap tables in RAM */
++#define MARK_STAGE      0x1004u         /* offsets of the markers in RAM */
++#define MARK_CTX1_A     0x1008u
++#define MARK_CTX1_B     0x100cu
++#define MARK_TRAP       0x1020u
++#define PROM_WORDS      0x200
++#define CODE            0x100           /* word index of the code */
++#define TT_TFAULT       1               /* instruction access exception */
++#define PSR_S_PIL15     0xf80
++#define PSR_ET          0x20
++
++static char *write_prom(bool traps_on)
++{
++    const uint32_t psr = PSR_S_PIL15 | (traps_on ? PSR_ET : 0);
++    const uint32_t code[] = {
++        0x03004010,             /* sethi %hi(0x01004000), %g1 */
++        0x81986000,             /* wr    %g1, 0, %tbr        trap table */
++        0x90102100,             /* mov   0x100, %o0 */
++        0x92102200,             /* mov   0x200, %o1 */
++        0xd2a20080,             /* sta   %o1, [%o0] 4        context table pointer */
++        0x90102200,             /* mov   0x200, %o0 */
++        0xc0a20080,             /* sta   %g0, [%o0] 4        context 0 */
++        0x81902000,             /* wr    %g0, 0, %wim */
++        0x81882000 | psr,       /* wr    %g0, psr, %psr      S, PIL 15, ET? */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0xd4800080,             /* lda   [%g0] 4, %o2        MMU control register */
++        0x9412a001,             /* or    %o2, 1, %o2         MMU on */
++        0xd4a00080,             /* sta   %o2, [%g0] 4 */
++        0x07004004,             /* sethi %hi(0x01001000), %g3 */
++        0x88102001,             /* mov   1, %g4 */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 1 */
++        0x92102001,             /* mov   1, %o1 */
++        0x8a102300,             /* mov   0x300, %g5          flush: context */
++        0xd2a20080,             /* sta   %o1, [%o0] 4        context 1 */
++        0x88102002,             /* mov   2, %g4              fetched in context 1 */
++        0xc820e008,             /* st    %g4, [%g3 + 8]      marker A */
++        0xc0a14300,             /* sta   %g0, [%g5] 0x18     flush the context */
++        0x88102003,             /* mov   3, %g4 */
++        0xc820e00c,             /* st    %g4, [%g3 + 0xc]    marker B */
++        0xc0a20080,             /* sta   %g0, [%o0] 4        context 0 */
++        0x81882fa0,             /* wr    %g0, 0xfa0, %psr    traps on */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0x88102004,             /* mov   4, %g4 */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 4: the end */
++        0x10800000,             /* b     . */
++        0x01000000,             /* nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    /* Trap i before the trap table is set: store i at MARK_TRAP, stop */
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03004004);         /* sethi %hi(0x01001000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4m-mmu-ctx-ifetch-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++/*
++ * A trap table at TRAP_TABLE in both contexts' RAM: trap i stores i at
++ * virtual VA_RAM + MARK_TRAP (in the RAM of the context it came in) and
++ * stops.
++ */
++static void write_trap_table(QTestState *qts, uint64_t base)
++{
++    uint32_t be[256 * 4];
++    int i;
++
++    for (i = 0; i < 256; i++) {
++        be[4 * i] = cpu_to_be32(0x03004004);         /* sethi %hi(0x01001000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    qtest_memwrite(qts, base + TRAP_TABLE, be, sizeof(be));
++}
++
++static void write_tables(QTestState *qts, uint64_t prom_base)
++{
++    /* Context table: PTDs of the two level 1 tables */
++    qtest_writel(qts, CTX_TABLE, (CTX0_L1 >> 4) | 1);
++    qtest_writel(qts, CTX_TABLE + 4, (CTX1_L1 >> 4) | 1);
++    /* Context 0: the PROM at 0 (16 MB, ACC 2 RX), RAM at 0x01000000 (RWX) */
++    qtest_writel(qts, CTX0_L1, (uint32_t)(prom_base >> 4) | 0x0a);
++    qtest_writel(qts, CTX0_L1 + 4, 0x0e);
++    /* Context 1: no PROM, RAM from 0x01000000 at 0x01000000 */
++    qtest_writel(qts, CTX1_L1, 0);
++    qtest_writel(qts, CTX1_L1 + 4, (uint32_t)(CTX1_RAM >> 4) | 0x0e);
++    write_trap_table(qts, 0);
++    write_trap_table(qts, CTX1_RAM);
++}
++
++typedef struct {
++    const char *name;
++    const char *machine;
++    uint64_t prom_base;
++    bool traps_on;
++} TestCase;
++
++static void test_ctx_ifetch(const void *data)
++{
++    const TestCase *t = data;
++    g_autofree char *prom = write_prom(t->traps_on);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine %s -accel tcg -m 64 -bios %s -S",
++                                  t->machine, prom);
++
++    write_tables(qts, t->prom_base);
++    qtest_qmp_assert_success(qts, "{ 'execute': 'cont' }");
++
++    while (qtest_readl(qts, MARK_TRAP) == 0 &&
++           qtest_readl(qts, CTX1_RAM + MARK_TRAP) == 0 &&
++           qtest_readl(qts, MARK_STAGE) < 4) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    g_assert_cmpuint(qtest_readl(qts, MARK_TRAP), ==, 0);
++    if (t->traps_on) {
++        /* The first fetch in context 1 traps there */
++        g_assert_cmpuint(qtest_readl(qts, CTX1_RAM + MARK_TRAP), ==, TT_TFAULT);
++        g_assert_cmpuint(qtest_readl(qts, MARK_STAGE), ==, 1);
++        g_assert_cmpuint(qtest_readl(qts, CTX1_RAM + MARK_CTX1_A), ==, 0);
++    } else {
++        /* It runs on in the page, in context 1, and back to the end */
++        g_assert_cmpuint(qtest_readl(qts, CTX1_RAM + MARK_TRAP), ==, 0);
++        g_assert_cmpuint(qtest_readl(qts, CTX1_RAM + MARK_CTX1_A), ==, 2);
++        g_assert_cmpuint(qtest_readl(qts, CTX1_RAM + MARK_CTX1_B), ==, 3);
++        g_assert_cmpuint(qtest_readl(qts, MARK_CTX1_A), ==, 0);
++        g_assert_cmpuint(qtest_readl(qts, MARK_STAGE), ==, 4);
++    }
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++int main(int argc, char **argv)
++{
++    static const TestCase cases[] = {
++        { "ss10/traps-off", "SS-10", 0xff0000000ULL, false },
++        { "ss10/traps-on", "SS-10", 0xff0000000ULL, true },
++        { "ss5/traps-off", "SS-5", 0x70000000ULL, false },
++        { "ss5/traps-on", "SS-5", 0x70000000ULL, true },
++    };
++    int i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        for (i = 0; i < ARRAY_SIZE(cases); i++) {
++            g_autofree char *name =
++                g_strdup_printf("sun4m-mmu-ctx-ifetch/%s", cases[i].name);
++            qtest_add_data_func(name, &cases[i], test_ctx_ifetch);
++        }
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0049-target-sparc-take-a-bus-error-on-a-SuperSPARC-load-o.patch b/debian/patches/wsh/0049-target-sparc-take-a-bus-error-on-a-SuperSPARC-load-o.patch
new file mode 100644
index 0000000..2e9d93d
--- /dev/null
+++ b/debian/patches/wsh/0049-target-sparc-take-a-bus-error-on-a-SuperSPARC-load-o.patch
@@ -0,0 +1,259 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: take a bus error on a SuperSPARC load or fetch as an access exception
+
+SunOS 4.1.3 (sun4m) panics on the SS-10 right after "SUNW,fdtwo0" with
+"BAD TRAP: cpu=0 type=29". Its generic sun4m kernel probes for VME
+controllers, which the SS-10 doesn't have: with its fault catcher armed
+(nofault) it reads physical 0xd.0108_0000, where QEMU has nothing. QEMU
+raises the data access error (trap 0x29) for a bus error on every sparc32
+CPU, and 4.1.3's trap() hands only the data access exception (trap 0x09)
+to the catcher, so the probe panics. 4.1.3_U1 added cases for 0x21 and
+0x29 to trap(), which is why 4.1.3_U1B boots.
+
+On the SuperSPARC a bus error (a timeout or an error acknowledge) on a
+load is a data access exception, with the cause in the SFSR (FT=5,
+access bus error), and on an instruction fetch an instruction access
+exception. A test on a real SS-20 (SuperSPARC-II) posted to the
+OpenBIOS list in 2013 found "sbus timeout: read = Data Access Exception,
+write = Level 15 int", and 4.1.3's own nofault path expects trap 0x09.
+
+Add the CPU feature "buserr-access-exc", set on the TI-SuperSparc-*
+models only. With it a bus error on a load raises trap 0x09 and on an
+instruction fetch trap 0x01; the SFSR and SFAR are written as before.
+Stores keep trap 0x29 (the hardware reports a failed write later, as a
+level 15 interrupt, which this doesn't model), and so do accesses that
+bypass the MMU (ASI 0x20-0x2f, the MXCC stream registers) and those
+through unimplemented ASIs, until there is evidence for them. The
+microSPARC, TurboSPARC, LEON and other models are unchanged. The
+feature can be turned off (-cpu TI-SuperSparc-II,-buserr-access-exc). A
+new trace event, sparc_bus_error_access_exc, shows each such trap.
+
+Tested on SS-10 under OpenBIOS: the SunOS 4.1.3 CD installs (Programmer)
+and the installed disk boots to "SunOS sunos413 4.1.3 3 sun4m", four
+times; the CD's kernel takes the new trap 9 times before its installer
+(five VME controller reads at 0xd.0108_0000-0xd.0108_1000, four empty
+SBus slots). Plain QEMU 11.1.3 with its own OpenBIOS panics the same
+way; with that OpenBIOS, a build with this change gets to the installer.
+34 installed disks
+(Solaris 2.2-9, SunOS 4.1.3_U1B and 4.1.4, NetBSD 9.3 and 11.1, OpenBSD
+5.9, Debian 4.0, Red Hat 6.2) boot as before: 18 on SS-10/SS-20, which
+take the new trap only on the empty SBus slots and SunOS's probes
+(Solaris 2.6 also with 4 CPUs), and 16 on SS-5, which never take it.
+---
