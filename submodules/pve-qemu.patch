+ sun4m_iommu_bad_addr(uint64_t addr) "bad addr 0x%"PRIx64
++sun4m_iommu_cpu_write_error(uint64_t addr, unsigned size, uint32_t afsr) "cpu write error at 0x%"PRIx64" size %u, afsr 0x%x"
+ 
