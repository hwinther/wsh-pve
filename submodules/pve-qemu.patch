diff --git a/debian/patches/wsh/0133-hw-sparc64-migrate-the-sabre-the-IOMMU-the-ebus-and-.patch b/debian/patches/wsh/0133-hw-sparc64-migrate-the-sabre-the-IOMMU-the-ebus-and-.patch
