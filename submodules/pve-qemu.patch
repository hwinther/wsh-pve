+index 378a1c3091..6866de3998 100644
+--- a/tests/qtest/sun4m-bus-error-trap-test.c
++++ b/tests/qtest/sun4m-bus-error-trap-test.c
+@@ -82,7 +82,7 @@ static char *write_prom(const TestCase *t)
+         0x81902000,             /* wr    %g0, 0, %wim */
+         0x81882f80,             /* wr    %g0, 0xf80, %psr    S, PIL 15 */
+         NOP, NOP, NOP,
+-        0xd4800080,             /* lda   [%g0] 4, %o2        MMU control register */
++        0x94102000,             /* mov   0, %o2              boot mode off */
+         0x9412a001,             /* or    %o2, 1, %o2         MMU on */
+         0xd4a00080,             /* sta   %o2, [%g0] 4 */
+         0x81882fa0,             /* wr    %g0, 0xfa0, %psr    traps on */
+diff --git a/tests/qtest/sun4m-mmu-ctx-ifetch-test.c b/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
+index b4fcbd042c..78bb2051db 100644
+--- a/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
++++ b/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
+@@ -59,7 +59,7 @@ static char *write_prom(bool traps_on)
+         0x01000000,             /* nop */
+         0x01000000,             /* nop */
+         0x01000000,             /* nop */
+-        0xd4800080,             /* lda   [%g0] 4, %o2        MMU control register */
++        0x94102000,             /* mov   0, %o2              boot mode off */
+         0x9412a001,             /* or    %o2, 1, %o2         MMU on */
+         0xd4a00080,             /* sta   %o2, [%g0] 4 */
+         0x07004004,             /* sethi %hi(0x01001000), %g3 */
