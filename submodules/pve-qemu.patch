++#if !defined(TARGET_SPARC64) && !defined(CONFIG_USER_ONLY)
++/*
++ * The sparc32 FPUs defer fp_exception: the FPop that raises an enabled
++ * IEEE 754 exception moves the FPU to fp_exception_pending, and the trap
++ * is taken by the next floating-point instruction (SPARC V8 manual,
++ * section 7.3 and appendix L; microSPARC and SuperSPARC manuals).
++ * The FPop does not write its destination; it goes into the FQ, and
++ * the integer unit carries on with the instruction after it.
++ */
++static G_NORETURN void fp_exception_pending(CPUSPARCState *env,
++                                            uintptr_t ra)
++{
++    CPUState *cs = env_cpu(env);
++    MemOpIdx oi = make_memop_idx(MO_BEUL, cpu_mmu_index(cs, true));
++
++    cpu_restore_state(cs, ra);
++    env->fq.s.addr = env->pc;
++    env->fq.s.insn = cpu_ldl_code_mmu(env, env->pc, oi, 0);
++    env->fp_pending = 1;
++    env->pc = env->npc;
++    env->npc = env->npc + 4;
++    cpu_loop_exit(cs);
++}
