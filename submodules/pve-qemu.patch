++            s->regs[CS_PC] = 0;
++            s->play_next = false;
+         }
+-        val &= 0x7f;
++        cs_play_update(s);
++        break;
++    case CS_PC:
++        s->regs[saddr] = val;
++        cs_play_update(s);
++        break;
++    case CS_PNC:
++        /* the count loads the next buffer; a count of 0 unloads it */
+         s->regs[saddr] = val;
++        s->play_next = val != 0;
++        cs_play_update(s);
+         break;
+     default:
+         s->regs[saddr] = val;
+@@ -138,13 +580,25 @@ static const MemoryRegionOps cs_mem_ops = {
+     .endianness = DEVICE_BIG_ENDIAN,
+ };
+ 
++static int cs_post_load(void *opaque, int version_id)
++{
++    CSState *s = opaque;
++
++    s->play_running = false;
++    cs_play_setup(s);
++    cs_play_update(s);
++    return 0;
++}
