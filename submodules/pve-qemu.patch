+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the Solaris idle halt on sun4m
+
+A tiny boot PROM runs a loop laid out as the idle loop of Solaris 2.6
+and counts its rounds in RAM. With nothing runnable and interrupts
+enabled at level 0, the count must stop (the CPU halted at the call of
+idle_cpu, and no device interrupts); it must keep going with
+solaris-idle=off, with a runnable thread, at interrupt level 15 and on
+an SS-20 with two CPUs. Any trap stops the test with the trap type in
+RAM.
+
+The PROM word at the RAM address of disp_nrunnable says 1: with the MMU
+off in boot mode an instruction fetch from there would read it, so the
+idle case also checks that the helper reads RAM, as the loop does.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+Applied-Upstream: https://github.com/tenox7/lemu/commit/60a4acb01432442dacd13f28be9debbad18d6b55
+---
+ tests/qtest/meson.build               |   3 +-
+ tests/qtest/sun4m-solaris-idle-test.c | 165 ++++++++++++++++++++++++++
+ 2 files changed, 167 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-solaris-idle-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 75ad261ee8..265d19b658 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -200,7 +200,8 @@ qtests_sh4 = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-te
+ qtests_sh4eb = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-test'] : [])
+ 
+ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+-                'sun4m-escc-test', 'sun4m-apc-test'] + \
++                'sun4m-escc-test', 'sun4m-apc-test',
++                'sun4m-solaris-idle-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-solaris-idle-test.c b/tests/qtest/sun4m-solaris-idle-test.c
+new file mode 100644
+index 0000000000..12b5a053cb
+--- /dev/null
++++ b/tests/qtest/sun4m-solaris-idle-test.c
+@@ -0,0 +1,165 @@
++/*
++ * QTest: halting the CPU in the Solaris idle loop on sun4m
++ *
++ * A boot PROM runs a loop laid out as the idle loop of Solaris 2.6: it
++ * counts its rounds in RAM, then calls "swtch" when the word at
++ * CPU + 0x58 (disp_nrunnable) is not 0 and calls the function that the
++ * word at CPU + 0x5c (idle_cpu) points to when it is. With interrupts
++ * enabled at level 0 and none pending, QEMU halts the CPU at that call,
++ * and as no device interrupts, the count stops. It must keep going with
++ * solaris-idle=off, with a runnable thread, at interrupt level 15 and with
++ * two CPUs.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the CPU structure, its round count at 0 and the trap marker */
++#define RAM_CPU         0x1000ULL
++#define RAM_COUNT       (RAM_CPU + 0)
++#define RAM_TRAP        (RAM_CPU + 0x20)
++#define PROM_WORDS      0x420           /* up to past PROM_DECOY */
++#define PROM_DECOY      ((RAM_CPU + 0x58) / 4)
++#define CODE            0x100           /* word index of the code */
++
++/*
++ * The PROM: a trap table whose entries store their trap type at RAM_TRAP
++ * and stop, and at 0x400 the loop. It runs from reset: MMU off, so
++ * instructions come from the PROM and data from RAM.
++ */
++static char *write_prom(uint32_t nrunnable, uint32_t psr)
++{
++    const uint32_t code[] = {
++        0x31000004,             /*        sethi %hi(0x1000), %i0 */
++        0x82102000 | nrunnable, /*        mov   nrunnable, %g1 */
++        0xc2262058,             /*        st    %g1, [%i0 + 0x58] */
++        0x82102464,             /*        mov   ret, %g1 */
++        0xc226205c,             /*        st    %g1, [%i0 + 0x5c] */
++        0x81882000 | psr,       /*        wr    %g0, psr, %psr */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0xca062000,             /* top:   ld    [%i0], %g5 */
++        0x8a016001,             /*        inc   %g5 */
++        0xca262000,             /*        st    %g5, [%i0] */
++        0xd0062058,             /*        ld    [%i0 + 0x58], %o0 */
++        0x80a22000,             /*        cmp   %o0, 0 */
++        0x02800006,             /*        be    idle */
++        0x21000004,             /*         sethi %hi(0x1000), %l0 */
++        0x40000009,             /*        call  ret          swtch */
++        0x01000000,             /*         nop */
++        0x10bffff7,             /*        b     top */
++        0x01000000,             /*         nop */
++        0xe004205c,             /* idle:  ld    [%l0 + 0x5c], %l0 */
++        0x9fc40000,             /*        call  %l0          idle_cpu */
++        0x01000000,             /*         nop */
++        0x10bffff2,             /*        b     top */
++        0x01000000,             /*         nop */
++        0x81c3e008,             /* ret:   retl */
++        0x01000000,             /*         nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03000004);     /* sethi %hi(0x1000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i);    /* mov i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020); /* st %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000); /* b . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    /*
++     * The PROM word at the RAM address of disp_nrunnable says 1. With the
++     * MMU off in boot mode an instruction fetch from there reads it, a data
++     * load reads RAM: the idle helper must read RAM, like the loop.
++     */
++    be[PROM_DECOY] = cpu_to_be32(1);
++    fd = g_file_open_tmp("sun4m-solaris-idle-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++/* The loop's round count 300 ms apart, once it has started */
++static void run(const char *machine, uint32_t nrunnable, uint32_t psr,
++                uint32_t *before, uint32_t *after)
++{
++    g_autofree char *prom = write_prom(nrunnable, psr);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine %s -accel tcg -bios %s",
++                                  machine, prom);
++
++    while (qtest_readl(qts, RAM_COUNT) == 0) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    g_usleep(300 * 1000);
++    *before = qtest_readl(qts, RAM_COUNT);
++    g_usleep(300 * 1000);
++    *after = qtest_readl(qts, RAM_COUNT);
++    g_assert_cmphex(qtest_readl(qts, RAM_TRAP), ==, 0);
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++#define PSR_S_ET        0xa0
++#define PSR_S_ET_PIL15  0xfa0
++
++typedef struct IdleCase {
++    const char *name;
++    const char *machine;
++    uint32_t nrunnable;
++    uint32_t psr;
++} IdleCase;
++
++/* Nothing runnable, interrupts enabled at level 0: the CPU stops */
++static void test_idle(void)
++{
++    uint32_t before, after;
++
++    run("SS-5", 0, PSR_S_ET, &before, &after);
++    g_assert_cmpuint(after, ==, before);
++}
++
++static void test_running(const void *data)
++{
++    const IdleCase *t = data;
++    uint32_t before, after;
++
++    run(t->machine, t->nrunnable, t->psr, &before, &after);
++    g_assert_cmpuint(after, >, before);
++}
++
++int main(int argc, char **argv)
++{
++    static const IdleCase running[] = {
++        { "off", "SS-5,solaris-idle=off", 0, PSR_S_ET },
++        { "runnable", "SS-5", 1, PSR_S_ET },
++        { "pil15", "SS-5", 0, PSR_S_ET_PIL15 },
++        { "smp2", "SS-20 -smp 2", 0, PSR_S_ET },
++    };
++    int i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        qtest_add_func("sun4m-solaris-idle/idle", test_idle);
++        for (i = 0; i < ARRAY_SIZE(running); i++) {
++            g_autofree char *name =
++                g_strdup_printf("sun4m-solaris-idle/%s", running[i].name);
++            qtest_add_data_func(name, &running[i], test_running);
++        }
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0017-target-sparc-flush-the-TLB-on-a-no-fault-bit-change-.patch b/debian/patches/wsh/0017-target-sparc-flush-the-TLB-on-a-no-fault-bit-change-.patch
new file mode 100644
index 0000000..d6ee76a
--- /dev/null
+++ b/debian/patches/wsh/0017-target-sparc-flush-the-TLB-on-a-no-fault-bit-change-.patch
@@ -0,0 +1,143 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: flush the TLB on a no-fault bit change only when needed
+
+On the SPARCstation 5 (microSPARC-II), Solaris 2.x runs programs that
+call deeper than the register windows 4 to 10 times slower than on the
+SPARCstation 20, while compiled code with shallow calls runs equally
+fast. Solaris's window overflow and underflow handlers for this CPU
+save or restore the user window with the no-fault bit (NF) set in the
+MMU control register, then clear it and read the fault status
+register, so that a missing stack page doesn't trap inside the
+handler. That is two writes of the control register per trap, and
+QEMU flushes the whole TLB whenever NF changes: about 280,000 flushes
+a second while Solaris runs an awk loop, against 700 on the
+SPARCstation 20, whose SuperSPARC handlers probe the page instead.
+
+NF decides whether a failed translation traps; it changes no
+translation that succeeds. The only TLB entries that depend on it are
+the ones sparc_cpu_tlb_fill makes for a failed translation in no-fault
+mode (or with traps disabled), with overridden permissions or
+redirected to an unassigned address. Note in env->mmu_nf_entries when
+it makes one, and on a change of NF flush only while that is set. The
+boot mode bit flushes as before (it changes instruction fetches with
+the MMU off); MMU_E selects another MMU index and hasn't flushed since
+MMU_PHYS_IDX, and the cache, parity, PSO and other bits aren't read
+anywhere. CPU reset and loadvm flush the TLB themselves, so a stale
+flag costs at most one extra flush. A new trace event,
+sparc_mmu_ctrl_flush, shows the flushes that remain: in a 15 minute
+benchmark run on the SPARCstation 5 they were 7955 clears of NF after a
+fault in no-fault mode and one at boot.
+
+Solaris 2.6, medians of 3 runs of the same benchmarks with and without
+this patch: on the SPARCstation 5 the awk loop takes 5.1 s instead of
+47.1 s (SPARCstation 20: 5.4 s), the BYTE Towers of Hanoi run 18900
+towers/s instead of 4830 (SPARCstation 20: 19500), and lmbench's
+open/close takes 11 us instead of 53 (8-10). Solaris also saves user
+windows with NF set when a trap arrives, on every CPU, so the
+SPARCstation 20 gains as well: signal catch 39 -> 13 us, protection
+fault 13 -> 3 us, mmap of 8 MB 2.4 -> 1.1 ms. Dhrystone, Whetstone and
+nbench don't change.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+Applied-Upstream: https://github.com/tenox7/lemu/commit/7f7081ce3982a139a1e1e042f320f644386dcbce
+---
+ target/sparc/cpu.h         |  6 ++++++
+ target/sparc/ldst_helper.c | 24 +++++++++++++++++++-----
+ target/sparc/mmu_helper.c  |  3 ++-
+ target/sparc/trace-events  |  3 +++
+ 4 files changed, 30 insertions(+), 6 deletions(-)
+
+diff --git a/target/sparc/cpu.h b/target/sparc/cpu.h
+index b43a7336dd..9f53f1b682 100644
+--- a/target/sparc/cpu.h
++++ b/target/sparc/cpu.h
+@@ -506,6 +506,12 @@ struct CPUArchState {
+     uint64_t mmubpaction;
+     uint64_t mmubpregs[4];
+     uint64_t prom_addr;
++    /*
++     * The TLB holds an entry that sparc_cpu_tlb_fill made for a failed
++     * translation (no-fault mode or traps disabled), with its permissions
++     * overridden. A change of MMU_NF flushes the TLB only while this is set.
++     */
++    bool mmu_nf_entries;
+     /* Halt in the idle loop of SunOS 4.1.4, see sunos_idle.c */
+     bool sunos_idle;
+     int64_t sunos_idle_since;   /* when the loop first found no work */
+diff --git a/target/sparc/ldst_helper.c b/target/sparc/ldst_helper.c
+index 4ec8799d1f..87b85eed3a 100644
+--- a/target/sparc/ldst_helper.c
++++ b/target/sparc/ldst_helper.c
+@@ -32,6 +32,7 @@
+ #include "user/page-protection.h"
+ #endif
+ #include "asi.h"
++#include "trace.h"
+ 
+ //#define DEBUG_MMU
+ //#define DEBUG_MXCC
+@@ -996,18 +997,31 @@ void helper_st_asi(CPUSPARCState *env, target_ulong addr, uint64_t val,
+     case ASI_LEON_MMUREGS: /* LEON3 write MMU regs */
+         {
+             int reg = (addr >> 8) & 0x1f;
+-            uint32_t oldreg;
++            uint32_t oldreg, changed;
+ 
+             oldreg = env->mmuregs[reg];
+             switch (reg) {
+             case 0: /* Control Register */
+                 env->mmuregs[reg] = (env->mmuregs[reg] & 0xff000000) |
+                     (val & 0x00ffffff);
+-                /* Mappings generated during no-fault mode
+-                   are invalid in normal mode.  */
+-                if ((oldreg ^ env->mmuregs[reg])
+-                    & (MMU_NF | env->def.mmu_bm)) {
++                changed = oldreg ^ env->mmuregs[reg];
++                /*
++                 * Of the bits here only boot mode changes a translation
++                 * (instruction fetches with the MMU off). MMU_E selects
++                 * another mmu_idx; caches, PSO and parity aren't modelled.
++                 * MMU_NF only decides whether a failed translation traps:
++                 * the one kind of entry that depends on it is the one that
++                 * sparc_cpu_tlb_fill makes for such a failure with
++                 * overridden permissions, which is invalid in normal mode.
++                 * Flush on a change of NF only when there is one: Solaris
++                 * sets and clears NF around each user window spill and fill
++                 * on the microSPARC, and nearly always nothing faults.
++                 */
++                if ((changed & env->def.mmu_bm) ||
++                    ((changed & MMU_NF) && env->mmu_nf_entries)) {
++                    trace_sparc_mmu_ctrl_flush(oldreg, env->mmuregs[reg]);
+                     tlb_flush(cs);
++                    env->mmu_nf_entries = false;
+                 }
+                 break;
+             case 1: /* Context Table Pointer Register */
+diff --git a/target/sparc/mmu_helper.c b/target/sparc/mmu_helper.c
+index 07ba25dfce..455b36c9ef 100644
+--- a/target/sparc/mmu_helper.c
++++ b/target/sparc/mmu_helper.c
+@@ -251,7 +251,8 @@ bool sparc_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+         /* No fault mode: if a mapping is available, just override
+            permissions. If no mapping is available, redirect accesses to
+            neverland. Fake/overridden mappings will be flushed when
+-           switching to normal mode. */
++           switching to normal mode (helper_st_asi, ASI_M_MMUREGS). */
++        env->mmu_nf_entries = true;
+         full.prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+         tlb_set_page_full(cs, mmu_idx, vaddr, &full);
+         return true;
+diff --git a/target/sparc/trace-events b/target/sparc/trace-events
+index 4b9103295f..12df5142e1 100644
+--- a/target/sparc/trace-events
++++ b/target/sparc/trace-events
+@@ -10,6 +10,9 @@ mmu_helper_get_phys_addr_code(uint32_t tl, int mmu_idx, uint64_t prim_context, u
+ mmu_helper_get_phys_addr_data(uint32_t tl, int mmu_idx, uint64_t prim_context, uint64_t sec_context, uint64_t address) "tl=%d mmu_idx=%d primary context=0x%"PRIx64" secondary context=0x%"PRIx64" address=0x%"PRIx64
+ mmu_helper_mmu_fault(uint64_t address, uint64_t paddr, int mmu_idx, uint32_t tl, uint64_t prim_context, uint64_t sec_context) "Translate at 0x%"PRIx64" -> 0x%"PRIx64", mmu_idx=%d tl=%d primary context=0x%"PRIx64" secondary context=0x%"PRIx64
+ 
++# ldst_helper.c
++sparc_mmu_ctrl_flush(uint32_t old, uint32_t val) "MMU control register 0x%08x -> 0x%08x: TLB flush"
++
+ # int32_helper.c
+ sun4m_cpu_interrupt(unsigned int level) "Set CPU IRQ %d"
+ sun4m_cpu_reset_interrupt(unsigned int level) "Reset CPU IRQ %d"
diff --git a/debian/patches/wsh/0018-tests-qtest-test-no-fault-mode-and-the-TLB-on-sun4m.patch b/debian/patches/wsh/0018-tests-qtest-test-no-fault-mode-and-the-TLB-on-sun4m.patch
new file mode 100644
index 0000000..2003ad5
--- /dev/null
+++ b/debian/patches/wsh/0018-tests-qtest-test-no-fault-mode-and-the-TLB-on-sun4m.patch
@@ -0,0 +1,180 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test no-fault mode and the TLB on sun4m
+
+A tiny boot PROM turns the SRMMU on with three 16 MB mappings: itself,
+RAM read-write, and RAM that user mode may only read. It sets and
+clears the no-fault bit once with no fault in between, then, with the
+bit set, stores to the read-only RAM with a user-mode ASI, which must
+not trap, clears the bit and stores again, which must take a data
+access exception. Run on SS-5 (microSPARC-II) and SS-20 (SuperSPARC).
+
+It passes with and without the previous patch, and fails when NF is
+simply left out of the flush condition: the second store then goes
+through the entry made in no-fault mode.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+Applied-Upstream: https://github.com/tenox7/lemu/commit/7475a0c20a9ef6fc87c1956346b65f33f54b89ae
+---
+ tests/qtest/meson.build              |   2 +-
+ tests/qtest/sun4m-mmu-nofault-test.c | 139 +++++++++++++++++++++++++++
+ 2 files changed, 140 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-mmu-nofault-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 265d19b658..04bc7dfa9b 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -201,7 +201,7 @@ qtests_sh4eb = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-
+ 
+ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-escc-test', 'sun4m-apc-test',
+-                'sun4m-solaris-idle-test'] + \
++                'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-mmu-nofault-test.c b/tests/qtest/sun4m-mmu-nofault-test.c
+new file mode 100644
+index 0000000000..7802da670c
+--- /dev/null
++++ b/tests/qtest/sun4m-mmu-nofault-test.c
+@@ -0,0 +1,139 @@
++/*
++ * QTest: no-fault mode of the sun4m SRMMU and the TLB
++ *
++ * A boot PROM turns the MMU on with three 16 MB mappings: the PROM itself
++ * at virtual 0, RAM read-write at 0x01000000 and RAM that user mode may
++ * only read at 0x02000000. With the no-fault bit (NF) set in the MMU
++ * control register it writes to the read-only RAM in user mode (ASI 0x0a),
++ * which must not trap; QEMU puts an entry with overridden permissions in
++ * its TLB for that. After NF is cleared the same write must trap (data
++ * access exception), so that entry must not outlive no-fault mode. Before
++ * that the PROM sets and clears NF once with no fault in between, which
++ * QEMU need not flush the TLB for.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the stage the PROM reached and the trap marker */
++#define RAM_STAGE       0x1004ULL
++#define RAM_TRAP        0x1020ULL
++#define PROM_WORDS      0x200
++#define CODE            0x100           /* word index of the code */
++#define TT_DATA_ACCESS  9
++
++static char *write_prom(uint64_t prom_base)
++{
++    /* L1 page table entry: the PROM at virtual 0, ACC 2 (RX), 16 MB */
++    uint32_t pte = (uint32_t)(prom_base >> 4) | 0x0a;
++    const uint32_t code[] = {
++        0x11000008,             /* sethi %hi(0x2000), %o0    context table */
++        0x92102301,             /* mov   0x301, %o1          PTD: L1 at 0x3000 */
++        0xd2220000,             /* st    %o1, [%o0] */
++        0x1100000c,             /* sethi %hi(0x3000), %o0    L1 table */
++        0x13000000 | (pte >> 10),       /* sethi %hi(pte), %o1 */
++        0x92126000 | (pte & 0x3ff),     /* or    %o1, %lo(pte), %o1 */
++        0xd2220000,             /* st    %o1, [%o0]          0x00000000: PROM */
++        0x9210200e,             /* mov   0xe, %o1            RAM, ACC 3 (RWX) */
++        0xd2222004,             /* st    %o1, [%o0 + 4]      0x01000000 */
++        0x92102016,             /* mov   0x16, %o1           RAM, ACC 5 (user R) */
++        0xd2222008,             /* st    %o1, [%o0 + 8]      0x02000000 */
++        0x90102100,             /* mov   0x100, %o0 */
++        0x92102200,             /* mov   0x200, %o1 */
++        0xd2a20080,             /* sta   %o1, [%o0] 4        context table pointer */
++        0x90102200,             /* mov   0x200, %o0 */
++        0xc0a20080,             /* sta   %g0, [%o0] 4        context 0 */
++        0x81902000,             /* wr    %g0, 0, %wim */
++        0x81882fa0,             /* wr    %g0, 0xfa0, %psr    S, ET, PIL 15 */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0xd4800080,             /* lda   [%g0] 4, %o2        MMU control register */
++        0x9412a001,             /* or    %o2, 1, %o2         MMU on */
++        0xd4a00080,             /* sta   %o2, [%g0] 4 */
++        0x9612a002,             /* or    %o2, 2, %o3         the same with NF */
++        0x07004004,             /* sethi %hi(0x01001000), %g3 */
++        0x88102001,             /* mov   1, %g4 */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 1: MMU on */
++        0x0b008000,             /* sethi %hi(0x02000000), %g5 */
++        0x8a116100,             /* or    %g5, 0x100, %g5     user read-only word */
++        0x84016100,             /* add   %g5, 0x100, %g2     another one */
++        0x8c102055,             /* mov   0x55, %g6 */
++        0xd6a00080,             /* sta   %o3, [%g0] 4        NF on */
++        0xd4a00080,             /* sta   %o2, [%g0] 4        NF off, no fault */
++        0xce808140,             /* lda   [%g2] 0x0a, %g7     user read: allowed */
++        0xd6a00080,             /* sta   %o3, [%g0] 4        NF on */
++        0xcca14140,             /* sta   %g6, [%g5] 0x0a     user write: no trap */
++        0xd4a00080,             /* sta   %o2, [%g0] 4        NF off */
++        0x88102002,             /* mov   2, %g4 */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 2 */
++        0xcca14140,             /* sta   %g6, [%g5] 0x0a     user write: traps */
++        0x88102003,             /* mov   3, %g4 */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 3: it didn't */
++        0x10800000,             /* b     . */
++        0x01000000,             /* nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    /* Trap i: store i at RAM_TRAP through its virtual address, and stop */
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03004004);         /* sethi %hi(0x01001000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4m-mmu-nofault-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++typedef struct {
++    const char *machine;
++    uint64_t prom_base;
++} TestCase;
++
++static void test_nofault(const void *data)
++{
++    const TestCase *t = data;
++    g_autofree char *prom = write_prom(t->prom_base);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine %s -accel tcg -m 64 -bios %s",
++                                  t->machine, prom);
++
++    while (qtest_readl(qts, RAM_TRAP) == 0 && qtest_readl(qts, RAM_STAGE) < 3) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    g_assert_cmpuint(qtest_readl(qts, RAM_STAGE), ==, 2);
++    g_assert_cmpuint(qtest_readl(qts, RAM_TRAP), ==, TT_DATA_ACCESS);
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++int main(int argc, char **argv)
++{
++    static const TestCase ss5 = { "SS-5", 0x70000000ULL };
++    static const TestCase ss20 = { "SS-20", 0xff0000000ULL };
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        qtest_add_data_func("sun4m-mmu-nofault/ss5", &ss5, test_nofault);
++        qtest_add_data_func("sun4m-mmu-nofault/ss20", &ss20, test_nofault);
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0019-target-sparc-let-a-write-to-psr-in-a-delay-slot-end-.patch b/debian/patches/wsh/0019-target-sparc-let-a-write-to-psr-in-a-delay-slot-end-.patch
new file mode 100644
index 0000000..34f2da8
--- /dev/null
+++ b/debian/patches/wsh/0019-target-sparc-let-a-write-to-psr-in-a-delay-slot-end-.patch
@@ -0,0 +1,95 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: let a write to %psr in a delay slot end the TB
+
+QEMU looks at pending interrupts when the vCPU comes back to the main
+loop, so a write to %psr, which can unmask one, ends its translation
+block with exit_tb instead of chaining to the next (do_wrpsr() sets
+DISAS_EXIT). In a delay slot that was lost: sparc_tr_translate_insn()
+turned DISAS_EXIT into DISAS_TOO_MANY whenever the PC no longer
+followed the insn, and advance_pc() resolved a pending conditional
+branch with goto_tb and DISAS_NORETURN, so the block chained on to the
+branch target. An interrupt the write let in then waited for whatever
+next stopped the vCPU: on one CPU the next timer or device interrupt,
+so nobody noticed. Before 25524734c6 (QEMU 8.2) the wrpsr case emitted
+its own exit_tb, which worked in a delay slot.
+
+Solaris lowers PIL in a delay slot in splx() and splr()
+("bl,a 1f; wr %o3, newpil, %psr"). With two or four CPUs on SS-10 or
+SS-20 it hung within minutes: one CPU sends a level 13 cross-call
+(xc_sync_cache) and spins until the other acknowledges it; the other
+spins in a mutex_tryenter loop that lowers PIL from 13 to 4 through
+splx and raises it again, never leaving its chained blocks, while its
+interrupt controller has the soft interrupt pending and the CPU has it
+in pil_in and interrupt_index. The system timer goes to the other CPU,
+so nothing kicks it. Setting its icount_decr from a debugger let the
+interrupt in and both CPUs went on. Single-threaded TCG hung the same
+way.
+
+Keep DISAS_EXIT after a delay slot. When the slot follows a
+conditional branch, compute the branch at run time into pc/npc and
+exit; when the PC after the slot is known only at run time (jmpl,
+rett), it is in cpu_pc already, so the exit stores only static values.
+
+Solaris 2.6 on SS-20 then ran 30 minutes of parallel load on 2 and on
+4 CPUs (every CPU 99-100% busy, no checksum error); before, a 256 MB
+write and sync hung every time. One CPU is unaffected: the qtests and
+the guest regression runs pass as before.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+Applied-Upstream: https://github.com/tenox7/lemu/commit/bfdff3fd83ef5758dae3c3b414269cc1c0d7c315
+---
+ target/sparc/translate.c | 27 ++++++++++++++++++++++++---
+ 1 file changed, 24 insertions(+), 3 deletions(-)
+
+diff --git a/target/sparc/translate.c b/target/sparc/translate.c
+index 679b15c389..d8ccd8335d 100644
+--- a/target/sparc/translate.c
++++ b/target/sparc/translate.c
+@@ -2572,6 +2572,19 @@ static bool advance_pc(DisasContext *dc)
+             break;
+ 
+         case JUMP_PC:
++            if (dc->base.is_jmp == DISAS_EXIT) {
++                /*
++                 * The insn in the delay slot asked for an exit to the
++                 * main loop (e.g. a write to %psr that lowered PIL):
++                 * resolve the branch at run time instead of chaining.
++                 */
++                gen_generic_branch(dc);
++                tcg_gen_mov_tl(cpu_pc, cpu_npc);
++                tcg_gen_addi_tl(cpu_npc, cpu_npc, 4);
++                dc->pc = DYNAMIC_PC;
++                dc->npc = DYNAMIC_PC;
++                break;
++            }
+             /* we can do a static jump */
+             l1 = gen_new_label();
+             tcg_gen_brcondi_tl(dc->jump.cond, dc->jump.c1, dc->jump.c2, l1);
+@@ -5992,7 +6005,12 @@ static void sparc_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+     if (dc->base.is_jmp == DISAS_NORETURN) {
+         return;
+     }
+-    if (dc->pc != dc->base.pc_next) {
++    /*
++     * Keep DISAS_EXIT when the insn was in a delay slot: it is how a
++     * write to %psr (or a membar #Sync on sparc64) gets the main loop
++     * to look at pending interrupts again.
++     */
++    if (dc->pc != dc->base.pc_next && dc->base.is_jmp != DISAS_EXIT) {
+         dc->base.is_jmp = DISAS_TOO_MANY;
+     }
+ }
+@@ -6056,8 +6074,11 @@ static void sparc_tr_tb_stop(DisasContextBase *dcbase, CPUState *cs)
+        break;
+ 
+     case DISAS_EXIT:
+-        /* Exit TB */
+-        save_state(dc);
++        /* Exit TB; after a delay slot the PC may be known only at run time */
++        if (!(dc->pc & 3)) {
++            tcg_gen_movi_tl(cpu_pc, dc->pc);
++        }
++        save_npc(dc);
+         tcg_gen_exit_tb(NULL, 0);
+         break;
+ 
diff --git a/debian/patches/wsh/0020-tests-qtest-test-an-interrupt-let-in-from-a-delay-sl.patch b/debian/patches/wsh/0020-tests-qtest-test-an-interrupt-let-in-from-a-delay-sl.patch
new file mode 100644
index 0000000..bbfee52
--- /dev/null
+++ b/debian/patches/wsh/0020-tests-qtest-test-an-interrupt-let-in-from-a-delay-sl.patch
@@ -0,0 +1,199 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test an interrupt let in from a delay slot on sun4m
+
+A tiny boot PROM loops: it raises PIL to 15, writes the set register
+of its CPU's interrupt controller (0 in the first round, soft
+interrupt 13 from the second), counts the round and lowers PIL to 0
+with a write to %psr: a plain one, or one in the delay slot of ba, of
+a taken bne, of a taken bne,a (as in Solaris's splx) and of jmpl. The
+interrupt must be taken in the second round.
+
+Without the previous patch the four delay-slot cases fail: once the
+first round has chained the blocks, the CPU never comes back to the
+main loop and the PROM goes round and round. The plain case passes
+with and without it.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+Applied-Upstream: https://github.com/tenox7/lemu/commit/74085832a529c714c47a0c288f690f5973901491
+---
+ tests/qtest/meson.build                 |   3 +-
+ tests/qtest/sun4m-pil-delay-slot-test.c | 156 ++++++++++++++++++++++++
+ 2 files changed, 158 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-pil-delay-slot-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 04bc7dfa9b..ff0981ddfc 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -201,7 +201,8 @@ qtests_sh4eb = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-
+ 
+ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-escc-test', 'sun4m-apc-test',
+-                'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test'] + \
++                'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test',
++                'sun4m-pil-delay-slot-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-pil-delay-slot-test.c b/tests/qtest/sun4m-pil-delay-slot-test.c
+new file mode 100644
+index 0000000000..606521a271
+--- /dev/null
++++ b/tests/qtest/sun4m-pil-delay-slot-test.c
+@@ -0,0 +1,156 @@
++/*
++ * QTest: an interrupt let in by a write to %psr in a delay slot on sun4m
++ *
++ * A boot PROM loops: it raises PIL to 15, writes the set register of its
++ * CPU's interrupt controller, counts the round in RAM and lowers PIL to 0
++ * again. In the first round it writes 0 there, from the second on the bit
++ * of soft interrupt 13, which must then be taken as soon as PIL is 0. The
++ * write to %psr that lowers PIL is a plain instruction, or in the delay
++ * slot of a branch (always, conditional, conditional with annul, jmpl):
++ * Solaris lowers PIL in the delay slot of "bl,a" in splx().
++ *
++ * QEMU looks at pending interrupts between translation blocks that don't
++ * chain, and a write to %psr ends its block for that. One in a delay slot
++ * used to chain on to the branch target instead, so once the first round
++ * had linked the blocks, the interrupt waited for something else to stop
++ * the CPU, and here nothing does. That is how two CPUs running Solaris
++ * stopped: the one that was sent a cross-call never took it.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the round the PROM is in and the trap marker */
++#define RAM_ROUND       0x1004ULL
++#define RAM_TRAP        0x1020ULL
++#define PROM_WORDS      0x200
++#define CODE            0x100           /* word index of the code */
++#define VARIANT         15              /* word index of the variant in code[] */
++#define LOOP            19              /* and of what follows it */
++#define TT_INTERRUPT_13 0x1d
++
++/* Four words that lower PIL to 0 and get to LOOP */
++static const uint32_t variants[][4] = {
++    {   /* plain */
++        0x818820a0,             /* wr    %g0, 0xa0, %psr     S, ET, PIL 0 */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++    }, { /* ba */
++        0x10800004,             /* ba    next */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++        0x01000000,             /* nop (not reached) */
++    }, { /* bne, taken */
++        0x80a02001,             /* cmp   %g0, 1 */
++        0x12800003,             /* bne   next */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++    }, { /* bne,a, taken: splx() in Solaris */
++        0x80a02001,             /* cmp   %g0, 1 */
++        0x32800003,             /* bne,a next */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++    }, { /* jmpl */
++        0x84102000 | ((CODE + LOOP) * 4),   /* mov   next, %g2 */
++        0x81c0a000,             /* jmp   %g2 */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++    },
++};
++
++static const char *const names[] = { "plain", "ba", "bne", "bne-annul", "jmpl" };
++
++/*
++ * The PROM: a trap table whose entries store their trap type at RAM_TRAP
++ * and stop, and at 0x400 the loop. It runs from reset: MMU off, so
++ * instructions come from the PROM and data from RAM and the devices.
++ */
++static char *write_prom(int variant)
++{
++    uint32_t code[] = {
++        0x111c7800,             /*        sethi %hi(0x71e00000), %o0  intctl */
++        0x31000004,             /*        sethi %hi(0x1000), %i0 */
++        0x92102000,             /*        mov   0, %o1          nothing yet */
++        0xa2102001,             /*        mov   1, %l1          round */
++        0x81882fa0,             /* again: wr    %g0, 0xfa0, %psr  PIL 15 */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0xd2222008,             /*        st    %o1, [%o0 + 8]  set soft ints */
++        0xc0022000,             /*        ld    [%o0], %g0 */
++        0x81882fa0,             /*        wr    %g0, 0xfa0, %psr  the CPU */
++        0x01000000,             /*        nop    looks at the interrupt */
++        0x01000000,             /*        nop    here and can't take it */
++        0x01000000,             /*        nop */
++        0xe2262004,             /*        st    %l1, [%i0 + 4]  the round */
++        0, 0, 0, 0,             /*        the variant: PIL 0 */
++        0x13080000,             /* next:  sethi %hi(0x20000000), %o1  soft 13 */
++        0xa2046001,             /*        inc   %l1 */
++        0x10bfffef,             /*        ba    again */
++        0x01000000,             /*         nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    memcpy(&code[VARIANT], variants[variant], sizeof(variants[variant]));
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    /* Trap i: store i at RAM_TRAP and stop */
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03000004);         /* sethi %hi(0x1000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4m-pil-delay-slot-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++static void test_interrupt(const void *data)
++{
++    int variant = GPOINTER_TO_INT(data);
++    g_autofree char *prom = write_prom(variant);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine SS-5 -accel tcg -bios %s", prom);
++
++    /* Without the interrupt the PROM goes round and round */
++    while (qtest_readl(qts, RAM_TRAP) == 0 &&
++           qtest_readl(qts, RAM_ROUND) < 1000) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    g_assert_cmphex(qtest_readl(qts, RAM_TRAP), ==, TT_INTERRUPT_13);
++    g_assert_cmpuint(qtest_readl(qts, RAM_ROUND), ==, 2);
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++int main(int argc, char **argv)
++{
++    int i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        for (i = 0; i < ARRAY_SIZE(variants); i++) {
++            g_autofree char *name =
++                g_strdup_printf("sun4m-pil-delay-slot/%s", names[i]);
++            qtest_add_data_func(name, GINT_TO_POINTER(i), test_interrupt);
++        }
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0021-ide-cmd646-latch-the-interrupt-status-bits-until-the.patch b/debian/patches/wsh/0021-ide-cmd646-latch-the-interrupt-status-bits-until-the.patch
new file mode 100644
index 0000000..935802d
--- /dev/null
+++ b/debian/patches/wsh/0021-ide-cmd646-latch-the-interrupt-status-bits-until-the.patch
@@ -0,0 +1,111 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] ide/cmd646: latch the interrupt status bits until the
+ guest clears them
+
+cmd646_set_irq() set the channel's interrupt status bit in MRDMODE
+(mirrored in CFR and ARTTIM23) when a drive raised INTRQ and cleared it
+again when INTRQ dropped. A drive drops INTRQ when its status register is
+read, so a guest that reads the drive status first and then looks at
+these bits never sees them set. On the chip they are latched and cleared
+by writing 1; QEMU already has the w1c masks for them.
+
+Solaris 10's ata driver on sun4u does exactly that after SET FEATURES
+and warns for every IDE device:
+
+  WARNING: Interrupt not seen after set_features
+
+Keep the status bits set when INTRQ drops, until the guest writes 1 to
+them in config space (the BMDMA register that mirrors MRDMODE doesn't
+clear them: bmdma_write() masks them out). The PCI interrupt line keeps
+following the drives' INTRQ, now kept in a field of its own: driving it
+from the latched bits instead left it asserted for guests that don't
+clear them, and Linux disabled the interrupt ("irq 7: nobody cared") and
+OpenBSD hung at boot. A device reset clears that field (the drives come
+out of reset with INTRQ low); otherwise the next config write after a
+reset raised the line again.
+
+Tested on sun4u, the only machine in this package with a cmd646 (alpha
+and hppa have one too, and aren't built here): Solaris 10 1/13 attaches
+the disk as dad0 without the warning; NetBSD 11.1 and 9.3, OpenBSD 8.0
+and the Debian 12 installer boot as before (sparc lab, sparc64 matrix).
+The next patch adds a qtest.
+
+The new field isn't in the migration stream (vmstate_ide_pci is shared
+by every PCI IDE controller): a guest migrated with INTRQ up sees the
+line low until the drive raises it again. sparc64 migration isn't
+offered by qemu-server.
+
+paulsheer/qemu 51d72e16 ("sun4u: fix cmd646 IRQ latch and LSI 53C895
+identity for Solaris 10") latches the bits too, and drives the interrupt
+line from them; this is a separate implementation that keeps the line on
+INTRQ.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+Applied-Upstream: https://github.com/tenox7/lemu/commit/07e0dfbcee1692b8a8c468294eedcad015870a88
+---
+ hw/ide/cmd646.c      | 20 +++++++++++++++-----
+ include/hw/ide/pci.h |  1 +
+ 2 files changed, 16 insertions(+), 5 deletions(-)
+
+diff --git a/hw/ide/cmd646.c b/hw/ide/cmd646.c
+index d44a90a162..0e3b11208a 100644
+--- a/hw/ide/cmd646.c
++++ b/hw/ide/cmd646.c
+@@ -182,12 +182,13 @@ static void bmdma_setup_bar(PCIIDEState *d)
+ 
+ static void cmd646_update_irq(PCIDevice *pd)
+ {
++    PCIIDEState *d = PCI_IDE(pd);
+     int pci_level;
+ 
+-    pci_level = ((pd->config[MRDMODE] & MRDMODE_INTR_CH0) &&
+-                 !(pd->config[MRDMODE] & MRDMODE_BLK_CH0)) ||
+-        ((pd->config[MRDMODE] & MRDMODE_INTR_CH1) &&
+-         !(pd->config[MRDMODE] & MRDMODE_BLK_CH1));
++    /* The interrupt line follows the drives' INTRQ, not the latched status */
++    pci_level =
++        ((d->intrq & 1) && !(pd->config[MRDMODE] & MRDMODE_BLK_CH0)) ||
++        ((d->intrq & 2) && !(pd->config[MRDMODE] & MRDMODE_BLK_CH1));
+     pci_set_irq(pd, pci_level);
+ }
+ 
+@@ -199,10 +200,17 @@ static void cmd646_set_irq(void *opaque, int channel, int level)
+     int irq_mask;
+ 
+     irq_mask = MRDMODE_INTR_CH0 << channel;
++    /*
++     * The interrupt status bits (MRDMODE, mirrored in CFR/ARTTIM23) latch
++     * the drive's INTRQ and stay set until the guest writes 1 to clear
++     * them; INTRQ dropping (the guest reading the drive's status register)
++     * doesn't clear them. The PCI interrupt line follows INTRQ itself.
++     */
+     if (level) {
++        d->intrq |= 1 << channel;
+         pd->config[MRDMODE] |= irq_mask;
+     } else {
+-        pd->config[MRDMODE] &= ~irq_mask;
++        d->intrq &= ~(1 << channel);
+     }
+     cmd646_update_dma_interrupts(pd);
+     cmd646_update_irq(pd);
+@@ -216,6 +224,8 @@ static void cmd646_reset(DeviceState *dev)
+     for (i = 0; i < 2; i++) {
+         ide_bus_reset(&d->bus[i]);
+     }
++    /* The drives come out of reset with INTRQ low */
++    d->intrq = 0;
+ }
+ 
+ static uint32_t cmd646_pci_config_read(PCIDevice *d,
+diff --git a/include/hw/ide/pci.h b/include/hw/ide/pci.h
+index ef03764caa..6ecbc84130 100644
+--- a/include/hw/ide/pci.h
++++ b/include/hw/ide/pci.h
+@@ -51,6 +51,7 @@ struct PCIIDEState {
+     BMDMAState bmdma[2];
+     qemu_irq isa_irq[2];
+     uint32_t secondary; /* used only for cmd646 */
++    uint8_t intrq; /* used only for cmd646: INTRQ of channel n in bit n */
+     MemoryRegion bmdma_bar;
+     MemoryRegion cmd_bar[2];
+     MemoryRegion data_bar[2];
diff --git a/debian/patches/wsh/0022-tests-qtest-test-the-cmd646-interrupt-status-latch-o.patch b/debian/patches/wsh/0022-tests-qtest-test-the-cmd646-interrupt-status-latch-o.patch
