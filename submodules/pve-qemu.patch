+ 
++/* BPcc on %icc with cond, predicted not taken */
++static uint32_t bpcc_icc_to(int cond, int from, int to)
++{
++    return (cond << 25) | (1 << 22) | ((to - from) & 0x7ffff);
++}
++
++/* BPcc on %xcc with cond, predicted not taken */
++static uint32_t bpcc_xcc_pn_to(int cond, int from, int to)
++{
