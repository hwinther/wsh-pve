++/*
++ * A floating-point instruction in fp_exception_pending state: the FPU
++ * moves to fp_exception (qne = 1) and the instruction takes the trap,
++ * unless it has a higher-priority trap of its own.  For an FP load or
++ * store that is mem_address_not_aligned (priority 10, fp_exception is
++ * 11); the exception then stays pending for the next FP instruction,
++ * as the boot PROM of the SPARCstation LX expects.  align is the V8
++ * alignment mask of the access; 0 for an FPop or FBfcc.
++ */
++void helper_fp_deferred_trap(CPUSPARCState *env, target_ulong addr,
++                             uint32_t align)
++{
++    if (addr & align) {
++        cpu_raise_exception_ra(env, TT_UNALIGNED, GETPC());
++    }
++    env->fp_pending = 0;
++    env->fsr_qne = FSR_QNE;
++    env->fp_deferred_trap = 1;
++    cpu_raise_exception_ra(env, TT_FP_EXCP, GETPC());
++}
++#endif
