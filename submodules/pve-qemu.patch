diff --git a/debian/patches/wsh/0016-tests-qtest-test-the-Solaris-idle-halt-on-sun4m.patch b/debian/patches/wsh/0016-tests-qtest-test-the-Solaris-idle-halt-on-sun4m.patch
new file mode 100644
index 0000000..3c8dbea
--- /dev/null
+++ b/debian/patches/wsh/0016-tests-qtest-test-the-Solaris-idle-halt-on-sun4m.patch
@@ -0,0 +1,184 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the Solaris idle halt on sun4m
+
+A tiny boot PROM runs a loop laid out as the idle loop of Solaris 2.6
+and counts its rounds in RAM. With nothing runnable and interrupts
+enabled at level 0, the count must stop (the CPU halted at the call of
+idle_cpu, and no device interrupts); it must keep going with
+solaris-idle=off, with a runnable thread, at interrupt level 15 and on
+an SS-20 with two CPUs. Any trap stops the test with the trap type in
+RAM.
+---
+ tests/qtest/meson.build               |   3 +-
+ tests/qtest/sun4m-solaris-idle-test.c | 148 ++++++++++++++++++++++++++
+ 2 files changed, 150 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-solaris-idle-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 75ad261ee8..265d19b658 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -200,7 +200,8 @@ qtests_sh4 = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-te
+ qtests_sh4eb = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-test'] : [])
+ 
+ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+-                'sun4m-escc-test', 'sun4m-apc-test'] + \
++                'sun4m-escc-test', 'sun4m-apc-test',
++                'sun4m-solaris-idle-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-solaris-idle-test.c b/tests/qtest/sun4m-solaris-idle-test.c
+new file mode 100644
+index 0000000000..59faaa721b
+--- /dev/null
++++ b/tests/qtest/sun4m-solaris-idle-test.c
+@@ -0,0 +1,148 @@
++/*
++ * QTest: halting the CPU in the Solaris idle loop on sun4m
++ *
++ * A boot PROM runs a loop laid out as the idle loop of Solaris 2.6: it
++ * counts its rounds in RAM, then calls "swtch" when the word at
++ * CPU + 0x58 (disp_nrunnable) is not 0 and calls the function that the
++ * word at CPU + 0x5c (idle_cpu) points to when it is. With interrupts
++ * enabled at level 0 and none pending, QEMU halts the CPU at that call,
++ * and as no device interrupts, the count stops. It must keep going with
++ * solaris-idle=off, with a runnable thread, at interrupt level 15 and with
++ * two CPUs.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the CPU structure, its round count at 0 and the trap marker */
++#define RAM_CPU         0x1000ULL
++#define RAM_COUNT       (RAM_CPU + 0)
++#define RAM_TRAP        (RAM_CPU + 0x20)
++#define PROM_WORDS      0x200
++#define CODE            0x100           /* word index of the code */
++
++/*
++ * The PROM: a trap table whose entries store their trap type at RAM_TRAP
++ * and stop, and at 0x400 the loop. It runs from reset: MMU off, so
++ * instructions come from the PROM and data from RAM.
++ */
++static char *write_prom(uint32_t nrunnable, uint32_t psr)
++{
++    const uint32_t code[] = {
++        0x31000004,             /*        sethi %hi(0x1000), %i0 */
++        0x82102000 | nrunnable, /*        mov   nrunnable, %g1 */
++        0xc2262058,             /*        st    %g1, [%i0 + 0x58] */
++        0x82102464,             /*        mov   ret, %g1 */
++        0xc226205c,             /*        st    %g1, [%i0 + 0x5c] */
++        0x81882000 | psr,       /*        wr    %g0, psr, %psr */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0xca062000,             /* top:   ld    [%i0], %g5 */
++        0x8a016001,             /*        inc   %g5 */
++        0xca262000,             /*        st    %g5, [%i0] */
++        0xd0062058,             /*        ld    [%i0 + 0x58], %o0 */
++        0x80a22000,             /*        cmp   %o0, 0 */
++        0x02800006,             /*        be    idle */
++        0x21000004,             /*         sethi %hi(0x1000), %l0 */
++        0x40000009,             /*        call  ret          swtch */
++        0x01000000,             /*         nop */
++        0x10bffff7,             /*        b     top */
++        0x01000000,             /*         nop */
++        0xe004205c,             /* idle:  ld    [%l0 + 0x5c], %l0 */
++        0x9fc40000,             /*        call  %l0          idle_cpu */
++        0x01000000,             /*         nop */
++        0x10bffff2,             /*        b     top */
++        0x01000000,             /*         nop */
++        0x81c3e008,             /* ret:   retl */
++        0x01000000,             /*         nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03000004);         /* sethi %hi(0x1000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4m-solaris-idle-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++/* The loop's round count 300 ms apart, once it has started */
++static void run(const char *machine, uint32_t nrunnable, uint32_t psr,
++                uint32_t *before, uint32_t *after)
++{
++    g_autofree char *prom = write_prom(nrunnable, psr);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine %s -accel tcg -bios %s",
++                                  machine, prom);
++
++    while (qtest_readl(qts, RAM_COUNT) == 0) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    g_usleep(300 * 1000);
++    *before = qtest_readl(qts, RAM_COUNT);
++    g_usleep(300 * 1000);
++    *after = qtest_readl(qts, RAM_COUNT);
++    g_assert_cmphex(qtest_readl(qts, RAM_TRAP), ==, 0);
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++#define PSR_S_ET        0xa0
++#define PSR_PIL15       0xf00
++
++/* Nothing runnable, interrupts enabled at level 0: the CPU stops */
++static void test_idle(void)
++{
++    uint32_t before, after;
++
++    run("SS-5", 0, PSR_S_ET, &before, &after);
++    g_assert_cmpuint(after, ==, before);
++}
++
++static void test_running(const void *data)
++{
++    const char *const *t = data;
++    uint32_t before, after;
++
++    run(t[0], atoi(t[1]), strtoul(t[2], NULL, 0), &before, &after);
++    g_assert_cmpuint(after, >, before);
++}
++
++int main(int argc, char **argv)
++{
++    static const char *const off[] = { "SS-5,solaris-idle=off", "0", "0xa0" };
++    static const char *const runnable[] = { "SS-5", "1", "0xa0" };
++    static const char *const pil15[] = { "SS-5", "0", "0xfa0" };
++    static const char *const smp2[] = { "SS-20 -smp 2", "0", "0xa0" };
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        qtest_add_func("sun4m-solaris-idle/idle", test_idle);
++        qtest_add_data_func("sun4m-solaris-idle/off", off, test_running);
++        qtest_add_data_func("sun4m-solaris-idle/runnable", runnable,
++                            test_running);
++        qtest_add_data_func("sun4m-solaris-idle/pil15", pil15, test_running);
++        qtest_add_data_func("sun4m-solaris-idle/smp2", smp2, test_running);
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0017-target-sparc-flush-the-TLB-on-a-no-fault-bit-change-.patch b/debian/patches/wsh/0017-target-sparc-flush-the-TLB-on-a-no-fault-bit-change-.patch
new file mode 100644
index 0000000..cd3ce12
--- /dev/null
+++ b/debian/patches/wsh/0017-target-sparc-flush-the-TLB-on-a-no-fault-bit-change-.patch
@@ -0,0 +1,140 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: flush the TLB on a no-fault bit change only when needed
+
+On the SPARCstation 5 (microSPARC-II), Solaris 2.x runs programs that
+call deeper than the register windows 4 to 10 times slower than on the
+SPARCstation 20, while compiled code with shallow calls runs equally
+fast. Solaris's window overflow and underflow handlers for this CPU
+save or restore the user window with the no-fault bit (NF) set in the
+MMU control register, then clear it and read the fault status
+register, so that a missing stack page doesn't trap inside the
+handler. That is two writes of the control register per trap, and
+QEMU flushes the whole TLB whenever NF changes: about 280,000 flushes
+a second while Solaris runs an awk loop, against 700 on the
+SPARCstation 20, whose SuperSPARC handlers probe the page instead.
+
+NF decides whether a failed translation traps; it changes no
+translation that succeeds. The only TLB entries that depend on it are
+the ones sparc_cpu_tlb_fill makes for a failed translation in no-fault
+mode (or with traps disabled), with overridden permissions or
+redirected to an unassigned address. Note in env->mmu_nf_entries when
+it makes one, and on a change of NF flush only while that is set. The
+boot mode bit flushes as before (it changes instruction fetches with
+the MMU off); MMU_E selects another MMU index and hasn't flushed since
+MMU_PHYS_IDX, and the cache, parity, PSO and other bits aren't read
+anywhere. CPU reset and loadvm flush the TLB themselves, so a stale
+flag costs at most one extra flush. A new trace event,
+sparc_mmu_ctrl_flush, shows the flushes that remain: in a 15 minute
+benchmark run on the SPARCstation 5 they were 7955 clears of NF after a
+fault in no-fault mode and one at boot.
+
+Solaris 2.6, medians of 3 runs of the same benchmarks with and without
+this patch: on the SPARCstation 5 the awk loop takes 5.1 s instead of
+47.1 s (SPARCstation 20: 5.4 s), the BYTE Towers of Hanoi run 18900
+towers/s instead of 4830 (SPARCstation 20: 19500), and lmbench's
+open/close takes 11 us instead of 53 (8-10). Solaris also saves user
+windows with NF set when a trap arrives, on every CPU, so the
+SPARCstation 20 gains as well: signal catch 39 -> 13 us, protection
+fault 13 -> 3 us, mmap of 8 MB 2.4 -> 1.1 ms. Dhrystone, Whetstone and
+nbench don't change.
+---
+ target/sparc/cpu.h         |  6 ++++++
+ target/sparc/ldst_helper.c | 24 +++++++++++++++++++-----
+ target/sparc/mmu_helper.c  |  3 ++-
+ target/sparc/trace-events  |  3 +++
+ 4 files changed, 30 insertions(+), 6 deletions(-)
+
+diff --git a/target/sparc/cpu.h b/target/sparc/cpu.h
+index b43a7336dd..9f53f1b682 100644
+--- a/target/sparc/cpu.h
++++ b/target/sparc/cpu.h
+@@ -506,6 +506,12 @@ struct CPUArchState {
+     uint64_t mmubpaction;
+     uint64_t mmubpregs[4];
+     uint64_t prom_addr;
++    /*
++     * The TLB holds an entry that sparc_cpu_tlb_fill made for a failed
++     * translation (no-fault mode or traps disabled), with its permissions
++     * overridden. A change of MMU_NF flushes the TLB only while this is set.
++     */
++    bool mmu_nf_entries;
+     /* Halt in the idle loop of SunOS 4.1.4, see sunos_idle.c */
+     bool sunos_idle;
+     int64_t sunos_idle_since;   /* when the loop first found no work */
+diff --git a/target/sparc/ldst_helper.c b/target/sparc/ldst_helper.c
+index 4ec8799d1f..87b85eed3a 100644
+--- a/target/sparc/ldst_helper.c
++++ b/target/sparc/ldst_helper.c
+@@ -32,6 +32,7 @@
+ #include "user/page-protection.h"
+ #endif
+ #include "asi.h"
++#include "trace.h"
+ 
+ //#define DEBUG_MMU
+ //#define DEBUG_MXCC
+@@ -996,18 +997,31 @@ void helper_st_asi(CPUSPARCState *env, target_ulong addr, uint64_t val,
+     case ASI_LEON_MMUREGS: /* LEON3 write MMU regs */
+         {
+             int reg = (addr >> 8) & 0x1f;
+-            uint32_t oldreg;
++            uint32_t oldreg, changed;
+ 
+             oldreg = env->mmuregs[reg];
+             switch (reg) {
+             case 0: /* Control Register */
+                 env->mmuregs[reg] = (env->mmuregs[reg] & 0xff000000) |
+                     (val & 0x00ffffff);
+-                /* Mappings generated during no-fault mode
+-                   are invalid in normal mode.  */
+-                if ((oldreg ^ env->mmuregs[reg])
+-                    & (MMU_NF | env->def.mmu_bm)) {
++                changed = oldreg ^ env->mmuregs[reg];
++                /*
++                 * Of the bits here only boot mode changes a translation
++                 * (instruction fetches with the MMU off). MMU_E selects
++                 * another mmu_idx; caches, PSO and parity aren't modelled.
++                 * MMU_NF only decides whether a failed translation traps:
++                 * the one kind of entry that depends on it is the one that
++                 * sparc_cpu_tlb_fill makes for such a failure with
++                 * overridden permissions, which is invalid in normal mode.
++                 * Flush on a change of NF only when there is one: Solaris
++                 * sets and clears NF around each user window spill and fill
++                 * on the microSPARC, and nearly always nothing faults.
++                 */
++                if ((changed & env->def.mmu_bm) ||
++                    ((changed & MMU_NF) && env->mmu_nf_entries)) {
++                    trace_sparc_mmu_ctrl_flush(oldreg, env->mmuregs[reg]);
+                     tlb_flush(cs);
++                    env->mmu_nf_entries = false;
+                 }
+                 break;
+             case 1: /* Context Table Pointer Register */
+diff --git a/target/sparc/mmu_helper.c b/target/sparc/mmu_helper.c
+index 07ba25dfce..455b36c9ef 100644
+--- a/target/sparc/mmu_helper.c
++++ b/target/sparc/mmu_helper.c
+@@ -251,7 +251,8 @@ bool sparc_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+         /* No fault mode: if a mapping is available, just override
+            permissions. If no mapping is available, redirect accesses to
+            neverland. Fake/overridden mappings will be flushed when
+-           switching to normal mode. */
++           switching to normal mode (helper_st_asi, ASI_M_MMUREGS). */
++        env->mmu_nf_entries = true;
+         full.prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+         tlb_set_page_full(cs, mmu_idx, vaddr, &full);
+         return true;
+diff --git a/target/sparc/trace-events b/target/sparc/trace-events
+index 4b9103295f..12df5142e1 100644
+--- a/target/sparc/trace-events
++++ b/target/sparc/trace-events
+@@ -10,6 +10,9 @@ mmu_helper_get_phys_addr_code(uint32_t tl, int mmu_idx, uint64_t prim_context, u
+ mmu_helper_get_phys_addr_data(uint32_t tl, int mmu_idx, uint64_t prim_context, uint64_t sec_context, uint64_t address) "tl=%d mmu_idx=%d primary context=0x%"PRIx64" secondary context=0x%"PRIx64" address=0x%"PRIx64
+ mmu_helper_mmu_fault(uint64_t address, uint64_t paddr, int mmu_idx, uint32_t tl, uint64_t prim_context, uint64_t sec_context) "Translate at 0x%"PRIx64" -> 0x%"PRIx64", mmu_idx=%d tl=%d primary context=0x%"PRIx64" secondary context=0x%"PRIx64
+ 
++# ldst_helper.c
++sparc_mmu_ctrl_flush(uint32_t old, uint32_t val) "MMU control register 0x%08x -> 0x%08x: TLB flush"
++
+ # int32_helper.c
+ sun4m_cpu_interrupt(unsigned int level) "Set CPU IRQ %d"
+ sun4m_cpu_reset_interrupt(unsigned int level) "Reset CPU IRQ %d"
diff --git a/debian/patches/wsh/0018-tests-qtest-test-no-fault-mode-and-the-TLB-on-sun4m.patch b/debian/patches/wsh/0018-tests-qtest-test-no-fault-mode-and-the-TLB-on-sun4m.patch
