++++ b/hw/sparc/sun4m_iommu.c
+@@ -64,6 +64,16 @@
+ #define IOMMU_PGFLUSH       (0x0018 >> 2)
+ #define IOMMU_PGFLUSH_MASK  0xffffffff
+ 
++/*
++ * The TLB's 16 tags and data entries, which the boot PROMs reach with the
++ * diagnostic access bit (bit 1, NetBSD's IOMMU_CTL_DE) of the control
++ * register set. QEMU has no TLB:
++ * they are storage, and nothing reads them but the PROM's tests.
++ */
++#define IOMMU_TLB_TAG       (0x0100 >> 2)
++#define IOMMU_TLB_DATA      (0x0200 >> 2)
++#define IOMMU_TLB_ENTRIES   16
++
+ #define IOMMU_AFSR          (0x1000 >> 2)
+ #define IOMMU_AFSR_ERR      0x80000000 /* LE, TO, or BE asserted */
+ #define IOMMU_AFSR_LE       0x40000000 /* SBUS reports error after
+@@ -194,7 +204,7 @@ static void iommu_mem_write(void *opaque, hwaddr addr,
+         s->regs[saddr] = ((val & IOMMU_CTRL_MASK) | s->version);
+         break;
+     case IOMMU_BASE:
+-        s->regs[saddr] = val & IOMMU_BASE_MASK;
++        s->regs[saddr] = val & s->base_mask;
+         break;
+     case IOMMU_TLBFLUSH:
+         trace_sun4m_iommu_mem_writel_tlbflush(val);
+@@ -219,7 +229,7 @@ static void iommu_mem_write(void *opaque, hwaddr addr,
+     case IOMMU_SBCFG1:
+     case IOMMU_SBCFG2:
+     case IOMMU_SBCFG3:
+-        s->regs[saddr] = val & IOMMU_SBCFG_MASK;
++        s->regs[saddr] = val & s->sbcfg_mask;
+         break;
+     case IOMMU_ARBEN:
+         /* XXX implement SBus probing: fault when reading unmapped
+@@ -229,6 +239,9 @@ static void iommu_mem_write(void *opaque, hwaddr addr,
+     case IOMMU_MASK_ID:
+         s->regs[saddr] |= val & IOMMU_MASK_ID_MASK;
+         break;
++    case IOMMU_TLB_DATA ... IOMMU_TLB_DATA + IOMMU_TLB_ENTRIES - 1:
++        s->regs[saddr] = val & s->tlb_data_mask;
++        break;
+     default:
+         s->regs[saddr] = val;
+         break;
+@@ -251,7 +264,7 @@ static uint32_t iommu_page_get_flags(IOMMUState *s, hwaddr addr)
+     hwaddr iopte;
+     hwaddr pa = addr;
+ 
+-    iopte = s->regs[IOMMU_BASE] << 4;
++    iopte = (hwaddr)s->regs[IOMMU_BASE] << 4;
+     addr &= ~s->iostart;
+     iopte += (addr >> (IOMMU_PAGE_SHIFT - 2)) & ~3;
+     ret = address_space_ldl_be(&address_space_memory, iopte,
+@@ -371,6 +384,10 @@ static void iommu_realize(DeviceState *ds, Error **errp)
+ 
+ static const Property iommu_properties[] = {
+     DEFINE_PROP_UINT32("version", IOMMUState, version, 0),
++    DEFINE_PROP_UINT32("base-mask", IOMMUState, base_mask, IOMMU_BASE_MASK),
++    DEFINE_PROP_UINT32("sbcfg-mask", IOMMUState, sbcfg_mask,
++                       IOMMU_SBCFG_MASK),
++    DEFINE_PROP_UINT32("tlb-data-mask", IOMMUState, tlb_data_mask, 0xffffffff),
+ };
+ 
+ static void iommu_class_init(ObjectClass *klass, const void *data)
