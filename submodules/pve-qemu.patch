++        if (was_on && !s->play_running) {
++            /* the count zeroed in the middle of a buffer: a stop */
++            cs_play_drop(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
++        }
+         break;
+     case CS_PNC:
+         /* the count loads the next buffer; a count of 0 unloads it */
+@@ -745,7 +844,7 @@ static void cs_mem_write(void *opaque, hwaddr addr,
+          * callback, as after PEN.
+          */
+         if (feed && s->voice && s->play_running) {
+-            cs_play_feed(s, UINT32_MAX, now);
++            cs_play_feed(s, now);
+         }
+         /* a PMI still due waits while a next buffer is loaded */
+         cs_play_irqs(s);
+@@ -768,6 +867,8 @@ static int cs_pre_load(void *opaque)
+     CSState *s = opaque;
+ 
+     s->play_end = 0;
++    s->fifo_len = 0;
++    s->buf_taken = 0;
+     s->pi_at = -1;
+     s->pmi_at = -1;
+     return 0;
+@@ -776,10 +877,20 @@ static int cs_pre_load(void *opaque)
+ static int cs_post_load(void *opaque, int version_id)
+ {
+     CSState *s = opaque;
++    uint32_t fifo_len = s->fifo_len;
+ 
++    if (fifo_len > CS_FIFO || fifo_len % 2) {
++        return -EINVAL;
++    }
+     s->play_running = false;
+     s->play_drain = 0;
++    /* it compares the layout with the defaults here and would empty it */
+     cs_play_setup(s);
++    s->fifo_len = fifo_len;
++    if (fifo_len) {
++        /* the codec still has these to play, also when the pipe is empty */
++        s->play_drain = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + CS_DRAIN_NS;
++    }
+     cs_play_update(s);
+     /* a PI or PMI still due: set the timer again */
+     cs_play_irqs(s);
+@@ -807,6 +918,33 @@ static const VMStateDescription vmstate_cs4231_irqs = {
+     }
+ };
+ 
++/*
++ * Samples the APC took ahead of the codec: without them the codec would
++ * start again at once after a migration, so PI and PMI would come early,
++ * the address and count would read the APC's position, and up to 50 ms
++ * of sound would be lost
++ */
++static bool cs_fifo_needed(void *opaque)
++{
++    CSState *s = opaque;
++
++    return s->fifo_len > 0;
++}
++
++static const VMStateDescription vmstate_cs4231_fifo = {
++    .name = "cs4231/fifo",
++    .version_id = 1,
++    .minimum_version_id = 1,
++    .needed = cs_fifo_needed,
++    .fields = (const VMStateField[]) {
++        VMSTATE_INT64(play_end, CSState),
++        VMSTATE_UINT32(buf_taken, CSState),
++        VMSTATE_UINT32(fifo_len, CSState),
++        VMSTATE_INT16_ARRAY(fifo, CSState, CS_FIFO / 2),
++        VMSTATE_END_OF_LIST()
++    }
++};
++
+ static const VMStateDescription vmstate_cs4231 = {
+     .name ="cs4231",
+     .version_id = 2,
+@@ -821,6 +959,7 @@ static const VMStateDescription vmstate_cs4231 = {
+     },
+     .subsections = (const VMStateDescription * const []) {
+         &vmstate_cs4231_irqs,
++        &vmstate_cs4231_fifo,
+         NULL
+     }
+ };
diff --git a/debian/patches/wsh/0129-tests-qtest-test-cs4231-stops-and-migration-with-sam.patch b/debian/patches/wsh/0129-tests-qtest-test-cs4231-stops-and-migration-with-sam.patch
new file mode 100644
index 0000000..5e1875f
--- /dev/null
+++ b/debian/patches/wsh/0129-tests-qtest-test-cs4231-stops-and-migration-with-sam.patch
@@ -0,0 +1,207 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test cs4231 stops and migration with samples
+ taken ahead
+
+mid-stop plays one buffer of 800 bytes (100 ms at 8000 Hz) into a wav
+audiodev and stops 40 ms after the buffer's PI the way Linux does:
+the next count and address to 0, the count and address to 0, then the
+CSR without PDMA_GO. The wav file must hold what the codec played in
+those 40 ms (320 frames, +-16) and nothing that the APC had taken past
+it. playback still checks that a stop at PMI plays every sample.
+
+migrate-fifo migrates 20 ms into such a buffer, with up to 50 ms taken
+ahead of the codec. The address and count must read the codec's
+position (about 160 bytes in) on both sides, PMI must come 75-90 ms
+after the migration, and the destination's wav audiodev must get the
+other 80 ms (620-660 frames). The qtest clock starts at 0 in each
+process, so the destination's is stepped to the source's first, as
+the virtual clock goes on under TCG and KVM.
+
+Tested: all ten cases of sun4m-cs4231-test pass. Without the previous
+commit mid-stop fails: assertion failed (sound <= (STOP_MS + 2) * 8):
+(720 <= 336), and migrate-fifo fails on the source's count.
+---
+ tests/qtest/sun4m-cs4231-test.c | 163 ++++++++++++++++++++++++++++++++
+ 1 file changed, 163 insertions(+)
+
+diff --git a/tests/qtest/sun4m-cs4231-test.c b/tests/qtest/sun4m-cs4231-test.c
+index 38f854a..94427b8 100644
+--- a/tests/qtest/sun4m-cs4231-test.c
++++ b/tests/qtest/sun4m-cs4231-test.c
+@@ -654,6 +654,167 @@ static void test_codec_int(void)
+     qtest_quit(qts);
+ }
+ 
++/* The frames of sound in a wav file, after any silence before them */
++static gsize wav_sound_frames(const char *path)
++{
++    g_autofree uint8_t *wav = NULL;
++    gsize len, frames, start, sound;
++
++    g_assert_true(g_file_get_contents(path, (gchar **)&wav, &len, NULL));
++    g_assert_cmpuint(len, >, 44);
++    frames = (len - 44) / 4;
++    for (start = 0; start < frames; start++) {
++        if (lduw_le_p(wav + 44 + 4 * start) != 0) {
++            break;
++        }
++    }
++    for (sound = 0; start + sound < frames; sound++) {
++        if (lduw_le_p(wav + 44 + 4 * (start + sound)) == 0) {
++            break;
++        }
++    }
++    return sound;
++}
++
++/*
++ * A stop in the middle of a buffer, as Linux stops when its last period
++ * has played: the driver zeroes the counts and turns the DMA off while
++ * the APC has taken up to 50 ms past the codec's position. What was
++ * taken past that point must not reach the audiodev: the wav file must
++ * end where the codec was at the stop. playback checks that a stop at
++ * PMI still plays everything that was taken.
++ */
++#define STOP_MS         40
++
++static void test_mid_stop(void)
++{
++    g_autofree char *wav = NULL;
++    uint8_t buf[BUF_LEN];
++    QTestState *qts;
++    gsize sound;
++    int fd;
++
++    fd = g_file_open_tmp("sun4m-cs4231-XXXXXX.wav", &wav, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    close(fd);
++    qts = qtest_initf("-machine SS-5,audiodev=snd0 "
++                      "-audiodev wav,id=snd0,path=%s,out.frequency=8000,"
++                      "out.channels=2,out.format=s16", wav);
++    qtest_writel(qts, IOPTE_TABLE, (BUF_RAM >> 4) | 0x2);
++    qtest_writel(qts, IOMMU_BASE + 4, IOPTE_TABLE >> 4);
++    qtest_writel(qts, IOMMU_BASE, 0x1);
++    memset(buf, ULAW_POS, sizeof(buf));
++    qtest_memwrite(qts, BUF_RAM, buf, sizeof(buf));
++
++    codec_write(qts, CS_PFMT, CS_PFMT_ULAW_8K);
++    qtest_writel(qts, APC_PNVA, BUF_DVMA);
++    qtest_writel(qts, APC_PNC, BUF_LEN);
++    qtest_writel(qts, APC_CSR, APC_PI | APC_PMI | APC_ENABLES);
++    codec_write(qts, CS_ICONF, CS_PEN);
++
++    /* The codec starts on the buffer with its PI */
++    wait_csr(qts, APC_PI, 100);
++    qtest_writel(qts, APC_CSR, APC_PI | APC_ENABLES);
++    qtest_clock_step(qts, STOP_MS * 1000 * 1000);
++    g_assert_false(qtest_readl(qts, APC_CSR) & APC_PMI);
++
++    /* Linux's stop: counts to 0, then the DMA off */
++    qtest_writel(qts, APC_PNC, 0);
++    qtest_writel(qts, APC_PNVA, 0);
++    qtest_writel(qts, APC_PC, 0);
++    qtest_writel(qts, APC_PVA, 0);
++    qtest_writel(qts, APC_CSR, APC_IE | APC_PIE | APC_PMIE);
++    qtest_clock_step(qts, 300 * 1000 * 1000);
++    qtest_quit(qts);
++
++    /* What the codec played in STOP_MS ms at 8000 Hz, and no more */
++    sound = wav_sound_frames(wav);
++    g_assert_cmpuint(sound, >=, (STOP_MS - 2) * 8);
++    g_assert_cmpuint(sound, <=, (STOP_MS + 2) * 8);
++    unlink(wav);
++}
++
++/*
++ * A migration while the APC has taken samples ahead of the codec: 20 ms
++ * into a 100 ms buffer it has taken up to 70 ms of it. On the other side
++ * the address and count must read as before (the codec's position), the
++ * codec must play the rest of the buffer, what was taken ahead included,
++ * and PMI must come when it has, 80 ms later.
++ */
++static void test_migrate_fifo(void)
++{
++    g_autofree char *path = NULL;
++    g_autofree char *uri = NULL;
++    g_autofree char *wav = NULL;
++    QTestState *src, *dst;
++    uint8_t buf[BUF_LEN];
++    uint32_t pva, pc;
++    int64_t t, now;
++    gsize sound;
++    int fd;
++
++    fd = g_file_open_tmp("sun4m-cs4231-XXXXXX.mig", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    close(fd);
++    uri = g_strdup_printf("file:%s", path);
++    fd = g_file_open_tmp("sun4m-cs4231-XXXXXX.wav", &wav, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    close(fd);
++
++    src = qtest_init("-machine SS-5,audiodev=snd0 "
++                     "-audiodev none,id=snd0");
++    qtest_writel(src, IOPTE_TABLE, (BUF_RAM >> 4) | 0x2);
++    qtest_writel(src, IOMMU_BASE + 4, IOPTE_TABLE >> 4);
++    qtest_writel(src, IOMMU_BASE, 0x1);
++    memset(buf, ULAW_POS, sizeof(buf));
++    qtest_memwrite(src, BUF_RAM, buf, sizeof(buf));
++    codec_write(src, CS_PFMT, CS_PFMT_ULAW_8K);
++    qtest_writel(src, APC_PNVA, BUF_DVMA);
++    qtest_writel(src, APC_PNC, BUF_LEN);
++    qtest_writel(src, APC_CSR, APC_PI | APC_PMI | APC_ENABLES);
++    codec_write(src, CS_ICONF, CS_PEN);
++    wait_csr(src, APC_PI, 100);
++    qtest_writel(src, APC_CSR, APC_PI | APC_ENABLES);
++    qtest_clock_step(src, 20 * 1000 * 1000);
++
++    /* The codec's position, about 160 bytes in, not the APC's */
++    now = qtest_clock_step(src, 1);
++    pva = qtest_readl(src, APC_PVA);
++    pc = qtest_readl(src, APC_PC);
++    g_assert_cmphex(pva + pc, ==, BUF_DVMA + BUF_LEN);
++    g_assert_cmpuint(pc, >=, BUF_LEN - 180);
++    g_assert_cmpuint(pc, <=, BUF_LEN - 150);
++    migrate_to_file(src, uri);
++    qtest_quit(src);
++
++    dst = qtest_initf("-machine SS-5,audiodev=snd0 "
++                      "-audiodev wav,id=snd0,path=%s,out.frequency=8000,"
++                      "out.channels=2,out.format=s16 -incoming %s", wav, uri);
++    wait_running(dst);
++    /*
++     * Under TCG and KVM the virtual clock goes on from the source's; the
++     * qtest clock starts at 0 in each process, so set it
++     */
++    qtest_clock_step(dst, now - qtest_clock_step(dst, 1));
++    g_assert_cmphex(qtest_readl(dst, APC_PVA), ==, pva);
++    g_assert_cmphex(qtest_readl(dst, APC_PC), ==, pc);
++
++    /* PMI when the codec has played the other 80 ms */
++    t = wait_csr(dst, APC_PMI, 200);
++    g_assert_cmpint(t, >=, 75);
++    g_assert_cmpint(t, <=, 90);
++    qtest_writel(dst, APC_CSR, APC_PMI | APC_ENABLES);
++    qtest_clock_step(dst, 300 * 1000 * 1000);
++    qtest_quit(dst);
++
++    /* All of those 80 ms reached the audiodev, 640 frames */
++    sound = wav_sound_frames(wav);
++    g_assert_cmpuint(sound, >=, 620);
++    g_assert_cmpuint(sound, <=, 660);
++    unlink(wav);
++    unlink(path);
++}
++
+ int main(int argc, char **argv)
+ {
+     g_test_init(&argc, &argv, NULL);
+@@ -666,6 +827,8 @@ int main(int argc, char **argv)
+     qtest_add_func("sun4m-cs4231/short-chain", test_short_chain);
+     qtest_add_func("sun4m-cs4231/migrate", test_migrate);
+     qtest_add_func("sun4m-cs4231/codec-int", test_codec_int);
++    qtest_add_func("sun4m-cs4231/mid-stop", test_mid_stop);
++    qtest_add_func("sun4m-cs4231/migrate-fifo", test_migrate_fifo);
+ 
+     return g_test_run();
+ }
diff --git a/debian/patches/wsh/0130-ui-dbus-read-GL-scanouts-back-for-VNC-next-to-displa.patch b/debian/patches/wsh/0130-ui-dbus-read-GL-scanouts-back-for-VNC-next-to-displa.patch
new file mode 100644
index 0000000..7100279
--- /dev/null
+++ b/debian/patches/wsh/0130-ui-dbus-read-GL-scanouts-back-for-VNC-next-to-displa.patch
@@ -0,0 +1,440 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] ui/dbus: read GL scanouts back for VNC next to -display
+ dbus,gl=on
+
+With gl=on the D-Bus display's GL context refused every listener but
+its own, so "-display dbus,gl=on -vnc ..." stopped at the start with
+"Display vnc is incompatible with the GL context". A VM whose display
+has to reach a D-Bus client as dmabufs (a streaming server on the
+host) then had no VNC console, where egl-headless keeps one: it reads
+each GL scanout back into the console's surface and tells the 2D
+listeners.
+
+The D-Bus display now does the same for the listeners without GL. The
+D-Bus console's own listener, which is registered on every console
+whether a client listens or not, keeps the GL scanout it is given (the
+texture, or the dmabuf, imported into QEMU's EGL context the first
+time it is read) and, on a console with GL, refreshes: at a refresh
+after a GL update, and only while the console has a listener without
+GL, it blits the scanout into a framebuffer of its size (flipped when
+the scanout's y0_top says so), reads it into the console's surface and
+calls qemu_console_update_2d(). That is new in ui/console.c: the
+dpy_gfx_update of the console's listeners without dpy_gl_update only,
+so the D-Bus clients don't get a second update for a frame they have
+as a dmabuf, and the surface isn't uploaded to its texture for
+nothing. qemu_console_has_2d_listener() says whether there is such a
+listener. The readback runs at most once per display refresh, not per
+frame as egl-headless does: a guest drawing a thousand frames a second
+costs VNC 33 reads a second (or what refresh-ms, next commit, sets).
+The surface must have the scanout's size and be x8r8g8b8, as the
+devices that scan out GL set it (virtio-gpu, qemu-3dfx); otherwise
+nothing is read. The cursor of a GL scanout isn't blended in.
+
+The EGL work saves and restores the current context, as a GL device's
+own context (virglrenderer's) may be current on the main loop.
+dpy_gl_release_dmabuf now releases the texture the import made.
+
+The readback is built only with CONFIG_OPENGL, and the dmabuf release
+with CONFIG_OPENGL and CONFIG_GBM both (meson finds GBM without
+OpenGL too): with --disable-opengl the D-Bus console is upstream's.
+
+Tested on Linux with the 3dfx binary's surfaceless EGL (llvmpipe and
+/dev/udmabuf): qemu-3dfx's Glide guest through dbus,gl=on with a VNC
+server next to it, the frame as VNC serves it and as the D-Bus client
+maps it; without GL, VNC and the D-Bus display show the VGA side by
+side as before.
+---
+ include/ui/console.h |   2 +
+ qemu-options.hx      |   5 +-
+ ui/console.c         |  38 +++++++++
+ ui/dbus-console.c    | 192 ++++++++++++++++++++++++++++++++++++++++++-
+ ui/dbus.c            |  11 ++-
+ ui/dbus.h            |   3 +
+ 6 files changed, 248 insertions(+), 3 deletions(-)
+
+diff --git a/include/ui/console.h b/include/ui/console.h
+index 3634956..1464830 100644
+--- a/include/ui/console.h
++++ b/include/ui/console.h
+@@ -287,6 +287,8 @@ int qemu_console_set_ui_info(QemuConsole *con, QemuUIInfo *info, bool delay);
+ 
+ void qemu_console_update(QemuConsole *con, int x, int y, int w, int h);
+ void qemu_console_update_full(QemuConsole *con);
++bool qemu_console_has_2d_listener(QemuConsole *con);
++void qemu_console_update_2d(QemuConsole *con, int x, int y, int w, int h);
+ void qemu_console_set_surface(QemuConsole *con,
+                               DisplaySurface *surface);
+ void qemu_console_text_set_cursor(QemuConsole *con, int x, int y);
+diff --git a/qemu-options.hx b/qemu-options.hx
+index 2d9fc48..192ed52 100644
+--- a/qemu-options.hx
++++ b/qemu-options.hx
+@@ -2314,7 +2314,10 @@ SRST
+         ``p2p=yes|no`` : Use peer-to-peer connection, accepted via QMP ``add_client``.
+ 
+         ``gl=on|off|core|es`` : Use OpenGL for rendering (the D-Bus interface
+-        will share framebuffers with DMABUF file descriptors).
++        will share framebuffers with DMABUF file descriptors). A display
++        without GL next to it, such as ``-vnc``, gets the GL scanouts read
++        back into the console's surface at each display refresh, as with
++        ``egl-headless``.
+ 
+     ``sdl``
+         Display video output via SDL (usually in a separate graphics
+diff --git a/ui/console.c b/ui/console.c
+index a8a2a24..5dc8792 100644
+--- a/ui/console.c
++++ b/ui/console.c
+@@ -760,6 +760,44 @@ void qemu_console_update_full(QemuConsole *con)
+     qemu_console_update(con, 0, 0, w, h);
+ }
+ 
++/*
++ * The listeners without GL (VNC) of a console whose display has GL: they show the console's
++ * surface, and see a GL scanout only if the display reads it back into that surface (the D-Bus
++ * display does, in ui/dbus-console.c).
++ */
++static bool dcl_is_2d(QemuConsole *con, DisplayChangeListener *dcl)
++{
++    return dcl->con == con && !dcl->ops->dpy_gl_update;
++}
++
++bool qemu_console_has_2d_listener(QemuConsole *con)
++{
++    DisplayChangeListener *dcl;
++
++    QLIST_FOREACH(dcl, &con->ds->listeners, next) {
++        if (dcl_is_2d(con, dcl)) {
++            return true;
++        }
++    }
++    return false;
++}
++
++/*
++ * qemu_console_update() for the listeners without GL only: the surface got a GL scanout read
++ * back for them. The GL listeners show the scanout itself, and the surface's texture isn't used
++ * while there is one.
++ */
++void qemu_console_update_2d(QemuConsole *con, int x, int y, int w, int h)
++{
++    DisplayChangeListener *dcl;
++
++    QLIST_FOREACH(dcl, &con->ds->listeners, next) {
++        if (dcl_is_2d(con, dcl) && dcl->ops->dpy_gfx_update) {
++            dcl->ops->dpy_gfx_update(dcl, x, y, w, h);
++        }
++    }
++}
++
+ void qemu_console_set_surface(QemuConsole *con,
+                              DisplaySurface *surface)
+ {
+diff --git a/ui/dbus-console.c b/ui/dbus-console.c
+index e1ac068..6d5d4b0 100644
+--- a/ui/dbus-console.c
++++ b/ui/dbus-console.c
+@@ -28,6 +28,9 @@
+ #include "ui/kbd-state.h"
+ #include "trace.h"
+ #include <stdint.h>
++#ifdef CONFIG_OPENGL
++#include "ui/egl-helpers.h"
++#endif
+ 
+ #ifdef G_OS_UNIX
+ #include <gio/gunixfdlist.h>
+@@ -55,6 +58,23 @@ struct _DBusDisplayConsole {
+     guint last_x;
+     guint last_y;
+     Notifier mouse_mode_notifier;
++
++#ifdef CONFIG_OPENGL
++    /*
++     * A GL scanout, read back into the console's surface for the listeners without GL (VNC
++     * next to -display dbus,gl=on), as egl-headless does for them: at the console's refresh,
++     * once per refresh at most, and only while there is such a listener.
++     */
++    DisplaySurface *ds;
++    QemuDmaBuf *scanout_dmabuf;
++    uint32_t scanout_tex;
++    uint32_t scanout_width;
++    uint32_t scanout_height;
++    bool scanout_y0_top;
++    bool scanout_dirty;
++    egl_fb scanout_fb;
++    egl_fb blit_fb;
++#endif
+ };
+ 
+ G_DEFINE_TYPE(DBusDisplayConsole,
+@@ -77,6 +97,9 @@ dbus_gfx_switch(DisplayChangeListener *dcl,
+ {
+     DBusDisplayConsole *ddc = container_of(dcl, DBusDisplayConsole, dcl);
+ 
++#ifdef CONFIG_OPENGL
++    ddc->ds = new_surface;
++#endif
+     dbus_display_console_set_size(ddc,
+                                   surface_width(new_surface),
+                                   surface_height(new_surface));
+@@ -88,9 +111,102 @@ dbus_gfx_update(DisplayChangeListener *dcl,
+ {
+ }
+ 
++#ifdef CONFIG_OPENGL
++/* The scanout's framebuffers live in QEMU's own EGL context; keep whichever one is current */
++static EGLContext
++dbus_console_gl_begin(void)
++{
++    EGLContext prev = eglGetCurrentContext();
++
++    if (prev != qemu_egl_rn_ctx) {
++        eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
++                       qemu_egl_rn_ctx);
++    }
++    return prev;
++}
++
++static void
++dbus_console_gl_end(EGLContext prev)
++{
++    if (prev != qemu_egl_rn_ctx) {
++        eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, prev);
++    }
++}
++
++static void
++dbus_console_scanout_reset(DBusDisplayConsole *ddc)
++{
++    if (ddc->scanout_fb.framebuffer || ddc->blit_fb.framebuffer) {
++        EGLContext prev = dbus_console_gl_begin();
++
++        egl_fb_destroy(&ddc->scanout_fb);
++        egl_fb_destroy(&ddc->blit_fb);
++        dbus_console_gl_end(prev);
++    }
++    ddc->scanout_dmabuf = NULL;
++    ddc->scanout_tex = 0;
++    ddc->scanout_dirty = false;
++}
++
++/* Main loop: the scanout into the console's surface, and its listeners without GL told */
++static void
++dbus_console_read_scanout(DBusDisplayConsole *ddc)
++{
++    DisplaySurface *ds = ddc->ds;
