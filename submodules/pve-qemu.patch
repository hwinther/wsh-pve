+ hw/sparc64/sun4u.c       |  6 ++++++
+ hw/sparc64/sun4u_iommu.c | 18 ++++++++++++++++
+ target/sparc/machine.c   | 45 ++++++++++++++++++++++++++++++++++++++++
+ 4 files changed, 97 insertions(+)
