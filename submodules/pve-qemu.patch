diff --git a/debian/patches/wsh/0110-target-sparc-halt-the-CPU-in-Linux-3.2-s-idle-loop-o.patch b/debian/patches/wsh/0110-target-sparc-halt-the-CPU-in-Linux-3.2-s-idle-loop-o.patch
