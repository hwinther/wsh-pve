++/*
++ * On the SS-600MP a CPU store to the SBus that the SBus answers with an error
++ * acknowledge comes back as an M-to-S write error in the IOMMU's AFSR and
++ * AFAR, with an interrupt; the CPU reports nothing itself.
++ */
++static bool sun4m_cpu_store_error(void *opaque, hwaddr addr, unsigned size,
++                                  unsigned mid, bool supervisor)
++{
++    if ((addr >> 32) != 0xe) {
++        return false;
++    }
++    sun4m_iommu_cpu_write_error(opaque, addr, size, mid, supervisor);
++    return true;
++}
++
+ static DeviceState *cpu_devinit(const char *cpu_type, unsigned int id,
