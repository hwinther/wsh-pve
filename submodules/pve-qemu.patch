diff --git a/debian/patches/wsh/0161-tests-qtest-test-SS-600MP-bus-errors-with-the-MMU-of.patch b/debian/patches/wsh/0161-tests-qtest-test-SS-600MP-bus-errors-with-the-MMU-of.patch
