+@@ -2,16 +2,22 @@
+  * QTest: halting the CPU in the idle loop of a guest kernel on sun4u
+  *
+  * A boot PROM runs a loop laid out as the idle loop of NetBSD, OpenBSD,
+- * Solaris 10 or Tribblix (illumos built with gcc) on sun4u, and counts
+- * its rounds in RAM in the function the loop calls. With the word that
+- * says there is work at 0, interrupts enabled at level 0 and none
+- * pending, QEMU halts the CPU at that call; with no interrupt to come,
+- * the count stops. It must keep going with idle-halt=off, with work,
+- * with interrupts disabled and at interrupt level 15. With a tick
++ * Solaris 10, Tribblix (illumos built with gcc) or Solaris 7 and 8 on sun4u,
++ * and counts its rounds in RAM in the function the loop calls. With the
++ * word that says there is work at 0, interrupts enabled at level 0 and
++ * none pending, QEMU halts the CPU at that call; with no interrupt to
++ * come, the count stops. It must keep going with idle-halt=off, with
++ * work, with interrupts disabled and at interrupt level 15. With a tick
+  * interrupt every millisecond, each tick must wake the CPU, its handler
+  * must run and the loop must go on after it, with far fewer rounds than
+  * with idle-halt=off.
+  *
++ * Linux's arch_cpu_idle() (as Linux 7.3, 6.1 and 7.0 lay it out) is
++ * called with interrupts disabled at level 14: the CPU must halt there,
++ * not with need_resched() set, interrupts enabled or at level 15, and
++ * the tick must wake it at level 14 and be taken when the loop enables
++ * interrupts.
++ *
+  * SPDX-License-Identifier: GPL-2.0-or-later
+  */
+ 
+@@ -32,6 +38,9 @@
+ #define RAM_NRUNNABLE   0x824ULL        /* disp_t at RAM_WORD, + 0x24 */
+ #define RAM_CPU         0x840ULL        /* cpu_disp at + 0 */
+ #define RAM_IDLE_CPU    0x848ULL
++#define RAM_TI          0x860ULL        /* Linux's thread_info: %g6 */
++#define RAM_TI_FLAGS    0x868ULL        /* its flags, TIF_NEED_RESCHED 8 */
++#define RAM_TLB_TYPE    0x870ULL        /* Linux's tlb_type: 1, spitfire */
+ 
+ /* PROM: reset at + 0x20, code at + 0x400, trap table at + 0x8000 */
+ #define PROM_BASE_HI    0x1fff0000      /* << 12 = 0x1fff0000000 */
+@@ -44,7 +53,9 @@
+ 
+ #define NOP             0x01000000
+ 
+-enum { NETBSD, OPENBSD, SOLARIS, TRIBBLIX };
++enum { NETBSD, OPENBSD, SOLARIS, TRIBBLIX, SOLARIS7, LINUX73, LINUX61, LINUX70 };
++
++#define IS_LINUX(k)     ((k) >= LINUX73)
+ 
+ static uint32_t call_to(int from, int to)
+ {
+@@ -64,6 +75,18 @@ static uint32_t bpcc_xcc_to(int cond, int from, int to)
+            ((to - from) & 0x7ffff);
