++#define IOC_TAGS        0xfdf000000ULL  /* a tag per 32-byte line */
++#define IOC_DATA        0xfdf008000ULL
++#define IOC_TAG_MASK    0xfff00000
+ #define LEBUFFER        0xef0040000ULL
+ #define LEBUFFER_SIZE   0x20000
+ #define LE_RDP          0xef0060000ULL
+@@ -124,6 +129,39 @@ static void test_vme_regs(void)
