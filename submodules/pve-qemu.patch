+     DEFINE_PROP_UINT32("rap-mask", SysBusPCNetState, rap_mask, 0x7f),
++    /*
++     * Receive as the Am7990: take a receive descriptor whatever the
++     * reserved bits of its message count word hold, and a loopback frame
++     * at the length it was sent. Off by default: with it the SS-5 and
++     * SS-20 boot PROMs' loopback test passes and their default boot with
++     * a blank NVRAM waits for a RARP reply instead of reaching "ok".
++     */
++    DEFINE_PROP_BOOL("am7990", SysBusPCNetState, state.am7990, false),
+ };
+ 
+ static void lance_class_init(ObjectClass *klass, const void *data)
+diff --git a/hw/net/pcnet.c b/hw/net/pcnet.c
+index 0bd7d43..c10c1fe 100644
+--- a/hw/net/pcnet.c
++++ b/hw/net/pcnet.c
+@@ -443,7 +443,7 @@ static inline void pcnet_rmd_store(PCNetState *s, struct pcnet_RMD *rmd,
+     struct pcnet_RMD rmd;                       \
