++    if (qtest_has_accel("tcg")) {
++        qtest_add_func("/sun4u/reset/tb-flush", test_reset_tb_flush);
++    }
+     return g_test_run();
+ }
diff --git a/debian/patches/wsh/0114-target-sparc-halt-the-CPU-in-FreeBSD-s-idle-loop-on-.patch b/debian/patches/wsh/0114-target-sparc-halt-the-CPU-in-FreeBSD-s-idle-loop-on-.patch
