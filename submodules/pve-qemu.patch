+         if (slavio_timer_is_user(tc)) {
+             // read user timer MSW
+             slavio_timer_get_out(t);
++            if (s->read_ahead) {
++                slavio_timer_read_count(t, t->run, true);
++                t->msw_read = true;
++            }
+             ret = t->counthigh | t->reached;
+         } else {
+             // read limit
+@@ -187,8 +260,16 @@ static uint64_t slavio_timer_mem_readl(void *opaque, hwaddr addr,
+         // of counter (user mode)
+         slavio_timer_get_out(t);
+         if (slavio_timer_is_user(tc)) { // read user timer LSW
++            if (s->read_ahead) {
++                slavio_timer_read_count(t, t->run, !t->msw_read);
++                t->msw_read = false;
++            }
+             ret = t->count & TIMER_MAX_COUNT64;
+         } else { // read limit
++            if (s->read_ahead) {
++                /* the counter mode counters always run */
++                slavio_timer_read_count(t, true, true);
++            }
+             ret = (t->count & TIMER_MAX_COUNT32) |
+                 t->reached;
+         }
+@@ -229,6 +310,7 @@ static void slavio_timer_mem_writel(void *opaque, hwaddr addr,
+     saddr = addr >> 2;
+     switch (saddr) {
+     case TIMER_LIMIT:
++        slavio_timer_read_reset(t);
+         ptimer_transaction_begin(t->timer);
+         if (slavio_timer_is_user(tc)) {
+             uint64_t count;
+@@ -258,6 +340,7 @@ static void slavio_timer_mem_writel(void *opaque, hwaddr addr,
+             uint64_t count;
+ 
+             // set user counter LSW, reset counter
++            slavio_timer_read_reset(t);
+             t->limit = TIMER_MAX_COUNT64;
+             t->count = val & TIMER_MAX_COUNT64;
+             t->reached = 0;
+@@ -308,6 +391,7 @@ static void slavio_timer_mem_writel(void *opaque, hwaddr addr,
+                 ptimer_transaction_begin(curr_timer->timer);
+                 // check for a change in timer mode for this processor
+                 if ((val & processor) != (s->cputimer_mode & processor)) {
++                    slavio_timer_read_reset(curr_timer);
+                     if (val & processor) { // counter -> user timer
+                         qemu_irq_lower(curr_timer->irq);
+                         // counters are always running
+@@ -401,6 +485,7 @@ static void slavio_timer_reset(DeviceState *d)
+         curr_timer->limit = 0;
+         curr_timer->count = 0;
+         curr_timer->reached = 0;
++        slavio_timer_read_reset(curr_timer);
+         if (i <= s->num_cpus) {
+             ptimer_transaction_begin(curr_timer->timer);
+             ptimer_set_limit(curr_timer->timer,
+@@ -455,6 +540,7 @@ static void slavio_timer_finalize(Object *obj)
+ 
+ static const Property slavio_timer_properties[] = {
+     DEFINE_PROP_UINT32("num_cpus",  SLAVIO_TIMERState, num_cpus,  0),
++    DEFINE_PROP_BOOL("read-ahead", SLAVIO_TIMERState, read_ahead, false),
+ };
+ 
+ static void slavio_timer_class_init(ObjectClass *klass, const void *data)
+diff --git a/hw/timer/trace-events b/hw/timer/trace-events
+index 634ba1d..b0aa717 100644
+--- a/hw/timer/trace-events
++++ b/hw/timer/trace-events
+@@ -3,6 +3,7 @@
+ # slavio_timer.c
+ slavio_timer_get_out(uint64_t limit, uint32_t counthigh, uint32_t count) "limit 0x%"PRIx64" count 0x%x0x%08x"
+ slavio_timer_irq(uint32_t counthigh, uint32_t count) "callback: count 0x%x0x%08x"
++slavio_timer_read_ahead(uint64_t count, uint64_t read) "count 0x%016"PRIx64" read as 0x%016"PRIx64
+ slavio_timer_mem_readl_invalid(uint64_t addr) "invalid read address 0x%"PRIx64
