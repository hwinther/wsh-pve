++        n += write_linux_sun4v(a + n, at + n, true);
++        break;
++    case LINUX61:
++        /*
++         * be,pn sun4v; nop; call arch_touch_nmi_watchdog; nop;
++         * call touch_softlockup_watchdog; nop; enable interrupts; return
++         */
++        t = n;
++        n += 2;
++        a[n] = call_to(at + n, FUNC); n++;
++        a[n++] = NOP;
++        a[n] = call_to(at + n, FUNC + 3); n++;
++        a[n++] = NOP;
++        a[n++] = 0x91902000;            /* wrpr %g0, 0, %pil */
++        a[n++] = 0x81cfe008;            /* return %i7 + 8 */
++        a[n++] = NOP;
++        a[t] = bpcc_icc_to(BE, at + t, at + n);
++        a[t + 1] = NOP;
