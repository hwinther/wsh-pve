diff --git a/debian/patches/wsh/0065-tests-qtest-test-the-SPARCserver-600MP-s-VMEbus-regi.patch b/debian/patches/wsh/0065-tests-qtest-test-the-SPARCserver-600MP-s-VMEbus-regi.patch
new file mode 100644
index 0000000..e6741d1
--- /dev/null
+++ b/debian/patches/wsh/0065-tests-qtest-test-the-SPARCserver-600MP-s-VMEbus-regi.patch
@@ -0,0 +1,212 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the SPARCserver 600MP's VMEbus registers
+ and lebuffer
+
+qtest sun4m-ss600mp-test for the two patches before: on -M SS-600MP the
+VMEbus interface registers are an unimplemented device at the low
+priority that reads 0; the lebuffer is 128 KB of RAM at 0xe.f004_0000,
+in the lance's own address space; the lance initializes from an init
+block in the buffer (its station address comes from there), sends a
+frame from a descriptor there, gives the descriptor back in the buffer
+and raises its interrupt without the ledma's interrupt enable. The
+SS-10 has neither and keeps its ledma.
+---
+ tests/qtest/meson.build          |   3 +-
+ tests/qtest/sun4m-ss600mp-test.c | 174 +++++++++++++++++++++++++++++++
+ 2 files changed, 176 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-ss600mp-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 054b26b..ea13663 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -213,7 +213,8 @@
+                 'sun4m-fp-deferred-trap-test',
+                 'sun4m-onboard-sbus-test',
+                 'sun4m-nvram-test',
+-                'sun4m-ledma-test'] + \
++                'sun4m-ledma-test',
++                'sun4m-ss600mp-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-ss600mp-test.c b/tests/qtest/sun4m-ss600mp-test.c
+new file mode 100644
+index 0000000..d68cc8d
+--- /dev/null
++++ b/tests/qtest/sun4m-ss600mp-test.c
+@@ -0,0 +1,174 @@
++/*
++ * QTest: the SPARCserver 600MP's VMEbus interface registers and lebuffer
++ *
++ * SunOS 4.1.2's kernel sets up the 600MP's VMEbus interface at physical
++ * 0xf.df01_0000 (control, AFSR, AFAR) through the MMU bypass ASI before
++ * its banner; the machine has them as an unimplemented device (reads 0,
++ * writes ignored).
++ *
++ * The 600MP's lance works in a 128 KB buffer memory of its own below its
++ * registers (the "lebuffer" node, SBus slot f offset 0x40000), not through
++ * a DMA engine: its 24-bit addresses are offsets in that buffer, and it
++ * interrupts by itself. The test initializes the lance from an init
++ * block in the buffer, lets it send a frame from a descriptor there and
++ * checks that it hands the descriptor back and raises its interrupt.
++ * The SS-10 has neither.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++#define VME_REGS        0xfdf010000ULL
++#define LEBUFFER        0xef0040000ULL
++#define LEBUFFER_SIZE   0x20000
++#define LE_RDP          0xef0060000ULL
++#define LE_RAP          0xef0060002ULL
++/* the system interrupt pending register of the slavio interrupt controller */
++#define INTCTL_PENDING  0xff1410000ULL
++#define IRQ_LE          (1u << 16)
++
++#define CSR0_INIT       0x0001
++#define CSR0_STRT       0x0002
++#define CSR0_TDMD       0x0008
++#define CSR0_INEA       0x0040
++#define CSR0_IDON       0x0100
++#define CSR0_TINT       0x0200
++
++#define TMD1_OWN        0x8000
++#define TMD1_STP        0x0200
++#define TMD1_ENP        0x0100
++
++/* "info mtree" has a line "<range> (<prio>, <kind>): <name>" */
++static bool has_region(const char *mtree, const char *line)
++{
++    g_auto(GStrv) lines = g_strsplit(mtree, "\n", -1);
++    int i;
++
++    for (i = 0; lines[i]; i++) {
++        if (!strcmp(g_strstrip(lines[i]), line)) {
++            return true;
++        }
++    }
++    return false;
++}
++
++static void csr_write(QTestState *qts, int csr, uint16_t val)
++{
++    qtest_writew(qts, LE_RAP, csr);
++    qtest_writew(qts, LE_RDP, val);
++}
++
++static uint16_t csr_read(QTestState *qts, int csr)
++{
++    qtest_writew(qts, LE_RAP, csr);
++    return qtest_readw(qts, LE_RDP);
++}
++
++static void test_vme_regs(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++    g_autofree char *mtree = qtest_hmp(qts, "info mtree");
++
++    g_assert_true(has_region(mtree, "0000000fdf010000-0000000fdf010fff "
++                             "(prio -1000, i/o): sun-vme"));
++    qtest_writel(qts, VME_REGS, 0x40000000);
++    g_assert_cmphex(qtest_readl(qts, VME_REGS), ==, 0);
++    g_assert_cmphex(qtest_readl(qts, VME_REGS + 4), ==, 0);
++    g_assert_cmphex(qtest_readl(qts, VME_REGS + 8), ==, 0);
++    qtest_quit(qts);
++}
++
++static void test_lebuffer_memory(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++    g_autofree char *mtree = qtest_hmp(qts, "info mtree");
++
++    /* the lance's own address space, and the CPU's view of it in slot f */
++    g_assert_true(has_region(mtree, "address-space: lebuffer"));
++    g_assert_true(has_region(mtree, "0000000ef0040000-0000000ef005ffff "
++                             "(prio 0, ram): alias lebuffer-alias @lebuffer "
++                             "0000000000000000-000000000001ffff"));
++    qtest_writel(qts, LEBUFFER, 0x12345678);
++    qtest_writel(qts, LEBUFFER + LEBUFFER_SIZE - 4, 0x9abcdef0);
++    g_assert_cmphex(qtest_readl(qts, LEBUFFER), ==, 0x12345678);
++    g_assert_cmphex(qtest_readl(qts, LEBUFFER + LEBUFFER_SIZE - 4), ==,
++                    0x9abcdef0);
++    qtest_quit(qts);
++}
++
++static void test_lance_in_lebuffer(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++    int i;
++
++    /* the init block at 0x100: mode, padr, ladrf, rdra/rlen, tdra/tlen */
++    qtest_writew(qts, LEBUFFER + 0x100, 0x0000);
++    qtest_writew(qts, LEBUFFER + 0x102, 0x5254);
++    qtest_writew(qts, LEBUFFER + 0x104, 0x0012);
++    qtest_writew(qts, LEBUFFER + 0x106, 0x3456);
++    for (i = 0; i < 4; i++) {
++        qtest_writew(qts, LEBUFFER + 0x108 + 2 * i, 0);
++    }
++    qtest_writew(qts, LEBUFFER + 0x110, 0x0300);   /* one receive descriptor */
++    qtest_writew(qts, LEBUFFER + 0x112, 0x0000);
++    qtest_writew(qts, LEBUFFER + 0x114, 0x0200);   /* one transmit descriptor */
++    qtest_writew(qts, LEBUFFER + 0x116, 0x0000);
++
++    /* the transmit descriptor: a 64-byte frame at 0x400 */
++    qtest_writew(qts, LEBUFFER + 0x200, 0x0400);
++    qtest_writew(qts, LEBUFFER + 0x202, TMD1_OWN | TMD1_STP | TMD1_ENP);
++    qtest_writew(qts, LEBUFFER + 0x204, 0xf000 | (-64 & 0x0fff));
++    qtest_writew(qts, LEBUFFER + 0x206, 0);
++    for (i = 0; i < 64; i += 4) {
++        qtest_writel(qts, LEBUFFER + 0x400 + i, 0xffffffff);
++    }
++
++    csr_write(qts, 0, 0x0004);                     /* stop */
++    csr_write(qts, 1, 0x0100);                     /* the init block's address */
++    csr_write(qts, 2, 0x0000);
++    csr_write(qts, 0, CSR0_INIT);
++    g_assert_cmphex(csr_read(qts, 0) & CSR0_IDON, ==, CSR0_IDON);
++    /* the station address came from the buffer */
++    g_assert_cmphex(csr_read(qts, 12), ==, 0x5254);
++    g_assert_cmphex(csr_read(qts, 13), ==, 0x0012);
++    g_assert_cmphex(csr_read(qts, 14), ==, 0x3456);
++
++    /* clear IDON, start, send */
++    csr_write(qts, 0, CSR0_IDON);
++    g_assert_cmphex(qtest_readl(qts, INTCTL_PENDING) & IRQ_LE, ==, 0);
++    csr_write(qts, 0, CSR0_INEA | CSR0_STRT | CSR0_TDMD);
++    for (i = 0; i < 100 && (qtest_readw(qts, LEBUFFER + 0x202) & TMD1_OWN); i++) {
++        qtest_clock_step(qts, 1000000);
++    }
++    /* the lance gave the descriptor back, in the buffer, and interrupts */
++    g_assert_cmphex(qtest_readw(qts, LEBUFFER + 0x202) & TMD1_OWN, ==, 0);
++    g_assert_cmphex(csr_read(qts, 0) & CSR0_TINT, ==, CSR0_TINT);
++    g_assert_cmphex(qtest_readl(qts, INTCTL_PENDING) & IRQ_LE, ==, IRQ_LE);
++    qtest_quit(qts);
++}
++
++static void test_ss10_unchanged(void)
++{
++    QTestState *qts = qtest_init("-machine SS-10 -m 64");
++    g_autofree char *mtree = qtest_hmp(qts, "info mtree");
++
++    g_assert_null(strstr(mtree, "sun-vme"));
++    g_assert_null(strstr(mtree, "lebuffer"));
++    /* the ledma is still there, below the espdma */
++    g_assert_nonnull(strstr(mtree, "ledma-mmio"));
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4m-ss600mp/vme-regs", test_vme_regs);
++    qtest_add_func("sun4m-ss600mp/lebuffer-memory", test_lebuffer_memory);
++    qtest_add_func("sun4m-ss600mp/lance-in-lebuffer", test_lance_in_lebuffer);
++    qtest_add_func("sun4m-ss600mp/ss10-unchanged", test_ss10_unchanged);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0066-hw-sparc-sun4m-give-the-DBRI-registers-that-take-its.patch b/debian/patches/wsh/0066-hw-sparc-sun4m-give-the-DBRI-registers-that-take-its.patch
new file mode 100644
index 0000000..16c9626
--- /dev/null
+++ b/debian/patches/wsh/0066-hw-sparc-sun4m-give-the-DBRI-registers-that-take-its.patch
@@ -0,0 +1,341 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: give the DBRI registers that take its command
+ queue
+
+The DBRI's registers (slot offset 0x10000 on the SS-20 and the LX) were
+an unimplemented device that reads 0. Under the SS-20's Sun PROM a
+reconfiguration boot of Solaris 2.6 ("boot -r") then panicked in its
+dbri driver:
+
+  WARNING: dbri: DBRI Reg8 bad!
+  BAD TRAP: type=9 rp=... addr=0 mmu_fsr=126 rw=1
+  BAD TRAP occurred in module "dbri" due to an illegal access to a user
+  address.
+  panic: Data fault
+
+The driver attaches, then runs its audio start-up from a timeout. Its
+first command reads back REG8, the command queue pointer, to see how
+far the chip has got; 0 is outside the queue, so it calls its chip
+error routine, which resets the chip and walks all 14 of its pipes. The
+SS-20 PROM gives the node "isdn-disabled" (the LX PROM doesn't), and
+with that the driver never sets up the 12 ISDN pipes: the routine
+dereferenced the first one's null pointer. On the LX the same routine
+runs with all pipes set up and the system carries on. Ordinary boots
+don't load dbri, so only reconfiguration boots showed it.
+
+Give the registers a small model instead: they keep what is written,
+REG0's soft reset bit clears them, and writing REG8 or setting REG0's P
+bit makes the chip walk the command queue through the IOMMU, command by
+command by its length, following JUMP, until it stops on a WAIT with
+REG8 on it, as the driver expects. No data moves, no interrupt is
+raised, and the PIO pins in REG2 read low, so the drivers find no
+codec: Solaris 2.6 now attaches dbri without a warning under both PROMs
+and goes without sound, SunOS 4.1.4 on the LX says only "Audio: no
+Audio device found" (before also "dbri: DBRI Reg8 bad!"), and NetBSD
+9.3 on the LX still reports "chip never acked WAIT" and "no codec
+detected, aborting".
+---
+ hw/sparc/meson.build  |   1 +
+ hw/sparc/sun4m.c      |  13 ++-
+ hw/sparc/sun4m_dbri.c | 239 ++++++++++++++++++++++++++++++++++++++++++
+ hw/sparc/trace-events |   6 ++
+ 4 files changed, 256 insertions(+), 3 deletions(-)
+ create mode 100644 hw/sparc/sun4m_dbri.c
+
+diff --git a/hw/sparc/meson.build b/hw/sparc/meson.build
+index 19c442c..fbe3e99 100644
+--- a/hw/sparc/meson.build
++++ b/hw/sparc/meson.build
+@@ -2,5 +2,6 @@ sparc_ss = ss.source_set()
+ sparc_ss.add(when: 'CONFIG_LEON3', if_true: files('leon3.c'))
+ sparc_ss.add(when: 'CONFIG_SUN4M', if_true: files('sun4m.c'))
+ sparc_ss.add(when: 'CONFIG_SUN4M', if_true: files('sun4m_iommu.c'))
++sparc_ss.add(when: 'CONFIG_SUN4M', if_true: files('sun4m_dbri.c'))
+ 
+ hw_arch += {'sparc': sparc_ss}
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 0b619b1..30277f3 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -1220,9 +1220,16 @@ static void sun4m_hw_init(MachineState *machine)
+         memory_region_add_subregion_overlap(get_system_memory(),
+                                             hwdef->dbri_base + 0x1000,
+                                             dbri_prom, -1000);
+-        /* reg space */
+-        create_unimplemented_device("sun-DBRI",
+-                                    hwdef->dbri_base + 0x10000, 0x100);
++        /*
++         * Its registers, which take the command queue and nothing more:
++         * the drivers find no codec (sun4m_dbri.c).
++         */
++        dev = qdev_new("sun-DBRI");
++        object_property_set_link(OBJECT(dev), "iommu", OBJECT(iommu),
++                                 &error_abort);
++        s = SYS_BUS_DEVICE(dev);
++        sysbus_realize_and_unref(s, &error_fatal);
++        sysbus_mmio_map_overlap(s, 0, hwdef->dbri_base + 0x10000, -1000);
+     }
+ 
+     if (hwdef->cg6_base) {
+diff --git a/hw/sparc/sun4m_dbri.c b/hw/sparc/sun4m_dbri.c
+new file mode 100644
+index 0000000..ce25e2c
+--- /dev/null
++++ b/hw/sparc/sun4m_dbri.c
+@@ -0,0 +1,239 @@
++/*
++ * The DBRI's registers on the sun4m machines QEMU gives one (SS-20 and
++ * SPARCstation LX), without its serial pipes or a codec behind them.
++ *
++ * The DBRI (an ISDN and audio controller with a CS4215 codec on the board)
++ * is an SBus master that fetches its commands from a queue in memory: the
++ * driver writes the queue's DVMA address to REG8, and the chip works
++ * through it until a WAIT command, where it stops with REG8 on the WAIT.
++ * To add commands the driver writes them over the WAIT, ends them with a
++ * new WAIT and sets REG0's P bit, and the chip goes on from REG8.
++ *
++ * This model does that much and nothing else: it walks the queue through
++ * the IOMMU, steps over each command by its length, follows JUMP and stops
++ * at WAIT. It moves no data and raises no interrupts, and the PIO pins in
++ * REG2, through which drivers look for a codec, read low. Drivers see a
++ * chip that takes their commands and find no codec.
++ *
++ * Before, the registers read 0. Solaris 2.6's driver then found REG8
++ * "bad" at its first command and reset the chip in a routine that walks
++ * all its pipes, the ISDN ones too; under the SS-20 PROM, which gives the
++ * node "isdn-disabled", those pipes were never set up and the routine
++ * dereferenced a null pointer (BAD TRAP in module dbri, panic).
++ *
++ * Copyright (c) 2026 Hans Christian Winther-Sorensen
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "hw/core/sysbus.h"
++#include "hw/core/qdev-properties.h"
++#include "hw/sparc/sun4m_iommu.h"
++#include "migration/vmstate.h"
++#include "qapi/error.h"
++#include "qemu/module.h"
++#include "system/dma.h"
++#include "trace.h"
++#include "qom/object.h"
++
++#define TYPE_SUN4M_DBRI "sun-DBRI"
++OBJECT_DECLARE_SIMPLE_TYPE(DBRIState, SUN4M_DBRI)
++
++#define DBRI_REG_SIZE   0x100
++#define DBRI_NREGS      (DBRI_REG_SIZE / 4)
++
++#define DBRI_REG0       0       /* status and control */
++#define DBRI_REG2       2       /* parallel I/O pins */
++#define DBRI_REG8       8       /* command queue pointer */
++
++#define DBRI_R0_RESET   (1u << 0)   /* soft reset, clears itself */
++#define DBRI_R0_PROGRAM (1u << 15)  /* (re)start at REG8, clears itself */
++
++#define DBRI_R2_PIO     0xfu        /* pin levels; the enables above them */
++
++/* opcodes in bits 31-28 of a command's first word */
++#define DBRI_CMD_WAIT   0x0
++#define DBRI_CMD_JUMP   0x2
++
++/* a queue that never reaches a WAIT is given up after this many commands */
++#define DBRI_MAX_CMDS   1024
++
++struct DBRIState {
++    SysBusDevice parent_obj;
++
++    MemoryRegion iomem;
++    IOMMUState *iommu;
++    uint32_t regs[DBRI_NREGS];
++};
++
++/* words per command, by opcode (the DBRI data sheet's command list) */
++static const uint8_t dbri_cmd_words[16] = {
++    [0x0] = 1,  /* WAIT */
++    [0x1] = 1,  /* PAUSE */
++    [0x2] = 2,  /* JUMP, address */
++    [0x3] = 2,  /* IIQ, interrupt queue address */
++    [0x4] = 1,  /* REX */
++    [0x5] = 2,  /* SDP, buffer address */
++    [0x6] = 1,  /* CDP */
++    [0x7] = 3,  /* DTS, input and output time slot */
++    [0x8] = 2,  /* SSP, data */
++    [0x9] = 1,  /* CHI */
++    [0xa] = 1,  /* NT */
++    [0xb] = 1,  /* TE */
++    [0xc] = 1,  /* CDEC */
++    [0xd] = 2,  /* TEST, data */
++    [0xe] = 1,  /* CDM */
++    [0xf] = 1,  /* reserved */
++};
++
++static AddressSpace *dbri_dma_as(DBRIState *s)
++{
++    return s->iommu ? &s->iommu->iommu_as : &address_space_memory;
++}
++
++/* Work through the command queue from REG8 up to a WAIT. */
++static void dbri_run_queue(DBRIState *s)
++{
++    uint32_t addr = s->regs[DBRI_REG8];
++    unsigned n;
++
++    for (n = 0; n < DBRI_MAX_CMDS; n++) {
++        uint32_t cmd[3];
++        unsigned op, words;
++
++        if (dma_memory_read(dbri_dma_as(s), addr, cmd, 4,
++                            MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
++            trace_sun4m_dbri_dma_error(addr);
++            break;
++        }
++        cmd[0] = be32_to_cpu(cmd[0]);
++        op = cmd[0] >> 28;
++        words = dbri_cmd_words[op];
++        trace_sun4m_dbri_command(addr, cmd[0]);
++        if (op == DBRI_CMD_WAIT) {
++            /* REG8 stays on the WAIT, which the driver overwrites */
++            s->regs[DBRI_REG8] = addr;
++            return;
++        }
++        if (op == DBRI_CMD_JUMP) {
++            if (dma_memory_read(dbri_dma_as(s), addr + 4, &cmd[1], 4,
++                                MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
++                trace_sun4m_dbri_dma_error(addr + 4);
++                break;
++            }
++            addr = be32_to_cpu(cmd[1]);
++            continue;
++        }
++        addr += words * 4;
++    }
++    /* no WAIT (or a DMA error): stop where it got to */
++    s->regs[DBRI_REG8] = addr;
++}
++
++static void dbri_reset_regs(DBRIState *s)
++{
++    memset(s->regs, 0, sizeof(s->regs));
++}
++
++static uint64_t dbri_read(void *opaque, hwaddr addr, unsigned size)
++{
++    DBRIState *s = opaque;
++    uint32_t val = s->regs[addr >> 2];
++
++    if ((addr >> 2) == DBRI_REG2) {
++        /* nothing on the pins: they read low */
++        val &= ~DBRI_R2_PIO;
++    }
++
++    trace_sun4m_dbri_read(addr, val);
++    return val;
++}
++
++static void dbri_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
++{
++    DBRIState *s = opaque;
++    unsigned reg = addr >> 2;
++
++    trace_sun4m_dbri_write(addr, val);
++    switch (reg) {
++    case DBRI_REG0:
++        if (val & DBRI_R0_RESET) {
++            dbri_reset_regs(s);
++            return;
++        }
++        s->regs[reg] = val & ~DBRI_R0_PROGRAM;
++        if (val & DBRI_R0_PROGRAM) {
++            dbri_run_queue(s);
++        }
++        break;
++    case DBRI_REG8:
++        s->regs[reg] = val;
++        dbri_run_queue(s);
++        break;
++    default:
++        s->regs[reg] = val;
++        break;
++    }
++}
++
++static const MemoryRegionOps dbri_ops = {
++    .read = dbri_read,
++    .write = dbri_write,
++    .endianness = DEVICE_BIG_ENDIAN,
++    .valid = {
++        .min_access_size = 4,
++        .max_access_size = 4,
++    },
++};
++
++static void dbri_reset(DeviceState *dev)
++{
++    dbri_reset_regs(SUN4M_DBRI(dev));
++}
++
++static void dbri_init(Object *obj)
++{
++    DBRIState *s = SUN4M_DBRI(obj);
++
++    memory_region_init_io(&s->iomem, obj, &dbri_ops, s, "sun-DBRI",
++                          DBRI_REG_SIZE);
++    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
++    object_property_add_link(obj, "iommu", TYPE_SUN4M_IOMMU,
++                             (Object **)&s->iommu,
++                             qdev_prop_allow_set_link_before_realize, 0);
++}
++
++static const VMStateDescription vmstate_dbri = {
++    .name = "sun-DBRI",
++    .version_id = 1,
++    .minimum_version_id = 1,
++    .fields = (const VMStateField[]) {
++        VMSTATE_UINT32_ARRAY(regs, DBRIState, DBRI_NREGS),
++        VMSTATE_END_OF_LIST()
++    }
++};
++
++static void dbri_class_init(ObjectClass *klass, const void *data)
++{
++    DeviceClass *dc = DEVICE_CLASS(klass);
++
++    device_class_set_legacy_reset(dc, dbri_reset);
++    dc->vmsd = &vmstate_dbri;
++    dc->user_creatable = false;
++}
++
++static const TypeInfo dbri_info = {
++    .name          = TYPE_SUN4M_DBRI,
++    .parent        = TYPE_SYS_BUS_DEVICE,
++    .instance_size = sizeof(DBRIState),
++    .instance_init = dbri_init,
++    .class_init    = dbri_class_init,
++};
++
++static void dbri_register_types(void)
++{
++    type_register_static(&dbri_info);
++}
++
++type_init(dbri_register_types)
+diff --git a/hw/sparc/trace-events b/hw/sparc/trace-events
+index 00b0212..5c2398a 100644
+--- a/hw/sparc/trace-events
++++ b/hw/sparc/trace-events
+@@ -4,6 +4,12 @@
+ sun4m_cpu_set_irq_raise(int level) "Raise CPU IRQ %d"
+ sun4m_cpu_set_irq_lower(int level) "Lower CPU IRQ %d"
+ 
++# sun4m_dbri.c
++sun4m_dbri_read(uint64_t addr, uint32_t val) "read reg[0x%"PRIx64"] = 0x%08x"
++sun4m_dbri_write(uint64_t addr, uint64_t val) "write reg[0x%"PRIx64"] = 0x%08"PRIx64
++sun4m_dbri_command(uint32_t addr, uint32_t cmd) "command at 0x%08x: 0x%08x"
++sun4m_dbri_dma_error(uint32_t addr) "DMA error at 0x%08x"
++
+ # sun4m_iommu.c
+ sun4m_iommu_mem_readl(uint64_t addr, uint32_t ret) "read reg[0x%"PRIx64"] = 0x%x"
+ sun4m_iommu_mem_writel(uint64_t addr, uint32_t val) "write reg[0x%"PRIx64"] = 0x%x"
diff --git a/debian/patches/wsh/0067-tests-qtest-test-the-DBRI-s-registers-and-command-qu.patch b/debian/patches/wsh/0067-tests-qtest-test-the-DBRI-s-registers-and-command-qu.patch
new file mode 100644
index 0000000..f07930c
--- /dev/null
+++ b/debian/patches/wsh/0067-tests-qtest-test-the-DBRI-s-registers-and-command-qu.patch
@@ -0,0 +1,214 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the DBRI's registers and command queue on
+ sun4m
+
+qtest sun4m-dbri-test for the patch before, on the SS-20 and the LX:
+the registers read 0 after start and keep what is written, the soft
+reset bit clears them, the PIO pins read low; a queue of commands of
+one, two and three words with a JUMP to another page, read through the
+IOMMU, leaves REG8 on its WAIT; setting REG0's P bit leaves it there
+when nothing was added and goes on to the next WAIT when commands were
+written over it, and the P bit doesn't stay set; a queue on an unmapped
+page leaves REG8 where it was written. Without the patch before REG8
+reads 0 and the queue cases fail.
+---
+ tests/qtest/meson.build       |   3 +-
+ tests/qtest/sun4m-dbri-test.c | 175 ++++++++++++++++++++++++++++++++++
+ 2 files changed, 177 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-dbri-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 015945a..ca145e6 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -214,7 +214,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-onboard-sbus-test',
+                 'sun4m-nvram-test',
+                 'sun4m-ledma-test',
+-                'sun4m-ss600mp-test'] + \
++                'sun4m-ss600mp-test',
++                'sun4m-dbri-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-dbri-test.c b/tests/qtest/sun4m-dbri-test.c
+new file mode 100644
+index 0000000..090efbb
+--- /dev/null
++++ b/tests/qtest/sun4m-dbri-test.c
+@@ -0,0 +1,175 @@
++/*
++ * QTest: the DBRI's registers on the SS-20 and the SPARCstation LX
++ *
++ * The DBRI fetches its commands from a queue in memory through the IOMMU:
++ * REG8 is the queue pointer, and the chip stops on a WAIT command with
++ * REG8 on it. Solaris 2.6's driver checks REG8 before it adds commands;
++ * when it read 0 there (the registers were an unimplemented device), the
++ * driver reset the chip in a routine that, under the SS-20 PROM's
++ * "isdn-disabled", dereferenced a null pointer and panicked.
++ *
++ * The test checks that the registers keep what is written, that the soft
++ * reset bit clears them, that the PIO pins read low, and that the chip
++ * walks a queue through the IOMMU (commands of one, two and three words
++ * and a JUMP) to its WAIT, goes on from there when REG0's P bit is set,
++ * and stops on a queue it can't read. Nothing runs on the CPU.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++typedef struct {
++    const char *machine;
++    uint64_t dbri_base;         /* the registers, slot offset 0x10000 */
++    uint64_t iommu_base;
++} DbriCase;
++
++static const DbriCase ss20 = { "SS-20", 0xee0010000ULL, 0xfe0000000ULL };
++static const DbriCase lx = { "LX", 0x50010000ULL, 0x10000000ULL };
++
++#define REG(c, n)               ((c)->dbri_base + (n) * 4)
++#define R0_RESET                0x00000001
++#define R0_PROGRAM              0x00008000
++
++#define CMD_WAIT                0x00000000
++#define CMD_PAUSE               0x10000000
++#define CMD_JUMP                0x20000000
++#define CMD_IIQ                 0x30000000
++#define CMD_SDP                 0x50000000
++#define CMD_DTS                 0x70000000
++#define CMD_TEST                0xd0000000
++
++#define IOMMU_CTRL(c)           ((c)->iommu_base + 0x0000)
++#define IOMMU_BASE(c)           ((c)->iommu_base + 0x0004)
++#define IOMMU_CTRL_64M_ENAB     0x9     /* range 64 MB, enable */
++#define IOPTE_WRITE             0x4
++#define IOPTE_VALID             0x2
++#define DVMA_START_64M          0xfc000000U
++
++/* the IOMMU table, and two queue pages that are not adjacent in memory */
++#define IOPT_PA                 0x100000
++#define QUEUE_PA                0x200000
++#define QUEUE_DVMA              0xfc010000U
++#define JUMP_PA                 0x300000
++#define JUMP_DVMA               0xfc011000U
++#define UNMAPPED_DVMA           0xfc020000U
++
++static QTestState *start(const DbriCase *c)
++{
++    return qtest_initf("-M %s -m 64 -nodefaults", c->machine);
++}
++
++static void test_registers(const void *opaque)
++{
++    const DbriCase *c = opaque;
++    QTestState *qts = start(c);
++    int i;
++
++    for (i = 0; i < 10; i++) {
++        g_assert_cmphex(qtest_readl(qts, REG(c, i)), ==, 0);
++    }
++
++    /* REG0 keeps its bits; the P bit doesn't stay set */
++    qtest_writel(qts, REG(c, 0), 0x00005010);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 0)), ==, 0x00005010);
++    qtest_writel(qts, REG(c, 9), 0x12345678);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 9)), ==, 0x12345678);
++
++    /* the PIO pins read low, their enables as written */
++    qtest_writel(qts, REG(c, 2), 0xff);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 2)), ==, 0xf0);
++
++    /* soft reset */
++    qtest_writel(qts, REG(c, 0), R0_RESET);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 0)), ==, 0);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 2)), ==, 0);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 9)), ==, 0);
++
++    qtest_quit(qts);
++}
++
++static void map_page(QTestState *qts, uint32_t dvma, uint32_t pa)
++{
++    uint32_t idx = (dvma - DVMA_START_64M) >> 12;
++
++    qtest_writel(qts, IOPT_PA + idx * 4,
++                 (pa >> 4) | IOPTE_WRITE | IOPTE_VALID);
++}
++
++static void put_words(QTestState *qts, uint32_t pa, const uint32_t *w,
++                      int n)
++{
++    int i;
++
++    for (i = 0; i < n; i++) {
++        qtest_writel(qts, pa + i * 4, w[i]);
++    }
++}
++
++static void test_command_queue(const void *opaque)
++{
++    const DbriCase *c = opaque;
++    QTestState *qts = start(c);
++    /* IIQ, SDP, DTS, PAUSE, then a JUMP to the other page */
++    static const uint32_t queue[] = {
++        CMD_IIQ, 0xfc030000,
++        CMD_SDP | 0x491, 0x00000000,
++        CMD_DTS | 0x3c210, 0x00000000, 0x00000000,
++        CMD_PAUSE,
++        CMD_JUMP, JUMP_DVMA,
++    };
++    static const uint32_t jumped[] = {
++        CMD_SDP | 0x492, 0x00000000,
++        CMD_WAIT,
++    };
++    static const uint32_t more[] = {
++        CMD_TEST, 0x00000000,
++        CMD_WAIT,
++    };
++    const uint32_t wait1 = JUMP_DVMA + 2 * 4;
++    const uint32_t wait2 = wait1 + 2 * 4;
++
++    qtest_writel(qts, IOMMU_BASE(c), IOPT_PA >> 4);
++    qtest_writel(qts, IOMMU_CTRL(c), IOMMU_CTRL_64M_ENAB);
++    map_page(qts, QUEUE_DVMA, QUEUE_PA);
++    map_page(qts, JUMP_DVMA, JUMP_PA);
++    put_words(qts, QUEUE_PA, queue, ARRAY_SIZE(queue));
++    put_words(qts, JUMP_PA, jumped, ARRAY_SIZE(jumped));
++
++    /* writing REG8 starts the chip; it stops on the WAIT */
++    qtest_writel(qts, REG(c, 8), QUEUE_DVMA);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 8)), ==, wait1);
++
++    /* nothing new: the P bit leaves it on the same WAIT */
++    qtest_writel(qts, REG(c, 0), R0_PROGRAM);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 8)), ==, wait1);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 0)), ==, 0);
++
++    /* commands written over the WAIT run when the P bit is set */
++    put_words(qts, JUMP_PA + 2 * 4, more, ARRAY_SIZE(more));
++    qtest_writel(qts, REG(c, 0), 0x00005010 | R0_PROGRAM);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 8)), ==, wait2);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 0)), ==, 0x00005010);
++
++    /* a queue it can't read: it stops where it is */
++    qtest_writel(qts, REG(c, 8), UNMAPPED_DVMA);
++    g_assert_cmphex(qtest_readl(qts, REG(c, 8)), ==, UNMAPPED_DVMA);
++
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_data_func("/sun4m/dbri/registers/ss20", &ss20, test_registers);
++    qtest_add_data_func("/sun4m/dbri/registers/lx", &lx, test_registers);
++    qtest_add_data_func("/sun4m/dbri/command-queue/ss20", &ss20,
++                        test_command_queue);
++    qtest_add_data_func("/sun4m/dbri/command-queue/lx", &lx,
++                        test_command_queue);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0068-hw-pci-host-sabre-reset-the-PCI-control-status-regis.patch b/debian/patches/wsh/0068-hw-pci-host-sabre-reset-the-PCI-control-status-regis.patch
new file mode 100644
index 0000000..e5b79f7
--- /dev/null
+++ b/debian/patches/wsh/0068-hw-pci-host-sabre-reset-the-PCI-control-status-regis.patch
@@ -0,0 +1,34 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/pci-host/sabre: reset the PCI control/status
+ registers
+
+sabre_reset() left the PCI control/status registers (0x2000-0x202f) as
+the guest had last written them. Solaris writes the PBM's error bits
+back there to clear them, so once the machine was reset under a running
+Solaris (its reboot through the firmware's client interface boot
+service) the next boot read them as set and warned "pcipsy0: SERR
+asserted on pci bus". A power-on leaves them clear: clear them on every
+reset.
+---
+ hw/pci-host/sabre.c | 8 ++++++++
+ 1 file changed, 8 insertions(+)
+
+diff --git a/hw/pci-host/sabre.c b/hw/pci-host/sabre.c
+index 4296c87244..0a5df97d19 100644
+--- a/hw/pci-host/sabre.c
++++ b/hw/pci-host/sabre.c
+@@ -353,6 +353,14 @@ static void sabre_reset(DeviceState *d)
+     s->irq_request = NO_IRQ_REQUEST;
+     s->pci_irq_in = 0ULL;
+ 
++    /*
++     * The PCI control/status registers as a power-on leaves them. They
++     * kept what the guest last wrote, and Solaris writes its error bits
++     * back there: after a reset its next boot warned "pcipsy0: SERR
++     * asserted on pci bus".
++     */
++    memset(s->pci_control, 0, sizeof(s->pci_control));
++
+     if (s->nr_resets++ == 0) {
+         /* Power on reset */
+         s->reset_control = POR;
diff --git a/debian/patches/wsh/0069-tests-qtest-test-the-sabre-s-PCI-control-registers-a.patch b/debian/patches/wsh/0069-tests-qtest-test-the-sabre-s-PCI-control-registers-a.patch
new file mode 100644
index 0000000..f584fbd
--- /dev/null
+++ b/debian/patches/wsh/0069-tests-qtest-test-the-sabre-s-PCI-control-registers-a.patch
@@ -0,0 +1,83 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the sabre's PCI control registers
+ after a reset
+
+sun4u-sabre-reset-test writes every word of the sabre's PCI
+control/status registers, resets the machine and checks that they read
+as at power-on again. Without the previous patch they kept what was
+written.
+---
+ tests/qtest/meson.build              |  2 +-
+ tests/qtest/sun4u-sabre-reset-test.c | 50 ++++++++++++++++++++++++++++
+ 2 files changed, 51 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4u-sabre-reset-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 015945acf8..ab74842ffd 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -222,7 +222,7 @@ qtests_sparc64 = \
+   qtests_filter + \
+   ['prom-env-test', 'boot-serial-test', 'sun4u-cmd646-test',
+    'sun4u-idprom-test', 'sun4u-softint-test', 'sun4u-idle-test',
+-   'sun4u-sabre-irq-test']
++   'sun4u-sabre-irq-test', 'sun4u-sabre-reset-test']
+ 
+ qtests_npcm7xx = \
+   ['npcm7xx_adc-test',
+diff --git a/tests/qtest/sun4u-sabre-reset-test.c b/tests/qtest/sun4u-sabre-reset-test.c
+new file mode 100644
+index 0000000000..bc6ea30643
+--- /dev/null
++++ b/tests/qtest/sun4u-sabre-reset-test.c
+@@ -0,0 +1,50 @@
++/*
++ * QTest: the sabre's PCI control/status registers after a reset on sun4u
++ *
++ * The sabre kept its PCI control/status registers across a system reset,
++ * with what the guest had last written there. Solaris writes its error
++ * bits back to clear them; after a reboot (the firmware resets the
++ * machine) the next boot read them as set and warned "pcipsy0: SERR
++ * asserted on pci bus". A reset must leave them as a power-on does.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++#define SABRE_CONFIG    0x1fe00000000ULL    /* sabre registers (big-endian) */
++#define PCI_CONTROL     (SABRE_CONFIG + 0x2000)
++#define PCI_CONTROL_END (SABRE_CONFIG + 0x2030)
++
++static void test_pci_control_reset(void)
++{
++    QTestState *qts = qtest_init("-machine sun4u -nodefaults");
++    uint64_t addr;
++
++    /* As at power-on */
++    for (addr = PCI_CONTROL; addr < PCI_CONTROL_END; addr += 4) {
++        g_assert_cmphex(qtest_readl(qts, addr), ==, 0);
++    }
++
++    /* What a guest writes: error bits and its own settings */
++    for (addr = PCI_CONTROL; addr < PCI_CONTROL_END; addr += 4) {
++        qtest_writel(qts, addr, 0xffffffff);
++        g_assert_cmphex(qtest_readl(qts, addr), ==, 0xffffffff);
++    }
++
++    qtest_system_reset(qts);
++
++    for (addr = PCI_CONTROL; addr < PCI_CONTROL_END; addr += 4) {
++        g_assert_cmphex(qtest_readl(qts, addr), ==, 0);
++    }
++
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++    qtest_add_func("/sun4u/sabre/pci-control-reset", test_pci_control_reset);
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0070-target-sparc-halt-the-CPU-in-Linux-s-idle-loop-on-su.patch b/debian/patches/wsh/0070-target-sparc-halt-the-CPU-in-Linux-s-idle-loop-on-su.patch
new file mode 100644
index 0000000..92a6e00
--- /dev/null
+++ b/debian/patches/wsh/0070-target-sparc-halt-the-CPU-in-Linux-s-idle-loop-on-su.patch
@@ -0,0 +1,314 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: halt the CPU in Linux's idle loop on sun4u
+
+Linux on sun4u spins in its idle loop and keeps a host core busy for as
+long as the VM runs: the generic idle loop disables interrupts, finds
+need_resched() clear and calls arch_cpu_idle(), which on sun4u only
+touches the NMI watchdog (it yields to the hypervisor on sun4v), and
+goes round again once it has enabled interrupts. No kernel option
+changes that.
+
+The translator now also recognises arch_cpu_idle() at its call of
+arch_touch_nmi_watchdog(), by the test of tlb_type against hypervisor
+(3) next to it and the start of the sun4v branch (interrupts enabled,
+then PSTATE.IE cleared), as gcc lays it out either way round: Linux 6.1
+and 7.3 branch to the sun4v code, 6.17 and 7.0 around it. The helper
+halts the CPU there when %pil is 14 (what local_irq_disable() writes),
+PSTATE.IE is set, nothing is pending and TIF_NEED_RESCHED is clear in
+current_thread_info()->flags at %g6 + 8, after the same 100 us of
+spinning as for the other guests. It halts with interrupts disabled, as
+sun4v's cpu_yield and x86's mwait wait: on sun4u the tick, stick and
+interrupt vector wake a halted CPU whatever %pil, and the CPU goes on at
+the call; the interrupt is taken once the idle loop enables interrupts.
+
+The window read around a call grows from 8 to 24 words before it, for
+the layout where the sun4v branch comes first, and words on another page
+than the call's are read as 0 instead of skipping the call.
+
+An idle Linux then uses 5-6% of a host core instead of 100%: the wisp
+test kernel (Linux 7.3.4) and the installer kernels of Debian 12
+(6.1.27), 13 of 2025-11 (6.17.7) and 13 of 2026-06 (7.0.12). A CPU-bound
+job and the installer's boot take as long as before, and the guest
+clock keeps time.
+---
+ hw/sparc64/sun4u.c          |   2 +-
+ target/sparc/helper.h       |   1 +
+ target/sparc/sparc64_idle.c |  53 ++++++++++++++
+ target/sparc/translate.c    | 138 +++++++++++++++++++++++++++++++++---
+ 4 files changed, 184 insertions(+), 10 deletions(-)
+
+diff --git a/hw/sparc64/sun4u.c b/hw/sparc64/sun4u.c
+index ca52e1a..1901d47 100644
+--- a/hw/sparc64/sun4u.c
++++ b/hw/sparc64/sun4u.c
+@@ -909,7 +909,7 @@ static void sun4u_class_init(ObjectClass *oc, const void *data)
+                                    sun4u_set_idle_halt);
+     object_class_property_set_description(oc, "idle-halt",
+         "Halt the CPU while a known guest kernel (NetBSD, OpenBSD, Solaris, "
+-        "illumos) is idle, instead of spinning (default: on)");
++        "illumos, Linux) is idle, instead of spinning (default: on)");
+ }
+ 
+ static const TypeInfo sun4u_type = {
+diff --git a/target/sparc/helper.h b/target/sparc/helper.h
+index 130259e..7685738 100644
+--- a/target/sparc/helper.h
++++ b/target/sparc/helper.h
+@@ -14,6 +14,7 @@ DEF_HELPER_FLAGS_2(wrpil, TCG_CALL_NO_RWG, void, env, tl)
+ DEF_HELPER_2(wrgl, void, env, tl)
+ #ifndef CONFIG_USER_ONLY
+ DEF_HELPER_5(sparc64_idle, void, env, tl, tl, tl, tl)
++DEF_HELPER_3(sparc64_idle_linux, void, env, tl, tl)
+ #endif
+ DEF_HELPER_2(wrpstate, void, env, tl)
+ DEF_HELPER_1(done, void, env)
+diff --git a/target/sparc/sparc64_idle.c b/target/sparc/sparc64_idle.c
+index 1b545f5..a7e7384 100644
+--- a/target/sparc/sparc64_idle.c
++++ b/target/sparc/sparc64_idle.c
+@@ -57,6 +57,22 @@
+  *
+  * As in the sun4m idle loops, the loop spins on for 100 us before the
+  * first halt, as a disk request often completes that soon.
++ *
++ *   Linux arch_cpu_idle(), which the generic idle loop calls with
++ *   interrupts disabled (%pil 14) once it has found need_resched() clear:
++ *       if (tlb_type != hypervisor)
++ *           touch_nmi_watchdog();             <- here
++ *       else
++ *           ... sun4v_cpu_yield() ...
++ *     On sun4u it only touches the NMI watchdog, and the idle loop goes
++ *     round again as soon as it has enabled interrupts; the word is
++ *     need_resched()'s, the flags of current_thread_info() at %g6 + 8.
++ *
++ * Linux is halted at %pil 14 by helper_sparc64_idle_linux(), as sun4v's
++ * cpu_yield and x86's mwait wait with interrupts disabled. The tick and
++ * stick compare interrupts and the interrupt vector wake a halted CPU
++ * whatever %pil (hw/sparc64/sparc64.c), and the CPU goes on at the call;
++ * the interrupt is taken when the idle loop enables interrupts again.
+  */
+ 
+ #include "qemu/osdep.h"
+@@ -156,3 +172,40 @@ void HELPER(sparc64_idle)(CPUSPARCState *env, target_ulong pc,
+     cs->exception_index = EXCP_HLT;
+     cpu_loop_exit(cs);
+ }
++
++#define LINUX_PIL_NORMAL_MAX    14      /* local_irq_disable() */
++#define LINUX_TIF_NEED_RESCHED  (1 << 3)
++
++/*
++ * Linux, at the call in arch_cpu_idle() (pc); flags_addr is
++ * current_thread_info()->flags. Halt until the next interrupt when
++ * interrupts are disabled as the idle loop disables them, none is pending
++ * and need_resched() is clear, and go on at the call then: whatever %pil,
++ * the tick, stick and interrupt vector set cs->halted to 0.
++ */
++void HELPER(sparc64_idle_linux)(CPUSPARCState *env, target_ulong pc,
++                                target_ulong flags_addr)
++{
++    CPUState *cs = env_cpu(env);
++    uint64_t flags;
++
++    if (!(env->pstate & PS_IE) || env->psrpil != LINUX_PIL_NORMAL_MAX ||
++        env->tl || cpu_test_interrupt(cs, CPU_INTERRUPT_HARD) ||
++        (env->ivec_status & 0x20) || env->softint || env->pil_in) {
++        return;
++    }
++    if (!sparc64_idle_read(env, flags_addr, 8, &flags) ||
++        (flags & LINUX_TIF_NEED_RESCHED)) {
++        return;
++    }
++    if (!sparc64_idle_polled(env)) {
++        return;
++    }
++
++    trace_sparc64_idle(pc);
++    env->pc = pc;
++    env->npc = pc + 4;
++    cs->halted = 1;
++    cs->exception_index = EXCP_HLT;
++    cpu_loop_exit(cs);
++}
+diff --git a/target/sparc/translate.c b/target/sparc/translate.c
+index 72ed920..8999afe 100644
+--- a/target/sparc/translate.c
++++ b/target/sparc/translate.c
+@@ -6183,7 +6183,7 @@ static void gen_solaris_idle_mp(DisasContext *dc, CPUSPARCState *env,
+  * into a fixed pattern.
+  */
+ #define S64_NOP         0x01000000
+-#define S64_IDLE_BEFORE 8       /* words read before the call */
++#define S64_IDLE_BEFORE 24      /* words read before the call */
+ #define S64_IDLE_AFTER  12      /* and after it */
+ 
+ #define S64_RD(w)       extract32(w, 25, 5)
+@@ -6491,15 +6491,123 @@ static bool s64_idle_solaris(const uint32_t *w, target_ulong pc,
+     return true;
+ }
+ 
++/* cmp %rs1, 3 (subcc %rs1, 3, %g0) */
++static bool s64_cmp3(uint32_t w, int *rs1)
++{
++    if ((w & 0xfff83fff) != 0x80a02003) {
++        return false;
++    }
++    *rs1 = S64_RS1(w);
++    return true;
++}
++
++#define S64_WRPR_PIL0   0x91902000      /* wrpr %g0, 0, %pil */
++#define S64_RETURN      0x81cfe008      /* return %i7 + 8 */
++#define S64_RET         0x81c7e008      /* ret: jmpl %i7 + 8, %g0 */
++
++/*
++ * The start of the sun4v branch of Linux's arch_cpu_idle() at w[0]:
++ * interrupts enabled, then PSTATE.IE cleared over the hypervisor call
++ *
++ *        wrpr  %g0, 0, %pil
++ *        rdpr  %pstate, %a
++ *        andn  %a, 2, %a                  (PSTATE_IE)
++ *        wrpr  %a, %pstate
++ */
++static bool s64_linux_sun4v(const uint32_t *w)
++{
++    int a;
++
++    if (w[0] != S64_WRPR_PIL0 || (w[1] & 0xc1ffffff) != 0x81518000) {
++        return false;
++    }
++    a = S64_RD(w[1]);
++    return w[2] == (0x80282002 | a << 25 | a << 14) &&
++           (w[3] == (0x8d900000 | a << 14) || w[3] == (0x8d902000 | a << 14));
++}
++
++/*
++ * Linux arch_cpu_idle() (w[S64_IDLE_BEFORE] is the call). The generic
++ * idle loop calls it with interrupts disabled (%pil 14), having found
++ * need_resched() clear:
++ *
++ *     if (tlb_type != hypervisor)
++ *         touch_nmi_watchdog();           <- here, the call of
++ *     else {                                 arch_touch_nmi_watchdog()
++ *         raw_local_irq_enable(); ... sun4v_cpu_yield(); ...
++ *     }
++ *
++ * gcc lays the test of tlb_type out either way round. Linux 6.1 and 7.3:
++ *
++ *        ld    [%x + %lo(tlb_type)], %r
++ *        cmp   %r, 3                      (hypervisor)
++ *        be    sun4v
++ *         nop
++ *        call  arch_touch_nmi_watchdog    <- here
++ *        ...
++ *  sun4v: the sun4v branch (s64_linux_sun4v)
++ *
++ * Linux 6.17 and 7.0:
++ *
++ *        ld    [%x + %lo(tlb_type)], %r
++ *        cmp   %r, 3
++ *        bne   sun4u
++ *         nop
++ *        the sun4v branch (s64_linux_sun4v)
++ *        ...
++ *        return %i7 + 8                   (or ret)
++ *         ...
++ *  sun4u: call  arch_touch_nmi_watchdog   <- here
++ *
++ * The word is need_resched()'s, the flags of current_thread_info() at
++ * %g6 + 8.
++ */
++static bool s64_idle_linux(const uint32_t *w, target_ulong pc,
++                           S64IdleWord *iw)
++{
++    const uint32_t *c = w + S64_IDLE_BEFORE;
++    target_ulong t;
++    int32_t off;
++    int r, r2, x, i;
++
++    if (extract32(c[0], 30, 2) != 1) {      /* call disp30 */
++        return false;
++    }
++    iw->reg = 6;
++    iw->off = 8;
++
++    /* be sun4v; nop; call */
++    if (s64_lduw(c[-4], &x, &off, &r) && s64_cmp3(c[-3], &r2) && r2 == r &&
++        s64_bcc(c[-2], pc - 8, S64_BE, &t) && c[-1] == S64_NOP &&
++        t > pc + 4 && (t - pc) / 4 + 3 <= S64_IDLE_AFTER) {
++        return s64_linux_sun4v(c + (t - pc) / 4);
++    }
++
++    /* bne sun4u; nop; the sun4v branch; ...; return; ...; call */
++    if (c[-2] != S64_RETURN && c[-2] != S64_RET) {
++        return false;
++    }
++    for (i = 8; i <= S64_IDLE_BEFORE - 2; i++) {
++        if (s64_bcc(c[-i], pc - 4 * i, S64_BNE, &t) && t == pc &&
++            c[-i + 1] == S64_NOP && s64_cmp3(c[-i - 1], &r2) &&
++            s64_lduw(c[-i - 2], &x, &off, &r) && r == r2) {
++            return s64_linux_sun4v(c - i + 2);
++        }
++    }
++    return false;
++}
++
+ typedef struct Sparc64IdleLoop {
+     const char *kernel;
+     bool (*match)(const uint32_t *w, target_ulong pc, S64IdleWord *iw);
++    bool irqs_off;      /* at %pil 14: helper_sparc64_idle_linux() */
+ } Sparc64IdleLoop;
+ 
+ static const Sparc64IdleLoop sparc64_idle_loops[] = {
+     { "NetBSD", s64_idle_netbsd },
+     { "OpenBSD", s64_idle_openbsd },
+     { "Solaris", s64_idle_solaris },
++    { "Linux", s64_idle_linux, true },
+ };
+ 
+ /*
+@@ -6519,14 +6627,21 @@ static void gen_sparc64_idle(DisasContext *dc, CPUSPARCState *env,
+         return;
+     }
+     /* Off RAM, translator_ldl_end() would record these words as code */
+-    if (tb_page_addr0(dc->base.tb) == -1 ||
+-        !translator_is_same_page(&dc->base, start) ||
+-        !translator_is_same_page(&dc->base, start + 4 * (ARRAY_SIZE(w) - 1))) {
++    if (tb_page_addr0(dc->base.tb) == -1) {
+         return;
+     }
++    /*
++     * Only words on the call's page are read; the others are 0 (illtrap),
++     * which no layout has
++     */
+     for (i = 0; i < ARRAY_SIZE(w); i++) {
+-        w[i] = i == S64_IDLE_BEFORE ? insn :
+-               translator_ldl_end(env, &dc->base, start + 4 * i, MO_BE);
++        if (i == S64_IDLE_BEFORE) {
++            w[i] = insn;
++        } else if (translator_is_same_page(&dc->base, start + 4 * i)) {
++            w[i] = translator_ldl_end(env, &dc->base, start + 4 * i, MO_BE);
++        } else {
++            w[i] = 0;
++        }
+     }
+ 
+     for (k = 0; k < ARRAY_SIZE(sparc64_idle_loops); k++) {
+@@ -6544,9 +6659,14 @@ static void gen_sparc64_idle(DisasContext *dc, CPUSPARCState *env,
+         translator_io_start(&dc->base);
+         addr = tcg_temp_new();
+         tcg_gen_addi_tl(addr, gen_load_gpr(dc, iw.reg), iw.off);
+-        gen_helper_sparc64_idle(tcg_env, tcg_constant_tl(dc->pc), addr,
+-                                tcg_constant_tl(iw.indirect),
+-                                tcg_constant_tl(iw.off2));
++        if (l->irqs_off) {
++            gen_helper_sparc64_idle_linux(tcg_env, tcg_constant_tl(dc->pc),
++                                          addr);
++        } else {
++            gen_helper_sparc64_idle(tcg_env, tcg_constant_tl(dc->pc), addr,
++                                    tcg_constant_tl(iw.indirect),
++                                    tcg_constant_tl(iw.off2));
++        }
+         return;
+     }
+ }
diff --git a/debian/patches/wsh/0071-target-sparc-recognise-the-idle-loop-of-Solaris-7-an.patch b/debian/patches/wsh/0071-target-sparc-recognise-the-idle-loop-of-Solaris-7-an.patch
new file mode 100644
index 0000000..1b40daa
--- /dev/null
+++ b/debian/patches/wsh/0071-target-sparc-recognise-the-idle-loop-of-Solaris-7-an.patch
@@ -0,0 +1,112 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: recognise the idle loop of Solaris 7 and 8 on sun4u
+
+Solaris 7 3/99 and 8 2/02 (and 8 1/01's installation kernel) spin in
+idle() on sun4u like Solaris 9 and 10 did, but Sun's older compiler
+lays the loop out the other way round: the test of disp_nrunnable (in
+the CPU structure) branches to the call through idle_cpu when there is
+no work, and the call of swtch() comes first:
+
+    ld [%cpu + nrunnable], %x; cmp %x, 0; be idle; sethi %hi(idle_cpu)
+    call swtch; nop; b top; ...
+    idle: ldx [%y + %lo(idle_cpu)], %z; call %z; nop; b top
+
+The translator recognises that layout too, with the registers checked
+against each other and both branches back to the same top, and halts
+at the call through helper_sparc64_idle() as for Solaris 9 and 10. The
+layout needs the nine words before the call that the window now has.
+
+An idle Solaris 7 or 8 at the shell then uses about 3% of a host core
+instead of 100%; ten "sleep 1" and a CPU-bound job take as long as
+before.
+---
+ target/sparc/sparc64_idle.c |  2 +-
+ target/sparc/translate.c    | 55 +++++++++++++++++++++++++++++++++++++
+ 2 files changed, 56 insertions(+), 1 deletion(-)
+
+diff --git a/target/sparc/sparc64_idle.c b/target/sparc/sparc64_idle.c
+index a7e7384..69ad8e5 100644
+--- a/target/sparc/sparc64_idle.c
++++ b/target/sparc/sparc64_idle.c
+@@ -31,7 +31,7 @@
+  *           cpu_idle_cycle();                 <- here
+  *     cpu_idle_cycle() does nothing on sun4u; the word is spc_whichqs.
+  *
+- *   Solaris 9 and 10, illumos (Tribblix) idle(), with one CPU:
++ *   Solaris 7 to 10, illumos (Tribblix) idle(), with one CPU:
+  *       while (ncpus == 1) {
+  *           if (CPU->cpu_disp->disp_nrunnable == 0) {
+  *               (*idle_cpu)();                <- here
+diff --git a/target/sparc/translate.c b/target/sparc/translate.c
+index 8999afe..10299b1 100644
+--- a/target/sparc/translate.c
++++ b/target/sparc/translate.c
+@@ -6491,6 +6491,60 @@ static bool s64_idle_solaris(const uint32_t *w, target_ulong pc,
+     return true;
+ }
+ 
++/*
++ * Solaris 7 and 8, idle() with one CPU (w[S64_IDLE_BEFORE] is the call),
++ * as Sun's older compiler lays it out: the branch goes to the idle_cpu
++ * call when there is no work, and swtch() comes first:
++ *
++ *        ld    [%cpu + nrunnable], %x
++ *        cmp   %x, 0
++ *        be    idle
++ *         sethi %hi(idle_cpu), %y
++ *        call  swtch
++ *         nop
++ *        b     top
++ *         ...
++ *  idle: ldx   [%y + %lo(idle_cpu)], %z
++ *        call  %z                         <- here
++ *         nop
++ *        b     top
++ *
++ * The word is disp_nrunnable, in the CPU structure.
++ */
++static bool s64_idle_solaris7(const uint32_t *w, target_ulong pc,
++                              S64IdleWord *iw)
++{
++    const uint32_t *c = w + S64_IDLE_BEFORE;
++    target_ulong t, top, top2, sw;
++    int cpu, x, x2, y, a, z;
++    int32_t off, off2;
++
++    if (extract32(c[0], 30, 2) != 2 ||
++        !s64_lduw(c[-9], &cpu, &off, &x) ||
++        !s64_cmp0(c[-8], &x2) || x2 != x ||
++        !s64_bcc(c[-7], pc - 28, S64_BE, &t) || t != pc - 4 ||
++        !s64_call(c[-5], pc - 20, &sw) || c[-4] != S64_NOP ||
++        !s64_bcc(c[-3], pc - 12, S64_BA, &top) ||
++        !s64_ldx(c[-1], &a, &off2, &z) || S64_RS1(c[0]) != z ||
++        c[1] != S64_NOP || !s64_bcc(c[2], pc + 8, S64_BA, &top2) ||
++        top2 != top || top > pc - 36 || pc - top > 4 * 64) {
++        return false;
++    }
++    /* The delay slot: sethi %hi(idle_cpu), %y for the ldx */
++    if (extract32(c[-6], 22, 10) != (extract32(c[-6], 25, 5) << 3 | 4) ||
++        c[-6] == S64_NOP) {
++        return false;
++    }
++    y = S64_RD(c[-6]);
++    /* Nothing between the load and the call writes %cpu */
++    if (a != y || cpu == 0 || cpu == x || cpu == y || cpu == z) {
++        return false;
++    }
++    iw->reg = cpu;
++    iw->off = off;
++    return true;
++}
++
+ /* cmp %rs1, 3 (subcc %rs1, 3, %g0) */
+ static bool s64_cmp3(uint32_t w, int *rs1)
+ {
+@@ -6607,6 +6661,7 @@ static const Sparc64IdleLoop sparc64_idle_loops[] = {
+     { "NetBSD", s64_idle_netbsd },
+     { "OpenBSD", s64_idle_openbsd },
+     { "Solaris", s64_idle_solaris },
++    { "Solaris 7/8", s64_idle_solaris7 },
+     { "Linux", s64_idle_linux, true },
+ };
+ 
