++         * Its boot PROM reads and writes the offsets of the lance's page
++         * the lance doesn't decode and wants each load to trap with a bus
++         * error in the SFSR, with the MMU off and through the MMU bypass
++         * ASIs, and each store to come back as an M-to-S write error in
++         * the IOMMU's AFSR and AFAR with a level 15 interrupt.
++         */
++        .sbus_bus_errors = true,
+         .iommu_version = 0x01000000,
+         /*
+          * Its IOMMU keeps all of the page table base address (bits 31-10,
+diff --git a/hw/sparc/sun4m_iommu.c b/hw/sparc/sun4m_iommu.c
+index f9cacf4..0956695 100644
+--- a/hw/sparc/sun4m_iommu.c
++++ b/hw/sparc/sun4m_iommu.c
+@@ -283,6 +283,49 @@ static hwaddr iommu_translate_pa(hwaddr addr,
+     return pa;
+ }
+ 
++/*
++ * A CPU store to the SBus that the SBus answered with an error acknowledge
++ * (nothing at the address, or a size the device doesn't take), as the M-to-S
++ * interface reports it: an asynchronous write error in the AFSR and AFAR and
++ * the interrupt. The AFSR takes the error and bus error bits, the size of
++ * the MBus transaction, supervisor mode, the CPU's module ID, the address
++ * bits 4-0, the SBus size of the transfer (SunOS's async.h, MTSAFSR_*) and
++ * the physical address bits 35-32; the AFAR the address bits 31-0. A second
++ * error before the AFSR is cleared only sets the multiple error bit.
++ */
++void sun4m_iommu_cpu_write_error(IOMMUState *s, hwaddr addr, unsigned size,
++                                 unsigned mid, bool supervisor)
++{
++    uint32_t sbus_size;
++
++    if (s->regs[IOMMU_AFSR] & IOMMU_AFSR_ERR) {
++        s->regs[IOMMU_AFSR] |= IOMMU_AFSR_ME;
++        trace_sun4m_iommu_cpu_write_error(addr, size, s->regs[IOMMU_AFSR]);
++        return;
++    }
++    switch (size) {
++    case 1:
++        sbus_size = 1;          /* byte */
++        break;
++    case 2:
++        sbus_size = 2;          /* halfword */
++        break;
++    case 8:
++        sbus_size = 7;          /* two-word burst */
++        break;
++    default:
++        sbus_size = 0;          /* word */
++        break;
++    }
++    s->regs[IOMMU_AFSR] = IOMMU_AFSR_ERR | IOMMU_AFSR_BE |
++        (ctz32(size) << 25) | (supervisor ? IOMMU_AFSR_S : 0) |
++        ((mid & 0xf) << 20) | ((addr & 0x1f) << 12) | (sbus_size << 9) |
++        ((addr >> 32) & 0xf);
++    s->regs[IOMMU_AFAR] = addr;
++    trace_sun4m_iommu_cpu_write_error(addr, size, s->regs[IOMMU_AFSR]);
++    qemu_irq_raise(s->irq);
++}
++
