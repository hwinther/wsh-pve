+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test SS-600MP bus errors with the MMU off
+
+qtest sun4m-sbus-error-test for the two patches before: a PROM built by
+the test runs in boot mode with the MMU off and its trap table in the
+PROM and makes one access. On the SS-600MP a byte load through ASI 0x2e
+from the lance's page and a physical load from empty memory take trap
+0x09 with SFSR 0x436 and the SFAR; a byte store to the lance's page
+takes trap 0x1f with the SFSR clear and AFSR 0x9180120e, AFAR the
+address; a store to empty memory doesn't trap and leaves the SFSR
+clear; a load from the page the code is fetched from returns RAM. On
+the SS-10 nothing traps, the SFSR is as before and the AFSR stays
+clear. 7 cases; the SS-600MP ones fail without the patches, and
+ld-code-page without the TLB split alone.
+---
+ tests/qtest/meson.build             |   3 +-
+ tests/qtest/sun4m-sbus-error-test.c | 242 ++++++++++++++++++++++++++++
+ 2 files changed, 244 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-sbus-error-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 66dae63..8d2c137 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -222,7 +222,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-dbri-test',
+                 'sun4m-escc-break-test',
+                 'sun4m-ecc-test',
+-                'sun4m-iommu-regs-test'] + \
++                'sun4m-iommu-regs-test',
++                'sun4m-sbus-error-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-sbus-error-test.c b/tests/qtest/sun4m-sbus-error-test.c
+new file mode 100644
+index 0000000..f3d39c6
+--- /dev/null
++++ b/tests/qtest/sun4m-sbus-error-test.c
+@@ -0,0 +1,242 @@
++/*
++ * QTest: bus errors on the SPARCserver 600MP with the MMU off
++ *
++ * The SS-600MP's boot PROM checks that every offset of a device's page the
++ * device doesn't decode answers with an error acknowledge, with the MMU
++ * off and through the MMU bypass ASIs: a load traps as a data access
++ * exception (trap 0x09) with the bus error bit (BE, bit 10) in the SFSR, a
++ * store comes back as an M-to-S write error in the IOMMU's AFSR and AFAR
++ * with a level 15 interrupt (trap 0x1f) and leaves the SFSR alone. The
++ * machine sets the CPU's buserr-trap feature for this. With it a load
++ * from the page instructions are fetched from in boot mode reaches RAM,
++ * not the PROM. On the SS-10 nothing traps with the MMU off and the AFSR
++ * stays clear, as before.
++ *
++ * A tiny boot PROM runs in boot mode with the MMU off (fetches from the
++ * PROM, loads and stores physical), enables traps with its trap table at
++ * PROM offset 0, makes one access and records the SFSR and the register
++ * the access loaded. Every trap goes to a handler in the PROM that stores
++ * the trap type, the SFSR and the SFAR in RAM and stops.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++#define CODE            0x1000u         /* PROM offset of the code */
++#define HANDLER         0x1800u         /* PROM offset of the trap handler */
++#define PROM_SIZE       0x2000u
++#define MARKS           0x3000u         /* RAM address of the markers */
++#define MARK_STAGE      (MARKS + 0x04)
++#define MARK_TRAP       (MARKS + 0x20)
++#define MARK_SFSR       (MARKS + 0x24)  /* by the handler */
++#define MARK_SFAR       (MARKS + 0x28)
++#define MARK_LOADED     (MARKS + 0x2c)  /* what the access loaded */
++#define MARK_SFSR_AFTER (MARKS + 0x30)  /* the SFSR after an access */
++#define SAME_PAGE       0x17f0u         /* in the page of the code */
++#define RAM_MAGIC       0x5a17c0deu
++#define NOP             0x01000000
++
++#define TT_NONE         0
++#define TT_DFAULT       0x09            /* data access exception */
++#define TT_LEVEL15      0x1f            /* interrupt level 15 */
++
++#define SFSR_LEVEL      0x300           /* table walk level, not compared */
++#define SFSR_LOAD_BE    0x436           /* BE, supervisor load, FT 5, FAV */
++#define SFSR_LOAD       0x036           /* supervisor load, FT 5, FAV */
++
++#define AFSR            0xfe0001000ULL  /* the IOMMU's M-to-S AFSR, AFAR */
++#define AFAR            0xfe0001004ULL
++#define AFSR_ERR        0x80000000u
++
++#define LANCE_PAGE      0xf0060000u     /* slot f offset 0x60000, ASI 0x2e */
++
++typedef enum {
++    ACCESS_LDUBA,       /* lduba [addr] 0x2e, %o4 */
++    ACCESS_LDUB,        /* ldub [addr], %o4 (physical, MMU off) */
++    ACCESS_LD,          /* ld [addr], %o4 (physical, MMU off) */
++    ACCESS_STBA,        /* stba %g0, [addr] 0x2e */
++    ACCESS_STB,         /* stb %g0, [addr] (physical, MMU off) */
++} AccessKind;
++
++typedef struct {
++    const char *name;
++    const char *machine;
++    AccessKind kind;
++    uint32_t addr;
++    uint32_t tt;                /* the trap expected, or TT_NONE */
++    uint32_t sfsr;              /* the SFSR expected (masked) */
++    uint32_t afsr;              /* the AFSR expected after a store, or 0 */
++} TestCase;
++
++static char *write_prom(const TestCase *t)
++{
++    const uint32_t setup[] = {
++        0x81902000,             /* wr    %g0, 0, %wim */
++        0x81882fa0,             /* wr    %g0, 0xfa0, %psr    S, PIL 15, ET */
++        NOP, NOP, NOP,
++        0x0700000c,             /* sethi %hi(0x3000), %g3 */
++        0x88102001,             /* mov   1, %g4 */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 1 */
++        0x17000000 | (t->addr >> 10),   /* sethi %hi(addr), %o3 */
++        0x9612e000 | (t->addr & 0x3ff), /* or    %o3, %lo(addr), %o3 */
++    };
++    const uint32_t end[] = {
++        NOP,
++        0xd820e02c,             /* st    %o4, [%g3 + 0x2c]   loaded */
++        0x90102300,             /* mov   0x300, %o0 */
++        0xca820080,             /* lda   [%o0] 4, %g5        SFSR */
++        0xca20e030,             /* st    %g5, [%g3 + 0x30] */
++        0x88102002,             /* mov   2, %g4              no trap */
++        0xc820e004,             /* st    %g4, [%g3 + 4]      stage 2 */
++        0x10800000,             /* b     . */
++        NOP,
++    };
++    /* The handler stores the SFSR, the SFAR and the trap type (last) */
++    const uint32_t handler[] = {
++        0x0300000c,             /* sethi %hi(0x3000), %g1 */
++        0x85580000,             /* rd    %tbr, %g2 */
++        0x8530a004,             /* srl   %g2, 4, %g2 */
++        0x8408a0ff,             /* and   %g2, 0xff, %g2      trap type */
++        0x86102300,             /* mov   0x300, %g3 */
++        0xc880c080,             /* lda   [%g3] 4, %g4        SFSR */
++        0x86102400,             /* mov   0x400, %g3 */
++        0xca80c080,             /* lda   [%g3] 4, %g5        SFAR */
++        0xc8206024,             /* st    %g4, [%g1 + 0x24] */
++        0xca206028,             /* st    %g5, [%g1 + 0x28] */
++        0xc4206020,             /* st    %g2, [%g1 + 0x20] */
++        0x10800000,             /* b     . */
++        NOP,
++    };
++    uint32_t be[PROM_SIZE / 4] = { 0 };
++    uint32_t access;
++    char *path = NULL;
++    int fd, i, n = CODE / 4;
++
++    switch (t->kind) {
++    case ACCESS_LDUBA:
++        access = 0xd88ac000 | (0x2e << 5);      /* lduba [%o3] 0x2e, %o4 */
++        break;
++    case ACCESS_LDUB:
++        access = 0xd80ae000;                    /* ldub  [%o3], %o4 */
++        break;
++    case ACCESS_LD:
++        access = 0xd802e000;                    /* ld    [%o3], %o4 */
++        break;
++    case ACCESS_STBA:
++        access = 0xc0aac000 | (0x2e << 5);      /* stba  %g0, [%o3] 0x2e */
++        break;
++    case ACCESS_STB:
++        access = 0xc02ae000;                    /* stb   %g0, [%o3] */
++        break;
++    default:
++        g_assert_not_reached();
++    }
++
++    /* The trap table: reset (trap 0) to the code, the others to the handler */
++    for (i = 0; i < 256; i++) {
++        uint32_t target = i ? HANDLER : CODE;
++
++        be[4 * i] = cpu_to_be32(0x10800000 | ((target - 16 * i) / 4));
++        be[4 * i + 1] = cpu_to_be32(NOP);
++    }
++    for (i = 0; i < ARRAY_SIZE(setup); i++) {
++        be[n++] = cpu_to_be32(setup[i]);
++    }
++    be[n++] = cpu_to_be32(access);
++    for (i = 0; i < ARRAY_SIZE(end); i++) {
++        be[n++] = cpu_to_be32(end[i]);
++    }
++    for (i = 0; i < ARRAY_SIZE(handler); i++) {
++        be[HANDLER / 4 + i] = cpu_to_be32(handler[i]);
++    }
++    fd = g_file_open_tmp("sun4m-sbus-error-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++static void test_sbus_error(const void *data)
++{
++    const TestCase *t = data;
++    g_autofree char *prom = write_prom(t);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine %s -accel tcg -m 64 -bios %s -S",
++                                  t->machine, prom);
++
++    qtest_writel(qts, SAME_PAGE, RAM_MAGIC);
++    qtest_qmp_assert_success(qts, "{ 'execute': 'cont' }");
++
++    while (qtest_readl(qts, MARK_TRAP) == 0 &&
++           qtest_readl(qts, MARK_STAGE) < 2) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    if (t->tt == TT_NONE) {
++        g_assert_cmpuint(qtest_readl(qts, MARK_STAGE), ==, 2);
++        g_assert_cmphex(qtest_readl(qts, MARK_TRAP), ==, 0);
++        g_assert_cmphex(qtest_readl(qts, MARK_SFSR_AFTER) & ~SFSR_LEVEL, ==,
++                        t->sfsr);
++        if (t->addr == SAME_PAGE) {
++            g_assert_cmphex(qtest_readl(qts, MARK_LOADED), ==, RAM_MAGIC);
++        }
++    } else {
++        /* It got to the access, which trapped */
++        g_assert_cmpuint(qtest_readl(qts, MARK_STAGE), ==, 1);
++        g_assert_cmphex(qtest_readl(qts, MARK_TRAP), ==, t->tt);
++        g_assert_cmphex(qtest_readl(qts, MARK_SFSR) & ~SFSR_LEVEL, ==,
++                        t->sfsr);
++        if (t->tt == TT_DFAULT) {
++            g_assert_cmphex(qtest_readl(qts, MARK_SFAR), ==, t->addr);
++        }
++    }
++    if (t->afsr) {
++        g_assert_cmphex(qtest_readl(qts, AFSR), ==, t->afsr);
++        g_assert_cmphex(qtest_readl(qts, AFAR), ==, t->addr);
++    } else {
++        g_assert_cmphex(qtest_readl(qts, AFSR) & AFSR_ERR, ==, 0);
++    }
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++int main(int argc, char **argv)
++{
++    static const TestCase cases[] = {
++        /* SS-600MP: loads trap with BE, through the bypass ASI too */
++        { "ss600mp/lduba-lance-page", "SS-600MP", ACCESS_LDUBA,
++          LANCE_PAGE + 1, TT_DFAULT, SFSR_LOAD_BE, 0 },
++        { "ss600mp/ldub-no-memory", "SS-600MP", ACCESS_LDUB,
++          0x08000000, TT_DFAULT, SFSR_LOAD_BE, 0 },
++        /* A store to the SBus: an M-to-S write error and level 15 */
++        { "ss600mp/stba-lance-page", "SS-600MP", ACCESS_STBA,
++          LANCE_PAGE + 1, TT_LEVEL15, 0, 0x9180120e },
++        /* A store elsewhere: no trap and the SFSR stays clear */
++        { "ss600mp/stb-no-memory", "SS-600MP", ACCESS_STB,
++          0x08000000, TT_NONE, 0, 0 },
++        /* A load from the page the code is fetched from reaches RAM */
++        { "ss600mp/ld-code-page", "SS-600MP", ACCESS_LD,
++          SAME_PAGE, TT_NONE, 0, 0 },
++        /* SS-10: no trap with the MMU off, no write error, as before */
++        { "ss10/lduba-no-trap", "SS-10", ACCESS_LDUBA,
++          LANCE_PAGE + 0x100, TT_NONE, SFSR_LOAD, 0 },
++        { "ss10/stba-no-write-error", "SS-10", ACCESS_STBA,
