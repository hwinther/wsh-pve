+         gen_exception(dc, TT_ILL_INSN);
diff --git a/debian/patches/wsh/0043-hw-sparc64-sun4u-add-the-idle-halt-option-on-by-defa.patch b/debian/patches/wsh/0043-hw-sparc64-sun4u-add-the-idle-halt-option-on-by-defa.patch
