+ hw/net/pcnet.c   | 12 +++++++++++-
+ hw/net/pcnet.h   |  7 +++++++
+ hw/sparc/sun4m.c | 18 ++++++++++++++++--
+ 4 files changed, 42 insertions(+), 3 deletions(-)
+
