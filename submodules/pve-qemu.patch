++#define RR0_RXAV        0x01
++#define RR0_BRK         0x80
++
++#define RR3_EXTINTB     0x01
++#define RR3_EXTINTA     0x08
++#define RR3_RXINTA      0x20
++
++/* RR2 of channel B with the status in bits 1 to 3 */
