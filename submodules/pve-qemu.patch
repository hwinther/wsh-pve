++}
++
++static void test_reset_tb_flush(void)
++{
++    QTestState *qts = qtest_init("-machine sun4u -accel tcg -nodefaults");
++    gint64 end;
++    uint64_t n0, n;
++
++    /* The firmware runs and translates code; the power-on reset flushes nothing */
