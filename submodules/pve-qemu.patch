+ qapi/ui.json       |  7 ++++++-
+ qemu-options.hx    |  6 ++++++
+ ui/dbus-console.c  |  5 +++++
+ ui/dbus-listener.c |  5 +++++
+ ui/dbus.c          | 29 +++++++++++++++++++++++++++++
+ ui/dbus.h          |  4 ++++
+ 6 files changed, 55 insertions(+), 1 deletion(-)
+
+diff --git a/qapi/ui.json b/qapi/ui.json
+index 614621a..241e60b 100644
+--- a/qapi/ui.json
++++ b/qapi/ui.json
+@@ -1386,13 +1386,18 @@
+ #
+ # @audiodev: Use the specified DBus audiodev to export audio.
+ #
++# @refresh-ms: The display's refresh interval in milliseconds while
++#     a client listens, at most 3000 (default: 30, about 33 Hz; 14
++#     suits a 70 Hz guest).
++#
+ # Since: 7.0
+ ##
+ { 'struct'  : 'DisplayDBus',
+   'data'    : { '*rendernode' : 'str',
+                 '*addr': 'str',
+                 '*p2p': 'bool',
+-                '*audiodev': 'str' } }
++                '*audiodev': 'str',
++                '*refresh-ms': 'uint32' } }
+ 
+ ##
+ # @DisplayGLMode:
+diff --git a/qemu-options.hx b/qemu-options.hx
+index 192ed52..c6babf0 100644
+--- a/qemu-options.hx
++++ b/qemu-options.hx
+@@ -2271,6 +2271,7 @@ DEF("display", HAS_ARG, QEMU_OPTION_display,
+ #if defined(CONFIG_DBUS_DISPLAY)
+     "-display dbus[,addr=<dbusaddr>]\n"
+     "             [,gl=on|core|es|off][,rendernode=<file>]\n"
++    "             [,refresh-ms=<ms>]\n"
+ #endif
+     "-display none\n"
+     "                select display backend type\n"
+@@ -2319,6 +2320,11 @@ SRST
+         back into the console's surface at each display refresh, as with
+         ``egl-headless``.
+ 
++        ``refresh-ms=<ms>`` : The display's refresh interval while a client
++        listens (default 30 ms, about 33 Hz): how often the device's screen
++        is checked for changes and the client updated. 14 suits a 70 Hz
++        guest mode.
++
+     ``sdl``
+         Display video output via SDL (usually in a separate graphics
+         window; see the SDL documentation for other possibilities).
