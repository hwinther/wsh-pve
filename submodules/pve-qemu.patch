+         SPARC_CPU(cpus[i])->env.solaris_idle = sun4m_solaris_idle &&
+@@ -1146,6 +1167,12 @@ static void sun4m_hw_init(MachineState *machine)
+                        hwdef->iommu_base_mask, hwdef->iommu_sbcfg_mask,
+                        hwdef->iommu_tlb_data_mask,
+                        slavio_irq[30]);
++    if (hwdef->sbus_bus_errors) {
++        for (i = 0; i < smp_cpus; i++) {
