++         * arch_touch_nmi_watchdog; nop; call touch_softlockup_watchdog;
++         * nop; return
++         */
++        t = n;
++        n += 2;
++        n += write_linux_sun4v(a + n, at + n, true);
++        a[t] = bpcc_icc_to(BNE, at + t, at + n);
++        a[t + 1] = NOP;
++        a[n] = call_to(at + n, FUNC); n++;
++        a[n++] = NOP;
++        a[n] = call_to(at + n, FUNC + 3); n++;
++        a[n++] = NOP;
