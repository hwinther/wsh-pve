++            SPARC_CPU(cpus[i])->store_error_opaque = iommu;
++        }
++    }
+ 
+     if (hwdef->iommu_pad_base) {
+         /* On the real hardware (SS-5, LX) the MMU is not padded, but aliased.
+@@ -1591,6 +1618,14 @@ static void ss600mp_class_init(ObjectClass *oc, const void *data)
+          * where a read takes longer than the 500 ns tick.
