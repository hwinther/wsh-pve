@@ -0,0 +1,275 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the SS-600MP lance's loopback receive
+
+Cases for the patch before, as the SS-600MP boot PROM's loopback test
+sets it up: internal loopback, one receive descriptor with a 40-byte
+buffer and 0xa5a5 in its message count word, a 32-byte broadcast
+frame. With the Am7990 behaviour the receive descriptor must come back
+without an error (STP, ENP), the message count must read 36 (the frame
+and its FCS, no padding), CSR0 must show RINT without MISS or ERR, the
+frame must be in the buffer and nothing past it.
+
+- sun4m-ss600mp-test lance-loopback: in the 600MP's lebuffer.
+- sun4m-ledma-test lance-loopback/ss5 and lance-loopback/ss20: through
+  the ledma and the IOMMU with -global lance.am7990=on, and without it
+  the old result (the descriptor stays with the lance, CSR0 MISS and
+  ERR), which the SS-5 and SS-20 PROMs' default boot relies on.
+
+The three Am7990 cases fail without the patch before.
+---
+ tests/qtest/sun4m-ledma-test.c   | 111 +++++++++++++++++++++++++++++++
+ tests/qtest/sun4m-ss600mp-test.c |  91 +++++++++++++++++++++++++
+ 2 files changed, 202 insertions(+)
+
+diff --git a/tests/qtest/sun4m-ledma-test.c b/tests/qtest/sun4m-ledma-test.c
+index 6558891..85c44d5 100644
+--- a/tests/qtest/sun4m-ledma-test.c
++++ b/tests/qtest/sun4m-ledma-test.c
+@@ -18,6 +18,11 @@
+  * mapped at 0xff400000 by default, and an IOMMU error with the register
+  * set to 0. Nothing runs on the CPU.
+  *
++ * With its am7990 property (set on the SS-600MP) the lance hands a short
++ * loopback frame back at the length it sent it, and takes a receive
++ * descriptor whatever the reserved bits of its message count word hold,
++ * as the Am7990 does; without it the SS-5 and SS-20 keep the old result.
++ *
+  * SPDX-License-Identifier: GPL-2.0-or-later
+  */
+ 
+@@ -161,6 +166,108 @@ static void test_lance_dvma(const void *opaque)
+     qtest_quit(qts);
+ }
+ 
++/*
++ * The lance in internal loopback, through the DMA and the IOMMU, with a
++ * receive descriptor whose message count word holds 0xa5a5 and a 40-byte
++ * buffer for a 32-byte frame. With the am7990 property (the SS-600MP's)
++ * the frame comes back as 36 bytes, the frame and its FCS, not padded to
++ * 60; without it (the SS-5's and SS-20's) the lance still takes no such
++ * descriptor and misses the frame, as before.
++ */
++#define LB_RMD      0x020
++#define LB_TMD      0x030
++#define LB_TXBUF    0x100
++#define LB_RXBUF    0x200
++#define LB_LEN      32
++#define LB_RXLEN    40
++#define LB_HADR     ((INITBLK_DVMA >> 16) & 0xff)
++#define LB_MODE     0x0044      /* internal loopback */
++#define DESC_OWN    0x8000
++#define DESC_STP    0x0200
++#define DESC_ENP    0x0100
++#define CSR0_STRT   0x0002
++#define CSR0_ERR    0x8000
++#define CSR0_MISS   0x1000
++#define CSR0_RINT   0x0400
++
++static QTestState *lance_loopback(const LedmaCase *c, bool am7990)
++{
++    QTestState *qts = qtest_initf("-M %s -m 64 -nodefaults%s", c->machine,
++                                  am7990 ? " -global lance.am7990=on" : "");
++    uint32_t idx = (INITBLK_DVMA - DVMA_START_64M) >> 12;
++    uint64_t pa = INITBLK_PA;
++    int i;
++
++    qtest_writel(qts, IOMMU_BASE(c), IOPT_PA >> 4);
++    qtest_writel(qts, IOMMU_CTRL(c), IOMMU_CTRL_64M_ENAB);
++    qtest_writel(qts, IOPT_PA + idx * 4,
++                 (INITBLK_PA >> 4) | IOPTE_WRITE | IOPTE_VALID);
