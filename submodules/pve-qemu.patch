+++ b/debian/patches/wsh/0020-tests-qtest-test-an-interrupt-let-in-from-a-delay-sl.patch
@@ -0,0 +1,198 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test an interrupt let in from a delay slot on sun4m
+
+A tiny boot PROM loops: it raises PIL to 15, writes the set register
+of its CPU's interrupt controller (0 in the first round, soft
+interrupt 13 from the second), counts the round and lowers PIL to 0
+with a write to %psr: a plain one, or one in the delay slot of ba, of
+a taken bne, of a taken bne,a (as in Solaris's splx) and of jmpl. The
+interrupt must be taken in the second round.
+
+Without the previous patch the four delay-slot cases fail: once the
+first round has chained the blocks, the CPU never comes back to the
+main loop and the PROM goes round and round. The plain case passes
+with and without it.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build                 |   3 +-
+ tests/qtest/sun4m-pil-delay-slot-test.c | 156 ++++++++++++++++++++++++
+ 2 files changed, 158 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-pil-delay-slot-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 04bc7dfa9b..ff0981ddfc 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -201,7 +201,8 @@ qtests_sh4eb = (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-
+ 
+ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-escc-test', 'sun4m-apc-test',
+-                'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test'] + \
++                'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test',
++                'sun4m-pil-delay-slot-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-pil-delay-slot-test.c b/tests/qtest/sun4m-pil-delay-slot-test.c
+new file mode 100644
+index 0000000000..606521a271
+--- /dev/null
++++ b/tests/qtest/sun4m-pil-delay-slot-test.c
+@@ -0,0 +1,156 @@
++/*
++ * QTest: an interrupt let in by a write to %psr in a delay slot on sun4m
++ *
++ * A boot PROM loops: it raises PIL to 15, writes the set register of its
++ * CPU's interrupt controller, counts the round in RAM and lowers PIL to 0
++ * again. In the first round it writes 0 there, from the second on the bit
++ * of soft interrupt 13, which must then be taken as soon as PIL is 0. The
++ * write to %psr that lowers PIL is a plain instruction, or in the delay
++ * slot of a branch (always, conditional, conditional with annul, jmpl):
++ * Solaris lowers PIL in the delay slot of "bl,a" in splx().
++ *
++ * QEMU looks at pending interrupts between translation blocks that don't
++ * chain, and a write to %psr ends its block for that. One in a delay slot
++ * used to chain on to the branch target instead, so once the first round
++ * had linked the blocks, the interrupt waited for something else to stop
++ * the CPU, and here nothing does. That is how two CPUs running Solaris
++ * stopped: the one that was sent a cross-call never took it.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the round the PROM is in and the trap marker */
++#define RAM_ROUND       0x1004ULL
++#define RAM_TRAP        0x1020ULL
++#define PROM_WORDS      0x200
++#define CODE            0x100           /* word index of the code */
++#define VARIANT         15              /* word index of the variant in code[] */
++#define LOOP            19              /* and of what follows it */
++#define TT_INTERRUPT_13 0x1d
++
++/* Four words that lower PIL to 0 and get to LOOP */
++static const uint32_t variants[][4] = {
++    {   /* plain */
++        0x818820a0,             /* wr    %g0, 0xa0, %psr     S, ET, PIL 0 */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++        0x01000000,             /* nop */
++    }, { /* ba */
++        0x10800004,             /* ba    next */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++        0x01000000,             /* nop (not reached) */
++    }, { /* bne, taken */
++        0x80a02001,             /* cmp   %g0, 1 */
++        0x12800003,             /* bne   next */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++    }, { /* bne,a, taken: splx() in Solaris */
++        0x80a02001,             /* cmp   %g0, 1 */
++        0x32800003,             /* bne,a next */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++    }, { /* jmpl */
++        0x84102000 | ((CODE + LOOP) * 4),   /* mov   next, %g2 */
++        0x81c0a000,             /* jmp   %g2 */
++        0x818820a0,             /*  wr   %g0, 0xa0, %psr */
++        0x01000000,             /* nop (not reached) */
++    },
++};
++
++static const char *const names[] = { "plain", "ba", "bne", "bne-annul", "jmpl" };
++
++/*
++ * The PROM: a trap table whose entries store their trap type at RAM_TRAP
++ * and stop, and at 0x400 the loop. It runs from reset: MMU off, so
++ * instructions come from the PROM and data from RAM and the devices.
++ */
++static char *write_prom(int variant)
++{
++    uint32_t code[] = {
++        0x111c7800,             /*        sethi %hi(0x71e00000), %o0  intctl */
++        0x31000004,             /*        sethi %hi(0x1000), %i0 */
++        0x92102000,             /*        mov   0, %o1          nothing yet */
++        0xa2102001,             /*        mov   1, %l1          round */
++        0x81882fa0,             /* again: wr    %g0, 0xfa0, %psr  PIL 15 */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0x01000000,             /*        nop */
++        0xd2222008,             /*        st    %o1, [%o0 + 8]  set soft ints */
++        0xc0022000,             /*        ld    [%o0], %g0 */
++        0x81882fa0,             /*        wr    %g0, 0xfa0, %psr  the CPU */
++        0x01000000,             /*        nop    looks at the interrupt */
++        0x01000000,             /*        nop    here and can't take it */
++        0x01000000,             /*        nop */
++        0xe2262004,             /*        st    %l1, [%i0 + 4]  the round */
++        0, 0, 0, 0,             /*        the variant: PIL 0 */
++        0x13080000,             /* next:  sethi %hi(0x20000000), %o1  soft 13 */
++        0xa2046001,             /*        inc   %l1 */
++        0x10bfffef,             /*        ba    again */
++        0x01000000,             /*         nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    memcpy(&code[VARIANT], variants[variant], sizeof(variants[variant]));
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    /* Trap i: store i at RAM_TRAP and stop */
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03000004);         /* sethi %hi(0x1000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4m-pil-delay-slot-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++static void test_interrupt(const void *data)
++{
++    int variant = GPOINTER_TO_INT(data);
++    g_autofree char *prom = write_prom(variant);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine SS-5 -accel tcg -bios %s", prom);
++
++    /* Without the interrupt the PROM goes round and round */
++    while (qtest_readl(qts, RAM_TRAP) == 0 &&
++           qtest_readl(qts, RAM_ROUND) < 1000) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    g_assert_cmphex(qtest_readl(qts, RAM_TRAP), ==, TT_INTERRUPT_13);
++    g_assert_cmpuint(qtest_readl(qts, RAM_ROUND), ==, 2);
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++int main(int argc, char **argv)
++{
++    int i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        for (i = 0; i < ARRAY_SIZE(variants); i++) {
++            g_autofree char *name =
++                g_strdup_printf("sun4m-pil-delay-slot/%s", names[i]);
++            qtest_add_data_func(name, GINT_TO_POINTER(i), test_interrupt);
++        }
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0021-ide-cmd646-latch-the-interrupt-status-bits-until-the.patch b/debian/patches/wsh/0021-ide-cmd646-latch-the-interrupt-status-bits-until-the.patch
new file mode 100644
index 0000000..52d882e
--- /dev/null
+++ b/debian/patches/wsh/0021-ide-cmd646-latch-the-interrupt-status-bits-until-the.patch
@@ -0,0 +1,110 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] ide/cmd646: latch the interrupt status bits until the
+ guest clears them
+
+cmd646_set_irq() set the channel's interrupt status bit in MRDMODE
+(mirrored in CFR and ARTTIM23) when a drive raised INTRQ and cleared it
+again when INTRQ dropped. A drive drops INTRQ when its status register is
+read, so a guest that reads the drive status first and then looks at
+these bits never sees them set. On the chip they are latched and cleared
+by writing 1; QEMU already has the w1c masks for them.
+
+Solaris 10's ata driver on sun4u does exactly that after SET FEATURES
+and warns for every IDE device:
+
+  WARNING: Interrupt not seen after set_features
+
+Keep the status bits set when INTRQ drops, until the guest writes 1 to
+them in config space (the BMDMA register that mirrors MRDMODE doesn't
+clear them: bmdma_write() masks them out). The PCI interrupt line keeps
+following the drives' INTRQ, now kept in a field of its own: driving it
+from the latched bits instead left it asserted for guests that don't
+clear them, and Linux disabled the interrupt ("irq 7: nobody cared") and
+OpenBSD hung at boot. A device reset clears that field (the drives come
+out of reset with INTRQ low); otherwise the next config write after a
+reset raised the line again.
+
+Tested on sun4u, the only machine in this package with a cmd646 (alpha
+and hppa have one too, and aren't built here): Solaris 10 1/13 attaches
+the disk as dad0 without the warning; NetBSD 11.1 and 9.3, OpenBSD 8.0
+and the Debian 12 installer boot as before (sparc lab, sparc64 matrix).
+The next patch adds a qtest.
+
+The new field isn't in the migration stream (vmstate_ide_pci is shared
+by every PCI IDE controller): a guest migrated with INTRQ up sees the
+line low until the drive raises it again. sparc64 migration isn't
+offered by qemu-server.
+
+paulsheer/qemu 51d72e16 ("sun4u: fix cmd646 IRQ latch and LSI 53C895
+identity for Solaris 10") latches the bits too, and drives the interrupt
+line from them; this is a separate implementation that keeps the line on
+INTRQ.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ hw/ide/cmd646.c      | 20 +++++++++++++++-----
+ include/hw/ide/pci.h |  1 +
+ 2 files changed, 16 insertions(+), 5 deletions(-)
+
+diff --git a/hw/ide/cmd646.c b/hw/ide/cmd646.c
+index d44a90a162..0e3b11208a 100644
+--- a/hw/ide/cmd646.c
++++ b/hw/ide/cmd646.c
+@@ -182,12 +182,13 @@ static void bmdma_setup_bar(PCIIDEState *d)
+ 
+ static void cmd646_update_irq(PCIDevice *pd)
+ {
++    PCIIDEState *d = PCI_IDE(pd);
+     int pci_level;
+ 
+-    pci_level = ((pd->config[MRDMODE] & MRDMODE_INTR_CH0) &&
+-                 !(pd->config[MRDMODE] & MRDMODE_BLK_CH0)) ||
+-        ((pd->config[MRDMODE] & MRDMODE_INTR_CH1) &&
+-         !(pd->config[MRDMODE] & MRDMODE_BLK_CH1));
++    /* The interrupt line follows the drives' INTRQ, not the latched status */
++    pci_level =
++        ((d->intrq & 1) && !(pd->config[MRDMODE] & MRDMODE_BLK_CH0)) ||
++        ((d->intrq & 2) && !(pd->config[MRDMODE] & MRDMODE_BLK_CH1));
+     pci_set_irq(pd, pci_level);
+ }
+ 
+@@ -199,10 +200,17 @@ static void cmd646_set_irq(void *opaque, int channel, int level)
+     int irq_mask;
+ 
+     irq_mask = MRDMODE_INTR_CH0 << channel;
++    /*
++     * The interrupt status bits (MRDMODE, mirrored in CFR/ARTTIM23) latch
++     * the drive's INTRQ and stay set until the guest writes 1 to clear
++     * them; INTRQ dropping (the guest reading the drive's status register)
++     * doesn't clear them. The PCI interrupt line follows INTRQ itself.
++     */
+     if (level) {
++        d->intrq |= 1 << channel;
+         pd->config[MRDMODE] |= irq_mask;
+     } else {
+-        pd->config[MRDMODE] &= ~irq_mask;
++        d->intrq &= ~(1 << channel);
+     }
+     cmd646_update_dma_interrupts(pd);
+     cmd646_update_irq(pd);
+@@ -216,6 +224,8 @@ static void cmd646_reset(DeviceState *dev)
+     for (i = 0; i < 2; i++) {
+         ide_bus_reset(&d->bus[i]);
+     }
++    /* The drives come out of reset with INTRQ low */
++    d->intrq = 0;
+ }
+ 
+ static uint32_t cmd646_pci_config_read(PCIDevice *d,
+diff --git a/include/hw/ide/pci.h b/include/hw/ide/pci.h
+index ef03764caa..6ecbc84130 100644
+--- a/include/hw/ide/pci.h
++++ b/include/hw/ide/pci.h
+@@ -51,6 +51,7 @@ struct PCIIDEState {
+     BMDMAState bmdma[2];
+     qemu_irq isa_irq[2];
+     uint32_t secondary; /* used only for cmd646 */
++    uint8_t intrq; /* used only for cmd646: INTRQ of channel n in bit n */
+     MemoryRegion bmdma_bar;
+     MemoryRegion cmd_bar[2];
+     MemoryRegion data_bar[2];
diff --git a/debian/patches/wsh/0022-tests-qtest-test-the-cmd646-interrupt-status-latch-o.patch b/debian/patches/wsh/0022-tests-qtest-test-the-cmd646-interrupt-status-latch-o.patch
new file mode 100644
index 0000000..0f10d3b
--- /dev/null
+++ b/debian/patches/wsh/0022-tests-qtest-test-the-cmd646-interrupt-status-latch-o.patch
@@ -0,0 +1,288 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the cmd646 interrupt status latch on
+ sun4u
+
+Nothing runs on the CPU, so the test sets up what OpenBIOS would (bus 1
+behind the simba bridge at 00:01.1, the cmd646's I/O BARs) and routes
+the sabre's IDE interrupt request to itself. A SET FEATURES on the
+primary master raises INTRQ; reading the status register drops it. The
+interrupt status bits in MRDMODE and CFR must stay set until the test
+writes 1 to clear them, and the PCI interrupt line must follow INTRQ
+whatever the bits are: the line is seen through the sabre, which raises
+its request again when the guest clears it while the line is still up.
+
+reset-drops-intrq resets the machine with INTRQ up: the drives come out
+of the reset with INTRQ low, so the line must stay down when the
+firmware sets the controller up again.
+
+Without the previous patch status-latched fails (MRDMODE reads 0 after
+the status read). With the line driven from the latched bits instead of
+INTRQ (the variant that broke Linux and OpenBSD) it fails too (the line
+stays up after the status read). Without the clear of INTRQ in
+cmd646_reset() reset-drops-intrq fails. With the patch all three pass.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build         |   2 +-
+ tests/qtest/sun4u-cmd646-test.c | 239 ++++++++++++++++++++++++++++++++
+ 2 files changed, 240 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4u-cmd646-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index ff0981ddfc..9bc0107c5e 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -208,7 +208,7 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+ qtests_sparc64 = \
+   (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-test'] : []) +            \
+   qtests_filter + \
+-  ['prom-env-test', 'boot-serial-test']
++  ['prom-env-test', 'boot-serial-test', 'sun4u-cmd646-test']
+ 
+ qtests_npcm7xx = \
+   ['npcm7xx_adc-test',
+diff --git a/tests/qtest/sun4u-cmd646-test.c b/tests/qtest/sun4u-cmd646-test.c
+new file mode 100644
+index 0000000000..1a982268ba
+--- /dev/null
++++ b/tests/qtest/sun4u-cmd646-test.c
+@@ -0,0 +1,239 @@
++/*
++ * QTest: the cmd646 interrupt status bits on sun4u
++ *
++ * The cmd646's interrupt status bits (MRDMODE, mirrored in CFR and
++ * ARTTIM23) latch a drive's INTRQ and stay set until the guest writes 1 to
++ * clear them. Solaris's ata driver reads the drive's status register,
++ * which drops INTRQ, and then looks at these bits; it warned "Interrupt
++ * not seen after set_features" when they had followed INTRQ down.
++ *
++ * The PCI interrupt line must still follow INTRQ: guests that never clear
++ * the bits (Linux, OpenBSD) would otherwise see it stuck high. It is
++ * watched through the sabre, which turns the line into a request for the
++ * CPU and re-raises that request when the guest clears it while the line
++ * is still up.
++ *
++ * Nothing runs on the CPU, so the test sets up what OpenBIOS would: bus 1
++ * behind the simba bridge at 00:01.1 and the cmd646's I/O BARs.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qobject/qdict.h"
++#include "hw/pci/pci_regs.h"
++
++#define SABRE_CONFIG    0x1fe00000000ULL    /* sabre registers (big-endian) */
++#define PCI_CONFIG      0x1fe01000000ULL    /* PCI configuration space */
++#define PCI_IO          0x1fe02000000ULL    /* PCI I/O space */
++/* OBIO interrupt map and clear registers of ino 0x20, the IDE controller */
++#define OBIO_IMR_HDD    (SABRE_CONFIG + 0x1004)
++#define OBIO_CLR_HDD    (SABRE_CONFIG + 0x1804)
++#define IMR_ENABLED     0x80000000
++#define IVEC_HDD        0x20
++
++#define DEVFN_SIMBA_A   0x09                /* 00:01.1 */
++#define DEVFN_CMD646    0x18                /* 01:03.0 */
++#define IO_CMD0         0x400               /* BAR0: channel 0 command block */
++#define IO_CTL0         0x408               /* BAR1: channel 0 control block */
++
++#define CFR             0x50
++#define CFR_INTR_CH0    0x04
++#define MRDMODE         0x71
++#define MRDMODE_INTR_CH0 0x04
++
++#define ATA_FEATURE     1
++#define ATA_NSECTOR     2
++#define ATA_DEVICE      6
++#define ATA_STATUS      7                   /* read: status, write: command */
++#define ATA_DEVCTL      2                   /* in the control block */
++#define CMD_SET_FEATURES 0xef
++#define STATUS_BSY      0x80
++#define STATUS_ERR      0x01
++
++static uint64_t cfg_addr(int bus, int devfn, int reg)
++{
++    return PCI_CONFIG + (bus << 16) + (devfn << 8) + reg;
++}
++
++/* Byte accesses only: both spaces are little-endian on a big-endian CPU */
++static uint8_t cfg_read(QTestState *qts, int bus, int devfn, int reg)
++{
++    return qtest_readb(qts, cfg_addr(bus, devfn, reg));
++}
++
++static void cfg_write(QTestState *qts, int bus, int devfn, int reg,
++                      uint32_t val, int len)
++{
++    int i;
++
++    for (i = 0; i < len; i++) {
++        qtest_writeb(qts, cfg_addr(bus, devfn, reg + i), val >> (8 * i));
++    }
++}
++
++static const char *find_sabre(QTestState *qts)
++{
++    static char path[64];
++    int i;
++
++    for (i = 0; i < 64; i++) {
++        QDict *rsp;
++        bool found;
++
++        snprintf(path, sizeof(path), "/machine/unattached/device[%d]", i);
++        rsp = qtest_qmp(qts, "{ 'execute': 'qom-get', 'arguments': "
++                        "{ 'path': %s, 'property': 'type' } }", path);
++        found = qdict_haskey(rsp, "return") &&
++                !strcmp(qdict_get_str(rsp, "return"), "sabre");
++        qobject_unref(rsp);
++        if (found) {
++            return path;
++        }
++    }
++    g_assert_not_reached();
++}
++
++/* What OpenBIOS would set up, after power-on or a reset */
++static void configure(QTestState *qts)
++{
++    qtest_writel(qts, OBIO_IMR_HDD, IMR_ENABLED);
++
++    /* Bus 1 behind 00:01.1, which already forwards I/O 0-0xfff */
++    cfg_write(qts, 0, DEVFN_SIMBA_A, PCI_SECONDARY_BUS, 1, 1);
++    cfg_write(qts, 0, DEVFN_SIMBA_A, PCI_SUBORDINATE_BUS, 1, 1);
++    g_assert_cmphex(cfg_read(qts, 1, DEVFN_CMD646, PCI_VENDOR_ID), ==, 0x95);
++    g_assert_cmphex(cfg_read(qts, 1, DEVFN_CMD646, PCI_DEVICE_ID), ==, 0x46);
++
++    cfg_write(qts, 1, DEVFN_CMD646, PCI_BASE_ADDRESS_0, IO_CMD0, 4);
++    cfg_write(qts, 1, DEVFN_CMD646, PCI_BASE_ADDRESS_1, IO_CTL0, 4);
++    cfg_write(qts, 1, DEVFN_CMD646, PCI_COMMAND, PCI_COMMAND_IO, 2);
++
++    /* Drive interrupts on (nIEN clear), no interrupt so far */
++    qtest_writeb(qts, PCI_IO + IO_CTL0 + ATA_DEVCTL, 0);
++    g_assert_false(qtest_get_irq(qts, IVEC_HDD));
++}
++
++static QTestState *setup(void)
++{
++    QTestState *qts;
++
++    qts = qtest_init("-machine sun4u -nodefaults "
++                     "-blockdev driver=null-co,read-zeroes=on,node-name=d0 "
++                     "-device ide-hd,drive=d0,bus=ide.0,unit=0");
++
++    /* The sabre's IDE interrupt request goes to the test, not the CPU */
++    qtest_irq_intercept_out_named(qts, find_sabre(qts), "ivec-irq");
++    configure(qts);
++    return qts;
++}
++
++/* SET FEATURES (transfer mode PIO 4): completes at once, raising INTRQ */
++static void set_features(QTestState *qts)
++{
++    qtest_writeb(qts, PCI_IO + IO_CMD0 + ATA_DEVICE, 0xa0);
++    qtest_writeb(qts, PCI_IO + IO_CMD0 + ATA_FEATURE, 0x03);
++    qtest_writeb(qts, PCI_IO + IO_CMD0 + ATA_NSECTOR, 0x0c);
++    qtest_writeb(qts, PCI_IO + IO_CMD0 + ATA_STATUS, CMD_SET_FEATURES);
++}
++
++static uint8_t mrdmode(QTestState *qts)
++{
++    return cfg_read(qts, 1, DEVFN_CMD646, MRDMODE) & MRDMODE_INTR_CH0;
++}
++
++static uint8_t cfr(QTestState *qts)
++{
++    return cfg_read(qts, 1, DEVFN_CMD646, CFR) & CFR_INTR_CH0;
++}
++
++/*
++ * The guest acknowledges the sabre's request; it comes back while the line
++ * is up
++ */
++static bool line_after_clear(QTestState *qts)
++{
++    qtest_writel(qts, OBIO_CLR_HDD, 0);
++    return qtest_get_irq(qts, IVEC_HDD);
++}
++
++static void test_status_latched(void)
++{
++    QTestState *qts = setup();
++    uint8_t status;
++
++    set_features(qts);
++    g_assert_true(qtest_get_irq(qts, IVEC_HDD));
++    g_assert_cmphex(mrdmode(qts), ==, MRDMODE_INTR_CH0);
++    g_assert_cmphex(cfr(qts), ==, CFR_INTR_CH0);
++    g_assert_true(line_after_clear(qts));
++
++    /* Reading the status drops INTRQ: the line goes down, the bits stay */
++    status = qtest_readb(qts, PCI_IO + IO_CMD0 + ATA_STATUS);
++    g_assert_cmphex(status & (STATUS_BSY | STATUS_ERR), ==, 0);
++    g_assert_false(line_after_clear(qts));
++    g_assert_cmphex(mrdmode(qts), ==, MRDMODE_INTR_CH0);
++    g_assert_cmphex(cfr(qts), ==, CFR_INTR_CH0);
++
++    /* Writing 1 clears them, in MRDMODE and in its CFR mirror */
++    cfg_write(qts, 1, DEVFN_CMD646, MRDMODE, MRDMODE_INTR_CH0, 1);
++    g_assert_cmphex(mrdmode(qts), ==, 0);
++    g_assert_cmphex(cfr(qts), ==, 0);
++    g_assert_false(line_after_clear(qts));
++
++    qtest_quit(qts);
++}
++
++static void test_clear_keeps_line(void)
++{
++    QTestState *qts = setup();
++
++    /* Clearing the bits while INTRQ is up leaves the line up */
++    set_features(qts);
++    cfg_write(qts, 1, DEVFN_CMD646, MRDMODE, MRDMODE_INTR_CH0, 1);
++    g_assert_cmphex(mrdmode(qts), ==, 0);
++    g_assert_true(line_after_clear(qts));
++
++    /* until the guest reads the status */
++    qtest_readb(qts, PCI_IO + IO_CMD0 + ATA_STATUS);
++    g_assert_false(line_after_clear(qts));
++
++    /* The next command latches the bits again */
++    set_features(qts);
++    g_assert_cmphex(mrdmode(qts), ==, MRDMODE_INTR_CH0);
++    g_assert_true(line_after_clear(qts));
++
++    qtest_quit(qts);
++}
++
++/*
++ * A reset with INTRQ up: the drives come out of it with INTRQ low, so the
++ * line must stay down when the firmware sets the controller up again.
++ */
++static void test_reset_drops_intrq(void)
++{
++    QTestState *qts = setup();
++
++    set_features(qts);
++    g_assert_true(qtest_get_irq(qts, IVEC_HDD));
++    /* Masking the interrupt in the sabre withdraws its request */
++    qtest_writel(qts, OBIO_IMR_HDD, 0);
++    g_assert_false(qtest_get_irq(qts, IVEC_HDD));
++
++    qtest_system_reset(qts);
++    configure(qts);
++
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4u-cmd646/status-latched", test_status_latched);
++    qtest_add_func("sun4u-cmd646/clear-keeps-line", test_clear_keeps_line);
++    qtest_add_func("sun4u-cmd646/reset-drops-intrq", test_reset_drops_intrq);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0023-target-sparc-halt-idle-CPUs-in-the-Solaris-multiproc.patch b/debian/patches/wsh/0023-target-sparc-halt-idle-CPUs-in-the-Solaris-multiproc.patch
new file mode 100644
index 0000000..2c256f1
--- /dev/null
+++ b/debian/patches/wsh/0023-target-sparc-halt-idle-CPUs-in-the-Solaris-multiproc.patch
@@ -0,0 +1,717 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: halt idle CPUs in the Solaris multiprocessor idle loop
+
+With more than one CPU, the idle thread of Solaris 2.5.1 to 9 runs
+another loop than the one solaris_idle handles: it never calls idle_cpu,
+it polls the CPU's own dispatch queue and calls disp_getwork() to take a
+thread from the kernel preemption queue or from another CPU. Every idle
+vCPU keeps a host core busy, and as each round raises and lowers the
+interrupt level (helper_wrpsr takes the BQL), the polling CPUs also slow
+down the busy ones. And nothing tells an idle CPU that it has work:
+setbackdq() puts a thread on its queue and counts it in disp_nrunnable,
+cpu_resched() pokes only a CPU that runs a thread, and only one CPU takes
+the clock. So a plain halt until the next interrupt could leave work
+waiting indefinitely.
+
+The translator recognises the call of disp_getwork in that loop by the
+words from the load of disp_nrunnable to the call (one layout for the
+kernels of 2.6, 7, 8 and 9, another for 2.5.1). At the call a helper
+halts the CPU when disp_nrunnable is 0, interrupts are enabled at level
+0 and none is pending, after the loop has found nothing for 100 us. The
+halt ends:
+
+- when another CPU queues work for it: Solaris queues threads at a
+  raised interrupt level and lowers it with a write to %psr afterwards,
+  so helper_wrpsr() wakes every CPU halted in the loop whose
+  disp_nrunnable is no longer 0, and one of them when the writing CPU
+  has more than one thread queued (what disp_getwork() would take);
+- at the next interrupt, as with one CPU;
+- 10 ms after it began, from a timer: work that reaches the CPU in any
+  other way (a thread on the kernel preemption queue, a race) waits at
+  most that long. disp_getwork() runs once then, and the CPU halts again
+  if it found nothing.
+
+The halted CPUs and their disp_nrunnable are in a mask that the writer
+reads after a full barrier, as the halting CPU reads disp_nrunnable
+again after setting its bit, and the kick is a flag that
+sparc_cpu_has_work() sees, set with the BQL held. A migrated CPU that was
+halted there is woken on the destination (a subsection, sent only then).
+The Solaris idle helpers now read disp_nrunnable through a host pointer
+looked up once by a page table walk: probe_access_flags() would assert
+when another CPU had flushed the TLB entry since the loop's load.
+With the MMU off the address is physical: the debug lookup tries an
+instruction fetch first, which boot mode would take from the PROM.
+
+The board turns this on with env->solaris_idle_mp.
+-trace sparc_solaris_idle_mp_match shows whether a kernel was recognised,
+sparc_solaris_idle_mp and sparc_solaris_idle_mp_wake each halt and why it
+ended.
+
+An idle Solaris 2.6 on an SS-20 then uses 4-5% of a host core with 2
+or 4 CPUs, about as much as with one, instead of 198% and 341%. A single
+CPU-bound job is no longer slowed down by the polling CPUs (an awk loop
+alone 5.3-5.6 s with 2 and 4 CPUs instead of 8.6 and 16 s; 5.3-6.3 s
+with one CPU), and pipe round trips, fork, pipelines and parallel jobs
+take as long as before with 2 CPUs and less time with 4. The CPU that
+ran a thread polls again for 100 us before it halts (a round more than
+20 us after the one before restarts the poll): with a 100 us gap
+instead, lat_pipe with 2 CPUs took 15% longer.
+
