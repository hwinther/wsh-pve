++    uint32_t base_mask;     /* the bits the page table base register keeps */
++    uint32_t sbcfg_mask;    /* the bits the SBus slot configuration keeps */
++    uint32_t tlb_data_mask; /* the bits the TLB data entries keep */
+ };
+ typedef struct IOMMUState IOMMUState;
+ 
diff --git a/debian/patches/wsh/0154-tests-qtest-test-the-register-bits-the-sun4m-IOMMU-k.patch b/debian/patches/wsh/0154-tests-qtest-test-the-register-bits-the-sun4m-IOMMU-k.patch
new file mode 100644
index 0000000..e6a0492
--- /dev/null
+++ b/debian/patches/wsh/0154-tests-qtest-test-the-register-bits-the-sun4m-IOMMU-k.patch
@@ -0,0 +1,160 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the register bits the sun4m IOMMU keeps
+
+qtest sun4m-iommu-regs-test: on SS-600MP the base register keeps bits
+31-10, each SBus slot register bits 17-15 and 3-0 (written as the PROM
+does, one pattern there and the other to the next slot, and each slot
+keeps its own), the TLB tags all bits and the TLB data all but bits 6-3
+and 0 with the diagnostic bit set; on SS-10, SS-20 and SS-5 the old
+masks (0x07fffc00, 0x00010003, all bits). 12 cases; the three SS-600MP
+cases fail without the previous patch.
+---
+ tests/qtest/meson.build             |   3 +-
+ tests/qtest/sun4m-iommu-regs-test.c | 124 ++++++++++++++++++++++++++++
+ 2 files changed, 126 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-iommu-regs-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 74a82af..66dae63 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -221,7 +221,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-ss600mp-test',
+                 'sun4m-dbri-test',
+                 'sun4m-escc-break-test',
+-                'sun4m-ecc-test'] + \
++                'sun4m-ecc-test',
++                'sun4m-iommu-regs-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-iommu-regs-test.c b/tests/qtest/sun4m-iommu-regs-test.c
+new file mode 100644
+index 0000000..875ba95
+--- /dev/null
++++ b/tests/qtest/sun4m-iommu-regs-test.c
+@@ -0,0 +1,124 @@
++/*
++ * QTest: the register bits the sun4m IOMMU keeps
++ *
++ * Sun's SPARCserver 600MP boot PROM writes 0x5a5a5a5a and 0xa5a5a5a5 to
++ * the IOMMU's page table base register, its four SBus slot configuration
++ * registers and, with the diagnostic bit of the control register set, its
++ * TLB tags and data, and wants back the bits the 600MP's IOMMU keeps:
++ * bits 31-10 of the base, bits 17-15 and 3-0 of each slot register (each
++ * slot its own), all of a tag and all but bits 6-3 and 0 of a data entry.
++ * QEMU kept the microSPARC-II's base bits (26-10) and bits 16 and 1-0 of
++ * the slot registers. The other machines keep what they kept.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++typedef struct {
++    const char *machine;
++    uint64_t iommu_base;
++    uint32_t base_mask;
++    uint32_t sbcfg_mask;
++    uint32_t tlb_data_mask;
++} IOMMUCase;
++
++static const IOMMUCase cases[] = {
++    { "SS-600MP", 0xfe0000000ULL, 0xfffffc00, 0x0003800f, 0xffffff86 },
++    { "SS-10",    0xfe0000000ULL, 0x07fffc00, 0x00010003, 0xffffffff },
++    { "SS-20",    0xfe0000000ULL, 0x07fffc00, 0x00010003, 0xffffffff },
++    { "SS-5",     0x10000000ULL,  0x07fffc00, 0x00010003, 0xffffffff },
++};
++
++#define IOMMU_CTRL      0x0000
++#define IOMMU_BASE      0x0004
++#define IOMMU_TLB_TAG   0x0100
++#define IOMMU_TLB_DATA  0x0200
++#define IOMMU_SBCFG(n)  (0x1010 + 4 * (n))
++#define IOMMU_CTRL_DIAG 0x2
++
++#define PATTERN_A       0x5a5a5a5a
++#define PATTERN_B       0xa5a5a5a5
++
++static void test_base(const void *opaque)
++{
++    const IOMMUCase *c = opaque;
++    QTestState *qts = qtest_initf("-machine %s", c->machine);
++    uint64_t reg = c->iommu_base + IOMMU_BASE;
++
++    qtest_writel(qts, reg, PATTERN_A);
++    g_assert_cmphex(qtest_readl(qts, reg), ==, PATTERN_A & c->base_mask);
++    qtest_writel(qts, reg, PATTERN_B);
++    g_assert_cmphex(qtest_readl(qts, reg), ==, PATTERN_B & c->base_mask);
++    qtest_writel(qts, reg, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, reg), ==, c->base_mask);
++    qtest_quit(qts);
++}
++
++/* as the PROM does it: one pattern to a slot, the other to the next */
++static void test_sbcfg(const void *opaque)
++{
++    const IOMMUCase *c = opaque;
++    QTestState *qts = qtest_initf("-machine %s", c->machine);
++    int slot;
++
++    for (slot = 0; slot < 4; slot++) {
++        uint64_t reg = c->iommu_base + IOMMU_SBCFG(slot);
++        uint64_t other = c->iommu_base + IOMMU_SBCFG((slot + 3) % 4);
++
++        qtest_writel(qts, reg, PATTERN_A);
++        qtest_writel(qts, other, PATTERN_B);
++        g_assert_cmphex(qtest_readl(qts, reg), ==, PATTERN_A & c->sbcfg_mask);
++        qtest_writel(qts, reg, PATTERN_B);
++        qtest_writel(qts, other, PATTERN_A);
++        g_assert_cmphex(qtest_readl(qts, reg), ==, PATTERN_B & c->sbcfg_mask);
++        g_assert_cmphex(qtest_readl(qts, other), ==,
++                        PATTERN_A & c->sbcfg_mask);
++    }
++    qtest_quit(qts);
++}
++
++static void test_tlb(const void *opaque)
++{
++    const IOMMUCase *c = opaque;
++    QTestState *qts = qtest_initf("-machine %s", c->machine);
++    int i;
++
++    qtest_writel(qts, c->iommu_base + IOMMU_CTRL, IOMMU_CTRL_DIAG);
++    for (i = 0; i < 16; i++) {
++        uint64_t tag = c->iommu_base + IOMMU_TLB_TAG + 4 * i;
++        uint64_t data = c->iommu_base + IOMMU_TLB_DATA + 4 * i;
++
++        qtest_writel(qts, tag, PATTERN_A);
++        qtest_writel(qts, data, PATTERN_A);
++        g_assert_cmphex(qtest_readl(qts, tag), ==, PATTERN_A);
++        g_assert_cmphex(qtest_readl(qts, data), ==,
++                        PATTERN_A & c->tlb_data_mask);
++        qtest_writel(qts, data, 0xffffffff);
++        g_assert_cmphex(qtest_readl(qts, data), ==, c->tlb_data_mask);
++    }
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    int i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    for (i = 0; i < ARRAY_SIZE(cases); i++) {
++        g_autofree char *base =
++            g_strdup_printf("sun4m-iommu-regs/%s/base", cases[i].machine);
++        g_autofree char *sbcfg =
++            g_strdup_printf("sun4m-iommu-regs/%s/sbcfg", cases[i].machine);
++        g_autofree char *tlb =
++            g_strdup_printf("sun4m-iommu-regs/%s/tlb", cases[i].machine);
++
++        qtest_add_data_func(base, &cases[i], test_base);
++        qtest_add_data_func(sbcfg, &cases[i], test_sbcfg);
++        qtest_add_data_func(tlb, &cases[i], test_tlb);
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0155-hw-sparc-sun4m-keep-the-SS-600MP-VMEbus-control-regi.patch b/debian/patches/wsh/0155-hw-sparc-sun4m-keep-the-SS-600MP-VMEbus-control-regi.patch
new file mode 100644
index 0000000..4ad0a06
--- /dev/null
+++ b/debian/patches/wsh/0155-hw-sparc-sun4m-keep-the-SS-600MP-VMEbus-control-regi.patch
@@ -0,0 +1,151 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: keep the SS-600MP VMEbus control register's
+ enable bits
+
+Sun's SPARCserver 600MP boot PROM writes a walking one and all ones to
+the VMEbus interface's control register at 0xf.df01_0000 and wants back
+bits 31-28 (progress 0xb0 of its power-on self test, a loop on error
+otherwise). As NetBSD's vmereg.h names them, those are the I/O cache
+enable, VME slave enable, loopback and VMEbus reset bits, and bits 3-0
+are the interface's implementation number, here 0. The machine had the
+registers as an unimplemented device (wsh/0063), which reads 0.
+
+A small device sun4m-vme replaces it: the control register keeps bits
+31-28, the fault registers (AFAR, AFSR) and the rest of the page read 0
+and ignore writes as before. Nothing acts on the bits: no VMEbus, no I/O
+cache, no loopback. SunOS 4.1.2 writes the slave enable bit before its
+banner and now reads it back. vmstate sun4m-vme with the register; only
+the SS-600MP has the device.
+---
+ hw/sparc/sun4m.c | 103 +++++++++++++++++++++++++++++++++++++++++++++--
+ 1 file changed, 99 insertions(+), 4 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index b928dd8..207a90d 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -660,6 +660,100 @@ struct AFXState {
+     MemoryRegion mem;
+ };
+ 
++/*
++ * The SPARCserver 600MP's VMEbus interface registers: control, AFAR and
++ * AFSR (NetBSD's vmereg.h). The control register keeps its four enable
++ * bits: I/O cache, VME slave, loopback and VMEbus reset (bits 31-28);
++ * its implementation number (bits 3-0) reads 0. The boot PROM writes a
++ * walking one and all ones to it and wants these bits back. There is no
++ * VMEbus or I/O cache behind them; the fault registers read 0 and the
++ * rest of the page is ignored, as before.
++ */
++#define TYPE_SUN4M_VME "sun4m-vme"
++OBJECT_DECLARE_SIMPLE_TYPE(Sun4mVMEState, SUN4M_VME)
++
++#define VME_REGS_SIZE   0x1000
++#define VME_CR          0x0
++#define VME_CR_MASK     0xf0000000
++
++struct Sun4mVMEState {
++    SysBusDevice parent_obj;
++
++    MemoryRegion iomem;
++    uint32_t cr;
++};
++
++static uint64_t sun4m_vme_read(void *opaque, hwaddr addr, unsigned size)
++{
++    Sun4mVMEState *s = opaque;
++
++    return addr == VME_CR ? s->cr : 0;
++}
++
++static void sun4m_vme_write(void *opaque, hwaddr addr, uint64_t val,
++                            unsigned size)
++{
++    Sun4mVMEState *s = opaque;
++
++    if (addr == VME_CR) {
++        s->cr = val & VME_CR_MASK;
++    }
++}
++
++static const MemoryRegionOps sun4m_vme_ops = {
++    .read = sun4m_vme_read,
++    .write = sun4m_vme_write,
++    .endianness = DEVICE_BIG_ENDIAN,
++    .valid = {
++        .min_access_size = 1,
++        .max_access_size = 8,
++    },
++    .impl = {
++        .min_access_size = 4,
++        .max_access_size = 4,
++    },
++};
++
++static void sun4m_vme_reset(DeviceState *d)
++{
++    SUN4M_VME(d)->cr = 0;
++}
++
++static void sun4m_vme_init(Object *obj)
++{
++    Sun4mVMEState *s = SUN4M_VME(obj);
++
++    memory_region_init_io(&s->iomem, obj, &sun4m_vme_ops, s, "sun-vme",
++                          VME_REGS_SIZE);
++    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
++}
++
++static const VMStateDescription vmstate_sun4m_vme = {
++    .name = TYPE_SUN4M_VME,
++    .version_id = 1,
++    .minimum_version_id = 1,
++    .fields = (const VMStateField[]) {
++        VMSTATE_UINT32(cr, Sun4mVMEState),
++        VMSTATE_END_OF_LIST()
++    }
++};
++
++static void sun4m_vme_class_init(ObjectClass *oc, const void *data)
++{
++    DeviceClass *dc = DEVICE_CLASS(oc);
++
++    device_class_set_legacy_reset(dc, sun4m_vme_reset);
++    dc->vmsd = &vmstate_sun4m_vme;
++}
++
++static const TypeInfo sun4m_vme_info = {
++    .name          = TYPE_SUN4M_VME,
++    .parent        = TYPE_SYS_BUS_DEVICE,
++    .instance_size = sizeof(Sun4mVMEState),
++    .instance_init = sun4m_vme_init,
++    .class_init    = sun4m_vme_class_init,
++};
++
+ /* SS-5 TCX AFX register */
+ static void afx_init(hwaddr addr)
+ {
+@@ -1266,11 +1360,11 @@ static void sun4m_hw_init(MachineState *machine)
+         /*
+          * The SPARCserver 600MP's VMEbus interface registers (control,
+          * AFSR, AFAR), which SunOS 4.1.2 sets up through the MMU bypass
+-         * before its banner. No VMEbus model: reads 0, writes ignored, and
+-         * the VMEbus spaces themselves stay empty, so the kernel's probes
+-         * for VME devices find none.
++         * before its banner. No VMEbus model: the control register keeps
++         * its enable bits (TYPE_SUN4M_VME), the VMEbus spaces themselves
++         * stay empty, so the kernel's probes for VME devices find none.
+          */
+-        create_unimplemented_device("sun-vme", hwdef->vme_base, 0x1000);
++        sysbus_create_simple(TYPE_SUN4M_VME, hwdef->vme_base, NULL);
+     }
+ 
+     if (hwdef->bpp_base) {
+@@ -1786,6 +1880,7 @@ static void sun4m_register_types(void)
+ {
+     type_register_static(&idreg_info);
+     type_register_static(&afx_info);
++    type_register_static(&sun4m_vme_info);
+     type_register_static(&prom_info);
+     type_register_static(&ram_info);
+ }
diff --git a/debian/patches/wsh/0156-tests-qtest-test-the-SS-600MP-VMEbus-control-registe.patch b/debian/patches/wsh/0156-tests-qtest-test-the-SS-600MP-VMEbus-control-registe.patch
new file mode 100644
index 0000000..85b3848
--- /dev/null
+++ b/debian/patches/wsh/0156-tests-qtest-test-the-SS-600MP-VMEbus-control-registe.patch
@@ -0,0 +1,67 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the SS-600MP VMEbus control register
+
+sun4m-ss600mp-test's vme-regs case: the region is the sun4m-vme device
+(priority 0); the control register reads 0 after start, keeps bits
+31-28 of a walking one and of all ones, keeps the slave enable bit that
+SunOS 4.1.2 writes, and is 0 again after a system reset; the fault
+registers and the rest of the page read 0. Fails without the previous
+patch.
+---
+ tests/qtest/sun4m-ss600mp-test.c | 25 +++++++++++++++++++++----
+ 1 file changed, 21 insertions(+), 4 deletions(-)
+
+diff --git a/tests/qtest/sun4m-ss600mp-test.c b/tests/qtest/sun4m-ss600mp-test.c
+index d68cc8d..6be5c61 100644
+--- a/tests/qtest/sun4m-ss600mp-test.c
++++ b/tests/qtest/sun4m-ss600mp-test.c
+@@ -3,8 +3,9 @@
+  *
+  * SunOS 4.1.2's kernel sets up the 600MP's VMEbus interface at physical
+  * 0xf.df01_0000 (control, AFSR, AFAR) through the MMU bypass ASI before
+- * its banner; the machine has them as an unimplemented device (reads 0,
+- * writes ignored).
++ * its banner. The control register keeps its four enable bits (31-28),
++ * which the boot PROM writes and reads back; its implementation number,
++ * the fault registers and the rest of the page read 0.
+  *
+  * The 600MP's lance works in a 128 KB buffer memory of its own below its
+  * registers (the "lebuffer" node, SBus slot f offset 0x40000), not through
+@@ -21,6 +22,7 @@
+ #include "libqtest.h"
+ 
+ #define VME_REGS        0xfdf010000ULL
++#define VME_CR_MASK     0xf0000000      /* I/O cache, slave, loopback, reset */
+ #define LEBUFFER        0xef0040000ULL
+ #define LEBUFFER_SIZE   0x20000
+ #define LE_RDP          0xef0060000ULL
+@@ -71,12 +73,27 @@ static void test_vme_regs(void)
+     QTestState *qts = qtest_init("-machine SS-600MP -m 64");
+     g_autofree char *mtree = qtest_hmp(qts, "info mtree");
+ 
++    uint32_t bit;
++
+     g_assert_true(has_region(mtree, "0000000fdf010000-0000000fdf010fff "
+-                             "(prio -1000, i/o): sun-vme"));
+-    qtest_writel(qts, VME_REGS, 0x40000000);
++                             "(prio 0, i/o): sun-vme"));
+     g_assert_cmphex(qtest_readl(qts, VME_REGS), ==, 0);
++    /* as the PROM does it: a walking one, then all ones */
++    for (bit = 1; bit; bit <<= 1) {
++        qtest_writel(qts, VME_REGS, bit);
++        g_assert_cmphex(qtest_readl(qts, VME_REGS), ==, bit & VME_CR_MASK);
++    }
++    qtest_writel(qts, VME_REGS, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, VME_REGS), ==, VME_CR_MASK);
+     g_assert_cmphex(qtest_readl(qts, VME_REGS + 4), ==, 0);
+     g_assert_cmphex(qtest_readl(qts, VME_REGS + 8), ==, 0);
++    g_assert_cmphex(qtest_readl(qts, VME_REGS + 0x10), ==, 0);
++    /* what SunOS 4.1.2 writes, the slave enable bit */
++    qtest_writel(qts, VME_REGS, 0x40000000);
++    g_assert_cmphex(qtest_readl(qts, VME_REGS), ==, 0x40000000);
++    qtest_qmp_assert_success(qts, "{ 'execute': 'system_reset' }");
++    qtest_qmp_eventwait(qts, "RESET");
++    g_assert_cmphex(qtest_readl(qts, VME_REGS), ==, 0);
+     qtest_quit(qts);
+ }
+ 
diff --git a/debian/patches/wsh/0157-hw-net-lance-keep-two-bits-of-the-SS-600MP-lance-s-r.patch b/debian/patches/wsh/0157-hw-net-lance-keep-two-bits-of-the-SS-600MP-lance-s-r.patch
new file mode 100644
index 0000000..b4598c2
--- /dev/null
+++ b/debian/patches/wsh/0157-hw-net-lance-keep-two-bits-of-the-SS-600MP-lance-s-r.patch
@@ -0,0 +1,126 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/net/lance: keep two bits of the SS-600MP lance's register
+ address port
+
+Sun's SPARCserver 600MP boot PROM writes a walking one and all ones to
+the lance's register address port (RAP) and wants bits 1-0 back
+(progress 0xc1 of its power-on self test, a loop on error otherwise).
+The Am7990 has four CSRs and a two-bit RAP; the PCnet core behind
+QEMU's lance has 128 CSRs and keeps bits 6-0.
+
+New property rap-mask on the lance (default 0x7f, the old behaviour),
+and an hwdef field le_rap_mask that only the SS-600MP sets, to 0x3.
+The other machines are unchanged; the drivers for the chip (SunOS,
+Solaris, NetBSD, Linux) select only CSR0-CSR3 either way. On the
+SS-600MP the PCnet core's CSR4 and up (station address, mode) are no
+longer reachable through the RAP, as on the real chip. No new state.
+---
+ hw/net/lance.c         | 12 ++++++++++++
+ hw/sparc/sun4m.c       | 16 ++++++++++++++--
+ include/hw/net/lance.h |  1 +
+ 3 files changed, 27 insertions(+), 2 deletions(-)
+
+diff --git a/hw/net/lance.c b/hw/net/lance.c
+index 5d5bf9b..acfbb9e 100644
+--- a/hw/net/lance.c
++++ b/hw/net/lance.c
+@@ -46,6 +46,9 @@
+ #include "system/system.h"
+ 
+ 
++/* the register address port (RDP at 0, RAP at 2) */
++#define LANCE_RAP       2
++
+ static void parent_lance_reset(void *opaque, int irq, int level)
+ {
+     SysBusPCNetState *d = opaque;
+@@ -59,6 +62,9 @@ static void lance_mem_write(void *opaque, hwaddr addr,
+     SysBusPCNetState *d = opaque;
+ 
+     trace_lance_mem_writew(addr, val & 0xffff);
++    if (addr == LANCE_RAP) {
++        val &= d->rap_mask;
++    }
+     pcnet_ioport_writew(&d->state, addr, val & 0xffff);
+ }
+ 
+@@ -141,6 +147,12 @@ static const Property lance_properties[] = {
+     DEFINE_PROP_LINK("dma", SysBusPCNetState, state.dma_opaque,
+                      TYPE_DEVICE, DeviceState *),
+     DEFINE_NIC_PROPERTIES(SysBusPCNetState, state.conf),
++    /*
++     * The Am7990's register address port selects one of its four CSRs
++     * and keeps bits 1-0; the PCnet core behind it has 128 CSRs and keeps
++     * bits 6-0, the default here.
++     */
++    DEFINE_PROP_UINT32("rap-mask", SysBusPCNetState, rap_mask, 0x7f),
+ };
+ 
+ static void lance_class_init(ObjectClass *klass, const void *data)
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 207a90d..f41ed15 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -115,6 +115,7 @@ struct sun4m_hwdef {
+     uint32_t iommu_base_mask;   /* if set: the bits the base register keeps */
+     uint32_t iommu_sbcfg_mask;  /* if set: the bits the slot registers keep */
+     uint32_t iommu_tlb_data_mask; /* if set: the bits its TLB data keeps */
++    uint32_t le_rap_mask;       /* if set: the bits the lance's RAP keeps */
+     uint16_t machine_id;
+     uint8_t nvram_machine_id;
+     bool timer_read_ahead;      /* a counter read moves on (slavio_timer) */
+@@ -330,7 +331,8 @@ static void *iommu_init(hwaddr addr, uint32_t version, uint32_t base_mask,
+ static void *sparc32_dma_init(hwaddr dma_base,
+                               hwaddr esp_base, qemu_irq espdma_irq,
+                               hwaddr le_base, qemu_irq ledma_irq,
+-                              hwaddr lebuffer_base, MACAddr *mac)
++                              hwaddr lebuffer_base, uint32_t le_rap_mask,
++                              MACAddr *mac)
+ {
+     DeviceState *dma;
+     ESPDMADeviceState *espdma;
+@@ -362,6 +364,9 @@ static void *sparc32_dma_init(hwaddr dma_base,
+     if (lebuffer_base) {
+         qdev_prop_set_uint32(dma, "lebuffer-size", SUN4M_LEBUFFER_SIZE);
+     }
++    if (le_rap_mask) {
++        qdev_prop_set_uint32(DEVICE(lance), "rap-mask", le_rap_mask);
++    }
+     sysbus_realize_and_unref(SYS_BUS_DEVICE(dma), &error_fatal);
+     if (lebuffer_base) {
+         sysbus_mmio_map(SYS_BUS_DEVICE(dma), 1, lebuffer_base);
+@@ -1154,7 +1159,7 @@ static void sun4m_hw_init(MachineState *machine)
+     sparc32_dma_init(hwdef->dma_base,
+                      hwdef->esp_base, slavio_irq[18],
+                      hwdef->le_base, slavio_irq[16],
+-                     hwdef->lebuffer_base, &hostid);
++                     hwdef->lebuffer_base, hwdef->le_rap_mask, &hostid);
+ 
+     if (!graphic_width) {
+         graphic_width = 1024;
+@@ -1600,6 +1605,13 @@ static void ss600mp_class_init(ObjectClass *oc, const void *data)
+         .iommu_base_mask = 0xfffffc00,
+         .iommu_sbcfg_mask = 0x0003800f,
+         .iommu_tlb_data_mask = 0xffffff86,
++        /*
++         * Its lance's register address port keeps bits 1-0, as on the
++         * Am7990 (CSR0-CSR3): the boot PROM writes a walking one to it and
++         * wants them back. The other machines keep the PCnet core's 7 bits
++         * (the drivers select only CSR0-CSR3 either way).
++         */
++        .le_rap_mask = 0x3,
+         .max_mem = 0xf00000000ULL,
+     };
+ 
+diff --git a/include/hw/net/lance.h b/include/hw/net/lance.h
+index be473e2..ea729ae 100644
+--- a/include/hw/net/lance.h
++++ b/include/hw/net/lance.h
+@@ -43,6 +43,7 @@ struct SysBusPCNetState {
+     SysBusDevice parent_obj;
+ 
+     PCNetState state;
++    uint32_t rap_mask;  /* the bits the register address port keeps */
+ };
+ 
+ #endif
diff --git a/debian/patches/wsh/0158-tests-qtest-test-the-SS-600MP-lance-s-register-addre.patch b/debian/patches/wsh/0158-tests-qtest-test-the-SS-600MP-lance-s-register-addre.patch
new file mode 100644
index 0000000..77d68c6
--- /dev/null
+++ b/debian/patches/wsh/0158-tests-qtest-test-the-SS-600MP-lance-s-register-addre.patch
@@ -0,0 +1,91 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the SS-600MP lance's register address port
+
+sun4m-ss600mp-test case lance-rap: on SS-600MP the RAP keeps bits 1-0
+of a walking one and of all ones, and RAP 5 selects CSR1; on SS-10 it
+keeps bits 6-0. The lance-in-lebuffer case no longer reads the station
+address from CSR12-14, which the two-bit RAP doesn't reach on the
+SS-600MP; its transmit from a descriptor in the buffer still shows
+that the lance took its init block from there. lance-rap fails without
+the previous patch, and lance-in-lebuffer fails with it until this one.
+---
+ tests/qtest/sun4m-ss600mp-test.c | 38 ++++++++++++++++++++++++++++----
+ 1 file changed, 34 insertions(+), 4 deletions(-)
+
+diff --git a/tests/qtest/sun4m-ss600mp-test.c b/tests/qtest/sun4m-ss600mp-test.c
+index 6be5c61..51cc072 100644
+--- a/tests/qtest/sun4m-ss600mp-test.c
++++ b/tests/qtest/sun4m-ss600mp-test.c
+@@ -15,6 +15,10 @@
+  * checks that it hands the descriptor back and raises its interrupt.
+  * The SS-10 has neither.
+  *
++ * The lance's register address port keeps bits 1-0 on the 600MP, as on
++ * the Am7990, whose boot PROM writes a walking one to it; the SS-10 keeps
++ * the PCnet core's bits 6-0.
++ *
+  * SPDX-License-Identifier: GPL-2.0-or-later
+  */
+ 
+@@ -27,6 +31,7 @@
+ #define LEBUFFER_SIZE   0x20000
+ #define LE_RDP          0xef0060000ULL
+ #define LE_RAP          0xef0060002ULL
++#define SS10_LE_RAP     0xef0c00002ULL
+ /* the system interrupt pending register of the slavio interrupt controller */
+ #define INTCTL_PENDING  0xff1410000ULL
+ #define IRQ_LE          (1u << 16)
+@@ -147,10 +152,11 @@ static void test_lance_in_lebuffer(void)
+     csr_write(qts, 2, 0x0000);
+     csr_write(qts, 0, CSR0_INIT);
+     g_assert_cmphex(csr_read(qts, 0) & CSR0_IDON, ==, CSR0_IDON);
+-    /* the station address came from the buffer */
+-    g_assert_cmphex(csr_read(qts, 12), ==, 0x5254);
+-    g_assert_cmphex(csr_read(qts, 13), ==, 0x0012);
+-    g_assert_cmphex(csr_read(qts, 14), ==, 0x3456);
++    /*
++     * (The station address is in CSR12-14 of the PCnet core, which the
++     * Am7990's two-bit address port doesn't reach: the transmit below
++     * shows that the lance took the init block from the buffer.)
++     */
+ 
+     /* clear IDON, start, send */
+     csr_write(qts, 0, CSR0_IDON);
+@@ -166,6 +172,29 @@ static void test_lance_in_lebuffer(void)
+     qtest_quit(qts);
+ }
+ 
++static void test_lance_rap(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++    uint32_t bit;
++
++    /* as the PROM does it: a walking one, then all ones */
++    for (bit = 1; bit <= 0x8000; bit <<= 1) {
++        qtest_writew(qts, LE_RAP, bit);
++        g_assert_cmphex(qtest_readw(qts, LE_RAP), ==, bit & 3);
++    }
++    qtest_writew(qts, LE_RAP, 0xffff);
++    g_assert_cmphex(qtest_readw(qts, LE_RAP), ==, 3);
++    /* CSR1 (the init block address) through RAP 5 */
++    csr_write(qts, 5, 0x1234);
++    g_assert_cmphex(csr_read(qts, 1), ==, 0x1234);
++    qtest_quit(qts);
++
++    qts = qtest_init("-machine SS-10 -m 64");
++    qtest_writew(qts, SS10_LE_RAP, 0xffff);
++    g_assert_cmphex(qtest_readw(qts, SS10_LE_RAP), ==, 0x7f);
++    qtest_quit(qts);
++}
++
+ static void test_ss10_unchanged(void)
+ {
+     QTestState *qts = qtest_init("-machine SS-10 -m 64");
+@@ -185,6 +214,7 @@ int main(int argc, char **argv)
+     qtest_add_func("sun4m-ss600mp/vme-regs", test_vme_regs);
+     qtest_add_func("sun4m-ss600mp/lebuffer-memory", test_lebuffer_memory);
+     qtest_add_func("sun4m-ss600mp/lance-in-lebuffer", test_lance_in_lebuffer);
++    qtest_add_func("sun4m-ss600mp/lance-rap", test_lance_rap);
+     qtest_add_func("sun4m-ss600mp/ss10-unchanged", test_ss10_unchanged);
+ 
+     return g_test_run();
diff --git a/debian/patches/wsh/0159-target-sparc-let-a-SuperSPARC-load-bus-error-trap-wi.patch b/debian/patches/wsh/0159-target-sparc-let-a-SuperSPARC-load-bus-error-trap-wi.patch
new file mode 100644
index 0000000..ff9c658
--- /dev/null
+++ b/debian/patches/wsh/0159-target-sparc-let-a-SuperSPARC-load-bus-error-trap-wi.patch
@@ -0,0 +1,241 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: let a SuperSPARC load bus error trap with the
+ MMU off
+
+Sun's SPARCserver 600MP boot PROM (progress 0xc1 of its power-on self
+test) reads every power-of-two offset from 1 to 0x800 of the lance's
+page with byte, word and doubleword loads through the MMU bypass ASI,
+with the MMU off, and wants each to take a data access exception (trap
+0x09) with SFSR 0x436 (bus error bit 10, supervisor data load, FT 5,
+FAV) and the address in the SFAR. QEMU raised no trap for a bus error
+with the MMU off, and trap 0x29 without bit 10 through the bypass ASIs,
+so the PROM looped on error.
+
+New CPU feature buserr-trap, on no CPU model by default; the machine
+sets it (the SS-600MP, next patch). With it:
+
+- A failed load (nothing at the address, or a size the device doesn't
+  take) traps as a data access exception whether the MMU is on or off,
+  through the bypass ASIs too, with the BE bit (bit 10, SunOS's
+  MMU_SFSR_BE) added to the SFSR. Its memory probe takes the same traps
+  on empty banks and expects them.
+- A failed store goes to a board hook (SPARCCPU store_error, called
+  under the BQL) that reports it asynchronously; when the hook takes it,
+  nothing is recorded in the CPU. A failed access that doesn't trap (a
+  store or a fetch with the MMU off) leaves the SFSR and SFAR alone:
+  the PROM's earlier write to a board register QEMU doesn't model left
+  FT 5 there, and the first lance load then had the overwrite bit set
+  (0x437).
+- In boot mode a fetch's TLB entry serves fetches only and a load's or
+  store's data only. A fetch from the trap table's page filled an entry
+  that also allowed loads, so the PROM's probe of memory bank 15
+  (physical 0x0f0000000) read the PROM instead of timing out, and a
+  later fetch of the trap vector from a page a load had filled ran the
+  bus's zeros (trap 0x02 in error mode).
+
+Trace event sparc_bus_error_load_trap. Without buserr-trap nothing
+changes; no new state.
+---
+ target/sparc/cpu-feature.h.inc |  1 +
+ target/sparc/cpu.c             |  3 +++
+ target/sparc/cpu.h             | 12 +++++++++
+ target/sparc/ldst_helper.c     | 48 +++++++++++++++++++++++++++++++++-
+ target/sparc/mmu_helper.c      | 17 ++++++++++--
+ target/sparc/trace-events      |  1 +
+ 6 files changed, 79 insertions(+), 3 deletions(-)
+
+diff --git a/target/sparc/cpu-feature.h.inc b/target/sparc/cpu-feature.h.inc
+index 238c40e..eb8195d 100644
+--- a/target/sparc/cpu-feature.h.inc
++++ b/target/sparc/cpu-feature.h.inc
+@@ -20,3 +20,4 @@ FEATURE(BUSERR_ACCESS_EXC) /* Bus error on a load or fetch: access exception */
+ FEATURE(BOOT_MODE_IFETCH) /* Boot mode sends fetches to the PROM, MMU on or off */
+ FEATURE(SBUF_DIAG) /* SuperSPARC store buffer diagnostic registers */
+ FEATURE(CACHE_DIAG) /* SuperSPARC cache tag and data RAMs (ASI 0x0c-0x0f) */
++FEATURE(BUSERR_TRAP) /* A failed load traps, MMU on or off (SS-600MP) */
+diff --git a/target/sparc/cpu.c b/target/sparc/cpu.c
+index 5e7d6d6..eb4c2ed 100644
+--- a/target/sparc/cpu.c
++++ b/target/sparc/cpu.c
+@@ -582,6 +582,7 @@ static const char * const feature_name[] = {
+     [CPU_FEATURE_BIT_BOOT_MODE_IFETCH] = "boot-mode-ifetch",
+     [CPU_FEATURE_BIT_SBUF_DIAG] = "sbuf-diag",
+     [CPU_FEATURE_BIT_CACHE_DIAG] = "cache-diag",
++    [CPU_FEATURE_BIT_BUSERR_TRAP] = "buserr-trap",
+ #endif
+ };
+ 
+@@ -1027,6 +1028,8 @@ static const Property sparc_cpu_properties[] = {
+                     CPU_FEATURE_BIT_SBUF_DIAG, false),
+     DEFINE_PROP_BIT("cache-diag", SPARCCPU, env.def.features,
+                     CPU_FEATURE_BIT_CACHE_DIAG, false),
++    DEFINE_PROP_BIT("buserr-trap", SPARCCPU, env.def.features,
++                    CPU_FEATURE_BIT_BUSERR_TRAP, false),
+ #endif
+     DEFINE_PROP_UNSIGNED("iu-version", SPARCCPU, env.def.iu_version, 0,
+                          qdev_prop_uint64, target_ulong),
+diff --git a/target/sparc/cpu.h b/target/sparc/cpu.h
+index ad41ad2..ae30ec5 100644
+--- a/target/sparc/cpu.h
++++ b/target/sparc/cpu.h
+@@ -643,6 +643,18 @@ struct ArchCPU {
+     CPUState parent_obj;
+ 
+     CPUSPARCState env;
++#if !defined(TARGET_SPARC64) && !defined(CONFIG_USER_ONLY)
++    /*
++     * With buserr-trap: the board's handler for a store that failed on the
++     * bus, which the board reports asynchronously (the SS-600MP's M-to-S
++     * write error), given the physical address, the size, the CPU's MBus
++     * module ID and whether it was in supervisor mode. Returns false for an
++     * address the board doesn't report on.
++     */
++    bool (*store_error)(void *opaque, hwaddr addr, unsigned size,
++                        unsigned mid, bool supervisor);
++    void *store_error_opaque;
++#endif
+ };
+ 
+ /**
+diff --git a/target/sparc/ldst_helper.c b/target/sparc/ldst_helper.c
+index 9289075..95d4baf 100644
+--- a/target/sparc/ldst_helper.c
++++ b/target/sparc/ldst_helper.c
+@@ -19,6 +19,7 @@
+ 
+ #include "qemu/osdep.h"
+ #include "qemu/log.h"
++#include "qemu/main-loop.h"
+ #include "qemu/range.h"
+ #include "cpu.h"
+ #include "tcg/tcg.h"
+@@ -420,6 +421,9 @@ static void dump_asi(const char *txt, target_ulong addr, int asi, int size,
+ 
+ #ifndef CONFIG_USER_ONLY
+ #ifndef TARGET_SPARC64
++/* SFSR: the access ended in a bus error (an error acknowledge) */
++#define SFSR_BE (1 << 10)
++
+ /*
+  * A failed physical access (a bus error: nothing at the address, or an error
+  * acknowledge). is_asi is set for an access through an ASI the CPU doesn't
+@@ -432,7 +436,41 @@ static void sparc_raise_mmu_fault(CPUState *cs, hwaddr addr,
+                                   uintptr_t retaddr)
+ {
+     CPUSPARCState *env = cpu_env(cs);
++    SPARCCPU *cpu = SPARC_CPU(cs);
+     int fault_type;
++    /*
++     * buserr-trap (set by the SPARCserver 600MP machine): a load that
++     * nothing answers comes back to the SuperSPARC as an error acknowledge.
++     * It traps as a data access exception whether the MMU is on or off,
++     * also through the MMU bypass ASIs, with the bus error bit (BE, bit 10
++     * in SunOS's mmu.h) in the SFSR. The board's boot PROM checks this on
++     * the offsets of a device's page that the device doesn't decode.
++     */
++    bool buserr_trap = env->def.features & CPU_FEATURE_BUSERR_TRAP;
++    bool load_trap = buserr_trap && !is_write && !is_exec && !is_asi;
++
++    if (buserr_trap && is_write && !is_asi && cpu->store_error) {
++        /*
++         * A store goes through the store buffer and its error is
++         * asynchronous: the board reports it where it can (on the SS-600MP
++         * a store to the SBus is an M-to-S write error with a level 15
++         * interrupt), and nothing is recorded here.
++         */
++        BQL_LOCK_GUARD();
++
++        if (cpu->store_error(cpu->store_error_opaque, addr, size,
++                             (env->mxccregs[7] >> 24) & 0xf, env->psrs)) {
++            return;
++        }
++    }
++    if (buserr_trap && !load_trap && !(env->mmuregs[0] & MMU_E)) {
++        /*
++         * It doesn't trap (a store or a fetch with the MMU off): leave the
++         * SFSR and SFAR alone. Status left there would set the overwrite
++         * bit of the next fault, which the boot PROM checks.
++         */
++        return;
++    }
+ 
+ #ifdef DEBUG_UNASSIGNED
+     if (is_asi) {
+@@ -464,6 +502,9 @@ static void sparc_raise_mmu_fault(CPUState *cs, hwaddr addr,
+             env->mmuregs[3] |= 1 << 7;
+         }
+         env->mmuregs[3] |= (5 << 2) | 2;
++        if (load_trap) {
++            env->mmuregs[3] |= SFSR_BE;
++        }
+         /* SuperSPARC will never place instruction fault addresses in the FAR */
+         if (!is_exec) {
+             env->mmuregs[4] = addr; /* Fault address register */
+@@ -474,7 +515,8 @@ static void sparc_raise_mmu_fault(CPUState *cs, hwaddr addr,
+         env->mmuregs[3] |= 1;
+     }
+ 
+-    if ((env->mmuregs[0] & MMU_E) && !(env->mmuregs[0] & MMU_NF)) {
++    if ((env->mmuregs[0] & MMU_E || load_trap) &&
++        !(env->mmuregs[0] & MMU_NF)) {
+         int tt = is_exec ? TT_CODE_ACCESS : TT_DATA_ACCESS;
+ 
+         /*
+@@ -492,6 +534,10 @@ static void sparc_raise_mmu_fault(CPUState *cs, hwaddr addr,
+             tt = is_exec ? TT_TFAULT : TT_DFAULT;
+             trace_sparc_bus_error_access_exc(addr, tt);
+         }
++        if (load_trap) {
++            tt = TT_DFAULT;
++            trace_sparc_bus_error_load_trap(addr, size, env->mmuregs[3]);
++        }
+         cpu_raise_exception_ra(env, tt, retaddr);
+     }
+ 
+diff --git a/target/sparc/mmu_helper.c b/target/sparc/mmu_helper.c
+index a62a470..104a37d 100644
+--- a/target/sparc/mmu_helper.c
++++ b/target/sparc/mmu_helper.c
+@@ -85,15 +85,28 @@ static int get_physical_address(CPUSPARCState *env, CPUTLBEntryFull *full,
+     is_user = mmu_idx == MMU_USER_IDX;
+ 
+     if (mmu_idx == MMU_PHYS_IDX) {
++        /*
++         * In boot mode a fetch and a load from one address go to different
++         * places, the PROM and the bus, but share a TLB entry here. With
++         * buserr-trap, where a load from nothing traps, keep them apart: a
++         * fetch's entry serves fetches only and a load's or store's data
++         * only. Otherwise a load from the page of the trap table finds the
++         * PROM there instead of a time-out, and a fetch after a load from
++         * that page runs whatever the bus returned.
++         */
++        bool split = (env->def.features & CPU_FEATURE_BUSERR_TRAP) &&
++                     (env->mmuregs[0] & env->def.mmu_bm);
++
+         full->lg_page_size = TARGET_PAGE_BITS;
+         /* Boot mode: instruction fetches are taken from PROM */
+         if (rw == 2 && (env->mmuregs[0] & env->def.mmu_bm)) {
+             full->phys_addr = env->prom_addr | (address & 0x7ffffULL);
+-            full->prot = PAGE_READ | PAGE_EXEC;
++            full->prot = split ? PAGE_EXEC : PAGE_READ | PAGE_EXEC;
+             return 0;
+         }
+         full->phys_addr = address;
