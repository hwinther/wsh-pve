diff --git a/debian/patches/wsh/0112-hw-sparc64-drop-the-translated-code-on-a-reset.patch b/debian/patches/wsh/0112-hw-sparc64-drop-the-translated-code-on-a-reset.patch
new file mode 100644
index 0000000..54277e1
--- /dev/null
+++ b/debian/patches/wsh/0112-hw-sparc64-drop-the-translated-code-on-a-reset.patch
@@ -0,0 +1,52 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc64: drop the translated code on a reset
+
+After a reset (a reboot asks the firmware for one) openbios-sparc64
+clears the RAM below its own with 8-byte stores, so that the next system
+finds it zeroed as after a power-on. A store to a page that still has
+translated blocks on it invalidates the ones it overlaps, and taking a
+block off its page's list costs time in proportion to how many the page
+holds. After Debian 7's Linux 3.2 had run for a few minutes QEMU held
+600 000 to 1 600 000 blocks, many of them on a few pages, and the clear
+crawled there: most of the RAM in a minute or two, then a few bytes to
+a few KB a second around the pages the kernel had used (perf: 86% of
+the time in tb_page_remove()). A reboot after a minute at the shell
+(512 MB) reached the firmware's banner 336 s after the kernel's
+"Restarting system"; the installer's reboot after 85 minutes (1024 MB)
+took about 5 minutes.
+
+Queue a TB flush for the CPU in main_cpu_reset() on every reset after
+the power-on one; it runs before the CPU executes again. The same reboot
+then reaches the banner 2 s after "Restarting system", and the system
+boots to its login prompt.
+---
+ hw/sparc64/sparc64.c | 9 +++++++++
+ 1 file changed, 9 insertions(+)
+
+diff --git a/hw/sparc64/sparc64.c b/hw/sparc64/sparc64.c
+index 16f4aa05..e2e686a2 100644
+--- a/hw/sparc64/sparc64.c
++++ b/hw/sparc64/sparc64.c
+@@ -30,6 +30,7 @@
+ #include "hw/sparc/sparc64.h"
+ #include "qemu/timer.h"
+ #include "system/reset.h"
++#include "exec/tb-flush.h"
+ #include "trace.h"
+ 
+ 
+@@ -126,6 +127,14 @@ static void main_cpu_reset(void *opaque)
+         env->pc = s->prom_addr + 0x20ULL;
+     } else {
+         env->pc = s->prom_addr + 0x40ULL;
++        /*
++         * Drop the code translated for the system before. The firmware
++         * clears the RAM after a reset, and a store to a page that still
++         * has translated blocks invalidates them one by one, each at a
++         * cost that grows with their number on the page: after a Linux
++         * guest had run for a minute, the clear took over five minutes.
++         */
++        queue_tb_flush(CPU(s->cpu));
+     }
+     env->npc = env->pc + 4;
+ }
