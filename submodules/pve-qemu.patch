++        egl_fb_setup_new_tex(&ddc->blit_fb, w, h);
++    }
++    egl_fb_blit(&ddc->blit_fb, &ddc->scanout_fb, ddc->scanout_y0_top);
++    egl_fb_read(ds, &ddc->blit_fb);
