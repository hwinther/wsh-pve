+         }
+         break;
+-    case 2: // Read only
++    case CS_STATUS: // Read only
+         break;
+-    case 4:
+-        if (val & 1) {
++    case CS_CSR:
++        csr = s->regs[CS_CSR];
++        was_go = csr & APC_PDMA_GO;
++        if (val & APC_RESET) {
+             cs_reset(DEVICE(s));
++            csr = 0;
++            was_go = false;
++        }
++        /* 1s clear the interrupt bits; the read only bits are not kept */
++        csr = (csr & APC_INTS & ~val) | (val & APC_RW);
++        s->regs[CS_CSR] = csr;
++        if (was_go && !(csr & APC_PDMA_GO)) {
