+diff --git a/target/sparc/solaris_idle.c b/target/sparc/solaris_idle.c
+new file mode 100644
+index 0000000000..747d6c2944
+--- /dev/null
++++ b/target/sparc/solaris_idle.c
+@@ -0,0 +1,124 @@
++/*
++ * Solaris 2.x on sun4m: halt the CPU in the idle loop
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++/*
++ * With one CPU, the idle thread of Solaris 2.5.1 to 9 runs this loop in
++ * idle() at interrupt level 0:
++ *
++ *   while (ncpus == 1) {
++ *       if (CPU->cpu_disp.disp_nrunnable != 0)
++ *           swtch();
++ *       else
++ *           (*idle_cpu)();                   <- the translator's hook
++ *   }
++ *
++ * idle_cpu is the CPU module's way to stop the processor. Only the
++ * microSPARC-II module sets it, to a function that asks the power
++ * management driver (pmc) to write the APC register, which QEMU turns
++ * into a halt. On every other CPU, the SuperSPARC of the SPARCstation 10
++ * and 20 among them, it is a function that just returns, so the loop
++ * spins and keeps a host core busy.
++ *
++ * The translator finds the call through idle_cpu by the instructions
++ * around it (gen_solaris_idle() in translate.c), and takes from them the
++ * register and offset by which the loop loads disp_nrunnable. At the call
++ * it calls helper_solaris_idle(), which halts the CPU when disp_nrunnable
++ * is 0, interrupts are enabled at level 0 and none is pending, which is
++ * where idle_cpu exists to stop the processor. On a machine with one CPU
++ * only an interrupt handler can then make a thread runnable, and the board
++ * turns this on only for one CPU (with more, Solaris runs another loop and
++ * a CPU queues work for an idle one without an interrupt). The helper
++ * reads disp_nrunnable again, as an interrupt may have come since the loop
++ * loaded it.
++ *
++ * The CPU goes on at the call after the next interrupt (the clock ticks
++ * at 100 Hz), so idle_cpu still runs when the loop finds no work, and the
++ * guest counts its idle time as before.
++ *
++ * As in sunos_idle.c, the loop spins on for 100 us before the first halt,
++ * as a disk request often completes that soon.
++ */
++
++#include "qemu/osdep.h"
++#include "qemu/timer.h"
++#include "hw/core/cpu.h"
++#include "cpu.h"
++#include "accel/tcg/cpu-loop.h"
++#include "accel/tcg/cpu-mmu-index.h"
++#include "accel/tcg/probe.h"
++#include "exec/cpu-common.h"
++#include "exec/helper-proto.h"
++#include "exec/tlb-flags.h"
++#include "trace.h"
++
++/*
++ * Spin on for this long after the loop first found no work. A round that
++ * comes more than SOLARIS_IDLE_GAP_NS after the one before means that the
++ * guest left the loop between them.
++ */
++#define SOLARIS_IDLE_POLL_NS  (100 * SCALE_US)
++#define SOLARIS_IDLE_GAP_NS   (20 * SCALE_US)
++
++static bool solaris_idle_polled(CPUSPARCState *env)
++{
++    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
++
++    if (now - env->solaris_idle_last > SOLARIS_IDLE_GAP_NS) {
++        env->solaris_idle_since = now;
++    }
++    env->solaris_idle_last = now;
++    return now - env->solaris_idle_since >= SOLARIS_IDLE_POLL_NS;
++}
++
++/* Read a 4-byte kernel variable; false if it is not mapped RAM */
++static bool solaris_idle_read(CPUSPARCState *env, target_ulong addr,
++                              uint32_t *val)
++{
++    void *host;
++    int flags;
++
++    if (addr & 3) {
++        return false;
++    }
++    flags = probe_access_flags(env, addr, 4, MMU_DATA_LOAD,
++                               cpu_mmu_index(env_cpu(env), false), true,
++                               &host, 0);
++    if ((flags & TLB_INVALID_MASK) || !host) {
++        return false;
++    }
++    *val = ldl_be_p(host);
++    return true;
++}
++
++/*
++ * Solaris is at the call through idle_cpu in its idle loop. Halt until the
++ * next interrupt when no thread is runnable, and go on at the call then.
++ */
++void HELPER(solaris_idle)(CPUSPARCState *env, target_ulong pc,
++                          target_ulong nrunnable)
++{
++    CPUState *cs = env_cpu(env);
++    uint32_t val;
++
++    /* Interrupts are enabled and none is pending */
++    if (!env->psret || env->psrpil ||
++        cpu_test_interrupt(cs, CPU_INTERRUPT_HARD)) {
++        return;
++    }
++    if (!solaris_idle_read(env, nrunnable, &val) || val) {
++        return;
++    }
++    if (!solaris_idle_polled(env)) {
++        return;
++    }
++
++    trace_sparc_solaris_idle(pc);
++    env->pc = pc;
++    env->npc = pc + 4;
++    cs->halted = 1;
++    cs->exception_index = EXCP_HLT;
++    cpu_loop_exit(cs);
++}
+diff --git a/target/sparc/trace-events b/target/sparc/trace-events
+index 7a963db11f..4b9103295f 100644
+--- a/target/sparc/trace-events
++++ b/target/sparc/trace-events
+@@ -17,7 +17,11 @@ sun4m_cpu_reset_interrupt(unsigned int level) "Reset CPU IRQ %d"
+ # sunos_idle.c
+ sparc_sunos_idle(uint32_t pc) "idle loop halt, go on at 0x%08x"
+ 
++# solaris_idle.c
++sparc_solaris_idle(uint32_t pc) "idle loop halt, go on at 0x%08x"
++
+ # translate.c
++sparc_solaris_idle_match(const char *kernel, uint32_t pc, int reg, int off) "Solaris idle loop (%s): idle_cpu call at 0x%08x, disp_nrunnable at register %d offset %d"
+ sparc_sunos_idle_match(uint32_t pc, uint32_t top, uint32_t nrunnable, uint32_t whichqs, uint32_t qrunflag) "SunOS idle loop: branch at 0x%08x to 0x%08x, Nrunnable 0x%08x whichqs 0x%08x qrunflag 0x%08x"
+ 
+ # int64_helper.c
+diff --git a/target/sparc/translate.c b/target/sparc/translate.c
+index 739b47e78a..679b15c389 100644
+--- a/target/sparc/translate.c
++++ b/target/sparc/translate.c
+@@ -184,6 +184,7 @@ typedef struct DisasContext {
+ #else
+     bool fsr_qne;
+     bool sunos_idle;
++    bool solaris_idle;
+ #endif
+ #endif
+ 
+@@ -5702,6 +5703,8 @@ static void sparc_tr_init_disas_context(DisasContextBase *dcbase, CPUState *cs)
+     dc->fsr_qne = (dc->base.tb->flags & TB_FLAG_FSR_QNE) != 0;
+     dc->sunos_idle = cpu_env(cs)->sunos_idle && dc->supervisor &&
+                      !(tb_cflags(dc->base.tb) & CF_SINGLE_STEP);
++    dc->solaris_idle = cpu_env(cs)->solaris_idle && dc->supervisor &&
++                       !(tb_cflags(dc->base.tb) & CF_SINGLE_STEP);
+ # endif
+ #endif
+ #ifdef TARGET_SPARC64
+@@ -5825,6 +5828,144 @@ static void gen_sunos_idle(DisasContext *dc, CPUSPARCState *env)
+                           tcg_constant_tl(whichqs),
+                           tcg_constant_tl(qrunflag));
+ }
++
++/*
++ * Solaris 2.5.1 to 9 call idle_cpu from the idle loop in idle() when no
++ * thread is runnable; see solaris_idle.c. These are the words of that
++ * loop from the load of disp_nrunnable to the call, each with its mask,
++ * as the compiler of each release laid them out. Registers, offsets and
++ * addresses are left out; gen_solaris_idle() checks that the words use
++ * the registers consistently.
++ */
++#define SOLARIS_CALL            0x9fc00000  /* call %rs1 (jmpl %rs1, %o7) */
++#define SOLARIS_CALL_MASK       0xfff83fff
++
++#define SOL_ANY         { 0x00000000, 0x00000000 }
++#define SOL_LD_IMM      { 0xc0002000, 0xc1f82000 }  /* ld [%rs1 + simm13], %rd */
++#define SOL_LD_REG      { 0xc0000000, 0xc1f83fff }  /* ld [%rs1], %rd */
++#define SOL_CMP0        { 0x80a02000, 0xfff83fff }  /* cmp %rs1, 0 */
++#define SOL_TST         { 0x80900000, 0xffffffe0 }  /* tst %rs2 */
++#define SOL_SETHI       { 0x01000000, 0xc1c00000 }  /* sethi %hi(idle_cpu), %rd */
++#define SOL_CALL_DISP   { 0x40000000, 0xc0000000 }  /* call swtch */
++#define SOL_NOP         { 0x01000000, 0xffffffff }
++#define SOL_BA          { 0x10800000, 0xffc00000 }  /* b top */
++#define SOL_CALL_REG    { SOLARIS_CALL, SOLARIS_CALL_MASK }
++
++typedef struct SolarisIdleLoop {
++    const char *kernel;
++    int len;
++    /*
++     * w[0] loads disp_nrunnable, w[1] tests it, w[2] branches on it,
++     * w[3] is the sethi of &idle_cpu, w[len - 2] loads idle_cpu and
++     * w[len - 1] calls it.
++     */
++    uint32_t w[10][2];
++} SolarisIdleLoop;
++
++static const SolarisIdleLoop solaris_idle_loops[] = {
++    { "2.6/7/8", 10, {
++        SOL_LD_IMM,                 /*        ld    [%cpu + nrunnable], %x */
++        SOL_CMP0,                   /*        cmp   %x, 0 */
++        { 0x02800006, 0xffffffff }, /*        be    idle */
++        SOL_SETHI,                  /*         sethi %hi(idle_cpu), %y */
++        SOL_CALL_DISP,              /*        call  swtch */
++        SOL_NOP,                    /*         nop */
++        SOL_BA,                     /*        b     top */
++        SOL_ANY,                    /*         ... */
++        SOL_LD_IMM,                 /* idle:  ld    [%y + lo], %z */
++        SOL_CALL_REG,               /*        call  %z */
++    } },
++    { "9", 6, {
++        SOL_LD_IMM,                 /*        ld    [%cpu + nrunnable], %x */
++        SOL_CMP0,                   /*        cmp   %x, 0 */
++        { 0x12800007, 0xffffffff }, /*        bne   run */
++        SOL_SETHI,                  /*         sethi %hi(idle_cpu), %y */
++        SOL_LD_IMM,                 /*        ld    [%y + lo], %z */
++        SOL_CALL_REG,               /*        call  %z */
++    } },
++    { "2.5.1", 10, {
++        SOL_LD_REG,                 /*        ld    [%nrunnable], %x */
++        SOL_TST,                    /*        tst   %x */
++        { 0x22800006, 0xffffffff }, /*        be,a  idle */
++        SOL_SETHI,                  /*         sethi %hi(idle_cpu), %y */
++        SOL_CALL_DISP,              /*        call  swtch */
++        SOL_NOP,                    /*         nop */
++        SOL_BA,                     /*        b     top */
++        SOL_ANY,                    /*         ... */
++        SOL_LD_IMM,                 /* idle:  ld    [%y + lo], %z */
++        SOL_CALL_REG,               /*        call  %z */
++    } },
++};
++
++/*
++ * At a call through a register, if it is the call of idle_cpu in the
++ * Solaris idle loop, let helper_solaris_idle() halt the CPU
++ */
++static void gen_solaris_idle(DisasContext *dc, CPUSPARCState *env,
++                             uint32_t insn)
++{
++    uint32_t w[ARRAY_SIZE(solaris_idle_loops[0].w)];
++    int k, i;
++
++    /* The call is not in a delay slot */
++    if (dc->npc != dc->pc + 4) {
++        return;
++    }
++    /* Off RAM, translator_ldl_end() would record these words as code */
++    if (tb_page_addr0(dc->base.tb) == -1) {
++        return;
++    }
++    for (k = 0; k < ARRAY_SIZE(solaris_idle_loops); k++) {
++        const SolarisIdleLoop *l = &solaris_idle_loops[k];
++        target_ulong start = dc->pc - 4 * (l->len - 1);
++        int cpu, x, y, z;
++        int32_t off;
++        TCGv addr;
++
++        if (!translator_is_same_page(&dc->base, start)) {
++            continue;
++        }
++        for (i = 0; i < l->len - 1; i++) {
++            w[i] = translator_ldl_end(env, &dc->base, start + 4 * i, MO_BE);
++            if ((w[i] & l->w[i][1]) != l->w[i][0]) {
++                break;
++            }
++        }
++        if (i < l->len - 1) {
++            continue;
++        }
++        w[l->len - 1] = insn;
++
++        /* ld [%cpu + off], %x; tst %x */
++        cpu = extract32(w[0], 14, 5);
++        off = extract32(w[0], 13, 1) ? sextract32(w[0], 0, 13) : 0;
++        x = extract32(w[0], 25, 5);
++        if (x != (extract32(w[1], 13, 1) ? extract32(w[1], 14, 5)
++                                         : extract32(w[1], 0, 5))) {
++            continue;
++        }
++        /* sethi %hi(idle_cpu), %y; ld [%y + lo], %z; call %z */
++        y = extract32(w[3], 25, 5);
++        z = extract32(w[l->len - 2], 25, 5);
++        if (extract32(w[l->len - 2], 14, 5) != y ||
++            extract32(w[l->len - 1], 14, 5) != z) {
++            continue;
++        }
++        /* The loop writes %x, %y and %z, so %cpu must be another one */
++        if (cpu == x || cpu == y || cpu == z) {
++            continue;
++        }
++
++        trace_sparc_solaris_idle_match(l->kernel, dc->pc, cpu, off);
++
++        /* The helper reads the clock */
++        translator_io_start(&dc->base);
++        addr = tcg_temp_new();
++        tcg_gen_addi_tl(addr, gen_load_gpr(dc, cpu), off);
++        gen_helper_solaris_idle(tcg_env, tcg_constant_tl(dc->pc), addr);
++        return;
++    }
++}
+ #endif
+ 
+ static void sparc_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+@@ -5839,6 +5980,9 @@ static void sparc_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+     if (insn == sunos_idle_loop[SUNOS_IDLE_BRANCH][0] && dc->sunos_idle) {
+         gen_sunos_idle(dc, cpu_env(cs));
+     }
++    if ((insn & SOLARIS_CALL_MASK) == SOLARIS_CALL && dc->solaris_idle) {
++        gen_solaris_idle(dc, cpu_env(cs), insn);
++    }
+ #endif
+ 
+     if (!decode(dc, insn)) {
diff --git a/debian/patches/wsh/0015-hw-sparc-sun4m-add-the-solaris-idle-option-on-by-def.patch b/debian/patches/wsh/0015-hw-sparc-sun4m-add-the-solaris-idle-option-on-by-def.patch
new file mode 100644
index 0000000..2f00a93
--- /dev/null
+++ b/debian/patches/wsh/0015-hw-sparc-sun4m-add-the-solaris-idle-option-on-by-def.patch
@@ -0,0 +1,58 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: add the solaris-idle option, on by default
+
+It halts the CPU while Solaris 2.5.1 to 9 is idle, see
+target/sparc/solaris_idle.c. -M SS-20,solaris-idle=off lets the idle
+loop spin as before. Like sunos-idle it is off with more than one CPU:
+Solaris then runs another idle loop, in which a CPU is given work
+without an interrupt.
+---
+ hw/sparc/sun4m.c | 21 +++++++++++++++++++++
+ 1 file changed, 21 insertions(+)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 437cff65da..785ee3d8be 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -794,6 +794,19 @@ static void sun4m_set_sunos_idle(Object *obj, bool value, Error **errp)
+     sun4m_sunos_idle = value;
+ }
+ 
++/* Halt the CPU in the Solaris 2.x idle loop, see target/sparc/solaris_idle.c */
++static bool sun4m_solaris_idle = true;
++
