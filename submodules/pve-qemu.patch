++    }
++    return aci + n;
++}
++
+ /* Lay the loop of kernel k out at LOOP; returns its length */
+-static int write_loop(uint32_t *p, int k)
++static int write_loop(uint32_t *p, int k, uint32_t pil)
+ {
+     int n = 0;
+ 
++    if (IS_LINUX(k)) {
++        return write_linux(p, k, pil);
++    }
++
+     switch (k) {
+     case NETBSD:
+         /*
+@@ -159,6 +290,25 @@ static int write_loop(uint32_t *p, int k)
+         p[n] = bpcc_xcc_to(BA, LOOP + n, LOOP); n++;    /* ba,pt %xcc */
