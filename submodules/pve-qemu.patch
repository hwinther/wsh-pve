+     s->play_freq = as.freq;
+-    s->play_fmt = (val >> 5) & ((s->dregs[CS_MODE] & CS_MODE2) ? 7 : 3);
++    s->play_fmt = fmt;
+     trace_cs4231_play_format(as.freq, as.nchannels, s->play_fmt);
+     if (!s->audio_be) {
+         return;
+@@ -608,6 +686,8 @@ static void cs_reset(DeviceState *d)
+     s->play_running = false;
+     s->play_drain = 0;
+     s->play_end = 0;
++    s->fifo_len = 0;
++    s->buf_taken = 0;
+     s->pi_at = -1;
+     s->pmi_at = -1;
+     timer_del(s->irq_timer);
+@@ -638,6 +718,14 @@ static uint64_t cs_mem_read(void *opaque, hwaddr addr,
+         ret = cs_read_csr(s);
+         trace_cs4231_mem_readl_reg(saddr, ret);
+         break;
++    case CS_PVA:
++        ret = s->regs[CS_PVA] - cs_play_back(s);
++        trace_cs4231_mem_readl_reg(saddr, ret);
