diff --git a/debian/patches/wsh/0041-tests-qtest-test-the-ESP-interrupt-latency-on-sun4m.patch b/debian/patches/wsh/0041-tests-qtest-test-the-ESP-interrupt-latency-on-sun4m.patch
new file mode 100644
index 0000000..f215e65
--- /dev/null
+++ b/debian/patches/wsh/0041-tests-qtest-test-the-ESP-interrupt-latency-on-sun4m.patch
@@ -0,0 +1,204 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the ESP interrupt latency on sun4m
+
+Four cases in sun4m-esp-test on the SPARCstation 5, with the line seen
+through the DMA_INTR bit of the ESP DMA's CSR: by default the interrupt
+comes in the same instruction, as before. With
+-global sysbus-esp.irq-latency-us=500, after Select with ATN and Stop
+neither STAT_INT nor the line shows for 500 us, and both do then; the
+interrupt register has its bits at once, and reading it before then,
+the chip's reset command and a system reset cancel the interrupt.
+
+Without the previous patch QEMU doesn't start with the property: there
+is no such property.
+---
+ tests/qtest/sun4m-esp-test.c | 141 +++++++++++++++++++++++++++++++++++
+ 1 file changed, 141 insertions(+)
+
+diff --git a/tests/qtest/sun4m-esp-test.c b/tests/qtest/sun4m-esp-test.c
+index c8e9a15a63..43a454991d 100644
+--- a/tests/qtest/sun4m-esp-test.c
++++ b/tests/qtest/sun4m-esp-test.c
+@@ -16,6 +16,15 @@
+  * Nothing runs on the CPU: the test drives the ESP's registers itself,
+  * without DMA, as the guest's driver does.
+  *
++ * With sysbus-esp's irq-latency-us the ESP's interrupt (STAT_INT and the
++ * line) comes that long after the event: NeXTSTEP 3.3 and OPENSTEP 4.2
++ * deadlock when a command ends in the instruction that started it, and
++ * need 500 us. It is off by default. The irq-latency cases check that the
++ * interrupt comes at once by default, and with 500 us that neither shows
++ * until then, both do after it, the interrupt register has its bits at
++ * once, and reading it or a reset before then cancels the interrupt. They
++ * see the line in the ESP DMA's CSR, whose DMA_INTR bit follows it.
++ *
+  * SPDX-License-Identifier: GPL-2.0-or-later
+  */
+ 
+@@ -26,6 +35,14 @@
+ #define ESP_BASE        0x78800000ULL
+ #define ESP_REG(r)      (ESP_BASE + (r) * 4)
+ 
++/* The ESP DMA's CSR: DMA_INTR follows the ESP's interrupt line */
++#define ESPDMA_CSR      0x78400000ULL
++#define DMA_INTR        0x01
++
++/* The latency the tests set, as NeXTSTEP needs it */
++#define IRQ_LATENCY_ON  "-global sysbus-esp.irq-latency-us=500"
++#define IRQ_LATENCY_NS  500000
++
+ #define ESP_FIFO        0x2
+ #define ESP_CMD         0x3
+ #define ESP_RSTAT       0x4
+@@ -33,6 +50,7 @@
+ #define ESP_RINTR       0x5
+ #define ESP_RFLAGS      0x7
+ 
++#define CMD_RESET       0x02
+ #define CMD_TI          0x10
+ #define CMD_ICCS        0x11
+ #define CMD_MSGACC      0x12
+@@ -43,6 +61,7 @@
+ #define STAT_ST         0x03
+ #define STAT_MO         0x06
+ #define STAT_GE         0x40
++#define STAT_INT        0x80
+ 
+ #define INTR_FC         0x08
+ #define INTR_BS         0x10
+@@ -124,6 +143,121 @@ static uint8_t tur_after_sdtr(QTestState *qts)
+     return status;
+ }
+ 
++/* The ESP's interrupt line, as the ESP DMA sees it */
++static bool esp_irq_line(QTestState *qts)
++{
++    return qtest_readl(qts, ESPDMA_CSR) & DMA_INTR;
++}
++
++static QTestState *esp_irq_init(const char *extra)
++{
++    return qtest_initf("-machine SS-5 -nodefaults "
++                       "-drive if=scsi,index=0,format=raw,file=null-co:// %s",
++                       extra);
++}
++
++/* STAT_INT in the status register */
++static uint8_t esp_stat_int(QTestState *qts)
++{
++    return esp_readb(qts, ESP_RSTAT) & STAT_INT;
++}
++
++/*
++ * Select target 0 with ATN and Stop: the ESP finishes the selection in the
++ * register write and goes to the message out phase at once
++ */
++static void esp_select(QTestState *qts)
++{
++    esp_writeb(qts, ESP_FIFO, 0xc0);
++    esp_writeb(qts, ESP_WBUSID, 0);
++    esp_writeb(qts, ESP_CMD, CMD_SELATNS);
++    g_assert_cmphex(esp_readb(qts, ESP_RSTAT) & STAT_PHASE, ==, STAT_MO);
++}
++
++static void test_irq_latency(void)
++{
++    QTestState *qts = esp_irq_init(IRQ_LATENCY_ON);
++    uint8_t intr;
++
++    esp_select(qts);
++
++    /* Neither in the same instruction, nor 1 ns before the latency is up */
++    g_assert_cmphex(esp_stat_int(qts), ==, 0);
++    g_assert_false(esp_irq_line(qts));
++    qtest_clock_step(qts, IRQ_LATENCY_NS - 1);
++    g_assert_cmphex(esp_stat_int(qts), ==, 0);
++    g_assert_false(esp_irq_line(qts));
++
++    /* Then STAT_INT and the line together */
++    qtest_clock_step(qts, 1);
++    g_assert_cmphex(esp_stat_int(qts), ==, STAT_INT);
++    g_assert_true(esp_irq_line(qts));
++
++    /* Reading the interrupt register lowers it, as before */
++    intr = esp_readb(qts, ESP_RINTR);
++    g_assert_cmphex(intr & (INTR_BS | INTR_FC), ==, INTR_BS | INTR_FC);
++    g_assert_false(esp_irq_line(qts));
++    g_assert_cmphex(esp_stat_int(qts), ==, 0);
++
++    qtest_quit(qts);
++}
++
++static void test_irq_latency_cancel_lower(void)
++{
++    QTestState *qts = esp_irq_init(IRQ_LATENCY_ON);
++    uint8_t intr;
++
++    esp_select(qts);
++    qtest_clock_step(qts, IRQ_LATENCY_NS / 2);
++
++    /*
++     * A driver that polls the interrupt register (OpenBIOS) has its bits at
++     * once, and takes the interrupt with them
++     */
++    intr = esp_readb(qts, ESP_RINTR);
++    g_assert_cmphex(intr & (INTR_BS | INTR_FC), ==, INTR_BS | INTR_FC);
++    qtest_clock_step(qts, IRQ_LATENCY_NS * 2);
++    g_assert_cmphex(esp_stat_int(qts), ==, 0);
++    g_assert_false(esp_irq_line(qts));
++
++    qtest_quit(qts);
++}
++
++static void test_irq_latency_cancel_reset(void)
++{
++    QTestState *qts = esp_irq_init(IRQ_LATENCY_ON);
++
++    /* The chip's own reset command */
++    esp_select(qts);
++    esp_writeb(qts, ESP_CMD, CMD_RESET);
++    qtest_clock_step(qts, IRQ_LATENCY_NS * 2);
++    g_assert_false(esp_irq_line(qts));
++    g_assert_cmphex(esp_stat_int(qts), ==, 0);
++
++    /* A system reset */
++    esp_select(qts);
++    qtest_system_reset(qts);
++    qtest_clock_step(qts, IRQ_LATENCY_NS * 2);
++    g_assert_false(esp_irq_line(qts));
++    g_assert_cmphex(esp_stat_int(qts), ==, 0);
++
++    qtest_quit(qts);
++}
++
++static void test_irq_latency_default_off(void)
++{
++    QTestState *qts = esp_irq_init("");
++
++    /* By default the interrupt comes in the same instruction, as before */
++    esp_select(qts);
++    g_assert_cmphex(esp_stat_int(qts), ==, STAT_INT);
++    g_assert_true(esp_irq_line(qts));
++    esp_readb(qts, ESP_RINTR);
++    g_assert_false(esp_irq_line(qts));
++
++    qtest_quit(qts);
++}
++
+ static void test_cdb_after_sdtr(void)
+ {
+     QTestState *qts = qtest_init("-machine SS-5 -nodefaults "
+@@ -146,6 +280,13 @@ int main(int argc, char **argv)
+     g_test_init(&argc, &argv, NULL);
+ 
+     qtest_add_func("sun4m-esp/cdb-after-sdtr", test_cdb_after_sdtr);
++    qtest_add_func("sun4m-esp/irq-latency", test_irq_latency);
++    qtest_add_func("sun4m-esp/irq-latency-cancel-lower",
++                   test_irq_latency_cancel_lower);
++    qtest_add_func("sun4m-esp/irq-latency-cancel-reset",
++                   test_irq_latency_cancel_reset);
++    qtest_add_func("sun4m-esp/irq-latency-default-off",
++                   test_irq_latency_default_off);
+ 
+     return g_test_run();
+ }
diff --git a/debian/patches/wsh/0042-target-sparc-halt-the-CPU-in-the-idle-loop-of-sun4u-.patch b/debian/patches/wsh/0042-target-sparc-halt-the-CPU-in-the-idle-loop-of-sun4u-.patch
new file mode 100644
index 0000000..11b2b67
--- /dev/null
+++ b/debian/patches/wsh/0042-target-sparc-halt-the-CPU-in-the-idle-loop-of-sun4u-.patch
@@ -0,0 +1,690 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: halt the CPU in the idle loop of sun4u guests
+
+Nothing on an UltraSPARC-IIi stops the processor, and no kernel that
+runs on QEMU's sun4u tries: Solaris and illumos halt an idle CPU only
+through cpu_halt_cpu(), which only the SPARC64-VI module provides;
+NetBSD and Linux only yield to the hypervisor on sun4v; OpenBSD patches
+in the sleep instruction only on CPUs with several strands. So every
+sun4u guest spins in its idle loop and keeps a host core busy for as
+long as the VM runs.
+
+The translator recognises the idle loops of NetBSD 9 and 11
+(idle_loop() at its call of cpu_idle()), OpenBSD (sched_idle() at its
+call of cpu_idle_cycle()) and Solaris 9, 10 and illumos (idle() with one
+CPU, at the call through idle_cpu; Sun's compiler and gcc lay it out
+differently) by the words around that call, and takes from them where
+the loop keeps the word that says there is work: ci_want_resched,
+spc_whichqs, disp_nrunnable. The words are decoded and their registers
+checked against each other; branch targets must agree. At the call a
+helper halts the CPU when the word is 0, interrupts are enabled at
+level 0 and nothing is pending. QEMU's sun4u has one CPU, so only an
+interrupt handler can then give it work, and the guest's clock
+interrupts at least 100 times a second. The CPU goes on at the call
+after the next interrupt, so the guest runs its loop as before and
+counts its idle time the same way. As in the sun4m idle loops, the
+loop spins on for 100 us before the first halt.
+
+The board turns this on with env->idle_halt. -trace sparc64_idle_match
+shows whether a kernel was recognised.
+
+An idle guest at the shell then uses 3-9% of a host core instead of
+100%: NetBSD 9.3 and 11.1, OpenBSD 8.0, Solaris 9 and 10 (Tribblix m34
+about 22%, with FMA off: its ZFS disk faults on QEMU and rcm_daemon
+spins otherwise).
+The guest clock keeps time, ten "sleep 1" take as long as before, and
+CPU-bound work takes as long as before.
+---
+ target/sparc/cpu.h          |   6 +
+ target/sparc/helper.h       |   3 +
+ target/sparc/meson.build    |   1 +
+ target/sparc/sparc64_idle.c | 158 +++++++++++++++
+ target/sparc/trace-events   |   4 +
+ target/sparc/translate.c    | 389 ++++++++++++++++++++++++++++++++++++
+ 6 files changed, 561 insertions(+)
+ create mode 100644 target/sparc/sparc64_idle.c
+
+diff --git a/target/sparc/cpu.h b/target/sparc/cpu.h
+index 8d4ff2da8d..d85002739b 100644
+--- a/target/sparc/cpu.h
++++ b/target/sparc/cpu.h
+@@ -558,6 +558,12 @@ struct CPUArchState {
+     /* Interrupt vector registers */
+     uint64_t ivec_status;
+     uint64_t ivec_data[3];
++#if !defined(CONFIG_USER_ONLY)
++    /* Halt in the idle loop of a sun4u guest, see sparc64_idle.c */
++    bool idle_halt;
++    int64_t idle_halt_since;    /* when the loop first found no work */
++    int64_t idle_halt_last;     /* when the loop last found no work */
++#endif
+     uint32_t softint;
+ #define SOFTINT_TIMER   1
+ #define SOFTINT_STIMER  (1 << 16)
+diff --git a/target/sparc/helper.h b/target/sparc/helper.h
+index 7427af4959..58bd9e13f2 100644
+--- a/target/sparc/helper.h
++++ b/target/sparc/helper.h
+@@ -12,6 +12,9 @@ DEF_HELPER_3(solaris_idle_mp, void, env, tl, tl)
+ #else
+ DEF_HELPER_FLAGS_2(wrpil, TCG_CALL_NO_RWG, void, env, tl)
+ DEF_HELPER_2(wrgl, void, env, tl)
++#ifndef CONFIG_USER_ONLY
++DEF_HELPER_5(sparc64_idle, void, env, tl, tl, tl, tl)
++#endif
+ DEF_HELPER_2(wrpstate, void, env, tl)
+ DEF_HELPER_1(done, void, env)
+ DEF_HELPER_1(retry, void, env)
+diff --git a/target/sparc/meson.build b/target/sparc/meson.build
+index 56c13904f7..598730ff3e 100644
+--- a/target/sparc/meson.build
++++ b/target/sparc/meson.build
+@@ -22,6 +22,7 @@ sparc_system_ss.add(files(
+ ))
+ sparc_system_ss.add(when: 'TARGET_SPARC', if_true: files('sunos_idle.c'))
+ sparc_system_ss.add(when: 'TARGET_SPARC', if_true: files('solaris_idle.c'))
++sparc_system_ss.add(when: 'TARGET_SPARC64', if_true: files('sparc64_idle.c'))
+ 
+ target_arch += {'sparc': sparc_ss}
+ target_system_arch += {'sparc': sparc_system_ss}
+diff --git a/target/sparc/sparc64_idle.c b/target/sparc/sparc64_idle.c
+new file mode 100644
+index 0000000000..1b545f5e0f
+--- /dev/null
++++ b/target/sparc/sparc64_idle.c
+@@ -0,0 +1,158 @@
++/*
++ * sun4u: halt the CPU in the idle loop of the guest kernel
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++/*
++ * On a real UltraSPARC-II or -IIi nothing stops the processor: none of
++ * the kernels that run on QEMU's sun4u has a way to do it there. Solaris
++ * and illumos only halt an idle CPU through cpu_halt_cpu(), which only the
++ * SPARC64-VI module provides; NetBSD and Linux only yield to the
++ * hypervisor on sun4v, and OpenBSD's sleep instruction is patched in only
++ * on CPUs with several strands. So an idle guest spins in its idle loop,
++ * and keeps a host core busy for as long as the VM runs.
++ *
++ * The translator recognises the idle loops of the guests below by the
++ * instructions around one call in them (gen_sparc64_idle() in
++ * translate.c), and takes from those instructions where the loop keeps
++ * the word that says that there is work:
++ *
++ *   NetBSD 9 and 11 idle_loop():
++ *       if (!sched_curcpu_runnable_p()) {
++ *           cpu_idle();                       <- here
++ *           if (!sched_curcpu_runnable_p() && !ci->ci_want_resched)
++ *               continue;
++ *       }
++ *     cpu_idle() does nothing on sun4u; the word is ci_want_resched.
++ *
++ *   OpenBSD sched_idle():
++ *       while (spc->spc_whichqs == 0)
++ *           cpu_idle_cycle();                 <- here
++ *     cpu_idle_cycle() does nothing on sun4u; the word is spc_whichqs.
++ *
++ *   Solaris 9 and 10, illumos (Tribblix) idle(), with one CPU:
++ *       while (ncpus == 1) {
++ *           if (CPU->cpu_disp->disp_nrunnable == 0) {
++ *               (*idle_cpu)();                <- here
++ *               continue;
++ *           }
++ *           swtch();
++ *       }
++ *     idle_cpu is generic_idle_cpu(), which just returns, on every sun4u
++ *     CPU module but SPARC64-VI's; the word is disp_nrunnable. Where the
++ *     compiler has overwritten the cpu_disp pointer by the time of the
++ *     call (gcc, Tribblix), the helper follows it again from the CPU
++ *     structure.
++ *
++ * At the call helper_sparc64_idle() halts the CPU when the word is 0,
++ * interrupts are enabled at level 0 and none is pending: the call is
++ * where the kernel would stop the processor if it could. QEMU's sun4u has
++ * one CPU, so only an interrupt handler can then give it work, and the
++ * kernel's clock (%tick or %stick compare) interrupts at least 100 times a
++ * second. The CPU goes on at the call after the next interrupt, so the
++ * guest runs its loop as before and counts its idle time the same way.
++ * The helper reads the word again, as an interrupt may have come since
++ * the loop looked at it.
++ *
++ * As in the sun4m idle loops, the loop spins on for 100 us before the
++ * first halt, as a disk request often completes that soon.
++ */
++
++#include "qemu/osdep.h"
++#include "qemu/timer.h"
++#include "hw/core/cpu.h"
++#include "cpu.h"
++#include "accel/tcg/cpu-loop.h"
++#include "accel/tcg/cpu-mmu-index.h"
++#include "accel/tcg/probe.h"
++#include "exec/cpu-common.h"
++#include "exec/helper-proto.h"
++#include "exec/tlb-flags.h"
++#include "trace.h"
++
++/*
++ * Spin on for this long after the loop first found no work. A round that
++ * comes more than SPARC64_IDLE_GAP_NS after the one before means that the
++ * guest left the loop between them.
++ */
++#define SPARC64_IDLE_POLL_NS  (100 * SCALE_US)
++#define SPARC64_IDLE_GAP_NS   (20 * SCALE_US)
++
++static bool sparc64_idle_polled(CPUSPARCState *env)
++{
++    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
++
++    if (now - env->idle_halt_last > SPARC64_IDLE_GAP_NS) {
++        env->idle_halt_since = now;
++    }
++    env->idle_halt_last = now;
++    return now - env->idle_halt_since >= SPARC64_IDLE_POLL_NS;
++}
++
++/*
++ * Read a 4- or 8-byte kernel word that the loop has just loaded; false if
++ * it is not mapped RAM. With one CPU nothing can take the TLB entry away
++ * between the load and here.
++ */
++static bool sparc64_idle_read(CPUSPARCState *env, target_ulong addr,
++                              int size, uint64_t *val)
++{
++    void *host;
++    int flags;
++
++    if (addr & (size - 1)) {
++        return false;
++    }
++    flags = probe_access_flags(env, addr, size, MMU_DATA_LOAD,
++                               cpu_mmu_index(env_cpu(env), false), true,
++                               &host, 0);
++    if ((flags & TLB_INVALID_MASK) || !host) {
++        return false;
++    }
++    *val = size == 8 ? ldq_be_p(host) : ldl_be_p(host);
++    return true;
++}
++
++/*
++ * The guest is at the call in its idle loop (pc) and the 4-byte word at
++ * addr, or with indirect at off past the pointer at addr, says whether
++ * there is work. Halt until the next interrupt when there is none, and go
++ * on at the call then.
++ */
++void HELPER(sparc64_idle)(CPUSPARCState *env, target_ulong pc,
++                          target_ulong addr, target_ulong indirect,
++                          target_ulong off)
++{
++    CPUState *cs = env_cpu(env);
++    uint64_t val;
++
++    /*
++     * Interrupts are enabled at level 0 and nothing is pending: no
++     * interrupt, interrupt vector or soft interrupt
++     */
++    if (!(env->pstate & PS_IE) || env->psrpil || env->tl ||
++        cpu_test_interrupt(cs, CPU_INTERRUPT_HARD) ||
++        (env->ivec_status & 0x20) || env->softint || env->pil_in) {
++        return;
++    }
++    if (indirect) {
++        if (!sparc64_idle_read(env, addr, 8, &val)) {
++            return;
++        }
++        addr = val + off;
++    }
++    if (!sparc64_idle_read(env, addr, 4, &val) || val) {
++        return;
++    }
++    if (!sparc64_idle_polled(env)) {
++        return;
++    }
++
++    trace_sparc64_idle(pc);
++    env->pc = pc;
++    env->npc = pc + 4;
++    cs->halted = 1;
++    cs->exception_index = EXCP_HLT;
++    cpu_loop_exit(cs);
++}
+diff --git a/target/sparc/trace-events b/target/sparc/trace-events
+index f26fe1a843..5f204e0d56 100644
+--- a/target/sparc/trace-events
++++ b/target/sparc/trace-events
+@@ -25,7 +25,11 @@ sparc_solaris_idle(uint32_t pc) "idle loop halt, go on at 0x%08x"
+ sparc_solaris_idle_mp(int cpu, uint32_t pc) "cpu %d: multiprocessor idle loop halt, go on at 0x%08x"
+ sparc_solaris_idle_mp_wake(int cpu, const char *why) "cpu %d: wake from the idle loop halt (%s)"
+ 
++# sparc64_idle.c
++sparc64_idle(uint64_t pc) "idle loop halt, go on at 0x%"PRIx64
++
+ # translate.c
++sparc64_idle_match(const char *kernel, uint64_t pc, int reg, int off, int off2) "%s idle loop: call at 0x%"PRIx64", the word that says there is work at register %d offset %d or at offset %d past the pointer there (-1: not a pointer)"
+ sparc_solaris_idle_mp_match(const char *kernel, uint32_t pc, int reg, int off) "Solaris multiprocessor idle loop (%s): disp_getwork call at 0x%08x, disp_nrunnable at register %d offset %d"
+ sparc_solaris_idle_match(const char *kernel, uint32_t pc, int reg, int off) "Solaris idle loop (%s): idle_cpu call at 0x%08x, disp_nrunnable at register %d offset %d"
+ sparc_sunos_idle_match(uint32_t pc, uint32_t top, uint32_t nrunnable, uint32_t whichqs, uint32_t qrunflag) "SunOS idle loop: branch at 0x%08x to 0x%08x, Nrunnable 0x%08x whichqs 0x%08x qrunflag 0x%08x"
+diff --git a/target/sparc/translate.c b/target/sparc/translate.c
+index 65bc139929..65bd7a29b1 100644
+--- a/target/sparc/translate.c
++++ b/target/sparc/translate.c
+@@ -181,6 +181,7 @@ typedef struct DisasContext {
+     bool supervisor;
+ #ifdef TARGET_SPARC64
+     bool hypervisor;
++    bool idle_halt;
+ #else
+     bool fsr_qne;
+     bool sunos_idle;
+@@ -5732,6 +5733,8 @@ static void sparc_tr_init_disas_context(DisasContextBase *dcbase, CPUState *cs)
+     dc->supervisor = (dc->base.tb->flags & TB_FLAG_SUPER) != 0;
+ # ifdef TARGET_SPARC64
+     dc->hypervisor = (dc->base.tb->flags & TB_FLAG_HYPER) != 0;
++    dc->idle_halt = cpu_env(cs)->idle_halt && dc->supervisor &&
++                    !(tb_cflags(dc->base.tb) & CF_SINGLE_STEP);
+ # else
+     dc->fsr_qne = (dc->base.tb->flags & TB_FLAG_FSR_QNE) != 0;
+     dc->sunos_idle = cpu_env(cs)->sunos_idle && dc->supervisor &&
+@@ -6134,6 +6137,384 @@ static void gen_solaris_idle_mp(DisasContext *dc, CPUSPARCState *env,
+ }
+ #endif
+ 
++#if !defined(CONFIG_USER_ONLY) && defined(TARGET_SPARC64)
++/*
++ * The idle loops of sun4u guests, see sparc64_idle.c. Each is recognised
++ * at one call in it by the words around the call, taken from the kernels
++ * as their compilers laid them out; registers, offsets and addresses are
++ * read from the words and checked against each other rather than masked
++ * into a fixed pattern.
++ */
++#define S64_NOP         0x01000000
++#define S64_IDLE_BEFORE 8       /* words read before the call */
++#define S64_IDLE_AFTER  12      /* and after it */
++
++#define S64_RD(w)       extract32(w, 25, 5)
++#define S64_RS1(w)      extract32(w, 14, 5)
++
++/* call disp30 */
++static bool s64_call(uint32_t w, target_ulong pc, target_ulong *target)
++{
++    if (extract32(w, 30, 2) != 1) {
++        return false;
++    }
++    *target = pc + ((target_long)sextract32(w, 0, 30) << 2);
++    return true;
++}
++
++/*
++ * A branch on the integer condition codes (Bicc, or BPcc on %icc or %xcc)
++ * with condition cond; its target.
++ */
++static bool s64_bcc(uint32_t w, target_ulong pc, int cond, target_ulong *t)
++{
++    if (extract32(w, 30, 2) != 0 || extract32(w, 25, 4) != cond) {
++        return false;
++    }
++    switch (extract32(w, 22, 3)) {
++    case 2:                                 /* Bicc */
++        *t = pc + ((target_long)sextract32(w, 0, 22) << 2);
++        return true;
++    case 1:                                 /* BPcc */
++        if (extract32(w, 20, 1)) {          /* only %icc (00) and %xcc (10) */
++            return false;
++        }
++        *t = pc + ((target_long)sextract32(w, 0, 19) << 2);
++        return true;
++    }
++    return false;
++}
++
++/* A branch on register rs1 (BPr) with rcond; its target */
++static bool s64_bpr(uint32_t w, target_ulong pc, int rcond, int rs1,
++                    target_ulong *t)
++{
++    if (extract32(w, 30, 2) != 0 || extract32(w, 22, 3) != 3 ||
++        extract32(w, 28, 1) || extract32(w, 25, 3) != rcond ||
++        S64_RS1(w) != rs1) {
++        return false;
++    }
++    *t = pc + ((target_long)((sextract32(w, 20, 2) << 14) |
++                             extract32(w, 0, 14)) << 2);
++    return true;
++}
++
++#define S64_BNE         9
++#define S64_BE          1
++#define S64_BA          8
++#define S64_RNZ         5       /* brnz */
++
++/* cmp %rs1, 0 (subcc %rs1, 0, %g0) */
++static bool s64_cmp0(uint32_t w, int *rs1)
++{
++    if ((w & 0xfff83fff) != 0x80a02000) {
++        return false;
++    }
++    *rs1 = S64_RS1(w);
++    return true;
++}
++
++/* lduw [%rs1 + simm13], %rd, or [%rs1] */
++static bool s64_lduw(uint32_t w, int *rs1, int32_t *off, int *rd)
++{
++    if (extract32(w, 30, 2) != 3 || extract32(w, 19, 6) != 0) {
++        return false;
++    }
++    if (extract32(w, 13, 1)) {
++        *off = sextract32(w, 0, 13);
++    } else if (extract32(w, 0, 5) == 0) {   /* [%rs1 + %g0] */
++        *off = 0;
++    } else {
++        return false;
++    }
++    *rs1 = S64_RS1(w);
++    *rd = S64_RD(w);
++    return true;
++}
++
++/*
++ * Where the loop keeps the word that says there is work: at %reg + off,
++ * or, when indirect, at off2 past the pointer at %reg + off
++ */
++typedef struct S64IdleWord {
++    int reg;
++    int32_t off;
++    bool indirect;
++    int32_t off2;
++} S64IdleWord;
++
++/*
++ * The test of a function's result before NetBSD's cpu_idle() call:
++ * "cmp %o0, 0; bne out; nop" or "brnz %o0, out; nop" at w[i]. Its length,
++ * or 0, and where it branches.
++ */
++static int s64_netbsd_test(const uint32_t *w, target_ulong pc,
++                           target_ulong *out)
++{
++    int r;
++
++    if (s64_bpr(w[0], pc, S64_RNZ, 8, out) && w[1] == S64_NOP) {
++        return 2;
++    }
++    if (s64_cmp0(w[0], &r) && r == 8 &&
++        s64_bcc(w[1], pc + 4, S64_BNE, out) && w[2] == S64_NOP) {
++        return 3;
++    }
++    return 0;
++}
++
++/*
++ * NetBSD 9 and 11, idle_loop() (w[S64_IDLE_BEFORE] is the call):
++ *
++ *        call  sched_curcpu_runnable_p
++ *         nop
++ *        cmp   %o0, 0; bne out; nop       (or brnz %o0, out; nop)
++ *        call  cpu_idle                   <- here
++ *         nop
++ *        call  sched_curcpu_runnable_p
++ *         nop
++ *        cmp   %o0, 0; bne out; nop       (or brnz %o0, out; nop)
++ *        ld    [%ci + want_resched], %x
++ *        cmp   %x, 0
++ *        be    top
++ *         nop
++ *
++ * The word is ci_want_resched.
++ */
++static bool s64_idle_netbsd(const uint32_t *w, target_ulong pc,
++                            S64IdleWord *iw)
++{
++    const uint32_t *c = w + S64_IDLE_BEFORE;
++    target_ulong r0, r1, out0, out1, top;
++    int n0, n1, i, x, y, ci;
++
++    /* The test before the call, and the call of runnable_p before it */
++    for (n0 = 3; n0 >= 2; n0--) {
++        if (s64_netbsd_test(c - n0, pc - 4 * n0, &out0) == n0) {
++            break;
++        }
++    }
++    if (n0 < 2 || c[-n0 - 1] != S64_NOP ||
++        !s64_call(c[-n0 - 2], pc - 4 * (n0 + 2), &r0)) {
++        return false;
++    }
++    /* nop; call runnable_p; nop; the test */
++    if (c[1] != S64_NOP || !s64_call(c[2], pc + 8, &r1) || r1 != r0 ||
++        c[3] != S64_NOP) {
++        return false;
++    }
++    n1 = s64_netbsd_test(c + 4, pc + 16, &out1);
++    if (!n1 || out1 != out0) {
++        return false;
++    }
++    /* ld [%ci + off], %x; cmp %x, 0; be top; nop */
++    i = 4 + n1;
++    if (!s64_lduw(c[i], &ci, &iw->off, &x) || !s64_cmp0(c[i + 1], &y) ||
++        y != x ||
++        !s64_bcc(c[i + 2], pc + 4 * (i + 2), S64_BE, &top) ||
++        c[i + 3] != S64_NOP || top >= pc || pc - top > 4 * 64) {
++        return false;
++    }
++    /* The calls keep only the local and in registers */
++    if (ci < 16 || ci == x) {
++        return false;
++    }
++    iw->reg = ci;
++    return true;
++}
++
++/*
++ * OpenBSD, sched_idle() (w[S64_IDLE_BEFORE] is the call):
++ *
++ *   top: ld    [%spc + whichqs], %x
++ *        cmp   %x, 0
++ *        bne   out
++ *         nop
++ *        call  cpu_idle_cycle             <- here
++ *         nop
++ *        b     top
++ *         nop
++ *   out:
++ *
++ * The word is spc_whichqs.
++ */
++static bool s64_idle_openbsd(const uint32_t *w, target_ulong pc,
++                             S64IdleWord *iw)
++{
++    const uint32_t *c = w + S64_IDLE_BEFORE;
++    target_ulong t;
++    int spc, x, y;
++
++    if (!s64_lduw(c[-4], &spc, &iw->off, &x) ||
++        !s64_cmp0(c[-3], &y) || y != x ||
++        !s64_bcc(c[-2], pc - 8, S64_BNE, &t) || t != pc + 16 ||
++        c[-1] != S64_NOP || c[1] != S64_NOP ||
++        !s64_bcc(c[2], pc + 8, S64_BA, &t) || t != pc - 16 ||
++        c[3] != S64_NOP) {
++        return false;
++    }
++    if (spc < 16 || spc == x) {
++        return false;
++    }
++    iw->reg = spc;
++    return true;
++}
++
++/* ldx [%rs1 + simm13], %rd, or [%rs1] */
++static bool s64_ldx(uint32_t w, int *rs1, int32_t *off, int *rd)
++{
++    if (extract32(w, 30, 2) != 3 || extract32(w, 19, 6) != 0x0b) {
++        return false;
++    }
++    if (extract32(w, 13, 1)) {
++        *off = sextract32(w, 0, 13);
++    } else if (extract32(w, 0, 5) == 0) {   /* [%rs1 + %g0] */
++        *off = 0;
++    } else {
++        return false;
++    }
++    *rs1 = S64_RS1(w);
++    *rd = S64_RD(w);
++    return true;
++}
++
++/*
++ * Solaris 9 and 10, illumos, idle() with one CPU (w[S64_IDLE_BEFORE] is
++ * the call). Sun's compiler (Solaris 9: disp_t in the CPU structure;
++ * Solaris 10: cpu_disp points to it):
++ *
++ *       [ldx   [%cpu + cpu_disp], %disp]
++ *        ld    [%disp + nrunnable], %x
++ *        cmp   %x, 0
++ *        bne   run
++ *         sethi %hi(idle_cpu), %y
++ *        ldx   [%y + %lo(idle_cpu)], %z
++ *        call  %z                         <- here
++ *         ...
++ *        b     top
++ *
++ * gcc (Tribblix), with the address of idle_cpu kept in a register:
++ *
++ *        ldx   [%cpu + cpu_disp], %disp
++ *        ld    [%disp + nrunnable], %x    (%x may be %disp)
++ *        cmp   %x, 0
++ *        bne   run
++ *         nop
++ *        ldx   [%a], %z
++ *        call  %z                         <- here
++ *         ...
++ *        b     top
++ *
++ * The word is disp_nrunnable: at %disp + nrunnable when nothing after
++ * the load writes %disp, else at nrunnable past the pointer at %cpu +
++ * cpu_disp.
++ */
++static bool s64_idle_solaris(const uint32_t *w, target_ulong pc,
++                             S64IdleWord *iw)
++{
++    const uint32_t *c = w + S64_IDLE_BEFORE;
++    target_ulong t;
++    int disp, x, x2, y = -1, a, z, cpu, d2;
++    int32_t off, off2;
++
++    if (extract32(c[0], 30, 2) != 2 ||
++        !s64_lduw(c[-5], &disp, &off, &x) ||
++        !s64_cmp0(c[-4], &x2) || x2 != x ||
++        !s64_bcc(c[-3], pc - 12, S64_BNE, &t) || t <= pc + 4 ||
++        !s64_ldx(c[-1], &a, &off2, &z) || S64_RS1(c[0]) != z ||
++        !s64_bcc(c[2], pc + 8, S64_BA, &t)) {
++        return false;
++    }
++    /* The delay slot: sethi %hi(idle_cpu), %y for the ldx, or a nop */
++    if (extract32(c[-2], 22, 10) == (extract32(c[-2], 25, 5) << 3 | 4) &&
++        c[-2] != S64_NOP) {
++        y = S64_RD(c[-2]);
++        if (a != y) {
++            return false;
++        }
++    } else if (c[-2] != S64_NOP) {
++        return false;
++    }
++
++    if (disp != 0 && disp != x && disp != y && disp != z) {
++        /* Nothing between the load and the call writes %disp */
++        iw->reg = disp;
++        iw->off = off;
++        return true;
++    }
++    /* ldx [%cpu + cpu_disp], %disp, and nothing after writes %cpu */
++    if (!s64_ldx(c[-6], &cpu, &off2, &d2) || d2 != disp || cpu == 0 ||
++        cpu == disp || cpu == x || cpu == y || cpu == z) {
++        return false;
++    }
++    iw->reg = cpu;
++    iw->off = off2;
++    iw->indirect = true;
++    iw->off2 = off;
++    return true;
++}
++
++typedef struct Sparc64IdleLoop {
++    const char *kernel;
++    bool (*match)(const uint32_t *w, target_ulong pc, S64IdleWord *iw);
++} Sparc64IdleLoop;
++
++static const Sparc64IdleLoop sparc64_idle_loops[] = {
++    { "NetBSD", s64_idle_netbsd },
++    { "OpenBSD", s64_idle_openbsd },
++    { "Solaris", s64_idle_solaris },
++};
++
++/*
++ * At a call (disp30 or through a register), if it is the call in the idle
++ * loop of a known kernel, let helper_sparc64_idle() halt the CPU there
++ */
++static void gen_sparc64_idle(DisasContext *dc, CPUSPARCState *env,
++                             uint32_t insn)
++{
++    target_ulong start = dc->pc - 4 * S64_IDLE_BEFORE;
++    uint32_t w[S64_IDLE_BEFORE + 1 + S64_IDLE_AFTER];
++    int k, i;
++    TCGv addr;
++
++    /* The call is not in a delay slot */
++    if (dc->npc != dc->pc + 4) {
++        return;
++    }
++    /* Off RAM, translator_ldl_end() would record these words as code */
++    if (tb_page_addr0(dc->base.tb) == -1 ||
++        !translator_is_same_page(&dc->base, start) ||
++        !translator_is_same_page(&dc->base, start + 4 * (ARRAY_SIZE(w) - 1))) {
++        return;
++    }
++    for (i = 0; i < ARRAY_SIZE(w); i++) {
++        w[i] = i == S64_IDLE_BEFORE ? insn :
++               translator_ldl_end(env, &dc->base, start + 4 * i, MO_BE);
++    }
++
++    for (k = 0; k < ARRAY_SIZE(sparc64_idle_loops); k++) {
++        const Sparc64IdleLoop *l = &sparc64_idle_loops[k];
++        S64IdleWord iw = { 0 };
++
++        if (!l->match(w, dc->pc, &iw)) {
++            continue;
++        }
++
++        trace_sparc64_idle_match(l->kernel, dc->pc, iw.reg, iw.off,
++                                 iw.indirect ? iw.off2 : -1);
++
++        /* The helper reads the clock */
++        translator_io_start(&dc->base);
++        addr = tcg_temp_new();
++        tcg_gen_addi_tl(addr, gen_load_gpr(dc, iw.reg), iw.off);
++        gen_helper_sparc64_idle(tcg_env, tcg_constant_tl(dc->pc), addr,
++                                tcg_constant_tl(iw.indirect),
++                                tcg_constant_tl(iw.off2));
++        return;
++    }
++}
++#endif
++
+ static void sparc_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+ {
+     DisasContext *dc = container_of(dcbase, DisasContext, base);
+@@ -6154,6 +6535,14 @@ static void sparc_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+         gen_solaris_idle_mp(dc, cpu_env(cs), insn);
+     }
+ #endif
++#if !defined(CONFIG_USER_ONLY) && defined(TARGET_SPARC64)
++    /* call disp30, or call %rs1 (jmpl %rs1 + %g0 or + 0, %o7) */
++    if (dc->idle_halt && (extract32(insn, 30, 2) == 1 ||
++                          (insn & 0xfff83fff) == 0x9fc00000 ||
++                          (insn & 0xfff83fff) == 0x9fc02000)) {
++        gen_sparc64_idle(dc, cpu_env(cs), insn);
++    }
++#endif
+ 
