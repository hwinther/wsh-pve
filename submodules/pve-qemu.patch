++static int write_linux_sun4v(uint32_t *p, int at, bool pil14)
++{
++    int n = 0;
++
++    p[n++] = 0x91902000;                /* wrpr %g0, 0, %pil */
++    p[n++] = 0x83518000;                /* rdpr %pstate, %g1 */
++    p[n++] = 0x82286002;                /* andn %g1, 2, %g1 */
++    p[n++] = 0x8d904000;                /* wrpr %g1, %pstate */
++    p[n++] = 0xc259a008;                /* ldx [%g6 + 8], %g1 */
++    p[n++] = 0x80886008;                /* btst 8, %g1 */
++    p[n] = bpcc_xcc_pn_to(BNE, at + n, at + n + 4); n++;
++    p[n++] = NOP;
++    p[n] = call_to(at + n, FUNC + 3); n++;      /* sun4v_cpu_yield */
++    p[n++] = NOP;
++    p[n++] = 0x83518000;                /* rdpr %pstate, %g1 */
++    p[n++] = 0x82106002;                /* or %g1, 2, %g1 */
++    p[n++] = 0x8d904000;                /* wrpr %g1, %pstate */
++    if (pil14) {
++        p[n++] = 0x9190200e;            /* wrpr %g0, 14, %pil */
++    }
++    p[n++] = 0x81cfe008;                /* return %i7 + 8 */
