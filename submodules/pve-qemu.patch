diff --git a/debian/patches/wsh/0029-hw-sparc-sun4m-give-the-cs4231-its-interrupt-level-i.patch b/debian/patches/wsh/0029-hw-sparc-sun4m-give-the-cs4231-its-interrupt-level-i.patch
new file mode 100644
index 0000000..3a1e670
--- /dev/null
+++ b/debian/patches/wsh/0029-hw-sparc-sun4m-give-the-cs4231-its-interrupt-level-i.patch
@@ -0,0 +1,69 @@
+From: Antoni Sawicki <as@tenoware.com>
+Subject: [PATCH] hw/sparc/sun4m: give the cs4231 its interrupt level, iommu and audiodev
+
+OpenBIOS gives the SUNW,CS4231 node "intr" 5, and SunOS 4.1.4 takes the
+chip's interrupt at level 5 (dmesg: pri 5). The chip raised interrupt
+bit 5, which is level 11, so SunOS never saw it. Use bit 9: level 5.
+
+Link the chip to the IOMMU for its DMA, and add the machine's audiodev
+property, so -machine audiodev= picks the sound backend.
+
+Origin: https://github.com/tenox7/lemu/commit/42d325754c976b2eda0c7113c42f321a65373af6
+---
+ hw/sparc/sun4m.c | 22 +++++++++++++++++++---
+ 1 file changed, 19 insertions(+), 3 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 833b41a998..8b8a5d8baf 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -863,6 +863,7 @@ static void sun4m_hw_init(MachineState *machine)
+     DeviceState *dev, *ms_kb_orgate, *serial_orgate;
+     DeviceState *cpus[MAX_CPUS];
+     SysBusDevice *s;
++    void *iommu;
+     unsigned int smp_cpus = machine->smp.cpus;
+     unsigned int max_cpus = machine->smp.max_cpus;
+     HostMemoryBackend *ram_memdev = machine->memdev;
+@@ -921,7 +922,8 @@ static void sun4m_hw_init(MachineState *machine)
+         afx_init(hwdef->afx_base);
+     }
+ 
+-    iommu_init(hwdef->iommu_base, hwdef->iommu_version, slavio_irq[30]);
++    iommu = iommu_init(hwdef->iommu_base, hwdef->iommu_version,
++                       slavio_irq[30]);
+ 
+     if (hwdef->iommu_pad_base) {
+         /* On the real hardware (SS-5, LX) the MMU is not padded, but aliased.
+@@ -1082,8 +1084,21 @@ static void sun4m_hw_init(MachineState *machine)
+                      slavio_irq[30], fdc_tc);
+ 
+     if (hwdef->cs_base) {
+-        sysbus_create_simple("sun-CS4231", hwdef->cs_base,
+-                             slavio_irq[5]);
++        /* the APC DMA in front of the codec reads memory through the IOMMU */
++        dev = qdev_new("sun-CS4231");
++        if (machine->audiodev) {
++            qdev_prop_set_string(dev, "audiodev", machine->audiodev);
++        }
++        object_property_set_link(OBJECT(dev), "iommu", OBJECT(iommu),
++                                 &error_abort);
++        s = SYS_BUS_DEVICE(dev);
++        sysbus_realize_and_unref(s, &error_fatal);
++        sysbus_mmio_map(s, 0, hwdef->cs_base);
++        /*
++         * OpenBIOS gives the node "intr" 5, so the guest's handler is at
++         * interrupt level 5: interrupt bit 9 (SBus level 3) raises it.
++         */
++        sysbus_connect_irq(s, 0, slavio_irq[9]);
+     }
+ 
+     if (hwdef->dbri_base) {
+@@ -1173,6 +1188,7 @@ static void sun4m_machine_class_init(ObjectClass *oc, const void *data)
+     mc->default_boot_order = "c";
+     mc->default_display = "tcx";
+     mc->default_ram_id = "sun4m.ram";
++    machine_add_audiodev_property(mc);
+ 
+     object_class_property_add_bool(oc, "sunos-idle", sun4m_get_sunos_idle,
+                                    sun4m_set_sunos_idle);
diff --git a/debian/patches/wsh/0030-hw-sparc-sun4m-raise-the-SS-5-s-cs4231-at-SBus-level.patch b/debian/patches/wsh/0030-hw-sparc-sun4m-raise-the-SS-5-s-cs4231-at-SBus-level.patch
new file mode 100644
index 0000000..6e022d2
--- /dev/null
+++ b/debian/patches/wsh/0030-hw-sparc-sun4m-raise-the-SS-5-s-cs4231-at-SBus-level.patch
@@ -0,0 +1,89 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: raise the SS-5's cs4231 at SBus level 5
+
+The real SPARCstation 5 has its CS4231 at SBus level 5, processor level
+9: its PROM (ss5.bin 2.15) gives the node "intr" 0x39, an SBus
+interrupt at level 9. The chip raised interrupt bit 9, SBus level 3
+(processor level 5), the level OpenBIOS's "intr" 5 gives SunOS 4.
+Solaris takes OpenBIOS's "interrupts" 5, SBus level 5, and waits at
+level 9 instead: Solaris 2.6's audioplay stopped after its first
+buffers with "processor level 3 SBus interrupt not serviced". Under the
+Sun PROM no guest would have found the interrupt.
+
+Raise interrupt bit 11, SBus level 5, as the real machine. The frame
+buffer (cg3 or TCX) is at SBus level 5 too, so both go through an OR
+gate, as the keyboard and mouse do. OpenBIOS gives the node "intr" 9
+to match (wsh-pve openbios patch 0016).
+---
+ hw/sparc/sun4m.c | 29 +++++++++++++++++++++++------
+ 1 file changed, 23 insertions(+), 6 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 8b8a5d8baf..44e10094d3 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -860,7 +860,8 @@ static void sun4m_hw_init(MachineState *machine)
+     uint32_t initrd_size;
+     DriveInfo *fd[MAX_FD];
+     FWCfgState *fw_cfg;
+-    DeviceState *dev, *ms_kb_orgate, *serial_orgate;
++    DeviceState *dev, *ms_kb_orgate, *serial_orgate, *sbus5_orgate = NULL;
++    qemu_irq sbus5_irq;
+     DeviceState *cpus[MAX_CPUS];
+     SysBusDevice *s;
+     void *iommu;
+@@ -910,6 +911,21 @@ static void sun4m_hw_init(MachineState *machine)
+     for (i = 0; i < 32; i++) {
+         slavio_irq[i] = qdev_get_gpio_in(slavio_intctl, i);
+     }
++
++    /*
++     * SBus level 5 (interrupt bit 11, processor level 9): the frame buffer,
++     * and on the SS-5 the CS4231 too, as on the real machine. Two devices
++     * on one level need an OR gate.
++     */
++    sbus5_irq = slavio_irq[11];
++    if (hwdef->cs_base) {
++        sbus5_orgate = qdev_new(TYPE_OR_IRQ);
++        object_property_set_int(OBJECT(sbus5_orgate), "num-lines", 2,
++                                &error_fatal);
++        qdev_realize_and_unref(sbus5_orgate, NULL, &error_fatal);
++        qdev_connect_gpio_out(sbus5_orgate, 0, slavio_irq[11]);
++        sbus5_irq = qdev_get_gpio_in(sbus5_orgate, 0);
++    }
+     for (i = 0; i < MAX_CPUS; i++) {
+         slavio_cpu_irq[i] = qdev_get_gpio_in(slavio_intctl, 32 + i);
+     }
+@@ -975,7 +991,7 @@ static void sun4m_hw_init(MachineState *machine)
+             }
+ 
+             /* sbus irq 5 */
+-            cg3_init(hwdef->tcx_base, slavio_irq[11],
++            cg3_init(hwdef->tcx_base, sbus5_irq,
+                      MAX(CG3_VRAM_SIZE,
+                          ROUND_UP(graphic_width * graphic_height, MiB)),
+                      graphic_width, graphic_height, graphic_depth);
+@@ -993,7 +1009,7 @@ static void sun4m_hw_init(MachineState *machine)
+                 exit(1);
+             }
+ 
+-            tcx_init(hwdef->tcx_base, slavio_irq[11], 0x00100000,
++            tcx_init(hwdef->tcx_base, sbus5_irq, 0x00100000,
+                      graphic_width, graphic_height, graphic_depth);
+             vga_interface_created = true;
+         }
+@@ -1095,10 +1111,11 @@ static void sun4m_hw_init(MachineState *machine)
+         sysbus_realize_and_unref(s, &error_fatal);
+         sysbus_mmio_map(s, 0, hwdef->cs_base);
+         /*
+-         * OpenBIOS gives the node "intr" 5, so the guest's handler is at
+-         * interrupt level 5: interrupt bit 9 (SBus level 3) raises it.
++         * SBus level 5, processor level 9, as the real SS-5 and its PROM
++         * have it. OpenBIOS (wsh patch 0016) gives the node "interrupts" 5
++         * and "intr" 9 to match: Solaris takes the first, SunOS 4 the second.
+          */
+-        sysbus_connect_irq(s, 0, slavio_irq[9]);
++        sysbus_connect_irq(s, 0, qdev_get_gpio_in(sbus5_orgate, 1));
+     }
+ 
+     if (hwdef->dbri_base) {
diff --git a/debian/patches/wsh/0031-hw-audio-cs4231-start-without-sound-when-there-is-no.patch b/debian/patches/wsh/0031-hw-audio-cs4231-start-without-sound-when-there-is-no.patch
new file mode 100644
index 0000000..a571d9b
--- /dev/null
+++ b/debian/patches/wsh/0031-hw-audio-cs4231-start-without-sound-when-there-is-no.patch
@@ -0,0 +1,90 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/audio/cs4231: start without sound when there is no audio
+ backend
+
+The machine gives the codec the -machine audiodev, and without one the
+codec takes QEMU's default audio backend. That is what LEMU's SunOS
+4.1.4 kit relies on: it starts the SS-5 without an audiodev and plays
+its sound on the host's default output. But when there is no default
+backend, as with -nodefaults, realize failed and QEMU did not start
+("no default audio driver available").
+
+The codec is on the board, so a missing backend must not stop the
+machine. Report it as a warning and go on without a voice: the codec
+keeps its registers and plays nothing. Reset now also sets up the
+playback format and lowers the interrupt without a backend; every path
+that uses the voice already checks that there is one.
+
+Tested on 11.1.3 with the series up to here and the rest on top: an
+SS-5 with -nodefaults and no audiodev starts, prints "warning: cs4231:
+no sound: no default audio driver available" once and keeps running
+through two system_reset; the SS-4 does the same. With -audiodev none
+and -machine audiodev it takes that audiodev and prints nothing.
+Without -nodefaults, in a container without sound, it takes the default
+backend (alsa there, whose voice then fails to open). qemu-server
+always passes -nodefaults: an SS-5 VM without audio0 starts with that
+one warning in its task log (TASK OK) and opens no host sound device.
+sun4m-cs4231-test (two patches on) passes.
+
+The same change as sent to LEMU after review. The first version here
+opened no voice at all without an audiodev, which keeps that kit silent.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ hw/audio/cs4231.c | 22 ++++++++++++++++------
+ 1 file changed, 16 insertions(+), 6 deletions(-)
+
+diff --git a/hw/audio/cs4231.c b/hw/audio/cs4231.c
+index fba2553a35..0b26d4c5bf 100644
+--- a/hw/audio/cs4231.c
++++ b/hw/audio/cs4231.c
+@@ -54,6 +54,7 @@
+ #include "hw/core/qdev-properties.h"
+ #include "hw/sparc/sun4m_iommu.h"
+ #include "migration/vmstate.h"
++#include "qapi/error.h"
+ #include "qemu/audio.h"
+ #include "qemu/bswap.h"
+ #include "qemu/host-utils.h"
+@@ -445,6 +446,9 @@ static void cs_play_setup(CSState *s)
+     s->play_freq = as.freq;
+     s->play_fmt = (val >> 5) & ((s->dregs[CS_MODE] & CS_MODE2) ? 7 : 3);
+     trace_cs4231_play_format(as.freq, as.nchannels, s->play_fmt);
++    if (!s->audio_be) {
++        return;
++    }
+     s->voice = audio_be_open_out(s->audio_be, s->voice, "cs4231", s,
+                                  cs_audio_callback, &as);
+     cs_set_volume(s);
+@@ -460,10 +464,8 @@ static void cs_reset(DeviceState *d)
+     s->dregs[25] = CS_VER;
+     s->play_next = false;
+     s->play_running = false;
+-    if (s->audio_be) {
+-        cs_play_setup(s);
+-        cs_play_update(s);
+-    }
++    cs_play_setup(s);
++    cs_play_update(s);
+ }
+ 
+ static uint64_t cs_mem_read(void *opaque, hwaddr addr,
+@@ -617,8 +619,16 @@ static void cs4231_init(Object *obj)
+ static void cs4231_realize(DeviceState *dev, Error **errp)
+ {
+     CSState *s = CS4231(dev);
+-
+-    if (!audio_be_check(&s->audio_be, errp)) {
++    Error *err = NULL;
++
++    /*
++     * Without an audiodev the codec takes the default backend. The codec
++     * is on the board, so if there is none the machine still starts: the
++     * codec keeps its registers and plays nothing.
++     */
++    if (!audio_be_check(&s->audio_be, &err)) {
++        error_prepend(&err, "cs4231: no sound: ");
++        warn_report_err(err);
+         return;
+     }
+     cs_play_setup(s);
diff --git a/debian/patches/wsh/0032-hw-audio-cs4231-play-out-the-last-samples-when-playb.patch b/debian/patches/wsh/0032-hw-audio-cs4231-play-out-the-last-samples-when-playb.patch
new file mode 100644
index 0000000..720c02c
--- /dev/null
+++ b/debian/patches/wsh/0032-hw-audio-cs4231-play-out-the-last-samples-when-playb.patch
@@ -0,0 +1,132 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/audio/cs4231: play out the last samples when playback stops
+
+The APC takes its samples up to 50 ms ahead of the codec's clock, and
+the audiodev holds them until it has played them. When the pipe ran
+empty or the driver turned the playback DMA off, the codec turned its
+voice off at once, and the mixer drops what a voice that is off has not
+played yet: every sound lost its last 50 ms.
+
+Keep the voice on for 200 ms after playback stops, feeding nothing, and
+turn it off from the audio callback after that. A reset still turns it
+off at once.
+
+Tested: sun4m-cs4231-test (next commit) fails without this change: the
+wav file gets 1200 of the 1600 samples when the DMA is turned off as
+soon as the pipe is empty.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ hw/audio/cs4231.c | 35 +++++++++++++++++++++++++++++++----
+ 1 file changed, 31 insertions(+), 4 deletions(-)
+
+diff --git a/hw/audio/cs4231.c b/hw/audio/cs4231.c
+index 0b26d4c5bf..ac0fd73991 100644
+--- a/hw/audio/cs4231.c
++++ b/hw/audio/cs4231.c
+@@ -44,6 +44,11 @@
+  * FIFO, and SunOS loads the next buffer only after PI, so taking a whole
+  * buffer at once would leave the pipe empty.
+  *
++ * Because the samples are taken that far ahead, the voice stays on for
++ * CS_DRAIN_NS after playback stops, at the end of the last buffer or when
++ * the driver turns the DMA off, so that the audiodev still plays what was
++ * taken: turning it off at once drops the last 50 ms of every sound.
++ *
+  * Capture is not done: its registers keep what is written, and the
+  * capture pipe always reads as empty.
+  */
+@@ -66,6 +71,7 @@
+ #include "qom/object.h"
+ 
+ #define CS_SIZE 0x40
++#define CS_DRAIN_NS (200 * SCALE_MS)   /* well past the 50 ms taken ahead */
+ #define CS_REGS 16
+ #define CS_DREGS 32
+ #define CS_MAXDREG (CS_DREGS - 1)
+@@ -147,6 +153,7 @@ struct CSState {
+     bool play_running;      /* since play_start, without a gap */
+     int64_t play_start;     /* QEMU_CLOCK_VIRTUAL ns */
+     uint64_t play_units;    /* taken since play_start */
++    int64_t play_drain;     /* the voice stays on until then */
+ };
+ 
+ #define CS_RAP(s) ((s)->regs[CS_IAR] & CS_MAXDREG)
+@@ -233,17 +240,28 @@ static void cs_play_next(CSState *s)
+     }
+ }
+ 
++/* Playback stopped: let the audiodev play what was taken ahead */
++static void cs_play_stopped(CSState *s, int64_t now)
++{
++    s->play_running = false;
++    s->play_drain = now + CS_DRAIN_NS;
++}
++
+ static void cs_play_update(CSState *s)
+ {
+     bool run = cs_play_active(s);
++    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+ 
+     if (run && !s->play_running) {
+-        s->play_start = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
++        s->play_start = now;
+         s->play_units = 0;
++    } else if (!run && s->play_running) {
++        cs_play_stopped(s, now);
+     }
+     s->play_running = run;
+     if (s->voice) {
+-        audio_be_set_active_out(s->audio_be, s->voice, run);
++        audio_be_set_active_out(s->audio_be, s->voice,
++                                run || now < s->play_drain);
+     }
+     cs_update_irq(s);
+ }
+@@ -347,13 +365,18 @@ static void cs_audio_callback(void *opaque, int avail)
+ 
+     uint32_t room = MAX(avail, 0);
+     uint64_t rate, due, budget;
++    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+ 
+     if (!s->play_running) {
++        /* stopped: the voice is on only to play out the last samples */
++        if (now >= s->play_drain) {
++            audio_be_set_active_out(s->audio_be, s->voice, false);
++        }
+         return;
+     }
+     /* units a second: one sample of each channel, two for ADPCM */
+     rate = s->play_freq / (s->play_fmt == CS_FMT_ADPCM ? 2 : 1);
+-    due = muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->play_start,
++    due = muldiv64(now - s->play_start,
+                    rate, NANOSECONDS_PER_SECOND) + rate / 20;
+     budget = due > s->play_units ? due - s->play_units : 0;
+ 
+@@ -403,7 +426,9 @@ static void cs_audio_callback(void *opaque, int avail)
+         }
+     }
+     /* after a gap the clock starts again with the next buffer */
+-    s->play_running = cs_play_active(s);
++    if (!cs_play_active(s)) {
++        cs_play_stopped(s, now);
++    }
+ }
+ 
+ /* DAC attenuation is 1.5 dB a step; the mixer wants 0-255 */
+@@ -464,6 +489,7 @@ static void cs_reset(DeviceState *d)
+     s->dregs[25] = CS_VER;
+     s->play_next = false;
+     s->play_running = false;
++    s->play_drain = 0;
+     cs_play_setup(s);
+     cs_play_update(s);
+ }
+@@ -587,6 +613,7 @@ static int cs_post_load(void *opaque, int version_id)
+     CSState *s = opaque;
+ 
+     s->play_running = false;
++    s->play_drain = 0;
+     cs_play_setup(s);
+     cs_play_update(s);
+     return 0;
diff --git a/debian/patches/wsh/0033-tests-qtest-test-CS4231-playback-through-the-APC-DMA.patch b/debian/patches/wsh/0033-tests-qtest-test-CS4231-playback-through-the-APC-DMA.patch
new file mode 100644
index 0000000..37dc275
--- /dev/null
+++ b/debian/patches/wsh/0033-tests-qtest-test-CS4231-playback-through-the-APC-DMA.patch
@@ -0,0 +1,311 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test CS4231 playback through the APC DMA on sun4m
+
+Program the SPARCstation 5's codec and APC as the SunOS and NetBSD
+drivers do, with the buffers behind IOMMU mappings, and drive it with
+the virtual clock: the first buffer is taken only after PEN, the second
+when the first has played (about 100 ms at 8000 Hz), and then the pipe
+runs empty. PI, PD, PM and PMI must follow, each interrupt at SBus
+level 5 (system bit 11), the CPU's level 9, and not at level 5 or 11.
+A wav audiodev must get every sample of both buffers decoded from
+u-law, also when the DMA is turned off as soon as the pipe is empty,
+and nothing after them. A second case checks that DMA off drops the
+buffers and that the reset bit clears the APC.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build         |   3 +-
+ tests/qtest/sun4m-cs4231-test.c | 270 ++++++++++++++++++++++++++++++++
+ 2 files changed, 272 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-cs4231-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 0ebc864fa5..9b6a60b713 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -204,7 +204,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test',
+                 'sun4m-pil-delay-slot-test',
+                 'sun4m-solaris-smp-idle-test',
+-                'sun4m-fsr-rd-test'] + \
++                'sun4m-fsr-rd-test',
++                'sun4m-cs4231-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-cs4231-test.c b/tests/qtest/sun4m-cs4231-test.c
+new file mode 100644
+index 0000000000..f34e0fb3ee
+--- /dev/null
++++ b/tests/qtest/sun4m-cs4231-test.c
+@@ -0,0 +1,270 @@
++/*
++ * QTest: CS4231 playback through the APC DMA engine on the SPARCstation 5
++ *
++ * The test programs the chip the way the SunOS and NetBSD drivers do:
++ * IOMMU mappings for two u-law buffers, the playback format in the codec,
++ * the first buffer in the APC's next registers, the CSR with DMA on and
++ * its interrupts enabled, and then playback on in the codec (PEN). Driven
++ * by the virtual clock, the APC must take the first buffer (PI, the next
++ * registers free again: PD), take the second one when the first has been
++ * played and then run empty (PMI, PM), in real time at 8000 Hz, with each
++ * of those interrupts at SBus level 5, the CPU's level 9, as on the real
++ * machine. The samples must reach the audiodev decoded, all of them, also
++ * when the driver turns the DMA off as soon as the pipe is empty: a wav
++ * file with the right values for exactly the length of the two buffers.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* SPARCstation 5 */
++#define CS_BASE         0x6c000000ULL
++#define IOMMU_BASE      0x10000000ULL
++#define INTCTL_CPU0     0x71e00000ULL   /* per-CPU pending: 1 << PIL */
++#define INTCTL_SYS      0x71e10000ULL   /* system pending: 1 << bit */
++
++/* Codec and APC registers */
++#define CS_IAR          (CS_BASE + 0x00)
++#define CS_IDR          (CS_BASE + 0x04)
++#define APC_CSR         (CS_BASE + 0x10)
++#define APC_PVA         (CS_BASE + 0x30)
++#define APC_PC          (CS_BASE + 0x34)
++#define APC_PNVA        (CS_BASE + 0x38)
++#define APC_PNC         (CS_BASE + 0x3c)
++
++#define APC_IP          0x00800000
++#define APC_PI          0x00400000
++#define APC_IE          0x00080000
++#define APC_PIE         0x00040000
++#define APC_PMI         0x00008000
++#define APC_PM          0x00004000
++#define APC_PD          0x00002000
++#define APC_PMIE        0x00001000
++#define APC_PDMA_GO     0x00000008
++#define APC_ENABLES     (APC_IE | APC_PIE | APC_PMIE | APC_PDMA_GO)
++
++#define CS_PFMT         8
++#define CS_ICONF        9
++#define CS_PFMT_ULAW_8K 0x20            /* u-law, mono, 24.576 MHz / 3072 */
++#define CS_PEN          0x01
++
++/* The buffers in RAM and their DVMA addresses through the IOMMU */
++#define IOPTE_TABLE     0x200000ULL
++#define BUF_RAM         0x100000ULL
++#define BUF_DVMA        0xff000000U
++#define BUF_LEN         800             /* 100 ms at 8000 Hz */
++#define BUF2_OFFSET     0x1000          /* the second one on the next page */
++
++#define CS_LEVEL        9               /* processor level, the "intr" */
++#define CS_INTBIT       11              /* system bit: SBus level 5 */
++#define OLD_LEVELS      ((1u << 5) | (1u << 11))    /* earlier wirings */
++
++/* Two u-law values and what they decode to (G.711) */
++#define ULAW_POS        0xa0
++#define ULAW_NEG        0x20
++#define PCM_VALUE       7932
++
++static void codec_write(QTestState *qts, uint8_t reg, uint8_t val)
++{
++    qtest_writeb(qts, CS_IAR, reg);
++    qtest_writeb(qts, CS_IDR, val);
++}
++
++static bool level_pending(QTestState *qts, int level)
++{
++    return qtest_readl(qts, INTCTL_CPU0) & (1u << level);
++}
++
++/* Step the virtual clock 1 ms at a time until the CSR has `bits` */
++static int64_t wait_csr(QTestState *qts, uint32_t bits, int64_t limit_ms)
++{
++    int64_t ms;
++
++    for (ms = 0; ms < limit_ms; ms++) {
++        if ((qtest_readl(qts, APC_CSR) & bits) == bits) {
++            return ms;
++        }
++        qtest_clock_step(qts, 1000 * 1000);
++    }
++    g_assert_not_reached();
++}
++
++/*
++ * The wav file is stereo: the mixer doubles a mono voice played into a
++ * mono output (it adds left and right), so the test does not use one.
++ */
++static void check_wav(const char *path)
++{
++    g_autofree uint8_t *wav = NULL;
++    gsize len, frames, i, start, sound;
++    int16_t l, r;
++
++    g_assert_true(g_file_get_contents(path, (gchar **)&wav, &len, NULL));
++    g_assert_cmpuint(len, >, 44);
++    g_assert_cmpmem(wav, 4, "RIFF", 4);
++    g_assert_cmpuint(lduw_le_p(wav + 22), ==, 2);           /* channels */
++    g_assert_cmpuint(ldl_le_p(wav + 24), ==, 8000);         /* Hz */
++    g_assert_cmpuint(lduw_le_p(wav + 34), ==, 16);          /* bits */
++    frames = (len - 44) / 4;
++
++    /* Skip any silence before the sound starts */
++    for (start = 0; start < frames; start++) {
++        if (lduw_le_p(wav + 44 + 4 * start) != 0) {
++            break;
++        }
++    }
++    /* Both buffers, every sample, in order, and nothing after them */
++    for (sound = 0; start + sound < frames; sound++) {
++        if (lduw_le_p(wav + 44 + 4 * (start + sound)) == 0) {
++            break;
++        }
++    }
++    g_assert_cmpuint(sound, ==, 2 * BUF_LEN);
++    for (i = 0; i < 2 * BUF_LEN; i++) {
++        l = lduw_le_p(wav + 44 + 4 * (start + i));
++        r = lduw_le_p(wav + 44 + 4 * (start + i) + 2);
++        g_assert_cmpint(l, ==, r);
++        g_assert_cmpint(abs(l), >=, PCM_VALUE - 2);
++        g_assert_cmpint(abs(l), <=, PCM_VALUE + 2);
++        g_assert_cmpint(l > 0, ==, i < BUF_LEN);
++    }
++}
++
++static void test_playback(void)
++{
++    g_autofree char *wav = NULL;
++    uint8_t buf[BUF_LEN];
++    QTestState *qts;
++    uint32_t csr;
++    int64_t t1, t2;
++    int fd;
++
++    fd = g_file_open_tmp("sun4m-cs4231-XXXXXX.wav", &wav, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    close(fd);
++    qts = qtest_initf("-machine SS-5,audiodev=snd0 "
++                      "-audiodev wav,id=snd0,path=%s,out.frequency=8000,"
++                      "out.channels=2,out.format=s16", wav);
++
++    /* Before anything is loaded: the pipe is empty, no interrupt */
++    csr = qtest_readl(qts, APC_CSR);
++    g_assert_cmphex(csr & (APC_PM | APC_PD | APC_IP), ==, APC_PM | APC_PD);
++
++    /* Two pages mapped at BUF_DVMA, the second buffer on the second */
++    qtest_writel(qts, IOPTE_TABLE, (BUF_RAM >> 4) | 0x2);
++    qtest_writel(qts, IOPTE_TABLE + 4, ((BUF_RAM + BUF2_OFFSET) >> 4) | 0x2);
++    qtest_writel(qts, IOMMU_BASE + 4, IOPTE_TABLE >> 4);
++    qtest_writel(qts, IOMMU_BASE, 0x1);         /* 16 MB range, enabled */
++    memset(buf, ULAW_POS, sizeof(buf));
++    qtest_memwrite(qts, BUF_RAM, buf, sizeof(buf));
++    memset(buf, ULAW_NEG, sizeof(buf));
++    qtest_memwrite(qts, BUF_RAM + BUF2_OFFSET, buf, sizeof(buf));
++
++    codec_write(qts, CS_PFMT, CS_PFMT_ULAW_8K);
++    qtest_writel(qts, APC_PNVA, BUF_DVMA);
++    qtest_writel(qts, APC_PNC, BUF_LEN);
++    qtest_writel(qts, APC_CSR, APC_PI | APC_PMI | APC_ENABLES);
++
++    /* Loaded, but the codec has not asked for samples: nothing taken */
++    qtest_clock_step(qts, 50 * 1000 * 1000);
++    csr = qtest_readl(qts, APC_CSR);
++    g_assert_cmphex(csr & (APC_PI | APC_PD | APC_IP), ==, 0);
++    g_assert_false(level_pending(qts, CS_LEVEL));
++
++    /* PEN: the first buffer is taken at the next audio callback */
++    codec_write(qts, CS_ICONF, CS_PEN);
++    t1 = wait_csr(qts, APC_PI, 100);
++    g_assert_cmpint(t1, <=, 20);
++    csr = qtest_readl(qts, APC_CSR);
++    g_assert_cmphex(csr & (APC_IP | APC_PD | APC_PM), ==, APC_IP | APC_PD);
++    g_assert_cmphex(qtest_readl(qts, APC_PVA) & 0xfffff000, ==, BUF_DVMA);
++    g_assert_cmpuint(qtest_readl(qts, APC_PC), <=, BUF_LEN);
++    g_assert_true(level_pending(qts, CS_LEVEL));
++    g_assert_true(qtest_readl(qts, INTCTL_SYS) & (1u << CS_INTBIT));
++    g_assert_false(qtest_readl(qts, INTCTL_CPU0) & OLD_LEVELS);
++
++    /* The driver clears PI and loads the second buffer */
++    qtest_writel(qts, APC_CSR, APC_PI | APC_ENABLES);
++    g_assert_false(qtest_readl(qts, APC_CSR) & (APC_PI | APC_IP));
++    g_assert_false(level_pending(qts, CS_LEVEL));
++    qtest_writel(qts, APC_PNVA, BUF_DVMA + BUF2_OFFSET);
++    qtest_writel(qts, APC_PNC, BUF_LEN);
++    g_assert_false(qtest_readl(qts, APC_CSR) & APC_PD);
++
++    /* It takes the second one when the first has played: about 100 ms */
++    t2 = wait_csr(qts, APC_PI, 300);
++    g_assert_cmpint(t2, >=, 40);
++    g_assert_cmpint(t2, <=, 130);
++    g_assert_cmphex(qtest_readl(qts, APC_PVA) & 0xfffff000, ==,
++                    BUF_DVMA + BUF2_OFFSET);
++    g_assert_true(qtest_readl(qts, APC_CSR) & APC_PD);
++    g_assert_true(level_pending(qts, CS_LEVEL));
++    qtest_writel(qts, APC_CSR, APC_PI | APC_ENABLES);
++
++    /* No third buffer: the pipe runs empty when the second has played */
++    t2 = wait_csr(qts, APC_PMI, 300);
++    g_assert_cmpint(t2, >=, 40);
++    g_assert_cmpint(t2, <=, 130);
++    csr = qtest_readl(qts, APC_CSR);
++    g_assert_cmphex(csr & (APC_IP | APC_PM | APC_PD), ==,
++                    APC_IP | APC_PM | APC_PD);
++    g_assert_cmpuint(qtest_readl(qts, APC_PC), ==, 0);
++    g_assert_cmphex(qtest_readl(qts, APC_PVA), ==,
++                    BUF_DVMA + BUF2_OFFSET + BUF_LEN);
++    g_assert_true(level_pending(qts, CS_LEVEL));
++
++    /* At once PMI cleared and the DMA off, as a driver may: quiet */
++    qtest_writel(qts, APC_CSR, APC_PMI);
++    g_assert_false(qtest_readl(qts, APC_CSR) & APC_IP);
++    g_assert_false(level_pending(qts, CS_LEVEL));
++    /* The backend still plays what was taken ahead; then the file */
++    qtest_clock_step(qts, 300 * 1000 * 1000);
++    qtest_quit(qts);
++    check_wav(wav);
++    unlink(wav);
++}
++
++/* DMA off drops the buffers, and the reset bit clears the APC */
++static void test_stop_reset(void)
++{
++    QTestState *qts = qtest_init("-machine SS-5,audiodev=snd0 "
++                                 "-audiodev none,id=snd0");
++
++    qtest_writel(qts, IOPTE_TABLE, (BUF_RAM >> 4) | 0x2);
++    qtest_writel(qts, IOMMU_BASE + 4, IOPTE_TABLE >> 4);
++    qtest_writel(qts, IOMMU_BASE, 0x1);
++    codec_write(qts, CS_PFMT, CS_PFMT_ULAW_8K);
++    qtest_writel(qts, APC_PNVA, BUF_DVMA);
++    qtest_writel(qts, APC_PNC, BUF_LEN);
++    qtest_writel(qts, APC_CSR, APC_ENABLES);
++    codec_write(qts, CS_ICONF, CS_PEN);
++    wait_csr(qts, APC_PI, 100);
++    g_assert_true(level_pending(qts, CS_LEVEL));
++
++    /* DMA off: the buffer is dropped, the pipe empty */
++    qtest_writel(qts, APC_CSR, APC_PI | (APC_ENABLES & ~APC_PDMA_GO));
++    g_assert_cmpuint(qtest_readl(qts, APC_PC), ==, 0);
++    g_assert_true(qtest_readl(qts, APC_CSR) & APC_PM);
++    g_assert_false(level_pending(qts, CS_LEVEL));
++
++    /* Reset: CSR back to the empty state, nothing pending */
++    qtest_writel(qts, APC_PNC, BUF_LEN);
++    qtest_writel(qts, APC_CSR, 0x1);
++    g_assert_cmphex(qtest_readl(qts, APC_CSR) & ~0x1, ==,
++                    APC_PM | APC_PD | 0x800 | 0x400);
++    g_assert_cmpuint(qtest_readl(qts, APC_PC), ==, 0);
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4m-cs4231/playback", test_playback);
++    qtest_add_func("sun4m-cs4231/stop-reset", test_stop_reset);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0034-hw-sparc64-sun4u-take-the-IDPROM-MAC-address-from-a-.patch b/debian/patches/wsh/0034-hw-sparc64-sun4u-take-the-IDPROM-MAC-address-from-a-.patch
new file mode 100644
index 0000000..67af41c
--- /dev/null
+++ b/debian/patches/wsh/0034-hw-sparc64-sun4u-take-the-IDPROM-MAC-address-from-a-.patch
@@ -0,0 +1,115 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc64/sun4u: take the IDPROM MAC address from a -device NIC
+
+OpenBIOS gives the guest the IDPROM's MAC address as the system's, and
+NetBSD and Solaris use it for hme0: the sunhme has no local-mac-address
+of its own. NetBSD's wm (e1000) takes it too.
+
+sun4u fills the IDPROM while it builds the machine, from the onboard NIC
+(the first -nic/-net nic of the default model, at 01:01.1). A NIC added
+with -device, as qemu-server and libvirt add them, doesn't exist yet at
+that point, so the IDPROM gets QEMU's default 52:54:00:12:34:56: every
+guest has that address whatever mac= says, and two of them on one
+network clash.
+
+Without an onboard NIC, fill the IDPROM again once the machine is
+complete (a machine-init-done notifier, before the firmware runs): from
+the first NIC of the machine's own model (sunhme, the onboard NIC of a
+real Ultra 5/10), else from the first NIC of any model. The host id is
+made from the MAC address, as before, so it changes with it. With an
+onboard NIC, or with no NIC at all, the IDPROM is what it was.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ hw/sparc64/sun4u.c | 71 ++++++++++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 71 insertions(+)
+
+diff --git a/hw/sparc64/sun4u.c b/hw/sparc64/sun4u.c
+index a348096aee..42540f3dbc 100644
+--- a/hw/sparc64/sun4u.c
++++ b/hw/sparc64/sun4u.c
+@@ -153,6 +153,60 @@ static int sun4u_NVRAM_set_params(Nvram *nvram, uint16_t NVRAM_size,
+     return 0;
+ }
+ 
++/*
++ * Without an onboard NIC the IDPROM's MAC address is filled in once the
++ * machine is complete, from the NICs added with -device (see below).
++ */
++typedef struct Sun4uIdprom {
++    Notifier machine_done;
++    Nvram *nvram;
++    const char *nic_model;
++} Sun4uIdprom;
++
++typedef struct Sun4uNicSearch {
++    const char *model;
++    NICState *nic;
++} Sun4uNicSearch;
++
++static void sun4u_find_nic(NICState *nic, void *opaque)
++{
++    Sun4uNicSearch *search = opaque;
++
++    if (!search->nic && (!search->model ||
++                         !strcmp(qemu_get_queue(nic)->model, search->model))) {
++        search->nic = nic;
++    }
++}
++
++static void sun4u_idprom_machine_done(Notifier *notifier, void *data)
++{
++    Sun4uIdprom *idprom = container_of(notifier, Sun4uIdprom, machine_done);
++    NvramClass *k = NVRAM_GET_CLASS(idprom->nvram);
++    Sun4uNicSearch search = { .model = idprom->nic_model };
++    struct Sun_nvram header;
++    unsigned int i;
++
++    /*
++     * The first NIC of the machine's own model (sunhme, the onboard NIC of
++     * a real Ultra 5/10, whose MAC address is the one in its IDPROM), else
++     * the first NIC of any model.
++     */
++    qemu_foreach_nic(sun4u_find_nic, &search);
++    if (!search.nic) {
++        search.model = NULL;
++        qemu_foreach_nic(sun4u_find_nic, &search);
++    }
++    if (!search.nic) {
++        return;
++    }
++
++    memset(&header, 0, sizeof(header));
++    Sun_init_header(&header, search.nic->conf->macaddr.a, 0x80);
++    for (i = 0; i < sizeof(header); i++) {
++        (k->write)(idprom->nvram, 0x1fd8 + i, ((uint8_t *)&header)[i]);
++    }
++}
++
+ static uint64_t sun4u_load_kernel(const char *kernel_filename,
+                                   const char *initrd_filename,
+                                   ram_addr_t RAM_size, uint64_t *initrd_size,
+@@ -689,6 +743,23 @@ static void sun4uv_init(MemoryRegion *address_space_mem,
+                            graphic_width, graphic_height, graphic_depth,
+                            (uint8_t *)&macaddr);
+ 
++    /*
++     * OpenBIOS gives the guest the IDPROM's MAC address as the system's,
++     * and the sunhme has no other: NetBSD and Solaris use it for hme0. A
++     * NIC added with -device (as most management tools do) doesn't exist
++     * yet, so without an onboard NIC the IDPROM has a default address that
++     * is the same for every machine. Take the address from the NICs once
++     * they are all there, before the firmware reads it.
++     */
++    if (!onboard_nic) {
++        Sun4uIdprom *idprom = g_new0(Sun4uIdprom, 1);
++
++        idprom->nvram = nvram;
++        idprom->nic_model = mc->default_nic;
++        idprom->machine_done.notify = sun4u_idprom_machine_done;
++        qemu_add_machine_init_done_notifier(&idprom->machine_done);
++    }
++
+     dev = qdev_new(TYPE_FW_CFG_IO);
+     qdev_prop_set_bit(dev, "dma_enabled", false);
+     object_property_add_child(OBJECT(ebus), TYPE_FW_CFG, OBJECT(dev));
diff --git a/debian/patches/wsh/0035-tests-qtest-test-the-IDPROM-MAC-address-on-sun4u.patch b/debian/patches/wsh/0035-tests-qtest-test-the-IDPROM-MAC-address-on-sun4u.patch
new file mode 100644
index 0000000..aa771e2
--- /dev/null
+++ b/debian/patches/wsh/0035-tests-qtest-test-the-IDPROM-MAC-address-on-sun4u.patch
@@ -0,0 +1,169 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the IDPROM MAC address on sun4u
+
+The test reads the IDPROM from the m48t59 NVRAM through the ebus's I/O
+space (bus 1 behind the simba bridge at 00:01.1, with the bridge's I/O
+window opened over the NVRAM as OpenBIOS would) and checks its MAC
+address, format and machine type bytes, host id and checksum: QEMU's
+default without a NIC, the address of a sunhme added with -device, the
+first sunhme when a virtio-net-pci comes before it, the first NIC when
+there is no sunhme, and the onboard -net nic over a -device sunhme.
+
+Without the previous patch the device case fails (the IDPROM has
+52:54:00:12:34:56); with it all five pass.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build         |   3 +-
+ tests/qtest/sun4u-idprom-test.c | 128 ++++++++++++++++++++++++++++++++
+ 2 files changed, 130 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4u-idprom-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 9b6a60b713..1eb55ea351 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -211,7 +211,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+ qtests_sparc64 = \
+   (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-test'] : []) +            \
+   qtests_filter + \
+-  ['prom-env-test', 'boot-serial-test', 'sun4u-cmd646-test']
++  ['prom-env-test', 'boot-serial-test', 'sun4u-cmd646-test',
++   'sun4u-idprom-test']
+ 
+ qtests_npcm7xx = \
+   ['npcm7xx_adc-test',
+diff --git a/tests/qtest/sun4u-idprom-test.c b/tests/qtest/sun4u-idprom-test.c
+new file mode 100644
+index 0000000000..d9902ba0ce
+--- /dev/null
++++ b/tests/qtest/sun4u-idprom-test.c
+@@ -0,0 +1,128 @@
++/*
++ * QTest: the MAC address in the sun4u IDPROM
++ *
++ * OpenBIOS gives the guest the IDPROM's MAC address as the system's, and
++ * NetBSD and Solaris use it for hme0 (the sunhme has no address of its
++ * own in the device tree). It must be the one given to the NIC, also when
++ * the NIC is added with -device rather than as the onboard -nic.
++ *
++ * The IDPROM is the last 32 bytes of the m48t59 NVRAM, at 0x2000 in the
++ * PCI I/O space of the ebus's bus (bus 1, behind the simba bridge at
++ * 00:01.1). Nothing runs on the CPU, so the test opens the bridge's I/O
++ * window over the NVRAM itself, as OpenBIOS would.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "hw/pci/pci_regs.h"
++
++#define PCI_CONFIG      0x1fe01000000ULL    /* PCI configuration space */
++#define PCI_IO          0x1fe02000000ULL    /* PCI I/O space */
++#define DEVFN_SIMBA_A   0x09                /* 00:01.1 */
++#define NVRAM_IO        0x2000              /* m48t59, 8 KB */
++#define IDPROM          (PCI_IO + NVRAM_IO + 0x1fd8)
++#define IDPROM_LEN      16
++
++#define DEFAULT_MAC     "52:54:00:12:34:56"
++
++static void cfg_writeb(QTestState *qts, int bus, int devfn, int reg,
++                       uint8_t val)
++{
++    qtest_writeb(qts, PCI_CONFIG + (bus << 16) + (devfn << 8) + reg, val);
++}
++
++/* Start the machine with `args` and read its IDPROM */
++static void read_idprom(const char *args, uint8_t *idprom)
++{
++    QTestState *qts;
++    int i;
++
++    qts = qtest_initf("-machine sun4u -nodefaults %s", args);
++
++    /* Bus 1 behind 00:01.1, its I/O window over 0x2000-0x3fff */
++    cfg_writeb(qts, 0, DEVFN_SIMBA_A, PCI_SECONDARY_BUS, 1);
++    cfg_writeb(qts, 0, DEVFN_SIMBA_A, PCI_SUBORDINATE_BUS, 1);
++    cfg_writeb(qts, 0, DEVFN_SIMBA_A, PCI_IO_BASE, NVRAM_IO >> 8);
++    cfg_writeb(qts, 0, DEVFN_SIMBA_A, PCI_IO_LIMIT, (NVRAM_IO + 0x1fff) >> 8);
++
++    for (i = 0; i < IDPROM_LEN; i++) {
++        idprom[i] = qtest_readb(qts, IDPROM + i);
++    }
++    qtest_quit(qts);
++}
++
++/* The IDPROM's MAC address is `mac`, and the header around it is valid */
++static void check_idprom(const char *args, const char *mac)
++{
++    uint8_t idprom[IDPROM_LEN], sum = 0;
++    char got[18];
++    int i;
++
++    read_idprom(args, idprom);
++    snprintf(got, sizeof(got), "%02x:%02x:%02x:%02x:%02x:%02x",
++             idprom[2], idprom[3], idprom[4], idprom[5], idprom[6], idprom[7]);
++    g_assert_cmpstr(got, ==, mac);
++
++    g_assert_cmphex(idprom[0], ==, 0x01);               /* format */
++    g_assert_cmphex(idprom[1], ==, 0x80);               /* machine type */
++    g_assert_cmpmem(&idprom[12], 3, &idprom[5], 3);     /* host id serial */
++    for (i = 0; i < IDPROM_LEN - 1; i++) {
++        sum ^= idprom[i];
++    }
++    g_assert_cmphex(idprom[15], ==, sum);
++}
++
++/* No NIC: QEMU's default address, as before */
++static void test_no_nic(void)
++{
++    check_idprom("", DEFAULT_MAC);
++}
++
++/* A sunhme added with -device, as qemu-server and libvirt do */
++static void test_device(void)
++{
++    check_idprom("-device sunhme,mac=bc:24:11:00:00:01,bus=pciB",
++                 "bc:24:11:00:00:01");
++}
++
++/* The first sunhme, though another NIC model comes first */
++static void test_first_sunhme(void)
++{
++    check_idprom("-device virtio-net-pci,mac=bc:24:11:00:00:02,bus=pciB "
++                 "-device sunhme,mac=bc:24:11:00:00:03,bus=pciB "
++                 "-device sunhme,mac=bc:24:11:00:00:04,bus=pciB",
++                 "bc:24:11:00:00:03");
++}
++
++/* No sunhme: the first NIC of any model */
++static void test_other_model(void)
++{
++    check_idprom("-device virtio-net-pci,mac=bc:24:11:00:00:05,bus=pciB "
++                 "-device virtio-net-pci,mac=bc:24:11:00:00:06,bus=pciB",
++                 "bc:24:11:00:00:05");
++}
++
++/* The onboard NIC keeps its place in the IDPROM, as before */
++static void test_onboard(void)
++{
++    check_idprom("-net nic,model=sunhme,macaddr=bc:24:11:00:00:07 "
++                 "-device sunhme,mac=bc:24:11:00:00:08,bus=pciB",
++                 "bc:24:11:00:00:07");
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4u-idprom/no-nic", test_no_nic);
++    qtest_add_func("sun4u-idprom/device", test_device);
++    if (qtest_has_device("virtio-net-pci")) {
++        qtest_add_func("sun4u-idprom/first-sunhme", test_first_sunhme);
++        qtest_add_func("sun4u-idprom/other-model", test_other_model);
++    }
++    qtest_add_func("sun4u-idprom/onboard", test_onboard);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0036-target-sparc-write-softint-under-the-BQL.patch b/debian/patches/wsh/0036-target-sparc-write-softint-under-the-BQL.patch
new file mode 100644
index 0000000..03070b2
--- /dev/null
+++ b/debian/patches/wsh/0036-target-sparc-write-softint-under-the-BQL.patch
@@ -0,0 +1,80 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: write %softint under the BQL
+
+The tick, stick and hstick timers set their bits in softint from the
+main loop, holding the BQL. The guest's %set_softint, %clear_softint
+and %softint writes read, modify and write softint in the vCPU thread
+without it, and took the BQL only afterwards, for cpu_check_irqs(). A
+timer that fired between the read and the write had its bit written
+over, and its interrupt was lost.
+
+illumos arms %tick_cmpr for its next clock tick only after it has
+handled the level 14 interrupt of the last one, and writes
+%set_softint and %clear_softint for every device interrupt. Tribblix
+(illumos) on sun4u lost its clock for good in about one of three long
+runs with heavy interrupt traffic: idle with interrupts enabled, but no
+level 14 interrupt ever again, and everything that sleeps hung. A trace
+caught it: tick_irq() saw softint 0x401, then the guest's clear of bit
+10 left 0x000.
+
+Take the BQL around the read-modify-write in the three helpers, as
+cpu_check_irqs() needs it anyway.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ target/sparc/int64_helper.c | 14 ++++++++++++--
+ 1 file changed, 12 insertions(+), 2 deletions(-)
+
+diff --git a/target/sparc/int64_helper.c b/target/sparc/int64_helper.c
+index 60ab0478fc..ea618296ce 100644
+--- a/target/sparc/int64_helper.c
++++ b/target/sparc/int64_helper.c
+@@ -273,15 +273,19 @@ trap_state *cpu_tsptr(CPUSPARCState* env)
+     return &env->ts[env->tl & MAXTL_MASK];
+ }
+ 
++/*
++ * The tick, stick and hstick timers set their bits in softint from the
++ * main loop, with the BQL held.  The guest's writes to softint must read,
++ * modify and write it under the BQL too: a timer bit set between the read
++ * and the write would be lost, and with it the timer interrupt.
++ */
+ static bool do_modify_softint(CPUSPARCState *env, uint32_t value)
+ {
+     if (env->softint != value) {
+         env->softint = value;
+ #if !defined(CONFIG_USER_ONLY)
+         if (cpu_interrupts_enabled(env)) {
+-            bql_lock();
+             cpu_check_irqs(env);
+-            bql_unlock();
+         }
+ #endif
+         return true;
+@@ -291,6 +295,8 @@ static bool do_modify_softint(CPUSPARCState *env, uint32_t value)
+ 
+ void helper_set_softint(CPUSPARCState *env, uint64_t value)
+ {
++    BQL_LOCK_GUARD();
++
+     if (do_modify_softint(env, env->softint | (uint32_t)value)) {
+         trace_int_helper_set_softint(env->softint);
+     }
+@@ -298,6 +304,8 @@ void helper_set_softint(CPUSPARCState *env, uint64_t value)
+ 
+ void helper_clear_softint(CPUSPARCState *env, uint64_t value)
+ {
++    BQL_LOCK_GUARD();
++
+     if (do_modify_softint(env, env->softint & (uint32_t)~value)) {
+         trace_int_helper_clear_softint(env->softint);
+     }
+@@ -305,6 +313,8 @@ void helper_clear_softint(CPUSPARCState *env, uint64_t value)
+ 
+ void helper_write_softint(CPUSPARCState *env, uint64_t value)
+ {
++    BQL_LOCK_GUARD();
++
+     if (do_modify_softint(env, (uint32_t)value)) {
+         trace_int_helper_write_softint(env->softint);
+     }
diff --git a/debian/patches/wsh/0037-tests-qtest-test-that-a-tick-during-a-softint-write-.patch b/debian/patches/wsh/0037-tests-qtest-test-that-a-tick-during-a-softint-write-.patch
new file mode 100644
index 0000000..3d5f1b8
--- /dev/null
+++ b/debian/patches/wsh/0037-tests-qtest-test-that-a-tick-during-a-softint-write-.patch
@@ -0,0 +1,164 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test that a tick during a %softint write is kept on sun4u
+
+A boot PROM arms %tick_cmpr 10 us ahead and, with interrupts off, sets
+and clears soft interrupt 1 until %softint shows TICK_INT, then clears
+it, counts the tick and arms the next; if 16M rounds go by without one,
+it counts the tick as lost. The test runs it for up to 20000 ticks
+(10 s at most) and expects none lost.
+
+The race can't be made to happen on demand, but the loop is almost all
+%softint writes: without the previous patch a tick was lost within the
+first three in each of 30 runs; with it, 30 runs saw over 20000 ticks
+each and lost none. With the patch a tick can't be lost, so the test
+can't fail spuriously.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build          |   2 +-
+ tests/qtest/sun4u-softint-test.c | 123 +++++++++++++++++++++++++++++++
+ 2 files changed, 124 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4u-softint-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 1eb55ea351..d3a2c22c84 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -212,7 +212,7 @@ qtests_sparc64 = \
+   (config_all_devices.has_key('CONFIG_ISA_TESTDEV') ? ['endianness-test'] : []) +            \
+   qtests_filter + \
+   ['prom-env-test', 'boot-serial-test', 'sun4u-cmd646-test',
+-   'sun4u-idprom-test']
++   'sun4u-idprom-test', 'sun4u-softint-test']
+ 
+ qtests_npcm7xx = \
+   ['npcm7xx_adc-test',
+diff --git a/tests/qtest/sun4u-softint-test.c b/tests/qtest/sun4u-softint-test.c
+new file mode 100644
+index 0000000000..4d45cbaedf
+--- /dev/null
++++ b/tests/qtest/sun4u-softint-test.c
+@@ -0,0 +1,123 @@
++/*
++ * QTest: a tick interrupt that fires during a write to %softint on sun4u
++ *
++ * A boot PROM arms %tick_cmpr 10 us ahead and, with interrupts off, sets
++ * and clears soft interrupt 1 with %set_softint and %clear_softint until
++ * %softint shows the tick's bit (TICK_INT), clears it and counts the
++ * tick; if 16M rounds go by without one, it counts the tick as lost. Then
++ * it arms the next one.
++ *
++ * The tick timer sets TICK_INT from the main loop, holding the BQL; the
++ * writes to %softint read, modify and write it in the vCPU thread. They
++ * didn't take the BQL, so a tick that fired between their read and their
++ * write was overwritten and lost, and a guest that waits for its clock
++ * interrupt before arming the next (illumos) lost its clock for good.
++ * The race can't be made to happen on demand, but the loop is almost all
++ * %softint writes: without the lock a tick was lost within the first
++ * three in each of 30 runs. With it, no tick can be lost.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the ticks the PROM saw and lost */
++#define RAM_SEEN        0x800ULL
++#define RAM_LOST        0x808ULL
++#define PROM_WORDS      0x100
++#define RESET           (0x20 / 4)      /* power-on reset: prom + 0x20 */
++
++#define TICKS           20000           /* enough ticks */
++#define MIN_TICKS       1000            /* the least for a pass */
++#define SECONDS         10
++
++/*
++ * Runs from power-on reset: RED state, MMU off, PSTATE.IE clear, so the
++ * tick's level 14 interrupt is never taken and its bit stays in %softint.
++ */
++static const uint32_t code[] = {
++    0xa0102000,     /*        mov   0, %l0          ticks seen */
++    0xa2102000,     /*        mov   0, %l1          ticks lost */
++    0x27004000,     /*        sethi %hi(0x1000000), %l3 */
++    0x83410000,     /* again: rd    %tick, %g1 */
++    0x820063e8,     /*        add   %g1, 1000, %g1  10 us on */
++    0x83287001,     /*        sllx  %g1, 1, %g1 */
++    0x83307001,     /*        srlx  %g1, 1, %g1     INT_DIS off */
++    0xaf806000,     /*        wr    %g1, 0, %tick_cmpr */
++    0xa4100013,     /*        mov   %l3, %l2 */
++    0xa9802002,     /* spin:  wr    %g0, 2, %set_softint */
++    0xab802002,     /*        wr    %g0, 2, %clear_softint */
++    0x85458000,     /*        rd    %softint, %g2 */
++    0x8088a001,     /*        andcc %g2, 1, %g0     TICK_INT */
++    0x12800009,     /*        bne   got */
++    0x01000000,     /*         nop */
++    0xa4a4a001,     /*        subcc %l2, 1, %l2 */
++    0x12bffff9,     /*        bne   spin */
++    0x01000000,     /*         nop */
++    0xa2046001,     /*        inc   %l1             lost */
++    0xe2702808,     /*        stx   %l1, [%g0 + 0x808] */
++    0x10bfffef,     /*        ba    again */
++    0x01000000,     /*         nop */
++    0xab802001,     /* got:   wr    %g0, 1, %clear_softint */
++    0xa0042001,     /*        inc   %l0 */
++    0xe0702800,     /*        stx   %l0, [%g0 + 0x800] */
++    0x10bfffea,     /*        ba    again */
++    0x01000000,     /*         nop */
++};
++
++static char *write_prom(void)
++{
++    uint32_t be[PROM_WORDS];
++    char *path = NULL;
++    int fd, i;
++
++    /* Anything else: b . */
++    for (i = 0; i < PROM_WORDS; i++) {
++        be[i] = cpu_to_be32(0x10800000);
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[RESET + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4u-softint-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++static void test_tick(void)
++{
++    g_autofree char *prom = write_prom();
++    gint64 end = g_get_monotonic_time() + SECONDS * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine sun4u -accel tcg -nodefaults "
++                                  "-bios %s", prom);
++    uint64_t seen = 0, lost = 0;
++
++    while (g_get_monotonic_time() < end) {
++        g_usleep(10000);
++        seen = qtest_readq(qts, RAM_SEEN);
++        lost = qtest_readq(qts, RAM_LOST);
++        if (lost || seen >= TICKS) {
++            break;
++        }
++    }
++    qtest_quit(qts);
++    unlink(prom);
++
++    g_test_message("ticks seen %" PRIu64 ", lost %" PRIu64, seen, lost);
++    g_assert_cmpuint(lost, ==, 0);
++    g_assert_cmpuint(seen, >=, MIN_TICKS);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        qtest_add_func("sun4u-softint/tick", test_tick);
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0038-esp-don-t-count-the-message-out-bytes-as-part-of-the.patch b/debian/patches/wsh/0038-esp-don-t-count-the-message-out-bytes-as-part-of-the.patch
new file mode 100644
index 0000000..b7388d2
--- /dev/null
+++ b/debian/patches/wsh/0038-esp-don-t-count-the-message-out-bytes-as-part-of-the.patch
@@ -0,0 +1,37 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] esp: don't count the message out bytes as part of the CDB
+
+esp_cdb_ready() compared the whole cmdfifo with the CDB's length, but
+the cmdfifo starts with the IDENTIFY byte and any further message out
+bytes, cmdfifo_cdb_offset of them. A driver that selects with ATN and
+Stop, sends a message and then the CDB one byte at a time with a
+Transfer Information command each had its command dispatched too
+early: after IDENTIFY and a 5-byte SDTR message, the first CDB byte
+alone made a "complete" 6-byte CDB.
+
+That is what Linux 2.6.18's esp driver does on sun4m when it
+negotiates synchronous transfers: the target got a one-byte command,
+answered CHECK CONDITION with ILLEGAL REQUEST, and Linux reset the bus
+and took the disk and CD-ROM offline.
+
+Count only the bytes after cmdfifo_cdb_offset.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ hw/scsi/esp.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/hw/scsi/esp.c b/hw/scsi/esp.c
+index 9e8d0d6cfa..b7c27e82c5 100644
+--- a/hw/scsi/esp.c
++++ b/hw/scsi/esp.c
+@@ -470,7 +470,8 @@ static bool esp_cdb_ready(ESPState *s)
+ 
+     cdblen = scsi_cdb_length((uint8_t *)&pbuf[s->cmdfifo_cdb_offset]);
+ 
+-    return cdblen < 0 ? false : (len >= cdblen);
++    /* The IDENTIFY and other message bytes before the CDB don't count */
++    return cdblen < 0 ? false : (len - s->cmdfifo_cdb_offset >= cdblen);
+ }
+ 
+ static void esp_dma_ti_check(ESPState *s)
diff --git a/debian/patches/wsh/0039-tests-qtest-test-a-CDB-sent-byte-by-byte-after-a-mes.patch b/debian/patches/wsh/0039-tests-qtest-test-a-CDB-sent-byte-by-byte-after-a-mes.patch
new file mode 100644
index 0000000..cb98dd6
--- /dev/null
+++ b/debian/patches/wsh/0039-tests-qtest-test-a-CDB-sent-byte-by-byte-after-a-mes.patch
@@ -0,0 +1,192 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test a CDB sent byte by byte after a message out on sun4m
+
+Drive the SPARCstation 5's ESP without DMA as Linux 2.6's esp driver
+does when it negotiates synchronous transfers: Select with ATN and
+Stop with IDENTIFY, an extended SDTR message with Transfer Information,
+then TEST UNIT READY one byte per Transfer Information. The target must
+stay in the command phase until the sixth byte, and the command must
+reach it whole: twice, the first answered with the reset's unit
+attention, the second with GOOD.
+
+Without the previous patch the first CDB byte already ends the command
+phase.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build      |   3 +-
+ tests/qtest/sun4m-esp-test.c | 151 +++++++++++++++++++++++++++++++++++
+ 2 files changed, 153 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-esp-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index d3a2c22c84..8759f3fd77 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -205,7 +205,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-pil-delay-slot-test',
+                 'sun4m-solaris-smp-idle-test',
+                 'sun4m-fsr-rd-test',
+-                'sun4m-cs4231-test'] + \
++                'sun4m-cs4231-test',
++                'sun4m-esp-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-esp-test.c b/tests/qtest/sun4m-esp-test.c
+new file mode 100644
+index 0000000000..c8e9a15a63
+--- /dev/null
++++ b/tests/qtest/sun4m-esp-test.c
+@@ -0,0 +1,151 @@
++/*
++ * QTest: a CDB sent byte by byte after a message out phase on sun4m's ESP
++ *
++ * Linux 2.6's esp driver negotiates synchronous transfers: it selects
++ * the target with Select with ATN and Stop (IDENTIFY only), sends an
++ * extended SDTR message in the message out phase, and then puts the
++ * CDB on the bus one byte at a time, a Transfer Information command
++ * for each byte. The command must reach the target only when the whole
++ * CDB is in, however many message bytes came before it.
++ *
++ * The ESP counted the IDENTIFY and message bytes as part of the CDB, so
++ * here the first CDB byte alone made a "complete" 6-byte command: the
++ * target got one byte, answered CHECK CONDITION (ILLEGAL REQUEST), and
++ * Linux reset the bus and took the disk and CD-ROM offline.
++ *
++ * Nothing runs on the CPU: the test drives the ESP's registers itself,
++ * without DMA, as the guest's driver does.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++/* SPARCstation 5: the ESP's registers are 4 bytes apart */
++#define ESP_BASE        0x78800000ULL
++#define ESP_REG(r)      (ESP_BASE + (r) * 4)
++
++#define ESP_FIFO        0x2
++#define ESP_CMD         0x3
++#define ESP_RSTAT       0x4
++#define ESP_WBUSID      0x4
++#define ESP_RINTR       0x5
++#define ESP_RFLAGS      0x7
++
++#define CMD_TI          0x10
++#define CMD_ICCS        0x11
++#define CMD_MSGACC      0x12
++#define CMD_SELATNS     0x43
++
++#define STAT_PHASE      0x07
++#define STAT_CD         0x02
++#define STAT_ST         0x03
++#define STAT_MO         0x06
++#define STAT_GE         0x40
++
++#define INTR_FC         0x08
++#define INTR_BS         0x10
++#define INTR_DC         0x20
++
++static uint8_t esp_readb(QTestState *qts, int reg)
++{
++    return qtest_readb(qts, ESP_REG(reg));
++}
++
++static void esp_writeb(QTestState *qts, int reg, uint8_t val)
++{
++    qtest_writeb(qts, ESP_REG(reg), val);
++}
++
++/* The bus phase after a command, with no gross error */
++static uint8_t esp_phase(QTestState *qts)
++{
++    uint8_t stat = esp_readb(qts, ESP_RSTAT);
++
++    g_assert_cmphex(stat & STAT_GE, ==, 0);
++    return stat & STAT_PHASE;
++}
++
++/*
++ * Select target 0 with ATN and Stop, send an SDTR message, then TEST UNIT
++ * READY one byte at a time; return the status byte
++ */
++static uint8_t tur_after_sdtr(QTestState *qts)
++{
++    /* SDTR: 100 ns, offset 15 */
++    static const uint8_t sdtr[] = { 0x01, 0x03, 0x01, 0x19, 0x0f };
++    static const uint8_t cdb[6] = { 0x00 };     /* TEST UNIT READY */
++    uint8_t intr, status;
++    int i;
++
++    /* IDENTIFY (disconnects allowed, LUN 0), and stop in message out */
++    esp_writeb(qts, ESP_FIFO, 0xc0);
++    esp_writeb(qts, ESP_WBUSID, 0);
++    esp_writeb(qts, ESP_CMD, CMD_SELATNS);
++    g_assert_cmphex(esp_phase(qts), ==, STAT_MO);
++    intr = esp_readb(qts, ESP_RINTR);
++    g_assert_cmphex(intr & (INTR_BS | INTR_FC), ==, INTR_BS | INTR_FC);
++
++    /* The SDTR message: the target goes on to the command phase */
++    for (i = 0; i < ARRAY_SIZE(sdtr); i++) {
++        esp_writeb(qts, ESP_FIFO, sdtr[i]);
++    }
++    esp_writeb(qts, ESP_CMD, CMD_TI);
++    g_assert_cmphex(esp_phase(qts), ==, STAT_CD);
++    intr = esp_readb(qts, ESP_RINTR);
++    g_assert_cmphex(intr & INTR_BS, ==, INTR_BS);
++
++    /* The CDB, one byte per Transfer Information */
++    for (i = 0; i < ARRAY_SIZE(cdb); i++) {
++        esp_writeb(qts, ESP_FIFO, cdb[i]);
++        esp_writeb(qts, ESP_CMD, CMD_TI);
++        if (i < ARRAY_SIZE(cdb) - 1) {
++            /* Not the whole CDB yet: the target waits for more */
++            g_assert_cmphex(esp_phase(qts), ==, STAT_CD);
++        }
++        esp_readb(qts, ESP_RINTR);
++    }
++
++    /* The whole CDB: the target ran it and has its status */
++    g_assert_cmphex(esp_phase(qts), ==, STAT_ST);
++    esp_writeb(qts, ESP_CMD, CMD_ICCS);
++    intr = esp_readb(qts, ESP_RINTR);
++    g_assert_cmphex(intr & INTR_FC, ==, INTR_FC);
++    g_assert_cmpuint(esp_readb(qts, ESP_RFLAGS) & 0x1f, ==, 2);
++    status = esp_readb(qts, ESP_FIFO);
++    g_assert_cmphex(esp_readb(qts, ESP_FIFO), ==, 0x00);   /* COMMAND COMPLETE */
++
++    /* Accept the message: the target goes to bus free */
++    esp_writeb(qts, ESP_CMD, CMD_MSGACC);
++    intr = esp_readb(qts, ESP_RINTR);
++    g_assert_cmphex(intr & INTR_DC, ==, INTR_DC);
++
++    return status;
++}
++
++static void test_cdb_after_sdtr(void)
++{
++    QTestState *qts = qtest_init("-machine SS-5 -nodefaults "
++                                 "-drive if=scsi,index=0,format=raw,"
++                                 "file=null-co://");
++
++    /*
++     * The first command after the reset gets CHECK CONDITION with the
++     * unit attention; the second one GOOD. A CDB cut short would get
++     * CHECK CONDITION (ILLEGAL REQUEST) every time.
++     */
++    g_assert_cmphex(tur_after_sdtr(qts), ==, 0x02);
++    g_assert_cmphex(tur_after_sdtr(qts), ==, 0x00);
++
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4m-esp/cdb-after-sdtr", test_cdb_after_sdtr);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0040-esp-let-the-interrupt-come-late-as-from-a-real-targe.patch b/debian/patches/wsh/0040-esp-let-the-interrupt-come-late-as-from-a-real-targe.patch
new file mode 100644
index 0000000..c85c33c
--- /dev/null
+++ b/debian/patches/wsh/0040-esp-let-the-interrupt-come-late-as-from-a-real-targe.patch
@@ -0,0 +1,251 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] esp: let the interrupt come late, as from a real target
+
+The ESP runs a command to its end in the register write that starts it
+and raised its interrupt in the same instruction; a real target takes
+milliseconds to seek and answer. NeXTSTEP 3.3 and OPENSTEP 4.2 on
+sun4m rely on that: their SCSI driver starts a command while holding a
+lock that the completion routine takes too. With the interrupt at once
+the completion ran at PIL 4 while the lock was still held, and spun on
+it forever. Both hung on every install attempt, on SS-5 and SS-20.
+
+Add sysbus-esp's irq-latency-us, 0 (off) by default. With it set, the
+interrupt, STAT_INT in the status register and the line (one signal on
+the chip), comes from a timer that long after the event. The interrupt
+register and the bus phase are set at once, so a driver that polls the
+interrupt register, as OpenBIOS does, sees no change; reading it before
+the timer fires takes the interrupt, and the chip's reset command and a
+device reset cancel it. A pending interrupt is migrated in a subsection
+and comes a whole latency after loading.
+
+-global sysbus-esp.irq-latency-us=500 lets both systems install. It
+stays off by default because every ESP interrupt then comes 0.5 ms
+later, about 2 ms per disk command: Solaris 2.6 reads its raw disk at
+20 MB/s instead of 70. Delaying only the line, with STAT_INT set at
+once, wasn't enough: a NeXTSTEP package install still hung once at
+500 us, as a driver that checks STAT_INT right after starting a command
+sees it end at once.
+---
+ hw/scsi/esp.c         | 95 +++++++++++++++++++++++++++++++++++++++++--
+ hw/scsi/trace-events  |  1 +
+ include/hw/scsi/esp.h |  5 +++
+ 3 files changed, 97 insertions(+), 4 deletions(-)
+
+diff --git a/hw/scsi/esp.c b/hw/scsi/esp.c
+index b7c27e82c5..1605a653fe 100644
+--- a/hw/scsi/esp.c
++++ b/hw/scsi/esp.c
+@@ -32,6 +32,8 @@
+ #include "trace.h"
+ #include "qemu/log.h"
+ #include "qemu/module.h"
++#include "qemu/timer.h"
++#include "hw/core/qdev-properties.h"
+ 
+ /*
+  * On Sparc32, this is the ESP (NCR53C90) part of chip STP2000 (Master I/O),
+@@ -43,17 +45,56 @@
+  * On Macintosh Quadra it is a NCR53C96.
+  */
+ 
++static void esp_assert_irq(ESPState *s)
++{
++    s->rregs[ESP_RSTAT] |= STAT_INT;
++    qemu_irq_raise(s->irq);
++    trace_esp_raise_irq();
++}
++
++/*
++ * A command runs to its end in the register write that starts it. With
++ * irq_latency_ns the interrupt (STAT_INT and the line, one signal on the
++ * chip) comes that much later, as from a real target, which takes
++ * milliseconds to seek and answer: a guest driver may rely on not seeing the
++ * end of a command while the thread that started it still holds its locks.
++ * The interrupt register and the bus phase are set at once, so a driver
++ * that polls the interrupt register sees no change. Off (0) by default:
++ * NeXTSTEP 3.3 and OPENSTEP 4.2 on sun4m need 500 us, and every interrupt
++ * coming later slows the disk for everything else.
++ */
+ static void esp_raise_irq(ESPState *s)
+ {
+-    if (!(s->rregs[ESP_RSTAT] & STAT_INT)) {
+-        s->rregs[ESP_RSTAT] |= STAT_INT;
+-        qemu_irq_raise(s->irq);
+-        trace_esp_raise_irq();
++    if (s->rregs[ESP_RSTAT] & STAT_INT || s->irq_pending) {
++        return;
++    }
++    if (s->irq_latency_ns) {
++        s->irq_pending = true;
++        trace_esp_raise_irq_delayed(s->irq_latency_ns);
++        timer_mod(s->irq_timer,
++                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + s->irq_latency_ns);
++        return;
++    }
++    esp_assert_irq(s);
++}
++
++static void esp_irq_timer_cb(void *opaque)
++{
++    ESPState *s = opaque;
++
++    if (s->irq_pending) {
++        s->irq_pending = false;
++        esp_assert_irq(s);
+     }
+ }
+ 
+ static void esp_lower_irq(ESPState *s)
+ {
++    /* Reading the interrupt register before the latency is up takes it */
++    if (s->irq_pending) {
++        s->irq_pending = false;
++        timer_del(s->irq_timer);
++    }
+     if (s->rregs[ESP_RSTAT] & STAT_INT) {
+         s->rregs[ESP_RSTAT] &= ~STAT_INT;
+         qemu_irq_lower(s->irq);
+@@ -1099,6 +1140,8 @@ static void handle_ti(ESPState *s)
+ 
+ void esp_hard_reset(ESPState *s)
+ {
++    s->irq_pending = false;
++    timer_del(s->irq_timer);
+     memset(s->rregs, 0, ESP_REGS);
+     memset(s->wregs, 0, ESP_REGS);
+     s->tchi_written = 0;
+@@ -1432,6 +1475,37 @@ static int esp_post_load(void *opaque, int version_id)
+     return 0;
+ }
+ 
++static bool esp_irq_pending_needed(void *opaque)
++{
++    ESPState *s = ESP(opaque);
++
++    return s->irq_pending;
++}
++
++static int esp_irq_pending_post_load(void *opaque, int version_id)
++{
++    ESPState *s = ESP(opaque);
++
