+ target/sparc/helper.h       |  2 +-
+ target/sparc/sparc64_idle.c | 31 +++++++++++++-------
+ target/sparc/translate.c    | 58 ++++++++++++++++++++++++++++++++++---
+ 4 files changed, 78 insertions(+), 16 deletions(-)
+
