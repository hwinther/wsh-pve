diff --git a/debian/patches/wsh/0172-tests-qtest-test-the-SS-600MP-s-ESC-DMA-registers.patch b/debian/patches/wsh/0172-tests-qtest-test-the-SS-600MP-s-ESC-DMA-registers.patch
new file mode 100644
index 0000000..72542af
--- /dev/null
+++ b/debian/patches/wsh/0172-tests-qtest-test-the-SS-600MP-s-ESC-DMA-registers.patch
@@ -0,0 +1,150 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the SS-600MP's ESC DMA registers
+
+sun4m-ss600mp-test cases for the patch before:
+
+- dma-csr: the control register reads ID 4, keeps 0x00042b90 of a
+  walking one and of all ones, and the bits SunOS's esp attach writes.
+- dma-count: the address keeps all 32 bits and sets no address-loaded
+  bit, the byte count keeps 24; on the SS-10 the DMA2 still reads ID
+  0xa, keeps 0x01fffff8 of all ones and 32 bits of the count, and an
+  address write sets the address-loaded bit.
+- dma-size-error: a byte, halfword and doubleword load and a byte and
+  halfword store each set the slave size error bit, a read of the
+  control register clears it, the store goes nowhere and a word write
+  of the control register keeps the bit.
+
+8 cases in all; the three new ones fail without the patch before.
+---
+ tests/qtest/sun4m-ss600mp-test.c | 97 ++++++++++++++++++++++++++++++++
+ 1 file changed, 97 insertions(+)
+
+diff --git a/tests/qtest/sun4m-ss600mp-test.c b/tests/qtest/sun4m-ss600mp-test.c
+index 51cc072..1430290 100644
+--- a/tests/qtest/sun4m-ss600mp-test.c
++++ b/tests/qtest/sun4m-ss600mp-test.c
+@@ -19,6 +19,13 @@
+  * the Am7990, whose boot PROM writes a walking one to it; the SS-10 keeps
+  * the PCnet core's bits 6-0.
+  *
++ * The 600MP's on-board SCSI DMA is the ESC gate array: device ID 4 in
++ * bits 31-28 of its control register, a write keeps bits 0x00042b90, the
++ * byte count register keeps 24 bits, an address write sets no
++ * address-loaded bit, and an access other than a word fails and sets the
++ * slave size error bit, which a read of the control register clears.
++ * The SS-10's DMA2 reads ID 0xa and keeps more bits.
++ *
+  * SPDX-License-Identifier: GPL-2.0-or-later
+  */
+ 
+@@ -32,6 +39,16 @@
+ #define LE_RDP          0xef0060000ULL
+ #define LE_RAP          0xef0060002ULL
+ #define SS10_LE_RAP     0xef0c00002ULL
++#define DMA_CSR         0xef0081000ULL
++#define DMA_ADDR        0xef0081004ULL
++#define DMA_COUNT       0xef0081008ULL
++#define SS10_DMA_CSR    0xef0400000ULL
++#define SS10_DMA_ADDR   0xef0400004ULL
++#define SS10_DMA_COUNT  0xef0400008ULL
++#define ESC_ID          0x40000000
++#define ESC_CSR_MASK    0x00042b90
++#define DMA_SLAVE_ERR   0x00000040
++#define DMA_A_LOADED    0x04000000
+ /* the system interrupt pending register of the slavio interrupt controller */
+ #define INTCTL_PENDING  0xff1410000ULL
+ #define IRQ_LE          (1u << 16)
+@@ -195,6 +212,83 @@ static void test_lance_rap(void)
+     qtest_quit(qts);
+ }
+ 
++static void test_dma_csr(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++    uint32_t bit;
++
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID);
++    /* as the PROM does it: a walking one, then all ones */
++    for (bit = 1; bit; bit <<= 1) {
++        qtest_writel(qts, DMA_CSR, bit);
++        g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==,
++                        ESC_ID | (bit & ESC_CSR_MASK));
++    }
++    qtest_writel(qts, DMA_CSR, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID | ESC_CSR_MASK);
++    /* SunOS's esp attach clears the reset and write bits */
++    qtest_writel(qts, DMA_CSR, ESC_CSR_MASK & ~0x180);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==,
++                    ESC_ID | (ESC_CSR_MASK & ~0x180));
++    qtest_writel(qts, DMA_CSR, 0);
++    qtest_quit(qts);
++}
++
++static void test_dma_count(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++
++    /* the address keeps all 32 bits and sets no address-loaded bit */
++    qtest_writel(qts, DMA_ADDR, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, DMA_ADDR), ==, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID);
++    /* the byte count keeps 24 */
++    qtest_writel(qts, DMA_COUNT, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, DMA_COUNT), ==, 0x00ffffff);
++    qtest_writel(qts, DMA_COUNT, 0x01000000);
++    g_assert_cmphex(qtest_readl(qts, DMA_COUNT), ==, 0);
++    qtest_quit(qts);
++
++    /* the SS-10's DMA2: all 32 bits, and the address-loaded bit */
++    qts = qtest_init("-machine SS-10 -m 64");
++    g_assert_cmphex(qtest_readl(qts, SS10_DMA_CSR), ==, 0xa0000000);
++    qtest_writel(qts, SS10_DMA_CSR, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, SS10_DMA_CSR), ==, 0xa1fffff8);
++    qtest_writel(qts, SS10_DMA_COUNT, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, SS10_DMA_COUNT), ==, 0xffffffff);
++    qtest_writel(qts, SS10_DMA_ADDR, 0x1000);
++    g_assert_cmphex(qtest_readl(qts, SS10_DMA_CSR) & DMA_A_LOADED, ==,
++                    DMA_A_LOADED);
++    qtest_quit(qts);
++}
++
++static void test_dma_size_error(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++
++    /* a byte, a halfword, a doubleword: each sets the bit, a read clears */
++    qtest_readb(qts, DMA_COUNT);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID | DMA_SLAVE_ERR);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID);
++    qtest_readw(qts, DMA_ADDR);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID | DMA_SLAVE_ERR);
++    qtest_readq(qts, DMA_CSR);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID | DMA_SLAVE_ERR);
++    /* stores too, and the store goes nowhere */
++    qtest_writel(qts, DMA_COUNT, 0x1234);
++    qtest_writeb(qts, DMA_COUNT, 0xff);
++    g_assert_cmphex(qtest_readl(qts, DMA_COUNT), ==, 0x1234);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID | DMA_SLAVE_ERR);
++    /* a write of the control register keeps it; reads of others too */
++    qtest_writew(qts, DMA_CSR, 0);
++    qtest_writel(qts, DMA_CSR, 0x10);
++    qtest_readl(qts, DMA_ADDR);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==,
++                    ESC_ID | DMA_SLAVE_ERR | 0x10);
++    g_assert_cmphex(qtest_readl(qts, DMA_CSR), ==, ESC_ID | 0x10);
++    qtest_quit(qts);
++}
++
+ static void test_ss10_unchanged(void)
+ {
+     QTestState *qts = qtest_init("-machine SS-10 -m 64");
+@@ -215,6 +309,9 @@ int main(int argc, char **argv)
+     qtest_add_func("sun4m-ss600mp/lebuffer-memory", test_lebuffer_memory);
+     qtest_add_func("sun4m-ss600mp/lance-in-lebuffer", test_lance_in_lebuffer);
+     qtest_add_func("sun4m-ss600mp/lance-rap", test_lance_rap);
++    qtest_add_func("sun4m-ss600mp/dma-csr", test_dma_csr);
++    qtest_add_func("sun4m-ss600mp/dma-count", test_dma_count);
++    qtest_add_func("sun4m-ss600mp/dma-size-error", test_dma_size_error);
