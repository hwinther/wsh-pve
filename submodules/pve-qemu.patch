++}
diff --git a/debian/patches/wsh/0026-target-sparc-let-sparc32-ld-and-st-fsr-ignore-rd.patch b/debian/patches/wsh/0026-target-sparc-let-sparc32-ld-and-st-fsr-ignore-rd.patch
new file mode 100644
index 0000000..bc46d35
--- /dev/null
+++ b/debian/patches/wsh/0026-target-sparc-let-sparc32-ld-and-st-fsr-ignore-rd.patch
@@ -0,0 +1,102 @@
+From: Antoni Sawicki <as@tenoware.com>
+Subject: [PATCH] target/sparc: let sparc32 ld and st %fsr ignore rd
+
+Real V7 and V8 chips ignore the rd field of LDFSR and STFSR. Since the
+move to decodetree (upstream 3d3c06737b, QEMU 8.2) QEMU took them only
+with rd 0 and raised an illegal instruction for any other rd.
+
+Old static SunOS 4 binaries have rd 4 there: the _sigtramp of an old
+libc saves the FSR with c92ba0e0 (st %fsr, [%sp + 0xe0]) and loads it
+back with c90ba0e0. These programs died with SIGILL at the first signal
+after they had used the FPU. One is islandLIC, the 1992 FLEXlm daemon
+of Island Productivity Series 3.0: it died about a minute after it
+started.
+
+sparc32 now takes any rd, as QEMU did before 8.2. sparc64 does not
+change: rd 0 is LDFSR and STFSR, rd 1 LDXFSR and STXFSR, rd 3 LDXEFSR,
+and the rest are still illegal.
+
+Tested on SunOS 4.1.4 (SS-5): a program with both words gets SIGILL on
+the old build and runs on the new one, islandLIC stays up, and the
+sparc and sparc64 qtests pass.
+
+Origin: https://github.com/tenox7/lemu/commit/0cdd14c1487c30b14a983db634658fd7a29789b2
+---
+ target/sparc/insns.decode | 14 +++++++++-----
+ target/sparc/translate.c  | 23 +++++++++++++++++++++--
+ 2 files changed, 30 insertions(+), 7 deletions(-)
+
+diff --git a/target/sparc/insns.decode b/target/sparc/insns.decode
+index 242ec42016..bb781c3891 100644
+--- a/target/sparc/insns.decode
++++ b/target/sparc/insns.decode
+@@ -662,15 +662,19 @@ STX         11 ..... 011110 ..... . .............          @r_r_r_asi # STXA
+ STX         11 ..... 011110 ..... . .............          @r_r_i_asi # STXA
+ 
+ LDF         11 ..... 100000 ..... . .............          @r_r_ri_na
+-LDFSR       11 00000 100001 ..... . .............          @n_r_ri
+-LDXFSR      11 00001 100001 ..... . .............          @n_r_ri
+-LDXEFSR     11 00011 100001 ..... . .............          @n_r_ri
++{
++  LDXFSR    11 00001 100001 ..... . .............          @n_r_ri
++  LDXEFSR   11 00011 100001 ..... . .............          @n_r_ri
++  LDFSR     11 ..... 100001 ..... . .............          @r_r_ri    # v7,v8: any rd
++}
+ LDQF        11 ..... 100010 ..... . .............          @q_r_ri_na
+ LDDF        11 ..... 100011 ..... . .............          @d_r_ri_na
+ 
+ STF         11 ..... 100100 ..... . .............          @r_r_ri_na
+-STFSR       11 00000 100101 ..... . .............          @n_r_ri
+-STXFSR      11 00001 100101 ..... . .............          @n_r_ri
++{
++  STXFSR    11 00001 100101 ..... . .............          @n_r_ri
++  STFSR     11 ..... 100101 ..... . .............          @r_r_ri    # v7,v8: any rd
++}
+ {
+   STQF      11 ..... 100110 ..... . .............          @q_r_ri_na # v9
+   STDFQ     11 ..... 100110 ..... . .............          @r_r_ri    # v7,v8
+diff --git a/target/sparc/translate.c b/target/sparc/translate.c
+index 913c012917..65bc139929 100644
+--- a/target/sparc/translate.c
++++ b/target/sparc/translate.c
+@@ -4659,11 +4659,26 @@ static bool trans_STDFQ(DisasContext *dc, arg_STDFQ *a)
+ #endif
+ }
+ 
++/*
++ * V9 has LDFSR and STFSR only with rd 0 (rd 1 is LDXFSR and STXFSR, rd 3
++ * LDXEFSR). V7 and V8 chips ignore rd, and old SunOS binaries have rd 4
++ * there: the _sigtramp of an old static libc saves the FSR with c92ba0e0.
++ * So sparc32 takes any rd.
++ */
++static bool fsr_rd_ok(DisasContext *dc, int rd)
++{
++    return !avail_64(dc) || rd == 0;
++}
++
+ static bool trans_LDFSR(DisasContext *dc, arg_r_r_ri *a)
+ {
+-    TCGv addr = gen_ldst_addr(dc, a->rs1, a->imm, a->rs2_or_imm);
++    TCGv addr;
+     TCGv_i32 tmp;
+ 
++    if (!fsr_rd_ok(dc, a->rd)) {
++        return false;
++    }
++    addr = gen_ldst_addr(dc, a->rs1, a->imm, a->rs2_or_imm);
+     if (addr == NULL) {
+         return false;
+     }
+@@ -4739,7 +4754,11 @@ static bool do_stfsr(DisasContext *dc, arg_r_r_ri *a, MemOp mop)
+     return advance_pc(dc);
+ }
+ 
+-TRANS(STFSR, ALL, do_stfsr, a, MO_BEUL)
++static bool trans_STFSR(DisasContext *dc, arg_r_r_ri *a)
++{
++    return fsr_rd_ok(dc, a->rd) && do_stfsr(dc, a, MO_BEUL);
++}
++
+ TRANS(STXFSR, 64, do_stfsr, a, MO_BEUQ)
+ 
+ static bool do_fc(DisasContext *dc, int rd, int32_t c)
diff --git a/debian/patches/wsh/0027-tests-qtest-test-ld-and-st-fsr-with-any-rd-on-sun4m.patch b/debian/patches/wsh/0027-tests-qtest-test-ld-and-st-fsr-with-any-rd-on-sun4m.patch
new file mode 100644
index 0000000..58048e2
--- /dev/null
+++ b/debian/patches/wsh/0027-tests-qtest-test-ld-and-st-fsr-with-any-rd-on-sun4m.patch
@@ -0,0 +1,170 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test ld and st %fsr with any rd on sun4m
+
+A tiny boot PROM enables the FPU, loads a value into the FSR with
+ld [%sp + 0xe0], %fsr, clears the word and stores the FSR back with
+st %fsr, [%sp + 0xe0], both with the same rd: 0, 4 (c90ba0e0 and
+c92ba0e0, the words of an old SunOS libc's _sigtramp) and 31. It must
+get to the end without a trap, and RD, TEM, fcc, aexc and cexc must
+read back.
+
+Without the previous patch the rd 4 case fails with trap type 2
+(illegal instruction); rd 0 passes with and without it.
+
+Forwarded: https://github.com/tenox7/lemu/pull/1
+---
+ tests/qtest/meson.build         |   3 +-
+ tests/qtest/sun4m-fsr-rd-test.c | 130 ++++++++++++++++++++++++++++++++
+ 2 files changed, 132 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-fsr-rd-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 9bd606b70d..0ebc864fa5 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -203,7 +203,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-escc-test', 'sun4m-apc-test',
+                 'sun4m-solaris-idle-test', 'sun4m-mmu-nofault-test',
+                 'sun4m-pil-delay-slot-test',
+-                'sun4m-solaris-smp-idle-test'] + \
++                'sun4m-solaris-smp-idle-test',
++                'sun4m-fsr-rd-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-fsr-rd-test.c b/tests/qtest/sun4m-fsr-rd-test.c
+new file mode 100644
+index 0000000000..b7d9973f7c
+--- /dev/null
++++ b/tests/qtest/sun4m-fsr-rd-test.c
+@@ -0,0 +1,130 @@
++/*
++ * QTest: ld and st %fsr with any rd on sun4m
++ *
++ * V7 and V8 chips ignore the rd field of LDFSR and STFSR. Old static
++ * SunOS 4 binaries have rd 4 there: the _sigtramp of an old libc saves
++ * the FSR with c92ba0e0 (st %fsr, [%sp + 0xe0]) and loads it back with
++ * c90ba0e0 (ld [%sp + 0xe0], %fsr). QEMU 8.2 to 11.1 took these words
++ * only with rd 0 and raised an illegal instruction trap for any other rd.
++ *
++ * A boot PROM enables the FPU, stores a value at [%sp + 0xe0], loads it
++ * into the FSR, clears the word and stores the FSR back there, with the
++ * same rd in both words. It must get to the end without a trap, and the
++ * fields that LDFSR sets must read back.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++/* RAM: the trap marker, the end marker and the FSR word at %sp + 0xe0 */
++#define RAM_TRAP        0x1020ULL
++#define RAM_DONE        0x1024ULL
++#define RAM_FSR         0x20e0ULL
++#define PROM_WORDS      0x200
++#define CODE            0x100           /* word index of the code */
++
++/* The FSR fields LDFSR sets: RD, TEM, fcc, aexc and cexc */
++#define FSR_LD_MASK     0xcf800fffu
++
++typedef struct FsrCase {
++    const char *name;
++    unsigned rd;
++    uint32_t fsr;
++} FsrCase;
++
++static const FsrCase cases[] = {
++    { "rd0", 0, 0x80000460 },   /* RD +inf, fcc 1, aexc dz nx */
++    { "rd4", 4, 0x48000ca0 },   /* RD zero, NVM, fcc 3, aexc uf nx */
++    { "rd31", 31, 0xc0800815 }, /* RD -inf, NXM, fcc 2, cexc nv uf nx */
++};
++
++/*
++ * The PROM: a trap table whose entries store their trap type at RAM_TRAP
++ * and stop, and at 0x400 the test. It runs from reset: MMU off, so
++ * instructions come from the PROM and data from RAM.
++ */
++static char *write_prom(const FsrCase *c)
++{
++    uint32_t code[] = {
++        0x03000004,                 /* sethi %hi(0x1000), %g1 */
++        0x82106fa0,                 /* or    %g1, 0xfa0, %g1 */
++        0x81886000,                 /* wr    %g1, %psr     EF, PIL 15, S, ET */
++        0x01000000,                 /* nop */
++        0x01000000,                 /* nop */
++        0x01000000,                 /* nop */
++        0x1d000008,                 /* sethi %hi(0x2000), %sp */
++        0x05000000 | (c->fsr >> 10),    /* sethi %hi(fsr), %g2 */
++        0x8410a000 | (c->fsr & 0x3ff),  /* or    %g2, %lo(fsr), %g2 */
++        0xc423a0e0,                 /* st    %g2, [%sp + 0xe0] */
++        0xc10ba0e0 | (c->rd << 25), /* ld    [%sp + 0xe0], %fsr (c90ba0e0) */
++        0xc023a0e0,                 /* st    %g0, [%sp + 0xe0] */
++        0xc12ba0e0 | (c->rd << 25), /* st    %fsr, [%sp + 0xe0] (c92ba0e0) */
++        0x03000004,                 /* sethi %hi(0x1000), %g1 */
++        0x86102001,                 /* mov   1, %g3 */
++        0xc6206024,                 /* st    %g3, [%g1 + 0x24]  done */
++        0x10800000,                 /* b     . */
++        0x01000000,                 /*  nop */
++    };
++    uint32_t be[PROM_WORDS] = { 0 };
++    char *path = NULL;
++    int fd, i;
++
++    /* Reset (trap 0): b 0x400 */
++    be[0] = cpu_to_be32(0x10800000 | CODE);
++    be[1] = cpu_to_be32(0x01000000);
++    /* Trap i: store i at RAM_TRAP and stop */
++    for (i = 1; i < CODE / 4; i++) {
++        be[4 * i] = cpu_to_be32(0x03000004);         /* sethi %hi(0x1000), %g1 */
++        be[4 * i + 1] = cpu_to_be32(0x84102000 | i); /* mov   i, %g2 */
++        be[4 * i + 2] = cpu_to_be32(0xc4206020);     /* st    %g2, [%g1 + 0x20] */
++        be[4 * i + 3] = cpu_to_be32(0x10800000);     /* b     . */
++    }
++    for (i = 0; i < ARRAY_SIZE(code); i++) {
++        be[CODE + i] = cpu_to_be32(code[i]);
++    }
++    fd = g_file_open_tmp("sun4m-fsr-rd-prom-XXXXXX", &path, NULL);
++    g_assert_cmpint(fd, >=, 0);
++    g_assert_cmpint(write(fd, be, sizeof(be)), ==, sizeof(be));
++    close(fd);
++    return path;
++}
++
++static void test_fsr_rd(const void *data)
++{
++    const FsrCase *c = data;
++    g_autofree char *prom = write_prom(c);
++    gint64 end = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
++    QTestState *qts = qtest_initf("-machine SS-5 -accel tcg -bios %s", prom);
++
++    while (qtest_readl(qts, RAM_TRAP) == 0 &&
++           qtest_readl(qts, RAM_DONE) == 0) {
++        g_assert_cmpint(g_get_monotonic_time(), <, end);
++        g_usleep(1000);
++    }
++    /* An illegal instruction would be trap type 2 */
++    g_assert_cmphex(qtest_readl(qts, RAM_TRAP), ==, 0);
++    g_assert_cmpuint(qtest_readl(qts, RAM_DONE), ==, 1);
++    g_assert_cmphex(qtest_readl(qts, RAM_FSR) & FSR_LD_MASK, ==, c->fsr);
++    qtest_quit(qts);
++    unlink(prom);
++}
++
++int main(int argc, char **argv)
++{
++    int i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    if (qtest_has_accel("tcg")) {
++        for (i = 0; i < ARRAY_SIZE(cases); i++) {
++            g_autofree char *name =
++                g_strdup_printf("sun4m-fsr-rd/%s", cases[i].name);
++            qtest_add_data_func(name, &cases[i], test_fsr_rd);
++        }
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0028-hw-audio-cs4231-play-sound-through-the-apc-dma-engin.patch b/debian/patches/wsh/0028-hw-audio-cs4231-play-sound-through-the-apc-dma-engin.patch
new file mode 100644
index 0000000..5fff9ae
--- /dev/null
+++ b/debian/patches/wsh/0028-hw-audio-cs4231-play-sound-through-the-apc-dma-engin.patch
@@ -0,0 +1,652 @@
+From: Antoni Sawicki <as@tenoware.com>
+Subject: [PATCH] hw/audio/cs4231: play sound through the apc dma engine
+
+The SPARCstation 5 codec made no sound: the APC DMA registers only kept
+what was written, so SunOS 4.1.4's driver waited for ever for its first
+buffer to end. Every program that drained /dev/audio hung, and SimCity
+for HyperLook froze at its first sound.
+
+Play the APC's playback buffers. Take the next buffer when the codec
+asks for samples, which needs playback on in the codec too (PEN), and
+raise PI and PD; raise PM and PMI when the pipe runs empty. Read the
+samples through the IOMMU at the codec's rate and play them into the
+audiodev, in all the codec's formats but ADPCM, with the DAC volume.
+Capture is still not done.
+
+The codec asks for its first samples at the next audio callback, not in
+the register write that turns it on. SunOS queues the rest of a write
+in that moment; when the first PI came before it, the driver played its
+first buffer twice.
+
+Tested with SunOS 4.1.4: a drain of 8000 bytes returns after 1.0 s with
+8000 samples played, twice in a row. /usr/demo/SOUND/play of
+spacemusic.au plays for 6.00 s and peaks at -5.2 dBFS (the file: -4.8).
+SimCity for HyperLook runs with its own audiomixer and plays its sounds.
+
+Origin: https://github.com/tenox7/lemu/commit/2938ff887a938b396b44588927bd14f90faa8e0c
+---
+ hw/audio/cs4231.c     | 496 +++++++++++++++++++++++++++++++++++++++++-
+ hw/audio/trace-events |   3 +
+ 2 files changed, 487 insertions(+), 12 deletions(-)
+
+diff --git a/hw/audio/cs4231.c b/hw/audio/cs4231.c
+index 7844b5b6c9..fba2553a35 100644
+--- a/hw/audio/cs4231.c
++++ b/hw/audio/cs4231.c
+@@ -22,21 +22,108 @@
+  * THE SOFTWARE.
+  */
+ 
++/*
++ * The SPARCstation 5 has the CS4231 codec behind Sun's APC DMA engine.
++ * The first 16 bytes are the codec's own registers, the rest the APC's:
++ *
++ *   0x00 codec index      0x04 codec data       0x08 codec status
++ *   0x0c codec PIO data   0x10 APC CSR
++ *   0x20 capture VA       0x24 capture count    0x28 next VA   0x2c next count
++ *   0x30 playback VA      0x34 playback count   0x38 next VA   0x3c next count
++ *
++ * Playback: the driver writes the next address and then the next count.
++ * When the codec first asks for samples, and again each time the current
++ * buffer is done, the APC moves the next buffer into the current
++ * registers, sets PD (the next registers are free again) and raises PI.
++ * When a buffer ends and no next one is loaded the pipe is
++ * empty: PM and PMI. The interrupt bits are cleared by writing 1s. The
++ * addresses go through the IOMMU, and the samples are played into the
++ * audiodev at the codec's rate, so a driver that waits for the end of its
++ * sound (SunOS AUDIO_DRAIN) gets it in real time. The buffers are taken
++ * at that rate too, at most 50 ms ahead: the real APC has only a small
++ * FIFO, and SunOS loads the next buffer only after PI, so taking a whole
++ * buffer at once would leave the pipe empty.
++ *
++ * Capture is not done: its registers keep what is written, and the
++ * capture pipe always reads as empty.
++ */
++
+ #include "qemu/osdep.h"
+ #include "hw/core/sysbus.h"
++#include "hw/core/irq.h"
++#include "hw/core/qdev-properties.h"
++#include "hw/sparc/sun4m_iommu.h"
+ #include "migration/vmstate.h"
++#include "qemu/audio.h"
++#include "qemu/bswap.h"
++#include "qemu/host-utils.h"
+ #include "qemu/module.h"
++#include "qemu/timer.h"
++#include "system/address-spaces.h"
++#include "system/dma.h"
+ #include "trace.h"
+ #include "qom/object.h"
+ 
+-/*
+- * In addition to Crystal CS4231 there is a DMA controller on Sparc.
+- */
+ #define CS_SIZE 0x40
+ #define CS_REGS 16
+ #define CS_DREGS 32
+ #define CS_MAXDREG (CS_DREGS - 1)
+ 
++/* Registers, as offset / 4 */
++#define CS_IAR      0       /* codec index */
++#define CS_IDR      1       /* codec data */
++#define CS_STATUS   2       /* codec status */
++#define CS_CSR      4       /* APC control and status */
++#define CS_PVA      12      /* playback address */
++#define CS_PC       13      /* playback count */
++#define CS_PNVA     14      /* next playback address */
++#define CS_PNC      15      /* next playback count */
++
++/* APC CSR */
++#define APC_IP      0x00800000  /* an interrupt is pending (read only) */
++#define APC_PI      0x00400000  /* playback took the next buffer */
++#define APC_CI      0x00200000  /* capture took the next buffer */
++#define APC_EI      0x00100000  /* error */
++#define APC_IE      0x00080000  /* interrupt enable */
++#define APC_PIE     0x00040000  /* PI enable */
++#define APC_CIE     0x00020000  /* CI enable */
++#define APC_EIE     0x00010000  /* EI enable */
++#define APC_PMI     0x00008000  /* playback pipe went empty */
++#define APC_PM      0x00004000  /* playback pipe is empty (read only) */
++#define APC_PD      0x00002000  /* next playback registers free (read only) */
++#define APC_PMIE    0x00001000  /* PMI enable */
++#define APC_CM      0x00000800  /* capture pipe is empty (read only) */
++#define APC_CD      0x00000400  /* next capture registers free (read only) */
++#define APC_CMI     0x00000200  /* capture pipe went empty */
++#define APC_CMIE    0x00000100  /* CMI enable */
++#define APC_PPAUSE  0x00000080  /* pause playback */
++#define APC_CPAUSE  0x00000040  /* pause capture */
++#define APC_PDMA_GO 0x00000008  /* playback DMA on */
++#define APC_CDMA_GO 0x00000004  /* capture DMA on */
++#define APC_RESET   0x00000001
++
++#define APC_INTS    (APC_PI | APC_CI | APC_EI | APC_PMI | APC_CMI)
++#define APC_RW      (APC_IE | APC_PIE | APC_CIE | APC_EIE | APC_PMIE | \
++                     APC_CMIE | 0xff)
++
++/* Codec indirect registers */
++#define CS_LDAC     6       /* left DAC output: mute, attenuation */
++#define CS_RDAC     7       /* right DAC output */
++#define CS_PFMT     8       /* playback format and rate */
++#define CS_ICONF    9       /* interface configuration */
++#define CS_MODE     12      /* mode and ID */
++#define CS_DAC_MUTE 0x80
++#define CS_PEN      0x01    /* playback on (in CS_ICONF) */
++#define CS_MODE2    0x40
++
++/* Playback formats, bits 7-5 of CS_PFMT */
++#define CS_FMT_U8       0
++#define CS_FMT_ULAW     1
++#define CS_FMT_S16LE    2
++#define CS_FMT_ALAW     3
++#define CS_FMT_ADPCM    5
++#define CS_FMT_S16BE    6
++
+ #define TYPE_CS4231 "sun-CS4231"
+ typedef struct CSState CSState;
+ DECLARE_INSTANCE_CHECKER(CSState, CS4231,
+@@ -47,14 +134,322 @@ struct CSState {
+ 
+     MemoryRegion iomem;
+     qemu_irq irq;
++    IOMMUState *iommu;
++    AudioBackend *audio_be;
++    SWVoiceOut *voice;
+     uint32_t regs[CS_REGS];
+     uint8_t dregs[CS_DREGS];
++    bool play_next;         /* the next playback registers are loaded */
++    int play_fmt;           /* from CS_PFMT */
++    int play_channels;
++    int play_freq;
++    bool play_running;      /* since play_start, without a gap */
++    int64_t play_start;     /* QEMU_CLOCK_VIRTUAL ns */
++    uint64_t play_units;    /* taken since play_start */
+ };
+ 
+-#define CS_RAP(s) ((s)->regs[0] & CS_MAXDREG)
++#define CS_RAP(s) ((s)->regs[CS_IAR] & CS_MAXDREG)
+ #define CS_VER 0xa0
+ #define CS_CDC_VER 0x8a
+ 
++static AddressSpace *cs_dma_as(CSState *s)
++{
++    return s->iommu ? &s->iommu->iommu_as : &address_space_memory;
++}
++
++static bool cs_play_go(CSState *s)
++{
++    return (s->regs[CS_CSR] & (APC_PDMA_GO | APC_PPAUSE)) == APC_PDMA_GO;
++}
++
++/*
++ * The APC fetches only when the codec asks for samples, so it takes no
++ * buffer before playback is on in the codec too. SunOS and the BSDs load
++ * the first buffer, then write the CSR with PI set to clear old
++ * interrupts, and only then set PEN: a buffer taken before that write
++ * would lose its PI, and the driver would never load the next one.
++ *
++ * The codec asks a moment after PEN, here at the next audio callback,
++ * not in the register write. SunOS queues the rest of a write in that
++ * moment. If the first PI comes before that, its driver thinks the
++ * sound has ended, and it plays the first buffer again with the rest.
++ */
++static bool cs_play_fetch(CSState *s)
++{
++    return cs_play_go(s) && (s->dregs[CS_ICONF] & CS_PEN);
++}
++
++/* There is a buffer to play, or one to take. */
++static bool cs_play_active(CSState *s)
++{
++    return cs_play_fetch(s) && (s->regs[CS_PC] != 0 || s->play_next);
++}
++
++static uint32_t cs_read_csr(CSState *s)
++{
++    uint32_t csr = s->regs[CS_CSR];
++
++    if (csr & APC_INTS) {
++        csr |= APC_IP;
++    }
++    if (!s->play_next) {
++        csr |= APC_PD;
++        if (s->regs[CS_PC] == 0) {
++            csr |= APC_PM;
++        }
++    }
++    if (!cs_play_go(s)) {
++        csr |= APC_PM;
++    }
++    return csr | APC_CM | APC_CD;
++}
++
++static void cs_update_irq(CSState *s)
++{
++    uint32_t csr = s->regs[CS_CSR];
++    bool level = (csr & APC_IE) &&
++                 (((csr & APC_PI) && (csr & APC_PIE)) ||
++                  ((csr & APC_PMI) && (csr & APC_PMIE)) ||
++                  ((csr & APC_CI) && (csr & APC_CIE)) ||
++                  ((csr & APC_CMI) && (csr & APC_CMIE)) ||
++                  ((csr & APC_EI) && (csr & APC_EIE)));
++
++    qemu_set_irq(s->irq, level);
++}
++
++/* The current playback buffer is done: take the next one, if any. */
++static void cs_play_next(CSState *s)
++{
++    if (s->play_next) {
++        s->regs[CS_PVA] = s->regs[CS_PNVA];
++        s->regs[CS_PC] = s->regs[CS_PNC];
++        s->play_next = false;
++        s->regs[CS_CSR] |= APC_PI;
++        trace_cs4231_play_next(s->regs[CS_PVA], s->regs[CS_PC]);
++    } else {
++        s->regs[CS_CSR] |= APC_PMI;
++        trace_cs4231_play_empty();
++    }
++}
++
++static void cs_play_update(CSState *s)
++{
++    bool run = cs_play_active(s);
++
++    if (run && !s->play_running) {
++        s->play_start = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
++        s->play_units = 0;
++    }
++    s->play_running = run;
++    if (s->voice) {
++        audio_be_set_active_out(s->audio_be, s->voice, run);
++    }
++    cs_update_irq(s);
++}
++
++/* G.711 decoders, after Sun's public domain g711.c */
++static int16_t cs_ulaw(uint8_t u)
++{
++    int t;
++
++    u = ~u;
++    t = (((u & 0x0f) << 3) + 0x84) << ((u & 0x70) >> 4);
++    return (u & 0x80) ? 0x84 - t : t - 0x84;
++}
++
++static int16_t cs_alaw(uint8_t a)
++{
++    int t, seg;
++
++    a ^= 0x55;
++    t = (a & 0x0f) << 4;
++    seg = (a & 0x70) >> 4;
++    if (seg == 0) {
++        t += 8;
++    } else {
++        t = (t + 0x108) << (seg - 1);
++    }
++    return (a & 0x80) ? t : -t;
++}
++
++/*
++ * Guest bytes per unit and host bytes per unit: a unit is one sample of
++ * each channel, or two of them for 4-bit ADPCM. The host side is always
++ * 16-bit signed.
++ */
++static void cs_play_units(CSState *s, uint32_t *in, uint32_t *out)
++{
++    uint32_t ch = s->play_channels;
++
++    switch (s->play_fmt) {
++    case CS_FMT_S16LE:
++    case CS_FMT_S16BE:
++        *in = 2 * ch;
++        *out = 2 * ch;
++        break;
++    case CS_FMT_ADPCM:
++        *in = ch;
++        *out = 4 * ch;
++        break;
++    default:
++        *in = ch;
++        *out = 2 * ch;
++        break;
++    }
++}
++
++static void cs_convert(CSState *s, const uint8_t *in, int16_t *out,
++                       uint32_t units)
++{
++    uint32_t i, n = units * s->play_channels;
++
++    switch (s->play_fmt) {
++    case CS_FMT_U8:
++        for (i = 0; i < n; i++) {
++            out[i] = (in[i] - 128) * 256;
++        }
++        break;
++    case CS_FMT_ULAW:
++        for (i = 0; i < n; i++) {
++            out[i] = cs_ulaw(in[i]);
++        }
++        break;
++    case CS_FMT_ALAW:
++        for (i = 0; i < n; i++) {
++            out[i] = cs_alaw(in[i]);
++        }
++        break;
++    case CS_FMT_S16LE:
++        for (i = 0; i < n; i++) {
++            out[i] = lduw_le_p(in + 2 * i);
++        }
++        break;
++    case CS_FMT_S16BE:
++        for (i = 0; i < n; i++) {
++            out[i] = lduw_be_p(in + 2 * i);
++        }
++        break;
++    default:
++        /* ADPCM and the reserved formats: silence at the right rate */
++        memset(out, 0, units * 4 * s->play_channels);
++        break;
++    }
++}
++
++/* The audiodev has room for avail bytes: feed it from the DMA buffers. */
++static void cs_audio_callback(void *opaque, int avail)
++{
++    CSState *s = opaque;
++    uint8_t in[1024];
++    int16_t out[2048];
++    uint32_t unit_in, unit_out;
++
++    uint32_t room = MAX(avail, 0);
++    uint64_t rate, due, budget;
++
++    if (!s->play_running) {
++        return;
++    }
++    /* units a second: one sample of each channel, two for ADPCM */
++    rate = s->play_freq / (s->play_fmt == CS_FMT_ADPCM ? 2 : 1);
++    due = muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->play_start,
++                   rate, NANOSECONDS_PER_SECOND) + rate / 20;
++    budget = due > s->play_units ? due - s->play_units : 0;
++
++    cs_play_units(s, &unit_in, &unit_out);
++    while (cs_play_fetch(s)) {
++        uint32_t pc = s->regs[CS_PC];
++        uint32_t units;
++
++        if (pc == 0) {
++            /* the first buffer, or one loaded after the pipe ran empty */
++            if (!s->play_next) {
++                break;
++            }
++            cs_play_next(s);
++            cs_update_irq(s);
++            continue;
++        }
++        if (pc < unit_in) {
++            /* a partial sample at the end of a buffer: skip it */
++            s->regs[CS_PVA] += pc;
++            s->regs[CS_PC] = 0;
++        } else {
++            units = MIN(pc / unit_in, room / unit_out);
++            units = MIN(units, sizeof(in) / unit_in);
++            units = MIN(units, sizeof(out) / unit_out);
++            units = MIN(units, budget);
++            if (units == 0) {
++                break;
++            }
++            dma_memory_read(cs_dma_as(s), s->regs[CS_PVA], in,
++                            units * unit_in, MEMTXATTRS_UNSPECIFIED);
++            cs_convert(s, in, out, units);
++            units = audio_be_write(s->audio_be, s->voice, out,
++                                   units * unit_out) / unit_out;
++            if (units == 0) {
++                break;
++            }
++            s->regs[CS_PVA] += units * unit_in;
++            s->regs[CS_PC] -= units * unit_in;
++            room -= units * unit_out;
++            budget -= units;
++            s->play_units += units;
++        }
++        if (s->regs[CS_PC] == 0) {
++            cs_play_next(s);
++            cs_update_irq(s);
++        }
++    }
++    /* after a gap the clock starts again with the next buffer */
++    s->play_running = cs_play_active(s);
++}
++
++/* DAC attenuation is 1.5 dB a step; the mixer wants 0-255 */
++static uint8_t cs_dac_level(uint8_t reg)
++{
++    uint32_t i, v = 255 << 8;
++
++    if (reg & CS_DAC_MUTE) {
++        return 0;
++    }
++    for (i = 0; i < (reg & 0x3f); i++) {
++        v = v * 215 / 256;
++    }
++    return v >> 8;
++}
++
++static void cs_set_volume(CSState *s)
++{
++    uint8_t l = s->dregs[CS_LDAC], r = s->dregs[CS_RDAC];
++
++    if (s->voice) {
++        audio_be_set_volume_out_lr(s->audio_be, s->voice,
++                                   (l & r & CS_DAC_MUTE) != 0,
++                                   cs_dac_level(l), cs_dac_level(r));
++    }
++}
++
++/* (Re)open the voice for the codec's playback format and rate */
++static void cs_play_setup(CSState *s)
++{
++    static const int divide[8] = { 3072, 1536, 896, 768, 448, 384, 512, 2560 };
++    uint8_t val = s->dregs[CS_PFMT];
++    struct audsettings as;
++
++    as.freq = ((val & 1) ? 16934400 : 24576000) / divide[(val >> 1) & 7];
++    as.nchannels = (val & 0x10) ? 2 : 1;
++    as.fmt = AUDIO_FORMAT_S16;
++    as.big_endian = HOST_BIG_ENDIAN;
++    s->play_channels = as.nchannels;
++    s->play_freq = as.freq;
++    s->play_fmt = (val >> 5) & ((s->dregs[CS_MODE] & CS_MODE2) ? 7 : 3);
++    trace_cs4231_play_format(as.freq, as.nchannels, s->play_fmt);
++    s->voice = audio_be_open_out(s->audio_be, s->voice, "cs4231", s,
++                                 cs_audio_callback, &as);
++    cs_set_volume(s);
++}
++
+ static void cs_reset(DeviceState *d)
+ {
+     CSState *s = CS4231(d);
+@@ -63,6 +458,12 @@ static void cs_reset(DeviceState *d)
+     memset(s->dregs, 0, CS_DREGS);
+     s->dregs[12] = CS_CDC_VER;
+     s->dregs[25] = CS_VER;
++    s->play_next = false;
++    s->play_running = false;
++    if (s->audio_be) {
++        cs_play_setup(s);
++        cs_play_update(s);
++    }
+ }
+ 
+ static uint64_t cs_mem_read(void *opaque, hwaddr addr,
+@@ -73,7 +474,7 @@ static uint64_t cs_mem_read(void *opaque, hwaddr addr,
+ 
+     saddr = addr >> 2;
+     switch (saddr) {
+-    case 1:
++    case CS_IDR:
+         switch (CS_RAP(s)) {
+         case 3: // Write only
+             ret = 0;
+@@ -84,6 +485,10 @@ static uint64_t cs_mem_read(void *opaque, hwaddr addr,
+         }
+         trace_cs4231_mem_readl_dreg(CS_RAP(s), ret);
+         break;
++    case CS_CSR:
++        ret = cs_read_csr(s);
++        trace_cs4231_mem_readl_reg(saddr, ret);
++        break;
+     default:
+         ret = s->regs[saddr];
+         trace_cs4231_mem_readl_reg(saddr, ret);
+@@ -96,12 +501,13 @@ static void cs_mem_write(void *opaque, hwaddr addr,
+                          uint64_t val, unsigned size)
+ {
+     CSState *s = opaque;
+-    uint32_t saddr;
++    uint32_t saddr, csr;
++    bool was_go;
+ 
+     saddr = addr >> 2;
+     trace_cs4231_mem_writel_reg(saddr, s->regs[saddr], val);
+     switch (saddr) {
+-    case 1:
++    case CS_IDR:
+         trace_cs4231_mem_writel_dreg(CS_RAP(s), s->dregs[CS_RAP(s)], val);
+         switch(CS_RAP(s)) {
+         case 11:
+@@ -111,20 +517,56 @@ static void cs_mem_write(void *opaque, hwaddr addr,
+             val &= 0x40;
+             val |= CS_CDC_VER; // Codec version
+             s->dregs[CS_RAP(s)] = val;
++            cs_play_setup(s);
++            break;
++        case CS_LDAC:
++        case CS_RDAC:
++            s->dregs[CS_RAP(s)] = val;
++            cs_set_volume(s);
++            break;
++        case CS_PFMT:
++            s->dregs[CS_RAP(s)] = val;
++            cs_play_setup(s);
++            cs_play_update(s);
++            break;
++        case CS_ICONF:
++            s->dregs[CS_RAP(s)] = val;
++            cs_play_update(s);
+             break;
+         default:
+             s->dregs[CS_RAP(s)] = val;
