+     default:
+         ret = s->regs[saddr];
+         trace_cs4231_mem_readl_reg(saddr, ret);
+@@ -651,7 +739,7 @@ static void cs_mem_write(void *opaque, hwaddr addr,
+ {
+     CSState *s = opaque;
+     uint32_t saddr, csr;
+-    bool was_go, feed;
++    bool was_go, was_on, feed;
+     int64_t now;
+ 
+     saddr = addr >> 2;
+@@ -720,14 +808,25 @@ static void cs_mem_write(void *opaque, hwaddr addr,
+             s->play_next = false;
+             s->pi_at = -1;
