++static void test_vme_ioc(void)
++{
++    QTestState *qts = qtest_init("-machine SS-600MP -m 64");
++    g_autofree char *mtree = qtest_hmp(qts, "info mtree");
++    uint32_t bit;
++
++    g_assert_true(has_region(mtree, "0000000fdf000000-0000000fdf00ffff "
