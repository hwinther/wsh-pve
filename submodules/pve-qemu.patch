diff --git a/debian/patches/wsh/0007-tests-qtest-am53c974-check-that-Select-with-ATN-work.patch b/debian/patches/wsh/0007-tests-qtest-am53c974-check-that-Select-with-ATN-work.patch
new file mode 100644
index 0000000..99e12a2
--- /dev/null
+++ b/debian/patches/wsh/0007-tests-qtest-am53c974-check-that-Select-with-ATN-work.patch
@@ -0,0 +1,104 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: am53c974: check that Select with ATN works after
+ a SCSI bus reset
+
+Select target 0 with ATN without DMA, issue a SCSI bus reset, then select
+again. A bus reset disconnects every device, so the second select must be
+accepted; the ESP used to stay in initiator mode and reject it as an
+illegal command, which sets STAT_GE in the status register. Solaris 2.5.1
+resets the bus to recover from errors and then loops on "gross error in
+esp status".
+
+Fails on 6f8ce26bb0 ("esp.c: only allow ESP commands permitted in the
+current asc_mode") through 11.1.3, passes on its parent and with the
+esp_bus_reset() fix.
+---
+ tests/qtest/am53c974-test.c | 68 +++++++++++++++++++++++++++++++++++++
+ 1 file changed, 68 insertions(+)
+
+diff --git a/tests/qtest/am53c974-test.c b/tests/qtest/am53c974-test.c
+index a3667275..ce56d437 100644
+--- a/tests/qtest/am53c974-test.c
++++ b/tests/qtest/am53c974-test.c
+@@ -289,6 +289,72 @@ static void test_reset_before_transfer_ok(void)
+     qtest_quit(s);
+ }
+ 
++/* am53c974 at PCI 00:02.0 with BAR0 (I/O) at 0xc000; ESP registers are 4 bytes apart */
++#define ESP_IO_BASE 0xc000
++#define ESP_REG(r) (ESP_IO_BASE + (r) * 4)
++
++#define ESP_FIFO   0x2
++#define ESP_CMD    0x3
++#define ESP_RSTAT  0x4
++#define ESP_WBUSID 0x4
++#define ESP_RINTR  0x5
++
++#define CMD_BUSRESET 0x03
++#define CMD_SELATN   0x42
++
++#define STAT_GE  0x40
++#define INTR_RST 0x80
++
++/* Select target 0 with ATN, without DMA: IDENTIFY then TEST UNIT READY from the FIFO */
++static void esp_select_atn_tur(QTestState *s)
++{
++    int i;
++
++    qtest_outb(s, ESP_REG(ESP_FIFO), 0x80);
++    for (i = 0; i < 6; i++) {
++        qtest_outb(s, ESP_REG(ESP_FIFO), 0x00);
++    }
++    qtest_outb(s, ESP_REG(ESP_WBUSID), 0);
++    qtest_outb(s, ESP_REG(ESP_CMD), CMD_SELATN);
++}
++
++/*
++ * A SCSI bus reset disconnects every device, so the chip is back in
++ * disconnected mode and Select with ATN is a valid command again. Guests
++ * such as Solaris 2.5.1 reset the bus to recover from errors and then
++ * select a target again; an illegal command interrupt there shows up as
++ * a gross error (STAT_GE) in the status register.
++ */
++static void test_select_after_bus_reset_ok(void)
++{
++    QTestState *s = qtest_init(
++        "-device am53c974,id=scsi "
++        "-device scsi-hd,drive=disk0 -drive "
++        "id=disk0,if=none,file=null-co://,format=raw -nodefaults");
++    uint8_t stat, intr;
++
++    qtest_outl(s, 0xcf8, 0x80001010);
++    qtest_outl(s, 0xcfc, ESP_IO_BASE);
++    qtest_outl(s, 0xcf8, 0x80001004);
++    qtest_outw(s, 0xcfc, 0x01);
++
++    /* Selecting target 0 puts the chip in initiator mode */
++    esp_select_atn_tur(s);
++    stat = qtest_inb(s, ESP_REG(ESP_RSTAT));
++    g_assert_cmphex(stat & STAT_GE, ==, 0);
++    qtest_inb(s, ESP_REG(ESP_RINTR));
++
++    qtest_outb(s, ESP_REG(ESP_CMD), CMD_BUSRESET);
++    intr = qtest_inb(s, ESP_REG(ESP_RINTR));
++    g_assert_cmphex(intr & INTR_RST, ==, INTR_RST);
++
++    esp_select_atn_tur(s);
++    stat = qtest_inb(s, ESP_REG(ESP_RSTAT));
++    g_assert_cmphex(stat & STAT_GE, ==, 0);
++
++    qtest_quit(s);
++}
++
+ int main(int argc, char **argv)
+ {
+     const char *arch = qtest_get_arch();
+@@ -318,6 +384,8 @@ int main(int argc, char **argv)
+                        test_inflight_cancel_ok);
+         qtest_add_func("am53c974/test_reset_before_transfer_ok",
+                        test_reset_before_transfer_ok);
++        qtest_add_func("am53c974/test_select_after_bus_reset_ok",
++                       test_select_after_bus_reset_ok);
+     }
+ 
+     return g_test_run();
diff --git a/debian/patches/wsh/0008-hw-display-cg3-take-screens-of-any-size-up-to-8-MB.patch b/debian/patches/wsh/0008-hw-display-cg3-take-screens-of-any-size-up-to-8-MB.patch
new file mode 100644
index 0000000..8e28299
--- /dev/null
+++ b/debian/patches/wsh/0008-hw-display-cg3-take-screens-of-any-size-up-to-8-MB.patch
@@ -0,0 +1,99 @@
+From: Antoni Sawicki <as@tenoware.com>
+Subject: [PATCH] hw/display/cg3: take screens of any size up to 8 MB
+
+The cg3 had 1 MB of video RAM, as the real card, and the Sun machines
+let it show 1024 x 768 or 1152 x 900 only. Its frame buffer starts in
+the middle of the 16 MB of its SBus slot, so there is room for 8 MB.
+The guest's driver takes the size from the properties that the card's
+FCode gives it: SunOS 4.1.4 reads width, height and linebytes and maps
+that much.
+
+-g now takes any size from 640 x 480 up to 8 MB of pixels with a width
+that 8 divides, and the video RAM grows with it. SunOS 4.1.4 runs
+OpenWindows and SunView at 1920 x 1080, and OpenWindows at 3200 x
+1800. Above about 6 MB of pixels its kernel resets at boot.
+
+The sizes other than 1024 x 768 need the FCode ROM of the next commit:
+with the old one OpenBIOS takes a fault at power-on, as it did at
+1152 x 900 before.
+
+Origin: https://github.com/tenox7/lemu/commit/527b934695b3e2568755606abec7446a356c961b
+---
+ hw/display/cg3.c |  9 ++++++++-
+ hw/sparc/sun4m.c | 25 ++++++++++++++++++++-----
+ 2 files changed, 28 insertions(+), 6 deletions(-)
+
+diff --git a/hw/display/cg3.c b/hw/display/cg3.c
+index f9dda15..ee11e90 100644
+--- a/hw/display/cg3.c
++++ b/hw/display/cg3.c
+@@ -161,7 +161,8 @@ static void cg3_invalidate_display(void *opaque)
+ {
+     CG3State *s = opaque;
+ 
+-    memory_region_set_dirty(&s->vram_mem, 0, CG3_VRAM_SIZE);
++    memory_region_set_dirty(&s->vram_mem, 0,
++                            memory_region_size(&s->vram_mem));
+ }
+ 
+ static uint64_t cg3_reg_read(void *opaque, hwaddr addr, unsigned size)
+@@ -286,6 +287,12 @@ static void cg3_realizefn(DeviceState *dev, Error **errp)
+     int ret;
+     char *fcode_filename;
+ 
++    if ((uint64_t)s->width * s->height > s->vram_size) {
++        error_setg(errp, "cg3: %u x %u does not fit in %u bytes of video RAM",
++                   s->width, s->height, s->vram_size);
++        return;
++    }
++
+     memory_region_init_rom(&s->rom, obj, "cg3.prom", FCODE_MAX_ROM_SIZE,
+                            &error_fatal);
+     sysbus_init_mmio(sbd, &s->rom);
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 550acdf..e72e754 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -87,6 +87,10 @@
+ #define MAX_PILS 16
+ #define MAX_VSIMMS 4
+ 
++/* A real cg3 has 1 MB of video RAM; its SBus slot has room for 8 MB */
++#define CG3_VRAM_SIZE        (1 * MiB)
++#define CG3_MAX_VRAM_SIZE    (8 * MiB)
++
+ #define ESCC_CLOCK 4915200
+ 
+ struct sun4m_hwdef {
+@@ -903,15 +907,26 @@ static void sun4m_hw_init(MachineState *machine)
+                 exit(1);
+             }
+ 
+-            if (!(graphic_width == 1024 && graphic_height == 768) &&
+-                !(graphic_width == 1152 && graphic_height == 900)) {
+-                error_report("Unsupported resolution: %d x %d", graphic_width,
+-                             graphic_height);
++            /*
++             * A real cg3 has 1 MB of video RAM, for 1152 x 900. The frame
++             * buffer starts in the middle of the 16 MB of its slot, so
++             * there is room for 8 MB. The guest takes the size from the
++             * properties that the card's FCode gives it, and so SunOS 4
++             * runs screens of other sizes too.
++             */
++            if (graphic_width < 640 || graphic_height < 480 ||
++                graphic_width % 8 ||
++                graphic_width * graphic_height > CG3_MAX_VRAM_SIZE) {
++                error_report("Unsupported resolution: %d x %d (640 x 480 or "
++                             "more, 8 MB of pixels at most, and a width that "
++                             "8 divides)", graphic_width, graphic_height);
+                 exit(1);
+             }
+ 
+             /* sbus irq 5 */
+-            cg3_init(hwdef->tcx_base, slavio_irq[11], 0x00100000,
++            cg3_init(hwdef->tcx_base, slavio_irq[11],
++                     MAX(CG3_VRAM_SIZE,
++                         ROUND_UP(graphic_width * graphic_height, MiB)),
+                      graphic_width, graphic_height, graphic_depth);
+             vga_interface_created = true;
+         } else {
diff --git a/debian/patches/wsh/0009-hw-sparc-sun4m-refuse-a-cg3-size-too-big-to-multiply.patch b/debian/patches/wsh/0009-hw-sparc-sun4m-refuse-a-cg3-size-too-big-to-multiply.patch
new file mode 100644
index 0000000..99b35b9
--- /dev/null
+++ b/debian/patches/wsh/0009-hw-sparc-sun4m-refuse-a-cg3-size-too-big-to-multiply.patch
@@ -0,0 +1,26 @@
+From: Antoni Sawicki <as@tenoware.com>
+Subject: [PATCH] hw/sparc/sun4m: refuse a cg3 size too big to multiply
+
+The check of the cg3 screen size multiplied width by height as int.
+With -g 65536x65536x8 the product wrapped to 0 and passed the check,
+and QEMU then aborted while it allocated the video RAM. Multiply in 64
+bits, so that such a size gets the "Unsupported resolution" message.
+
+Origin: https://github.com/tenox7/lemu/commit/5836ffc34929e95d655006dfe38a1bbf756dc839
+---
+ hw/sparc/sun4m.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index e72e754..7f26612 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -916,7 +916,7 @@ static void sun4m_hw_init(MachineState *machine)
+              */
+             if (graphic_width < 640 || graphic_height < 480 ||
+                 graphic_width % 8 ||
+-                graphic_width * graphic_height > CG3_MAX_VRAM_SIZE) {
++                (int64_t)graphic_width * graphic_height > CG3_MAX_VRAM_SIZE) {
+                 error_report("Unsupported resolution: %d x %d (640 x 480 or "
+                              "more, 8 MB of pixels at most, and a width that "
+                              "8 divides)", graphic_width, graphic_height);
diff --git a/debian/patches/wsh/0010-qemu-options-say-which-screen-sizes-the-cg3-takes.patch b/debian/patches/wsh/0010-qemu-options-say-which-screen-sizes-the-cg3-takes.patch
