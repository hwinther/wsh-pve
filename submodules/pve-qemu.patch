+     .version_id = 8,
+@@ -1469,6 +1543,10 @@ const VMStateDescription vmstate_esp = {
+         VMSTATE_UINT8_TEST(asc_mode, ESPState, esp_is_version_8),
+         VMSTATE_END_OF_LIST()
