+     }
++    if ((insn & SOLARIS_CALL_DISP_MASK) == SOLARIS_CALL_DISP &&
++        dc->solaris_idle_mp) {
++        gen_solaris_idle_mp(dc, cpu_env(cs), insn);
++    }
+ #endif
+ 
+     if (!decode(dc, insn)) {
