++    },
+ };
+ 
+ static void sysbus_esp_mem_write(void *opaque, hwaddr addr,
+@@ -1600,6 +1678,7 @@ static void sysbus_esp_realize(DeviceState *dev, Error **errp)
+     sysbus_init_irq(sbd, &s->irq);
+     sysbus_init_irq(sbd, &s->drq_irq);
