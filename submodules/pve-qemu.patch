+diff --git a/tests/qtest/vga-ar-index-test.c b/tests/qtest/vga-ar-index-test.c
+new file mode 100644
+index 0000000000..cd6b050e78
+--- /dev/null
++++ b/tests/qtest/vga-ar-index-test.c
+@@ -0,0 +1,154 @@
++/*
++ * QTest: reading the VGA attribute address register at 0x3c0
++ *
++ * The attribute controller has one port for its address and its data
++ * writes (0x3c0), steered by a flip-flop that a read of input status 1
++ * (0x3da) resets to the address state. The address register, with the
++ * palette address source bit (0x20) that turns the display on, reads back
++ * at 0x3c0 whatever the state of the flip-flop, and the read does not
++ * toggle it. The Incredible Machine saves the address that way right
++ * after writing an index, in the data state, and writes the saved value
++ * back when it has loaded the palette: a read of 0 there blanks the
++ * screen for good.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++#define VGA_ATT_W       0x3c0   /* attribute address/data write */
++#define VGA_ATT_R       0x3c1   /* attribute data read */
++#define VGA_MIS_W       0x3c2   /* miscellaneous output write */
++#define VGA_IS1_RC      0x3da   /* input status 1, colour */
++
++#define AR_PAS          0x20    /* palette address source */
++#define AR_MODE         0x10    /* attribute mode control register */
++#define AR_OVERSCAN     0x11    /* overscan colour register */
++
++typedef struct {
++    const char *name;
++    const char *machine;
++    const char *device;
++} VgaCase;
++
++static const VgaCase cases[] = {
++    { "std", "pc", "VGA" },
++    { "isa", "pc", "isa-vga" },
++    { "cirrus", "pc", "cirrus-vga" },
++    { "vmware", "pc", "vmware-svga" },
++};
++
++static QTestState *start(const VgaCase *c)
++{
++    QTestState *qts = qtest_initf("-machine %s -vga none -device %s",
++                                  c->machine, c->device);
++
++    /* colour mode: input status 1 at 0x3da (no BIOS runs under qtest) */
++    qtest_outb(qts, VGA_MIS_W, 0x67);
++    return qts;
++}
++
++/* Reset the flip-flop to the address state. */
++static void reset_flip_flop(QTestState *qts)
++{
++    qtest_inb(qts, VGA_IS1_RC);
++}
++
++/*
++ * 0x3c0 returns the index with the palette address source bit in both
++ * flip-flop states, and a read of it leaves the flip-flop where it was.
++ */
++static void test_read_index(const void *data)
++{
++    const VgaCase *c = data;
++    QTestState *qts = start(c);
++
++    reset_flip_flop(qts);
++    qtest_outb(qts, VGA_ATT_W, AR_PAS | AR_OVERSCAN);       /* now data */
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W), ==, AR_PAS | AR_OVERSCAN);
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W), ==, AR_PAS | AR_OVERSCAN);
++
++    /* still in the data state: this write is the overscan colour */
++    qtest_outb(qts, VGA_ATT_W, 0x5a);                        /* now address */
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_R), ==, 0x5a);
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W), ==, AR_PAS | AR_OVERSCAN);
++
++    /* and in the address state this write is an index */
++    qtest_outb(qts, VGA_ATT_W, AR_PAS | AR_MODE);           /* now data */
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W), ==, AR_PAS | AR_MODE);
++
++    /* without the palette address source bit */
++    reset_flip_flop(qts);
++    qtest_outb(qts, VGA_ATT_W, 0x05);
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W), ==, 0x05);
++    qtest_outb(qts, VGA_ATT_W, 0x15);                        /* palette 5 */
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_R), ==, 0x15);
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W), ==, 0x05);
++
++    qtest_quit(qts);
++}
++
++/*
++ * The Incredible Machine's palette load: save the address after writing
++ * an index (in the data state), load the palette registers (the game
++ * loads 15 to 1, here all 16), write the saved address back. The palette
++ * address source bit must survive.
++ */
++static void test_palette_load(const void *data)
++{
++    const VgaCase *c = data;
++    QTestState *qts = start(c);
++    uint8_t saved;
++    int i;
++
++    reset_flip_flop(qts);
++    qtest_outb(qts, VGA_ATT_W, AR_PAS);                     /* display on */
++    saved = qtest_inb(qts, VGA_ATT_W);                      /* data state */
++    g_assert_cmphex(saved, ==, AR_PAS);
++
++    for (i = 0; i < 16; i++) {
++        reset_flip_flop(qts);
++        qtest_outb(qts, VGA_ATT_W, i);
++        qtest_outb(qts, VGA_ATT_W, 0x3f - i);
++    }
++
++    reset_flip_flop(qts);
++    qtest_outb(qts, VGA_ATT_W, saved);
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W) & AR_PAS, ==, AR_PAS);
++    reset_flip_flop(qts);
++    g_assert_cmphex(qtest_inb(qts, VGA_ATT_W) & AR_PAS, ==, AR_PAS);
++
++    /* the palette registers took the values (read with PAS clear) */
++    for (i = 0; i < 16; i++) {
++        reset_flip_flop(qts);
++        qtest_outb(qts, VGA_ATT_W, i);
++        g_assert_cmphex(qtest_inb(qts, VGA_ATT_R), ==, 0x3f - i);
++    }
++
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    size_t i;
++
++    g_test_init(&argc, &argv, NULL);
++
++    for (i = 0; i < ARRAY_SIZE(cases); i++) {
++        g_autofree char *read_name = NULL;
++        g_autofree char *load_name = NULL;
++
++        if (!qtest_has_machine(cases[i].machine) ||
++            !qtest_has_device(cases[i].device)) {
++            continue;
++        }
++        read_name = g_strdup_printf("vga-ar-index/%s/read", cases[i].name);
++        load_name = g_strdup_printf("vga-ar-index/%s/palette-load",
++                                    cases[i].name);
++        qtest_add_data_func(read_name, &cases[i], test_read_index);
++        qtest_add_data_func(load_name, &cases[i], test_palette_load);
++    }
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0053-target-sparc-defer-the-fp_exception-of-an-IEEE-754-e.patch b/debian/patches/wsh/0053-target-sparc-defer-the-fp_exception-of-an-IEEE-754-e.patch
new file mode 100644
index 0000000..63436b4
--- /dev/null
+++ b/debian/patches/wsh/0053-target-sparc-defer-the-fp_exception-of-an-IEEE-754-e.patch
@@ -0,0 +1,411 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: defer the fp_exception of an IEEE 754 exception on sparc32
+
+The boot PROM of the SPARCstation LX (microSPARC-I, TMS390S10) stops in
+its POST at "FPU SP Trap Priority < Test" with "Unexpected Synchronous
+Trap Taken, Trap Type = 00000008", and QEMU then aborts on a trap with
+traps disabled. The test divides by zero with all IEEE traps enabled
+(TEM = 0x1f) and follows the fdivs with a misaligned single-precision
+store from an FP register. It expects mem_address_not_aligned (trap 7)
+on that store, and the fp_exception (trap 8) on a later FP instruction,
+with the fdivs in the floating-point queue. QEMU raises trap 8 on the
+fdivs itself; its comments say "we do not model the fp_exception_pending
+state". Plain QEMU 11.1.3 stops the same way.
+
+The sparc32 FPUs defer fp_exception. The SPARC V8 manual (section 7.3)
+allows an fp_exception to be deferred, even past a precise trap, and an
+outstanding one "is provoked into causing an fp_exception trap by
+execution of any FPop, load or store floating-point (including STFSR),
+or FBfcc instruction". Its appendix L models the FPUs of the
+implementations it covers with three states, fp_execute,
+fp_exception_pending and fp_exception: the FPU moves to fp_exception, loads
+the FQ and traps "when the IU attempts to execute any floating-point
+instruction". The TMS390S10 (microSPARC-I) reference guide and the
+microSPARC-IIep user's manual describe the same model for the microSPARC
+(any floating-point instruction, FBfcc included), and the SuperSPARC
+(TMS390Z50) documentation says "fp_exception is a deferred trap and is
+always reported to the next FPOP or FPEV (ldf or stf)". So this applies to
+every sparc32 CPU model in system emulation; linux-user and sparc64 are
+unchanged.
+
+Model fp_exception_pending for IEEE 754 exceptions:
+
+- An FPop that raises an exception enabled in TEM sets cexc and ftt as
+  before and writes neither its destination nor fcc. It records its
+  address and opcode for the FQ (qne stays 0) and enters
+  fp_exception_pending; execution goes on with the next instruction.
+- The next FPop, FBfcc, FP load (LDF, LDDF, LDFSR) or FP store (STF,
+  STDF, STFSR, STDFQ) takes trap 8 itself (new TB flag
+  TB_FLAG_FP_PENDING): the trap's pc is that instruction, qne is 1 and
+  the FQ holds the FPop.
+- A misaligned FP load or store takes its mem_address_not_aligned
+  (priority 10 against 11) and the exception stays pending for the next
+  FP instruction, which is what the LX PROM expects (the microSPARC-IIep
+  manual: lower-priority traps are ignored as they "persist, recur, or
+  are meaningless"). That check uses the V8 alignment, 8 bytes for LDDF,
+  STDF and STDFQ, although QEMU's own FP accesses check only 4
+  (MO_ALIGN_4); the PROM's double-precision test needs it. Traps that
+  come before the FPU sees the instruction (fp_disabled, a privileged
+  STDFQ in user mode) leave the state as it is.
+- The state migrates in a new subsection, cpu/fp_pending, with the FQ
+  entry.
+
+unimplemented_FPop, invalid_fp_register and sequence_error keep QEMU's
+handling (the trap at once, with pc advanced past the instruction), and
+so does fp_exception state (qne set).
+
+Tested with 11.1.3 and this series: the LX PROM's POST passes all its
+FPU tests (SP and DP Invalid, Overflow, Divide-by-0 and Inexact CEXC,
+Trap Priority > and <) and goes on to its "ok" prompt as far as QEMU's
+LX allows; the SS-5 PROM's POST prints the same as without the change.
+Solaris 2.6 on the SS-20 and the SS-5 delivers SIGFPE with FPE_FLTDIV
+and si_addr at the fdivs, also when system calls and a sleep come
+between the fdivs and the next FP instruction (the kernel then takes
+the trap), 504 of 504 times, and keeps running; FP results of C, nawk
+and bc are unchanged. 34 stored sparc32 disks boot and pass their checks
+as before.
