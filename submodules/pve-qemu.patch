++
++/*
++ * Linux's idle loop at LOOP: interrupts disabled at pil (14, as
++ * local_irq_disable() does), arch_cpu_idle() at ACI, interrupts enabled
++ * (the tick is taken here). arch_cpu_idle() calls FUNC on sun4u, which
++ * counts the round; FUNC + 3 stands in for touch_softlockup_watchdog()
++ * and sun4v_cpu_yield().
++ */
++static int write_linux(uint32_t *p, int k, uint32_t pil)
++{
++    const int aci = 8;                  /* arch_cpu_idle() at LOOP + 8 */
++    uint32_t *a = p + aci;
++    int at = LOOP + aci;
++    int n = 0, t;
++
++    p[n++] = 0x91902000 | pil;          /* top: wrpr %g0, pil, %pil */
++    p[n] = call_to(LOOP + n, at); n++;
++    p[n++] = NOP;
++    p[n++] = 0x91902000;                /* wrpr %g0, 0, %pil */
++    p[n] = bcc_to(BA, LOOP + n, LOOP); n++;
++    p[n++] = NOP;
