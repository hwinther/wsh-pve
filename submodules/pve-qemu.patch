diff --git a/debian/patches/wsh/0170-hw-audio-ac97-don-t-skip-a-buffer-when-CR-is-rewritt.patch b/debian/patches/wsh/0170-hw-audio-ac97-don-t-skip-a-buffer-when-CR-is-rewritt.patch
new file mode 100644
index 0000000..468e6e3
--- /dev/null
+++ b/debian/patches/wsh/0170-hw-audio-ac97-don-t-skip-a-buffer-when-CR-is-rewritt.patch
@@ -0,0 +1,167 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/audio/ac97: don't skip a buffer when CR is rewritten with
+ RPBM set
+
+Writing the bus master's control register with RPBM (run/pause) set
+always moved the engine to the next buffer descriptor (CIV = PIV,
+PIV + 1, a fetch), also when the engine was already running. On the
+ICH, RPBM going from 0 to 1 starts the engine, and writing 1 again
+changes nothing. Windows 98's AC97 drivers built on Microsoft's sample
+driver (SigmaTel's STAC97 among them) write CR with the interrupt
+enables and RPBM after each new LVI, so every new buffer made the
+engine skip the one it was playing: a 2 s WinMM sound was done after
+0.3-0.6 s, with 0.1-0.3 s of it played.
+
+Only RPBM going from 0 to 1 starts the engine now. After a reset it
+fetches the first descriptor as before; after a pause (RPBM cleared
+without a reset) it resumes in the current buffer instead of skipping
+it. Writing RPBM while it is set only updates the other bits. A halted
+engine (CIV = LVI played out) still restarts on a new LVI.
+
+qtest ac97-test playback_cr_rewrite: CR rewritten while running and a
+pause and resume keep CIV and PICB, a reset and a start fetch the first
+descriptor again; it fails without the change.
+---
+ hw/audio/ac97.c         | 21 ++++++++---
+ tests/qtest/ac97-test.c | 78 +++++++++++++++++++++++++++++++++++++++++
+ 2 files changed, 95 insertions(+), 4 deletions(-)
+
+diff --git a/hw/audio/ac97.c b/hw/audio/ac97.c
+index fd74c2499..02dcb8cb1 100644
+--- a/hw/audio/ac97.c
++++ b/hw/audio/ac97.c
+@@ -806,14 +806,27 @@ static void nabm_writeb(void *opaque, uint32_t addr, uint32_t val)
+         if (val & CR_RR) {
+             reset_bm_regs(s, r);
+         } else {
++            uint8_t old_cr = r->cr;
++
+             r->cr = val & CR_VALID_MASK;
+             if (!(r->cr & CR_RPBM)) {
+                 voice_set_active(s, r - s->bm_regs, 0);
+                 r->sr |= SR_DCH;
+-            } else {
+-                r->civ = r->piv;
+-                r->piv = (r->piv + 1) % 32;
+-                fetch_bd(s, r);
++            } else if (!(old_cr & CR_RPBM)) {
++                /*
++                 * RPBM going from 0 to 1 starts the engine. Writing it
++                 * while it is already 1 (a driver that rewrites CR with
++                 * the interrupt enables after each new LVI) changes
++                 * nothing on the ICH, and after a pause (RPBM cleared
++                 * without a reset) the engine resumes in the current
++                 * buffer. Only a start after a reset fetches the first
++                 * descriptor.
++                 */
++                if (!r->bd_valid) {
++                    r->civ = r->piv;
++                    r->piv = (r->piv + 1) % 32;
++                    fetch_bd(s, r);
++                }
+                 r->sr &= ~SR_DCH;
+                 voice_set_active(s, r - s->bm_regs, 1);
+             }
+diff --git a/tests/qtest/ac97-test.c b/tests/qtest/ac97-test.c
+index b71bd60a8..2f9042838 100644
+--- a/tests/qtest/ac97-test.c
++++ b/tests/qtest/ac97-test.c
+@@ -9,6 +9,7 @@
+ 
+ #include "qemu/osdep.h"
+ #include "libqtest.h"
++#include "qemu/bswap.h"
+ #include "qemu/module.h"
+ #include "libqos/qgraph.h"
+ #include "libqos/pci.h"
+@@ -75,6 +76,82 @@ static void ac97_record_downsample(void *obj, void *data, QGuestAllocator *alloc
+     qpci_io_writew(dev, bar0, 0x32, 0x1);
+ }
+ 
++/* Native audio bus master (IOBAR1): the PCM out registers */
++#define PO_BDBAR 0x10
++#define PO_CIV   0x14
++#define PO_LVI   0x15
++#define PO_SR    0x16
++#define PO_PICB  0x18
++#define PO_CR    0x1b
++#define CR_RPBM  0x01
++#define CR_RR    0x02
++#define CR_START (0x10 | 0x04 | CR_RPBM) /* IOCE, LVBIE, RPBM */
++
++/*
++ * CR written again with RPBM still set must not move the engine to the next
++ * buffer: Windows 98's AC97 drivers (Microsoft's sample driver and the codec
++ * vendors' drivers built on it) rewrite CR after each new LVI, and every
++ * rewrite used to skip the buffer being played. A pause (RPBM cleared without
++ * a reset) resumes in the same buffer. The audio timer doesn't run here (the
++ * virtual clock stands still), so nothing is transferred meanwhile.
++ */
++static void ac97_playback_cr_rewrite(void *obj, void *data,
++                                     QGuestAllocator *alloc)
++{
++    QAC97 *ac97 = obj;
++    QPCIDevice *dev = &ac97->dev;
++    QPCIBar bar1;
++    uint32_t bdl[4 * 2];
++    uint64_t bdl_pa = guest_alloc(alloc, sizeof(bdl));
++    uint64_t buf_pa = guest_alloc(alloc, 4 * 0x200);
++    int i;
++
++    for (i = 0; i < 4; i++) {
++        bdl[2 * i] = cpu_to_le32(buf_pa + i * 0x200);
++        bdl[2 * i + 1] = cpu_to_le32((1u << 31) | 0x100); /* IOC, 256 samples */
++    }
++    qtest_memwrite(dev->bus->qts, bdl_pa, bdl, sizeof(bdl));
++
++    qpci_device_enable(dev);
++    bar1 = qpci_iomap(dev, 1, NULL);
++    qpci_io_writeb(dev, bar1, PO_CR, CR_RR);
++    qpci_io_writel(dev, bar1, PO_BDBAR, bdl_pa);
++    qpci_io_writeb(dev, bar1, PO_LVI, 3);
++    qpci_io_writeb(dev, bar1, PO_CR, CR_START);
++    g_assert_cmpuint(qpci_io_readb(dev, bar1, PO_CIV), ==, 0);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_PICB), ==, 0x100);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_SR) & 1, ==, 0); /* DCH */
++
++    /* rewritten while running: the same buffer */
++    for (i = 0; i < 3; i++) {
++        qpci_io_writeb(dev, bar1, PO_CR, CR_START);
++        g_assert_cmpuint(qpci_io_readb(dev, bar1, PO_CIV), ==, 0);
++        g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_PICB), ==, 0x100);
++    }
++
++    /* paused and resumed: the same buffer, running again */
++    qpci_io_writeb(dev, bar1, PO_CR, CR_START & ~CR_RPBM);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_SR) & 1, ==, 1);
++    qpci_io_writeb(dev, bar1, PO_CR, CR_START);
++    g_assert_cmpuint(qpci_io_readb(dev, bar1, PO_CIV), ==, 0);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_PICB), ==, 0x100);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_SR) & 1, ==, 0);
++
++    /* a reset and a start: the first descriptor again */
++    qpci_io_writeb(dev, bar1, PO_CR, CR_RR);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_PICB), ==, 0);
++    qpci_io_writel(dev, bar1, PO_BDBAR, bdl_pa);
++    qpci_io_writeb(dev, bar1, PO_LVI, 3);
++    qpci_io_writeb(dev, bar1, PO_CR, CR_START);
++    g_assert_cmpuint(qpci_io_readb(dev, bar1, PO_CIV), ==, 0);
++    g_assert_cmpuint(qpci_io_readw(dev, bar1, PO_PICB), ==, 0x100);
++
++    qpci_io_writeb(dev, bar1, PO_CR, CR_RR);
++    qpci_iounmap(dev, bar1);
++    guest_free(alloc, buf_pa);
++    guest_free(alloc, bdl_pa);
++}
++
+ static void ac97_register_nodes(void)
+ {
+     QOSGraphEdgeOptions opts = {
+@@ -90,6 +167,7 @@ static void ac97_register_nodes(void)
+ 
+     qos_add_test("playback_upsample", "AC97", ac97_playback_upsample, NULL);
+     qos_add_test("record_downsample", "AC97", ac97_record_downsample, NULL);
++    qos_add_test("playback_cr_rewrite", "AC97", ac97_playback_cr_rewrite, NULL);
+ }
+ 
+ libqos_init(ac97_register_nodes);
diff --git a/debian/patches/wsh/0171-hw-dma-sparc32_dma-model-the-SS-600MP-s-SCSI-DMA-as-.patch b/debian/patches/wsh/0171-hw-dma-sparc32_dma-model-the-SS-600MP-s-SCSI-DMA-as-.patch
new file mode 100644
index 0000000..a3172d1
--- /dev/null
+++ b/debian/patches/wsh/0171-hw-dma-sparc32_dma-model-the-SS-600MP-s-SCSI-DMA-as-.patch
@@ -0,0 +1,292 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/dma/sparc32_dma: model the SS-600MP's SCSI DMA as the
+ ESC gate array
+
+Sun's SPARCserver 600MP boot PROM tests the on-board SCSI DMA's
+registers at slot f offset 0x81000 (progress 0xc3 of its power-on self
+test, a loop on error otherwise). The 600MP has the ESC gate array, not
+the DMA2 QEMU models (SunOS's dmaga.h and esp driver know it as device
+ID 4):
+
+- the control register reads ID 4 in bits 31-28, and a write keeps
+  bits 0x00042b90 (auto-drain, count interrupt enable, burst size, DMA
+  enable, write, reset, interrupt enable); the PROM writes a walking
+  one and wants exactly those back. QEMU read ID 0xa and kept more.
+- the byte count register keeps 24 bits (QEMU kept 32).
+- an address write sets no address-loaded bit (bit 26 is the DMA2's);
+  the PROM compares the whole control register.
+- a byte, halfword or doubleword access is answered with an error
+  acknowledge (the load traps with a bus error, the store is an M-to-S
+  write error, as for the lance's undecoded offsets) and sets the slave
+  size error bit (0x40), which the next read of the control register
+  returns and clears. The PROM makes each such access and then wants
+  the control register to read exactly ID 4 and that bit.
+
+New property esc on the sparc32 DMA devices (default off) and an hwdef
+field esp_dma_esc that only the SS-600MP sets, on its SCSI DMA. With
+the property off the registers and the access sizes are unchanged; the
+other machines keep the DMA2. SunOS's esp driver takes its ESC paths
+with ID 4 (it writes the count register, sets auto-drain and the burst
+size, skips the drain bit); nothing in them waits on a bit QEMU
+doesn't model. Trace event sparc32_dma_esc_size_error; no new state.
+---
+ hw/dma/sparc32_dma.c           | 96 +++++++++++++++++++++++++++++++---
+ hw/dma/trace-events            |  1 +
+ hw/sparc/sun4m.c               | 17 +++++-
+ include/hw/sparc/sparc32_dma.h |  6 +++
+ 4 files changed, 111 insertions(+), 9 deletions(-)
+
+diff --git a/hw/dma/sparc32_dma.c b/hw/dma/sparc32_dma.c
+index a06a44e..b82be30 100644
+--- a/hw/dma/sparc32_dma.c
++++ b/hw/dma/sparc32_dma.c
+@@ -56,6 +56,7 @@
+ 
+ #define DMA_VER 0xa0000000
+ #define DMA_INTR 1
++#define DMA_SLAVE_ERR 0x40
+ #define DMA_INTREN 0x10
+ #define DMA_WRITE_MEM 0x100
+ #define DMA_EN 0x200
+@@ -73,6 +74,18 @@
+ /* XXX SCSI and ethernet should have different read-only bit masks */
+ #define DMA_CSR_RO_MASK 0xfe000007
+ 
++/*
++ * The ESC gate array (device ID 4 in SunOS's dmaga.h): a write of its
++ * control register keeps auto-drain, the count interrupt enable, the
++ * burst size, DMA enable, write, reset and interrupt enable.
++ * Its byte count register has 24 bits. It has no address-loaded bit
++ * (that is the DMA2's), and an access other than a word sets the slave
++ * size error bit, which a read of the control register clears.
++ */
++#define ESC_VER 0x40000000
++#define ESC_CSR_WMASK 0x00042b90
++#define ESC_COUNT_MASK 0x00ffffff
++
+ enum {
+     GPIO_RESET = 0,
+     GPIO_DMA,
+@@ -243,13 +256,25 @@ static void dma_mem_write(void *opaque, hwaddr addr,
+             qemu_irq_lower(s->gpio[GPIO_DMA]);
+         }
+ 
++        if (s->esc) {
++            val &= ESC_CSR_WMASK;
++            val |= ESC_VER;
++            s->dmaregs[0] = (s->dmaregs[0] & ~ESC_CSR_WMASK) | val;
++            break;
++        }
+         val &= ~DMA_CSR_RO_MASK;
+         val |= DMA_VER;
+         s->dmaregs[0] = (s->dmaregs[0] & DMA_CSR_RO_MASK) | val;
+         break;
+     case 1:
+-        s->dmaregs[0] |= DMA_LOADED;
+-        /* fall through */
++        if (!s->esc) {
++            s->dmaregs[0] |= DMA_LOADED;
++        }
++        s->dmaregs[saddr] = val;
++        break;
++    case 2:
++        s->dmaregs[saddr] = s->esc ? val & ESC_COUNT_MASK : val;
++        break;
+     default:
+         s->dmaregs[saddr] = val;
+         break;
+@@ -266,12 +291,62 @@ static const MemoryRegionOps dma_mem_ops = {
+     },
+ };
+ 
++/*
++ * The ESC answers a byte, halfword or doubleword access with an error
++ * acknowledge and sets the slave size error bit; a read of the control
++ * register returns the bit and clears it.
++ */
++static MemTxResult esc_mem_read(void *opaque, hwaddr addr, uint64_t *data,
++                                unsigned size, MemTxAttrs attrs)
++{
++    DMADeviceState *s = opaque;
++
++    if (size != 4) {
++        s->dmaregs[0] |= DMA_SLAVE_ERR;
++        trace_sparc32_dma_esc_size_error(addr, size);
++        return MEMTX_ERROR;
++    }
++    *data = dma_mem_read(opaque, addr, size);
++    if (((addr & DMA_MASK) >> 2) == 0) {
++        s->dmaregs[0] &= ~DMA_SLAVE_ERR;
++    }
++    return MEMTX_OK;
++}
++
++static MemTxResult esc_mem_write(void *opaque, hwaddr addr, uint64_t data,
++                                 unsigned size, MemTxAttrs attrs)
++{
++    DMADeviceState *s = opaque;
++
++    if (size != 4) {
++        s->dmaregs[0] |= DMA_SLAVE_ERR;
++        trace_sparc32_dma_esc_size_error(addr, size);
++        return MEMTX_ERROR;
++    }
++    dma_mem_write(opaque, addr, data, size);
++    return MEMTX_OK;
++}
++
++static const MemoryRegionOps esc_mem_ops = {
++    .read_with_attrs = esc_mem_read,
++    .write_with_attrs = esc_mem_write,
++    .endianness = DEVICE_BIG_ENDIAN,
++    .valid = {
++        .min_access_size = 1,
++        .max_access_size = 8,
++    },
++    .impl = {
++        .min_access_size = 1,
++        .max_access_size = 8,
++    },
++};
++
+ static void sparc32_dma_device_reset(DeviceState *d)
+ {
+     DMADeviceState *s = SPARC32_DMA_DEVICE(d);
+ 
+     memset(s->dmaregs, 0, DMA_SIZE);
+-    s->dmaregs[0] = DMA_VER;
++    s->dmaregs[0] = s->esc ? ESC_VER : DMA_VER;
+     if (object_dynamic_cast(OBJECT(d), TYPE_SPARC32_LEDMA_DEVICE)) {
+         s->dmaregs[3] = LEDMA_BASE_ADDR_RESET;
+     }
+@@ -306,12 +381,18 @@ static void sparc32_dma_device_init(Object *obj)
+     qdev_init_gpio_out(dev, s->gpio, 2);
+ }
+ 
++static const Property sparc32_dma_device_properties[] = {
++    /* the ESC gate array instead of the DMA2 (the SCSI DMA only) */
++    DEFINE_PROP_BOOL("esc", DMADeviceState, esc, false),
++};
++
+ static void sparc32_dma_device_class_init(ObjectClass *klass, const void *data)
+ {
+     DeviceClass *dc = DEVICE_CLASS(klass);
+ 
+     device_class_set_legacy_reset(dc, sparc32_dma_device_reset);
+     dc->vmsd = &vmstate_sparc32_dma_device;
++    device_class_set_props(dc, sparc32_dma_device_properties);
+ }
+ 
+ static const TypeInfo sparc32_dma_device_info = {
+@@ -325,21 +406,22 @@ static const TypeInfo sparc32_dma_device_info = {
+ 
+ static void sparc32_espdma_device_init(Object *obj)
+ {
+-    DMADeviceState *s = SPARC32_DMA_DEVICE(obj);
+     ESPDMADeviceState *es = SPARC32_ESPDMA_DEVICE(obj);
+ 
+-    memory_region_init_io(&s->iomem, OBJECT(s), &dma_mem_ops, s,
+-                          "espdma-mmio", DMA_SIZE);
+-
+     object_initialize_child(obj, "esp", &es->esp, TYPE_SYSBUS_ESP);
+ }
+ 
+ static void sparc32_espdma_device_realize(DeviceState *dev, Error **errp)
+ {
++    DMADeviceState *s = SPARC32_DMA_DEVICE(dev);
+     ESPDMADeviceState *es = SPARC32_ESPDMA_DEVICE(dev);
+     SysBusESPState *sysbus = SYSBUS_ESP(&es->esp);
+     ESPState *esp = &sysbus->esp;
+ 
++    memory_region_init_io(&s->iomem, OBJECT(s),
++                          s->esc ? &esc_mem_ops : &dma_mem_ops, s,
++                          "espdma-mmio", DMA_SIZE);
++
+     esp->dma_memory_read = espdma_memory_read;
+     esp->dma_memory_write = espdma_memory_write;
+     esp->dma_opaque = SPARC32_DMA_DEVICE(dev);
+diff --git a/hw/dma/trace-events b/hw/dma/trace-events
+index 4c09790..1c4881d 100644
+--- a/hw/dma/trace-events
++++ b/hw/dma/trace-events
+@@ -17,6 +17,7 @@ sparc32_dma_mem_readl(uint64_t addr, uint32_t ret) "read dmareg 0x%"PRIx64": 0x%
+ sparc32_dma_mem_writel(uint64_t addr, uint32_t old, uint32_t val) "write dmareg 0x%"PRIx64": 0x%08x -> 0x%08x"
+ sparc32_dma_enable_raise(void) "Raise DMA enable"
+ sparc32_dma_enable_lower(void) "Lower DMA enable"
++sparc32_dma_esc_size_error(uint64_t addr, unsigned size) "ESC slave size error at 0x%"PRIx64" size %u"
+ 
+ # i8257.c
+ i8257_unregistered_dma(int nchan, int dma_pos, int dma_len) "unregistered DMA channel used nchan=%d dma_pos=%d dma_len=%d"
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 39cef03..154cc55 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -120,6 +120,7 @@ struct sun4m_hwdef {
+     uint8_t nvram_machine_id;
+     bool timer_read_ahead;      /* a counter read moves on (slavio_timer) */
+     bool sbus_bus_errors;       /* buserr-trap, SBus write errors (M-to-S) */
++    bool esp_dma_esc;           /* the SCSI DMA is the ESC gate array */
+ };
+ 
+ struct Sun4mMachineClass {
+@@ -333,7 +334,7 @@ static void *sparc32_dma_init(hwaddr dma_base,
+                               hwaddr esp_base, qemu_irq espdma_irq,
+                               hwaddr le_base, qemu_irq ledma_irq,
+                               hwaddr lebuffer_base, uint32_t le_rap_mask,
+-                              MACAddr *mac)
++                              bool esp_dma_esc, MACAddr *mac)
+ {
+     DeviceState *dma;
+     ESPDMADeviceState *espdma;
+@@ -368,6 +369,9 @@ static void *sparc32_dma_init(hwaddr dma_base,
+     if (le_rap_mask) {
+         qdev_prop_set_uint32(DEVICE(lance), "rap-mask", le_rap_mask);
+     }
++    if (esp_dma_esc) {
++        qdev_prop_set_bit(DEVICE(espdma), "esc", true);
++    }
+     sysbus_realize_and_unref(SYS_BUS_DEVICE(dma), &error_fatal);
+     if (lebuffer_base) {
+         sysbus_mmio_map(SYS_BUS_DEVICE(dma), 1, lebuffer_base);
+@@ -1186,7 +1190,8 @@ static void sun4m_hw_init(MachineState *machine)
+     sparc32_dma_init(hwdef->dma_base,
+                      hwdef->esp_base, slavio_irq[18],
+                      hwdef->le_base, slavio_irq[16],
+-                     hwdef->lebuffer_base, hwdef->le_rap_mask, &hostid);
++                     hwdef->lebuffer_base, hwdef->le_rap_mask,
++                     hwdef->esp_dma_esc, &hostid);
+ 
