++    /* as the PROM does it: a walking one through a tag and a data word */
++    for (bit = 1; bit; bit <<= 1) {
++        qtest_writel(qts, IOC_TAGS, bit);
++        g_assert_cmphex(qtest_readl(qts, IOC_TAGS), ==, bit & IOC_TAG_MASK);
++        qtest_writel(qts, IOC_DATA, bit);
++        g_assert_cmphex(qtest_readl(qts, IOC_DATA), ==, bit);
++    }
++    /* a tag per 32-byte line, a data word per word */
++    qtest_writel(qts, IOC_TAGS, 0xa5a5a5a5);
++    qtest_writel(qts, IOC_TAGS + 0x20, 0x5a5a5a5a);
++    qtest_writel(qts, IOC_TAGS + 0x7fe0, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, IOC_TAGS), ==, 0xa5a00000);
++    g_assert_cmphex(qtest_readl(qts, IOC_TAGS + 4), ==, 0xa5a00000);
++    g_assert_cmphex(qtest_readl(qts, IOC_TAGS + 0x20), ==, 0x5a500000);
++    g_assert_cmphex(qtest_readl(qts, IOC_TAGS + 0x7fe0), ==, IOC_TAG_MASK);
