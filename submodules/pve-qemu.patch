+index 378a1c3091..6866de3998 100644
+--- a/tests/qtest/sun4m-bus-error-trap-test.c
++++ b/tests/qtest/sun4m-bus-error-trap-test.c
+@@ -82,7 +82,7 @@ static char *write_prom(const TestCase *t)
+         0x81902000,             /* wr    %g0, 0, %wim */
+         0x81882f80,             /* wr    %g0, 0xf80, %psr    S, PIL 15 */
+         NOP, NOP, NOP,
+-        0xd4800080,             /* lda   [%g0] 4, %o2        MMU control register */
++        0x94102000,             /* mov   0, %o2              boot mode off */
+         0x9412a001,             /* or    %o2, 1, %o2         MMU on */
+         0xd4a00080,             /* sta   %o2, [%g0] 4 */
+         0x81882fa0,             /* wr    %g0, 0xfa0, %psr    traps on */
+diff --git a/tests/qtest/sun4m-mmu-ctx-ifetch-test.c b/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
+index b4fcbd042c..78bb2051db 100644
+--- a/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
++++ b/tests/qtest/sun4m-mmu-ctx-ifetch-test.c
+@@ -59,7 +59,7 @@ static char *write_prom(bool traps_on)
+         0x01000000,             /* nop */
+         0x01000000,             /* nop */
+         0x01000000,             /* nop */
+-        0xd4800080,             /* lda   [%g0] 4, %o2        MMU control register */
++        0x94102000,             /* mov   0, %o2              boot mode off */
+         0x9412a001,             /* or    %o2, 1, %o2         MMU on */
+         0xd4a00080,             /* sta   %o2, [%g0] 4 */
+         0x07004004,             /* sethi %hi(0x01001000), %g3 */
diff --git a/debian/patches/wsh/0122-hw-audio-cs4231-raise-pi-and-pmi-when-the-codec-gets.patch b/debian/patches/wsh/0122-hw-audio-cs4231-raise-pi-and-pmi-when-the-codec-gets.patch
new file mode 100644
index 0000000..3e43fe4
--- /dev/null
+++ b/debian/patches/wsh/0122-hw-audio-cs4231-raise-pi-and-pmi-when-the-codec-gets.patch
@@ -0,0 +1,425 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/audio/cs4231: raise pi and pmi when the codec gets
+ there
+
+The APC takes its samples up to 50 ms ahead of the codec's clock, and it
+set PI (next buffer taken) and PMI (pipe empty) at that moment. A buffer
+that fits in one audio callback, or an interrupt that the guest takes
+late, then showed both bits in one interrupt. On the real chip PMI
+follows PI by the time the buffer takes to play.
+
+SunOS 4.1.4's audio_4231_cintr looks at PMI before PI and acts on PMI
+only after a PI has found no next buffer to load. With both set at once
+it skips the PMI, the PI ends playback, and the PMI has been cleared
+with it: the last buffers are never marked played and a process in
+AUDIO_DRAIN sleeps for ever. SimCity for HyperLook's audiomixer does
+that after a few sound effects, and OpenWindows stops taking input
+("xnews: Warning: input queue lock broken!").
+
+The samples are still taken ahead, but PI is now raised when the codec
+clock gets to the start of the buffer and PMI when it has played the
+last one, from a timer. PMI also waits until the driver has cleared an
+enabled PI, and is not raised when a next buffer was loaded before the
+pipe ran dry. PD (next registers free) shows with the PI and not when
+the samples are taken, so that a driver that loads on PD gets one PI
+for each buffer. After a gap the codec goes on from the end of what it
+still had to play. Turning the DMA off and a reset drop what was due;
+a pause holds it.
+
+With the PI at its right time a driver loads the next buffer only when
+the codec starts on the last one, and a buffer shorter than the audio
+callback's period (10 ms) was then taken too late every time: 5 ms of
+sound, 5 ms of nothing. So a buffer loaded while the codec still plays
+the end of the one before is taken at once, and the codec's clock
+starts when its first samples are taken, not when playback is turned
+on.
+
+The times of a PI or PMI still due are migrated in a subsection, sent
+only while one is due, and the timer is set again after the load:
+without it a migration or loadvm in that window would lose the PMI and
+bring the same hang back. A stream without the subsection loads as
+before, with nothing due.
