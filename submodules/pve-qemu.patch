++#define SERIAL_IRQ      (1 << 15)
++
++#define WR0_RES_EXT_INT 0x10
++#define WR1_EXT_INT     0x01
++#define WR1_RXINTALL    0x10
++#define WR3_RX8_EN      0xc1
++#define WR4_X16_1STOP   0x44
++#define WR5_TX8_EN      0x68
++#define WR9_RESET_A     0x80
