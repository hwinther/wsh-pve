+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: keep the SS-600MP's I/O cache tags and data
+
+Sun's SPARCserver 600MP boot PROM tests the VMEbus interface's I/O
+cache after the lance (progress 0xc6 of its power-on self test, a loop
+on error otherwise): it writes a walking one to the first tag at
+physical 0xf.df00_0000 and wants bits 31-20 back, a walking one through
+all 32 bits of the first data word at 0xf.df00_8000, and then a march
+test over the 1024 tags (one per 32-byte line) and the 32 KB of data.
+QEMU had nothing there and the first load took a bus error.
+
+The sun4m-vme device gets a second MMIO region, mapped 64 KB below its
+registers on the SS-600MP (SunOS's sun4m iocache.h: the tags at
+0xdf000000, 1024 lines of 32 bytes, the flush space at 0xdf020000 left
+out): a tag per line keeps bits 31-20 (the address tag and the line's
+valid and writable bits), the data keeps every word. Storage only, no
+cache behind it; the VMEbus control register's I/O cache enable bit
+still does nothing. SunOS 4.1.2 uses the I/O cache only when the boot
+PROM's vme node says it has one, which OpenBIOS doesn't. The tags and
+data go in a vmstate subsection, sun4m-vme/ioc, sent only when one is
+not zero. Only the SS-600MP has the device.
+---
+ hw/sparc/sun4m.c | 85 +++++++++++++++++++++++++++++++++++++++++++++++-
+ 1 file changed, 84 insertions(+), 1 deletion(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 4c5901e..2ca7566 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -24,6 +24,7 @@
+ 
+ #include "qemu/osdep.h"
+ #include "qemu/units.h"
++#include "qemu/cutils.h"
+ #include "qapi/error.h"
+ #include "qemu/datadir.h"
+ #include "target/sparc/cpu.h"
+@@ -682,6 +683,12 @@ struct AFXState {
+  * walking one and all ones to it and wants these bits back. There is no
+  * VMEbus or I/O cache behind them; the fault registers read 0 and the
+  * rest of the page is ignored, as before.
++ *
++ * The I/O cache's tags and data, 64 KB below the registers (SunOS's
++ * sun4m iocache.h): 1024 lines of 32 bytes, a tag per line at its line
++ * offset in the first 32 KB (bits 31-20: the address tag and the line's
++ * valid and writable bits), the data in the next 32 KB. The boot PROM
++ * writes and reads back both; they are storage, no cache acts on them.
+  */
+ #define TYPE_SUN4M_VME "sun4m-vme"
+ OBJECT_DECLARE_SIMPLE_TYPE(Sun4mVMEState, SUN4M_VME)
+@@ -690,11 +697,20 @@ OBJECT_DECLARE_SIMPLE_TYPE(Sun4mVMEState, SUN4M_VME)
+ #define VME_CR          0x0
+ #define VME_CR_MASK     0xf0000000
+ 
++#define VME_IOC_SIZE        0x10000     /* MMIO region 1, the tags and data */
++#define VME_IOC_LINES       0x400
++#define VME_IOC_LINE_SHIFT  5
++#define VME_IOC_DATA        0x8000
++#define VME_IOC_TAG_MASK    0xfff00000
++
+ struct Sun4mVMEState {
+     SysBusDevice parent_obj;
+ 
+     MemoryRegion iomem;
++    MemoryRegion ioc;
+     uint32_t cr;
++    uint32_t ioc_tags[VME_IOC_LINES];
++    uint32_t ioc_data[VME_IOC_DATA / 4];
+ };
+ 
+ static uint64_t sun4m_vme_read(void *opaque, hwaddr addr, unsigned size)
+@@ -728,6 +744,42 @@ static const MemoryRegionOps sun4m_vme_ops = {
+     },
+ };
+ 
++static uint64_t sun4m_vme_ioc_read(void *opaque, hwaddr addr, unsigned size)
++{
++    Sun4mVMEState *s = opaque;
++
++    if (addr >= VME_IOC_DATA) {
++        return s->ioc_data[(addr - VME_IOC_DATA) >> 2];
++    }
++    return s->ioc_tags[addr >> VME_IOC_LINE_SHIFT];
++}
++
++static void sun4m_vme_ioc_write(void *opaque, hwaddr addr, uint64_t val,
++                                unsigned size)
++{
++    Sun4mVMEState *s = opaque;
++
++    if (addr >= VME_IOC_DATA) {
++        s->ioc_data[(addr - VME_IOC_DATA) >> 2] = val;
++    } else {
++        s->ioc_tags[addr >> VME_IOC_LINE_SHIFT] = val & VME_IOC_TAG_MASK;
++    }
++}
++
++static const MemoryRegionOps sun4m_vme_ioc_ops = {
++    .read = sun4m_vme_ioc_read,
++    .write = sun4m_vme_ioc_write,
++    .endianness = DEVICE_BIG_ENDIAN,
++    .valid = {
++        .min_access_size = 1,
++        .max_access_size = 8,
++    },
++    .impl = {
++        .min_access_size = 4,
++        .max_access_size = 4,
++    },
++};
++
+ static void sun4m_vme_reset(DeviceState *d)
+ {
+     SUN4M_VME(d)->cr = 0;
+@@ -740,8 +792,31 @@ static void sun4m_vme_init(Object *obj)
+     memory_region_init_io(&s->iomem, obj, &sun4m_vme_ops, s, "sun-vme",
+                           VME_REGS_SIZE);
+     sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
++    memory_region_init_io(&s->ioc, obj, &sun4m_vme_ioc_ops, s, "sun-vme-ioc",
++                          VME_IOC_SIZE);
++    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->ioc);
+ }
+ 
++static bool sun4m_vme_ioc_needed(void *opaque)
++{
++    Sun4mVMEState *s = opaque;
++
++    return !buffer_is_zero(s->ioc_tags, sizeof(s->ioc_tags)) ||
++           !buffer_is_zero(s->ioc_data, sizeof(s->ioc_data));
++}
++
++static const VMStateDescription vmstate_sun4m_vme_ioc = {
++    .name = TYPE_SUN4M_VME "/ioc",
++    .version_id = 1,
++    .minimum_version_id = 1,
++    .needed = sun4m_vme_ioc_needed,
++    .fields = (const VMStateField[]) {
++        VMSTATE_UINT32_ARRAY(ioc_tags, Sun4mVMEState, VME_IOC_LINES),
++        VMSTATE_UINT32_ARRAY(ioc_data, Sun4mVMEState, VME_IOC_DATA / 4),
++        VMSTATE_END_OF_LIST()
++    }
++};
++
+ static const VMStateDescription vmstate_sun4m_vme = {
+     .name = TYPE_SUN4M_VME,
+     .version_id = 1,
+@@ -749,6 +824,10 @@ static const VMStateDescription vmstate_sun4m_vme = {
+     .fields = (const VMStateField[]) {
+         VMSTATE_UINT32(cr, Sun4mVMEState),
+         VMSTATE_END_OF_LIST()
++    },
++    .subsections = (const VMStateDescription * const []) {
++        &vmstate_sun4m_vme_ioc,
++        NULL
+     }
+ };
+ 
+@@ -1404,8 +1483,12 @@ static void sun4m_hw_init(MachineState *machine)
+          * before its banner. No VMEbus model: the control register keeps
+          * its enable bits (TYPE_SUN4M_VME), the VMEbus spaces themselves
+          * stay empty, so the kernel's probes for VME devices find none.
++         * The I/O cache's tags and data are 64 KB below the registers.
+          */
+-        sysbus_create_simple(TYPE_SUN4M_VME, hwdef->vme_base, NULL);
++        SysBusDevice *vme = SYS_BUS_DEVICE(
++            sysbus_create_simple(TYPE_SUN4M_VME, hwdef->vme_base, NULL));
++
++        sysbus_mmio_map(vme, 1, hwdef->vme_base - VME_IOC_SIZE);
+     }
+ 
