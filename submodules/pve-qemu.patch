++++ b/tests/qtest/meson.build
+@@ -206,7 +206,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-solaris-smp-idle-test',
+                 'sun4m-fsr-rd-test',
