++    wreg(qts, ctrl, 5, WR5_TX8_EN);
++    wreg(qts, ctrl, 15, wr15);
++    wreg(qts, ctrl, 1, wr1);
++}
++
++static void send_break(QTestState *qts, const char *id)
++{
++    qtest_qmp_assert_success(qts,
++        "{ 'execute': 'chardev-send-break', 'arguments': { 'id': %s } }", id);
++}
++
++/*
++ * The break and its end are two interrupts. The end waits for the guest to
++ * reset the interrupt of the start, however long the guest takes.
++ */
++static void test_start_and_end(void)
++{
++    QTestState *qts = start();
++
++    setup(qts, TTYA_CTRL, WR1_EXT_INT | WR1_RXINTALL, WR15_BRK_IE);
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==, 0);
++
++    send_break(qts, "ttya");
++    g_assert_true(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_BRK);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, RR3_EXTINTA);
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 2), ==, RR2_EXTINTA);
++
++    /* Not serviced yet: the start stays latched past the character time */
++    qtest_clock_step(qts, 10 * CHAR_TIME_NS);
++    g_assert_true(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_BRK);
++
++    /* The guest resets it: the break ends, with a NUL in the receiver */
++    wreg(qts, TTYA_CTRL, 0, WR0_RES_EXT_INT);
++    g_assert_true(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_RXAV);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, RR3_RXINTA | RR3_EXTINTA);
++    /* Receive goes first */
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 2), ==, RR2_RXINTA);
++    g_assert_cmphex(qtest_readb(qts, TTYA_DATA), ==, 0);
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 2), ==, RR2_EXTINTA);
++    g_assert_true(irq(qts));
++
++    /* The end is reset too: nothing is left, and the line is down */
++    wreg(qts, TTYA_CTRL, 0, WR0_RES_EXT_INT);
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, 0);
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 2), ==, RR2_NOINT);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==, 0);
++
++    /* A second break works the same */
++    send_break(qts, "ttya");
++    g_assert_true(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & RR0_BRK, ==, RR0_BRK);
++
++    qtest_quit(qts);
++}
++
++/*
++ * The guest services the start at once, before the break has lasted a
++ * character time (Linux then reads RR0 until the bit is 0): the end comes
++ * after that time, as an interrupt of its own.
++ */
++static void test_end_after_char_time(void)
++{
++    QTestState *qts = start();
++
++    setup(qts, TTYA_CTRL, WR1_EXT_INT | WR1_RXINTALL, WR15_BRK_IE);
++    send_break(qts, "ttya");
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & RR0_BRK, ==, RR0_BRK);
++    wreg(qts, TTYA_CTRL, 0, WR0_RES_EXT_INT);
++
++    /* Still in the break: the bit follows the line, nothing is pending */
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_BRK);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, 0);
++
++    qtest_clock_step(qts, CHAR_TIME_NS);
++    g_assert_true(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_RXAV);
++    g_assert_cmphex(qtest_readb(qts, TTYA_DATA), ==, 0);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, RR3_EXTINTA);
++    wreg(qts, TTYA_CTRL, 0, WR0_RES_EXT_INT);
++    g_assert_false(irq(qts));
++
++    qtest_quit(qts);
++}
++
++/*
++ * A guest that polls (the firmware) has no interrupt enabled: RR0 shows the
++ * break while it lasts and the line stays down. It used to stay raised for
++ * as long as WR15's break bit was set, and the break never ended.
++ */
++static void test_polled(void)
++{
++    QTestState *qts = start();
++
++    setup(qts, TTYA_CTRL, 0, WR15_BRK_IE);
++    send_break(qts, "ttya");
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_BRK);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, 0);
++
++    qtest_clock_step(qts, CHAR_TIME_NS);
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_RXAV);
++    g_assert_cmphex(qtest_readb(qts, TTYA_DATA), ==, 0);
++
++    qtest_quit(qts);
++}
++
++/* Channel B, with no receive interrupt enabled */
++static void test_channel_b(void)
++{
++    QTestState *qts = start();
++
++    setup(qts, TTYB_CTRL, WR1_EXT_INT, WR15_BRK_IE);
++    send_break(qts, "ttyb");
++    g_assert_true(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, RR3_EXTINTB);
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 2), ==, RR2_EXTINTB);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & RR0_BRK, ==, 0);
++
++    wreg(qts, TTYB_CTRL, 0, WR0_RES_EXT_INT);
++    qtest_clock_step(qts, CHAR_TIME_NS);
++    /* The end, without receive interrupts: only the external/status one */
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 0) & (RR0_BRK | RR0_RXAV), ==,
++                    RR0_RXAV);
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 3), ==, RR3_EXTINTB);
++    wreg(qts, TTYB_CTRL, 0, WR0_RES_EXT_INT);
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYB_CTRL, 2), ==, RR2_NOINT);
++
++    qtest_quit(qts);
++}
++
++/* A channel reset ends what the break left pending */
++static void test_channel_reset(void)
++{
++    QTestState *qts = start();
++
++    setup(qts, TTYA_CTRL, WR1_EXT_INT | WR1_RXINTALL, WR15_BRK_IE);
++    send_break(qts, "ttya");
++    g_assert_true(irq(qts));
++    wreg(qts, TTYA_CTRL, 9, WR9_RESET_A);
++    g_assert_false(irq(qts));
++    qtest_clock_step(qts, CHAR_TIME_NS);
++    g_assert_false(irq(qts));
++    g_assert_cmphex(rreg(qts, TTYA_CTRL, 0) & RR0_BRK, ==, 0);
++
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("/sun4m/escc-break/start-and-end", test_start_and_end);
++    qtest_add_func("/sun4m/escc-break/end-after-char-time",
++                   test_end_after_char_time);
++    qtest_add_func("/sun4m/escc-break/polled", test_polled);
++    qtest_add_func("/sun4m/escc-break/channel-b", test_channel_b);
++    qtest_add_func("/sun4m/escc-break/channel-reset", test_channel_reset);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0143-hw-sparc-sun4m-present-the-MCC-with-more-than-512-MB.patch b/debian/patches/wsh/0143-hw-sparc-sun4m-present-the-MCC-with-more-than-512-MB.patch
new file mode 100644
index 0000000..1ab5a09
--- /dev/null
+++ b/debian/patches/wsh/0143-hw-sparc-sun4m-present-the-MCC-with-more-than-512-MB.patch
@@ -0,0 +1,71 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: present the MCC with more than 512 MB
+
+Solaris 2.5.1-9 panic early in startup on -M SS-10 and SS-20 with more
+than 512 MB (Solaris 2.6: "BAD TRAP: type=9 ... kernel read fault at
+addr=0x0" in kvm_init, as a reboot loop). The kernel reads the memory
+controller's implementation from bits 31:28 of the ECC memory enable
+register. For the SS-10's EMC (1) and the SS-20's SMC (2) it counts a
+page frame as memory only below 512 MB and looks the bank up among
+eight SIMM slots of 64 MB, as those controllers decode them; above that
+it takes the frame for no memory. Its first page table above 512 MB
+then has no page structure and the kernel dereferences NULL. The
+SS-600MP's MCC (0) has no such window: every page in the memory space
+is memory.
+
+The real SS-10 and SS-20 take at most 512 MB, so there is no
+configuration of theirs to follow. When the machine has more than
+512 MB, present the MCC on the SS-10 and SS-20, as on the SS-600MP:
+the MER reads implementation 0 and keeps only the MCC's bits, and the
+MCC's diagnostic register block is mapped. With 512 MB and less
+nothing changes. Solaris uses the controller type otherwise only for
+memory error reports and the SX/VSIMM, which QEMU doesn't raise or
+emulate.
+
+Only under OpenBIOS (a firmware whose file name starts with
+"openbios"): the Sun PROMs know only the machine's own controller.
+With the MCC the SS-20 PROM stops after its CPU probe; with the SMC it
+probes its eight banks and uses 512 MB, as before.
+
+Tested with Solaris 2.5.1, 2.6, 7, 8 and 9 on SS-20 and 2.6 and 7 on
+SS-10, 1024 and 2048 MB, one to four CPUs, with OpenBIOS (which needs
+more heap for page tables at 1 GB and more); the SS-20 PROM with 512
+and 1024 MB.
+---
+ hw/sparc/sun4m.c | 23 ++++++++++++++++++++---
+ 1 file changed, 20 insertions(+), 3 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 20e10bd..31ea300 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -1268,9 +1268,26 @@ static void sun4m_hw_init(MachineState *machine)
+                graphic_width, graphic_height, graphic_depth,
+                hwdef->nvram_machine_id, "Sun4m");
+ 
+-    if (hwdef->ecc_base)
+-        ecc_init(hwdef->ecc_base, slavio_irq[28],
+-                 hwdef->ecc_version);
++    if (hwdef->ecc_base) {
++        uint32_t ecc_version = hwdef->ecc_version;
++        g_autofree char *prom = g_path_get_basename(machine->firmware ?:
++                                                    PROM_FILENAME);
++
++        /*
++         * The SS-10's EMC and the SS-20's SMC decode eight SIMM slots of
++         * 64 MB, 512 MB in all, and Solaris counts a page above that as no
++         * memory on them: with more RAM it panics in startup.  The
++         * SS-600MP's MCC has no such limit, so present that one when the
++         * machine has more than 512 MB and runs OpenBIOS.  The Sun PROMs
++         * know only the machine's own controller: with the MCC the SS-20
++         * PROM stops after its CPU probe, with the SMC it uses 512 MB.
++         */
++        if (machine->ram_size > 512 * MiB &&
++            g_str_has_prefix(prom, "openbios")) {
++            ecc_version = 0x00000000; /* MCC: version 0, implementation 0 */
++        }
++        ecc_init(hwdef->ecc_base, slavio_irq[28], ecc_version);
++    }
+ 
+     dev = qdev_new(TYPE_FW_CFG_MEM);
+     fw_cfg = FW_CFG(dev);
diff --git a/debian/patches/wsh/0144-tests-qtest-test-the-memory-controller-version-with-.patch b/debian/patches/wsh/0144-tests-qtest-test-the-memory-controller-version-with-.patch
new file mode 100644
index 0000000..5b64fcc
--- /dev/null
+++ b/debian/patches/wsh/0144-tests-qtest-test-the-memory-controller-version-with-.patch
@@ -0,0 +1,132 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the memory controller version with more
+ than 512 MB on sun4m
+
+qtest sun4m-ecc-test for the patch before: the MER's implementation
+bits read 1 (EMC) on -M SS-10 and 2 (SMC) on SS-20 with 256 and 512 MB,
+0 (MCC) on both with 576 and 2048 MB, 2 on SS-20 with 1024 MB and a
+firmware file not named openbios*, and 0 on the SS-600MP; with
+1024 MB on SS-20 a write of all ones keeps only the MCC's bits (0x103),
+with 512 MB the SMC's (0x20000bff). The cases with more than 512 MB
+fail without the patch.
+---
+ tests/qtest/meson.build      |  3 +-
+ tests/qtest/sun4m-ecc-test.c | 95 ++++++++++++++++++++++++++++++++++++
+ 2 files changed, 97 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-ecc-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 73bf137..885331a 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -217,7 +217,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-ledma-test',
+                 'sun4m-ss600mp-test',
+                 'sun4m-dbri-test',
+-                'sun4m-escc-break-test'] + \
++                'sun4m-escc-break-test',
++                'sun4m-ecc-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-ecc-test.c b/tests/qtest/sun4m-ecc-test.c
+new file mode 100644
+index 0000000..cd1e1bc
+--- /dev/null
++++ b/tests/qtest/sun4m-ecc-test.c
+@@ -0,0 +1,95 @@
++/*
++ * QTest: the memory controller version sun4m presents with more than 512 MB
++ *
++ * Bits 31:28 of the ECC memory controller's memory enable register name
++ * the chip: 0 the SS-600MP's MCC, 1 the SS-10's EMC, 2 the SS-20's SMC.
++ * Solaris counts memory above 512 MB as none behind the EMC and SMC,
++ * which decode eight SIMM slots of 64 MB, so with more RAM the SS-10 and
++ * SS-20 present the MCC under OpenBIOS; with 512 MB and less, and under
++ * a Sun PROM, they keep their own chip.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++#define ECC_MER         0xf00000000ULL
++#define MER_IMPL_SHIFT  28
++
++static uint32_t mer_impl(const char *machine, int mb)
++{
++    QTestState *qts = qtest_initf("-machine %s -m %d", machine, mb);
++    uint32_t impl = qtest_readl(qts, ECC_MER) >> MER_IMPL_SHIFT;
++
++    qtest_quit(qts);
++    return impl;
++}
++
++static void test_ss10(void)
++{
++    g_assert_cmpuint(mer_impl("SS-10", 256), ==, 1);
++    g_assert_cmpuint(mer_impl("SS-10", 512), ==, 1);
++    g_assert_cmpuint(mer_impl("SS-10", 576), ==, 0);
++    g_assert_cmpuint(mer_impl("SS-10", 2048), ==, 0);
++}
++
++static void test_ss20(void)
++{
++    g_assert_cmpuint(mer_impl("SS-20", 256), ==, 2);
++    g_assert_cmpuint(mer_impl("SS-20", 512), ==, 2);
++    g_assert_cmpuint(mer_impl("SS-20", 576), ==, 0);
++    g_assert_cmpuint(mer_impl("SS-20", 2048), ==, 0);
++}
++
++/* A Sun PROM (any firmware not named openbios*) keeps the SMC */
++static void test_sun_prom(void)
++{
++    g_autofree char *path = NULL;
++    GError *err = NULL;
++    QTestState *qts;
++    int fd;
++
++    fd = g_file_open_tmp("sun4m-ecc-prom-XXXXXX", &path, &err);
++    g_assert_no_error(err);
++    g_assert_cmpint(write(fd, "\x10\x00\x00\x00", 4), ==, 4);
++    close(fd);
++
++    qts = qtest_initf("-machine SS-20 -m 1024 -bios %s", path);
++    g_assert_cmpuint(qtest_readl(qts, ECC_MER) >> MER_IMPL_SHIFT, ==, 2);
++    qtest_quit(qts);
++    unlink(path);
++}
++
++static void test_ss600mp(void)
++{
++    g_assert_cmpuint(mer_impl("SS-600MP", 256), ==, 0);
++}
++
++/* The MCC keeps only its enable, interrupt and refresh bits in the MER */
++static void test_mcc_mer(void)
++{
++    QTestState *qts = qtest_init("-machine SS-20 -m 1024");
++
++    qtest_writel(qts, ECC_MER, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, ECC_MER), ==, 0x00000103);
++    qtest_quit(qts);
++
++    qts = qtest_init("-machine SS-20 -m 512");
++    qtest_writel(qts, ECC_MER, 0xffffffff);
++    g_assert_cmphex(qtest_readl(qts, ECC_MER), ==, 0x20000bff);
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4m-ecc/ss10", test_ss10);
++    qtest_add_func("sun4m-ecc/ss20", test_ss20);
++    qtest_add_func("sun4m-ecc/sun-prom", test_sun_prom);
++    qtest_add_func("sun4m-ecc/ss600mp", test_ss600mp);
++    qtest_add_func("sun4m-ecc/mcc-mer", test_mcc_mer);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0145-target-sparc-keep-the-SuperSPARC-store-buffer-diagno.patch b/debian/patches/wsh/0145-target-sparc-keep-the-SuperSPARC-store-buffer-diagno.patch
new file mode 100644
index 0000000..de3f43b
--- /dev/null
+++ b/debian/patches/wsh/0145-target-sparc-keep-the-SuperSPARC-store-buffer-diagno.patch
@@ -0,0 +1,287 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] target/sparc: keep the SuperSPARC store buffer diagnostic registers
+
+Sun's SPARCserver 600MP boot PROM loops silently in its power-on self
+test on QEMU. Its store buffer test writes walking ones to the eight
+store buffer tags (ASI 0x30) and data doublewords (ASI 0x31) of the
+SuperSPARC, and to its store buffer control register (ASI 0x32), and
+reads each back. QEMU ignores stores to those ASIs and reads them as 0;
+the PROM's error path then repeats the test for ever (loop on error).
+
+Add the CPU feature "sbuf-diag", set on the TI-SuperSparc-* models. With
+it the registers keep what is written: eight tags at 0x00-0x38 (bits
+42-0, the bits the PROM tests), eight data doublewords and the control
+register (bits 5-0). A word access reads or writes one half of the
+doubleword, the high word at the lower address. There is no store
+buffer behind them; nothing else uses the values. The microSPARC,
+TurboSPARC (whose ASIs 0x30-0x32 are other diagnostics) and LEON models
+are unchanged, and -cpu TI-SuperSparc-II,-sbuf-diag turns it off.
+
+The registers go in a vmstate subsection "cpu/sbuf_diag", sent only
+when one of them is not zero; OpenBIOS and the operating systems don't
+write them, so their streams still load on older QEMU.
+
+With this the PROM passes its store buffer tests and goes on to the
+MXCC registers test.
+---
+ target/sparc/cpu-feature.h.inc |  1 +
+ target/sparc/cpu.c             | 15 ++++---
+ target/sparc/cpu.h             |  9 +++++
+ target/sparc/ldst_helper.c     | 74 ++++++++++++++++++++++++++++++++--
+ target/sparc/machine.c         | 33 +++++++++++++++
+ 5 files changed, 123 insertions(+), 9 deletions(-)
+
+diff --git a/target/sparc/cpu-feature.h.inc b/target/sparc/cpu-feature.h.inc
+index ca8fe3180e..09a7a0dcd2 100644
+--- a/target/sparc/cpu-feature.h.inc
++++ b/target/sparc/cpu-feature.h.inc
+@@ -18,3 +18,4 @@ FEATURE(IMA)
+ FEATURE(VIS4)
+ FEATURE(BUSERR_ACCESS_EXC) /* Bus error on a load or fetch: access exception */
+ FEATURE(BOOT_MODE_IFETCH) /* Boot mode sends fetches to the PROM, MMU on or off */
++FEATURE(SBUF_DIAG) /* SuperSPARC store buffer diagnostic registers */
+diff --git a/target/sparc/cpu.c b/target/sparc/cpu.c
+index 4e7a2e4d8d..e00e1462cc 100644
+--- a/target/sparc/cpu.c
++++ b/target/sparc/cpu.c
+@@ -449,7 +449,7 @@ static const sparc_def_t sparc_defs[] = {
+         .mmu_trcr_mask = 0xffffffff,
+         .nwindows = 8,
+         .features = CPU_DEFAULT_FEATURES | CPU_FEATURE_BUSERR_ACCESS_EXC |
+-                    CPU_FEATURE_BOOT_MODE_IFETCH,
++                    CPU_FEATURE_BOOT_MODE_IFETCH | CPU_FEATURE_SBUF_DIAG,
+     },
+     {
+         .name = "TI-SuperSparc-50", /* STP1020PGA */
+@@ -463,7 +463,7 @@ static const sparc_def_t sparc_defs[] = {
+         .mmu_trcr_mask = 0xffffffff,
+         .nwindows = 8,
+         .features = CPU_DEFAULT_FEATURES | CPU_FEATURE_BUSERR_ACCESS_EXC |
+-                    CPU_FEATURE_BOOT_MODE_IFETCH,
++                    CPU_FEATURE_BOOT_MODE_IFETCH | CPU_FEATURE_SBUF_DIAG,
+     },
+     {
+         .name = "TI-SuperSparc-51",
+@@ -478,7 +478,7 @@ static const sparc_def_t sparc_defs[] = {
+         .mxcc_version = 0x00000104,
+         .nwindows = 8,
+         .features = CPU_DEFAULT_FEATURES | CPU_FEATURE_BUSERR_ACCESS_EXC |
+-                    CPU_FEATURE_BOOT_MODE_IFETCH,
++                    CPU_FEATURE_BOOT_MODE_IFETCH | CPU_FEATURE_SBUF_DIAG,
+     },
+     {
+         .name = "TI-SuperSparc-60", /* STP1020APGA */
+@@ -492,7 +492,7 @@ static const sparc_def_t sparc_defs[] = {
+         .mmu_trcr_mask = 0xffffffff,
+         .nwindows = 8,
+         .features = CPU_DEFAULT_FEATURES | CPU_FEATURE_BUSERR_ACCESS_EXC |
+-                    CPU_FEATURE_BOOT_MODE_IFETCH,
++                    CPU_FEATURE_BOOT_MODE_IFETCH | CPU_FEATURE_SBUF_DIAG,
+     },
+     {
