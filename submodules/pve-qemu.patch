diff --git a/debian/patches/wsh/0173-hw-net-lance-receive-loopback-frames-as-the-Am7990-o.patch b/debian/patches/wsh/0173-hw-net-lance-receive-loopback-frames-as-the-Am7990-o.patch
new file mode 100644
