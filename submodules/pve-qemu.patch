index 0000000..7ec6479
--- /dev/null
+++ b/debian/patches/wsh/0055-hw-sparc-sun4m-take-at-most-128-MB-of-RAM-on-the-mic.patch
@@ -0,0 +1,81 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: take at most 128 MB of RAM on the microSPARC-I machines
+
+-M LX, SPARCClassic and SPARCbook (TI-MicroSparc-I) accept up to 256 MB,
+but with 256 MB OpenBIOS stops with "Trap 0x21": it puts the context
+table near the top of RAM, and QEMU's microSPARC-I keeps only bits 26:8
+of the context table pointer (mmu_ctpr_mask 0x007ffff0), so the MMU
+reads the table from 128 MB lower.
+
+The mask is right. The TMS390S10 (microSPARC-I) reference guide gives
+the context table pointer as "Context Table Pointer [26:08]", 19 bits,
+and says that the memory interface uses 27 bits of the 256 MB memory
+space, "limiting the maximum memory for a microSPARC-based system to
+128MB" (four banks of 32 MB), with the upper 128 MB mirroring the lower.
+
+Add max_ram to the sun4m hwdef, the RAM the machine takes when it is
+less than its memory space (max_mem), and set it to 128 MB for the three
+microSPARC-I machines. The memory space stays 256 MB, so the empty slot
+above RAM and everything the PROMs probe there is as before. -m 256 on
+those machines is now refused ("Too much memory for this machine: 256,
+maximum 128"); 128 MB and less work as before. The other machines are
+unchanged.
+
+Tested: -m 256 refused on LX, SPARCClassic and SPARCbook, and the SS-5
+still takes 256; with 128 MB OpenBIOS reaches its prompt on all three,
+and the LX PROM's POST reports four banks of 32 MB.
+---
+ hw/sparc/sun4m.c | 9 +++++++--
+ 1 file changed, 7 insertions(+), 2 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 44e1009..4e6b368 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -105,6 +105,7 @@ struct sun4m_hwdef {
+     } vsimm[MAX_VSIMMS];
+     hwaddr ecc_base;
+     uint64_t max_mem;
++    uint64_t max_ram;   /* if set: the RAM the memory controller takes */
+     uint32_t ecc_version;
+     uint32_t iommu_version;
+     uint16_t machine_id;
+@@ -869,11 +870,12 @@ static void sun4m_hw_init(MachineState *machine)
+     unsigned int max_cpus = machine->smp.max_cpus;
+     HostMemoryBackend *ram_memdev = machine->memdev;
+     MACAddr hostid;
++    uint64_t max_ram = hwdef->max_ram ? hwdef->max_ram : hwdef->max_mem;
+ 
+-    if (machine->ram_size > hwdef->max_mem) {
++    if (machine->ram_size > max_ram) {
+         error_report("Too much memory for this machine: %" PRId64 ","
+                      " maximum %" PRId64,
+-                     machine->ram_size / MiB, hwdef->max_mem / MiB);
++                     machine->ram_size / MiB, max_ram / MiB);
+         exit(1);
+     }
+ 
+@@ -1441,6 +1443,7 @@ static void ss_lx_class_init(ObjectClass *oc, const void *data)
+         .machine_id = lx_id,
+         .iommu_version = 0x04000000,
+         .max_mem = 0x10000000,
++        .max_ram = 0x08000000, /* microSPARC-I: 128 MB */
+     };
+ 
+     mc->desc = "Sun4m platform, SPARCstation LX";
+@@ -1506,6 +1509,7 @@ static void scls_class_init(ObjectClass *oc, const void *data)
+         .machine_id = scls_id,
+         .iommu_version = 0x05000000,
+         .max_mem = 0x10000000,
++        .max_ram = 0x08000000, /* microSPARC-I: 128 MB */
+     };
+ 
+     mc->desc = "Sun4m platform, SPARCClassic";
+@@ -1538,6 +1542,7 @@ static void sbook_class_init(ObjectClass *oc, const void *data)
+         .machine_id = sbook_id,
+         .iommu_version = 0x05000000,
+         .max_mem = 0x10000000,
++        .max_ram = 0x08000000, /* microSPARC-I: 128 MB */
+     };
+ 
+     mc->desc = "Sun4m platform, SPARCbook";
diff --git a/debian/patches/wsh/0056-hw-sparc-sun4m-map-the-SPARCstation-LX-s-on-board-SB.patch b/debian/patches/wsh/0056-hw-sparc-sun4m-map-the-SPARCstation-LX-s-on-board-SB.patch
new file mode 100644
index 0000000..2589149
--- /dev/null
+++ b/debian/patches/wsh/0056-hw-sparc-sun4m-map-the-SPARCstation-LX-s-on-board-SB.patch
@@ -0,0 +1,74 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: map the SPARCstation LX's on-board SBus devices
+
+The SPARCstation LX has a cgsix (GX) frame buffer in SBus slot 3, the
+DBRI audio chip in slot 2 and a parallel port (bpp) in slot 4, all on
+the board, and its boot PROM (OBP 2.10) carries the FCode for slots 2-4
+and probes them on every boot. -M LX has none of them, so the LX PROM
+stops at "ok" without its banner: with -vga none its slot 2 FCode takes
+a data access error loading the DBRI's FCode PROM (slot 2 offset
+0x1000), and with the default TCX in slot 2 the cgsix probe takes one
+(slot 3, the THC at offset 0x301094: "cgsix Data Access Error"). Past
+those it takes another one after the banner when it resets the DBRI (a
+write to slot 2 offset 0x10000), and NetBSD 9.3 panics in bppattach()
+reading the bpp's DMA CSR at 0x7c800000.
+
+Map them as the SS-20 has its DBRI and bpp: the DBRI at 0x50000000
+(slot 2, with the SS-20's layout: its PROM window at offset 0x1000, its
+registers at 0x10000), the bpp at 0x7c800000 (slot 4 offset 0xc800000),
+and, in a new cg6_base, the cgsix's 16 MB at 0x60000000 (slot 3, the
+size its FCode's "reg" gives), all unimplemented devices. They read as
+zero and ignore writes at the low priority of unimplemented devices, so
+the TCX or cg3 that -M LX puts in slot 2 keeps its addresses. The other
+machines are unchanged.
+
+With this the LX PROM probes every slot, prints its banner and boots
+over ttya with -nographic: Solaris 2.6 and NetBSD 9.3 to a login
+prompt. The cgsix node is there but unused: NetBSD 9.3 attaches cgsix0
+as a second display (rev 0, 1 MB), Solaris 2.6's cgsix driver fails to
+attach, and neither hangs. The DBRI's node has no name yet (the next
+patch). OpenBIOS on -M LX boots as before.
+---
+ hw/sparc/sun4m.c | 15 ++++++++++++++-
+ 1 file changed, 14 insertions(+), 1 deletion(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 4e6b368..a518ffa 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -99,7 +99,7 @@ struct sun4m_hwdef {
+     hwaddr serial_base, fd_base;
+     hwaddr afx_base, idreg_base, dma_base, esp_base, le_base;
+     hwaddr tcx_base, cs_base, apc_base, aux1_base, aux2_base;
+-    hwaddr bpp_base, dbri_base, sx_base;
++    hwaddr bpp_base, dbri_base, sx_base, cg6_base;
+     struct {
+         hwaddr reg_base, vram_base;
+     } vsimm[MAX_VSIMMS];
+@@ -1130,6 +1130,16 @@ static void sun4m_hw_init(MachineState *machine)
+                                     hwdef->dbri_base + 0x10000, 0x100);
+     }
+ 
++    if (hwdef->cg6_base) {
++        /*
++         * The on-board cgsix (GX) of the SPARCstation LX, which has no model
++         * here: its registers and frame buffer, the 16 MB its "reg" gives.
++         * The boot PROM carries its FCode and probes it in every
++         * configuration, and stops at a bus error there.
++         */
++        create_unimplemented_device("sun-cgsix", hwdef->cg6_base, 0x1000000);
++    }
++
+     if (hwdef->bpp_base) {
+         /* parallel port */
+         create_unimplemented_device("sun-bpp", hwdef->bpp_base, 0x20);
+@@ -1439,6 +1449,9 @@ static void ss_lx_class_init(ObjectClass *oc, const void *data)
+         .le_base      = 0x78c00000,
+         .aux1_base    = 0x71900000,
+         .aux2_base    = 0x71910000,
++        .bpp_base     = 0x7c800000, /* SBus slot 4 */
++        .dbri_base    = 0x50000000, /* on-board, SBus slot 2 */
++        .cg6_base     = 0x60000000, /* on-board, SBus slot 3 */
+         .nvram_machine_id = 0x80,
+         .machine_id = lx_id,
+         .iommu_version = 0x04000000,
diff --git a/debian/patches/wsh/0057-hw-sparc-sun4m-give-the-DBRI-an-FCode-PROM-that-make.patch b/debian/patches/wsh/0057-hw-sparc-sun4m-give-the-DBRI-an-FCode-PROM-that-make.patch
new file mode 100644
index 0000000..f480f1a
--- /dev/null
+++ b/debian/patches/wsh/0057-hw-sparc-sun4m-give-the-DBRI-an-FCode-PROM-that-make.patch
@@ -0,0 +1,131 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: give the DBRI an FCode PROM that makes its node
+
+The DBRI has an FCode PROM of its own at offset 0x1000 of its slot, and
+the boot PROMs of the SPARCstation LX, SS-10 and SS-20 load it when they
+probe the slot (the LX's FCode for slot 2 maps 0x40 bytes at that offset
+and byte-loads them). QEMU has an unimplemented device there that reads
+0, so the PROMs make the DBRI's node without a "name" ("<Unnamed>" in
+"ls") or "reg", and kernels that walk all nodes panic on it: SunOS
+4.1.4 on the LX ("BAD TRAP: cpu=0 type=9 ... kernel read fault at
+addr=0x0" in its autoconfiguration), and Solaris 2.1 and 2.2 on the
+SS-20 with its Sun PROM. With only a name, SunOS 4.1.4's GENERIC kernel
+still panics the same way in its dbri driver.
+
+Answer that window with a small FCode program that makes the node a DBRI
+has: name "SUNW,DBRIe", "reg" at offset 0x10000 of the slot (the
+register stub, 0x100 bytes), and its interrupt at SBus level 5 (the PROM
+turns that into "intr" 0x39, processor level 9). There is still no DBRI
+behind the registers: the drivers read zeros and go without sound
+(SunOS 4.1.4: "dbri: DBRI Reg8 bad!", "Audio: no Audio device found").
+The window is 0x40 bytes (it was 0x30), the size the LX PROM maps, and
+it lies below a frame buffer that -vga puts in the same slot (the LX's
+TCX or cg3, whose ROM covers offset 0x1000), like the unimplemented
+devices.
+
+With this the LX PROM prints "SUNW,DBRIe mmcodec" for slot 2, as a real
+LX does, SunOS 4.1.4 installs on the LX and boots, and Solaris 2.2's CD
+reaches its installer on the SS-20 under its Sun PROM.
+---
+ hw/sparc/sun4m.c | 74 ++++++++++++++++++++++++++++++++++++++++++++++--
+ 1 file changed, 72 insertions(+), 2 deletions(-)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index a518ffa..4c9e49f 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -49,6 +49,7 @@
+ #include "hw/char/escc.h"
+ #include "hw/misc/empty_slot.h"
+ #include "hw/misc/unimp.h"
++#include "system/address-spaces.h"
+ #include "hw/core/irq.h"
+ #include "hw/core/or-irq.h"
+ #include "hw/core/loader.h"
+@@ -845,6 +846,69 @@ static DeviceState *cpu_devinit(const char *cpu_type, unsigned int id,
+     return cpudev;
+ }
+ 
++/*
++ * The DBRI's own FCode PROM, which the boot PROMs of the SS-10, SS-20 and
++ * LX load from offset 0x1000 of its slot. Without FCode there they make
++ * the DBRI's SBus node without a "name", and SunOS 4 and Solaris 2.1 and
++ * 2.2 panic on it. This FCode makes the node a DBRI has: its name, its
++ * registers at offset 0x10000 and its interrupt at SBus level 5. With no
++ * DBRI behind the registers the drivers find no codec and go without
++ * sound.
++ */
++static const uint8_t dbri_fcode[] = {
++    0xf1, 0x08,                     /* start1, format */
++    0x06, 0x28,                     /* checksum of the bytes after the header */
++    0x00, 0x00, 0x00, 0x38,         /* length, with the header */
++    /* " SUNW,DBRIe" encode-string " name" property */
++    0x12, 0x0a, 'S', 'U', 'N', 'W', ',', 'D', 'B', 'R', 'I', 'e',
++    0x01, 0x14,
++    0x12, 0x04, 'n', 'a', 'm', 'e',
++    0x01, 0x10,
++    /* my-address 10000 + my-space 100 reg */
++    0x01, 0x02,
++    0x10, 0x00, 0x01, 0x00, 0x00,
++    0x1e,
++    0x01, 0x03,
++    0x10, 0x00, 0x00, 0x01, 0x00,
++    0x01, 0x16,
++    /* 5 0 intr */
++    0x10, 0x00, 0x00, 0x00, 0x05,
++    0xa5,
++    0x01, 0x17,
++    0x00,                           /* end0 */
++};
++
++#define DBRI_PROM_SIZE 0x40
++
++static uint64_t dbri_prom_read(void *opaque, hwaddr addr, unsigned size)
++{
++    uint64_t val = 0;
++    unsigned i;
++
++    for (i = 0; i < size; i++) {
++        val <<= 8;
++        if (addr + i < sizeof(dbri_fcode)) {
++            val |= dbri_fcode[addr + i];
++        }
++    }
++    return val;
++}
++
++static void dbri_prom_write(void *opaque, hwaddr addr, uint64_t val,
++                            unsigned size)
++{
++}
++
++static const MemoryRegionOps dbri_prom_ops = {
++    .read = dbri_prom_read,
++    .write = dbri_prom_write,
++    .endianness = DEVICE_BIG_ENDIAN,
++    .valid = {
++        .min_access_size = 1,
++        .max_access_size = 4,
++    },
++};
++
+ static void dummy_fdc_tc(void *opaque, int irq, int level)
+ {
+ }
+@@ -1123,8 +1187,14 @@ static void sun4m_hw_init(MachineState *machine)
+     if (hwdef->dbri_base) {
+         /* ISDN chip with attached CS4215 audio codec */
+         /* prom space */
+-        create_unimplemented_device("sun-DBRI.prom",
+-                                    hwdef->dbri_base + 0x1000, 0x30);
++        MemoryRegion *dbri_prom = g_new(MemoryRegion, 1);
++
++        memory_region_init_io(dbri_prom, NULL, &dbri_prom_ops, NULL,
++                              "sun-DBRI.prom", DBRI_PROM_SIZE);
++        /* below a frame buffer that -vga puts in the same slot (LX) */
++        memory_region_add_subregion_overlap(get_system_memory(),
++                                            hwdef->dbri_base + 0x1000,
++                                            dbri_prom, -1000);
+         /* reg space */
+         create_unimplemented_device("sun-DBRI",
+                                     hwdef->dbri_base + 0x10000, 0x100);
diff --git a/debian/patches/wsh/0058-tests-qtest-test-the-on-board-SBus-devices-of-sun4m.patch b/debian/patches/wsh/0058-tests-qtest-test-the-on-board-SBus-devices-of-sun4m.patch
new file mode 100644
index 0000000..85e2603
--- /dev/null
+++ b/debian/patches/wsh/0058-tests-qtest-test-the-on-board-SBus-devices-of-sun4m.patch
@@ -0,0 +1,169 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the on-board SBus devices of sun4m
+
+qtest sun4m-onboard-sbus-test for the two patches before: on -M LX the
+cgsix, DBRI and bpp regions are where the LX's slots 2-4 have them, at
+the low priority, and the default TCX's ROM stays above them; the SS-5
+has none of them; the DBRI's FCode PROM on the LX and the SS-20 has a
+valid FCode header, checksum and length, the name and no "reg", reads
+0 past its end and big-endian in wider reads.
+---
+ tests/qtest/meson.build               |   3 +-
+ tests/qtest/sun4m-onboard-sbus-test.c | 134 ++++++++++++++++++++++++++
+ 2 files changed, 136 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-onboard-sbus-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 8c1485b..874f4bd 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -210,7 +210,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-esp-test',
+                 'sun4m-mmu-ctx-ifetch-test',
+                 'sun4m-bus-error-trap-test',
+-                'sun4m-fp-deferred-trap-test'] + \
++                'sun4m-fp-deferred-trap-test',
++                'sun4m-onboard-sbus-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-onboard-sbus-test.c b/tests/qtest/sun4m-onboard-sbus-test.c
+new file mode 100644
+index 0000000..e265f35
+--- /dev/null
++++ b/tests/qtest/sun4m-onboard-sbus-test.c
+@@ -0,0 +1,134 @@
++/*
++ * QTest: the on-board SBus devices of sun4m machines without a model
++ *
++ * The SPARCstation LX has a cgsix in SBus slot 3, the DBRI in slot 2 and
++ * a parallel port (bpp) in slot 4, all on the board; its boot PROM
++ * carries their FCode and probes them on every boot. They are
++ * unimplemented devices (reads 0, writes ignored) at a low priority, so
++ * that a frame buffer that -vga puts in slot 2 keeps its addresses.
++ *
++ * The DBRI (LX, SS-10, SS-20) has its own FCode PROM at offset 0x1000 of
++ * its slot, which the Sun boot PROMs load: an FCode program that gives
++ * the node its name, its registers at offset 0x10000 of the slot and its
++ * interrupt at SBus level 5. The test checks its header, checksum, length
++ * and program, and that the rest of the window reads 0.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/bswap.h"
++
++#define DBRI_PROM_SIZE  0x40
++
++typedef struct {
++    const char *machine;
++    uint64_t dbri_prom;
++} DbriCase;
++
++static const DbriCase lx = { "LX", 0x50001000ULL };
++static const DbriCase ss20 = { "SS-20", 0xee0001000ULL };
++
++/* "info mtree" has a line "<range> (<prio>, <kind>): <name>" */
++static bool has_region(const char *mtree, const char *range, const char *prio,
++                       const char *name)
++{
++    g_autofree char *want = g_strdup_printf("%s (%s): %s", range, prio, name);
++    g_auto(GStrv) lines = g_strsplit(mtree, "\n", -1);
++    int i;
++
++    for (i = 0; lines[i]; i++) {
++        if (!strcmp(g_strstrip(lines[i]), want)) {
++            return true;
++        }
++    }
++    return false;
++}
++
++static void check_line(const char *mtree, const char *range, const char *name)
++{
++    g_assert_true(has_region(mtree, range, "prio -1000, i/o", name));
++}
++
++static void test_lx_regions(void)
++{
++    QTestState *qts = qtest_init("-machine LX -m 64");
++    g_autofree char *mtree = qtest_hmp(qts, "info mtree");
++
++    check_line(mtree, "0000000060000000-0000000060ffffff", "sun-cgsix");
++    check_line(mtree, "0000000050010000-00000000500100ff", "sun-DBRI");
++    check_line(mtree, "0000000050001000-000000005000103f", "sun-DBRI.prom");
++    check_line(mtree, "000000007c800000-000000007c80001f", "sun-bpp");
++    /* the TCX that -M LX has by default stays in slot 2, above them */
++    g_assert_true(has_region(mtree, "0000000050000000-000000005000ffff",
++                             "prio 0, rom", "tcx.prom"));
++    g_assert_cmphex(qtest_readl(qts, 0x60301818ULL), ==, 0);
++    qtest_quit(qts);
++}
++
++static void test_ss5_unchanged(void)
++{
++    QTestState *qts = qtest_init("-machine SS-5 -m 64");
++    g_autofree char *mtree = qtest_hmp(qts, "info mtree");
++
++    g_assert_null(strstr(mtree, "sun-cgsix"));
++    g_assert_null(strstr(mtree, "sun-DBRI"));
++    g_assert_null(strstr(mtree, "sun-bpp"));
++    qtest_quit(qts);
++}
++
++static void test_dbri_fcode(const void *data)
++{
++    const DbriCase *c = data;
++    QTestState *qts = qtest_initf("-machine %s -m 64 -vga none", c->machine);
++    uint8_t prom[DBRI_PROM_SIZE];
++    uint32_t len, sum = 0, i;
++    /*
++     * " SUNW,DBRIe" encode-string " name" property
++     * my-address 10000 + my-space 100 reg   5 0 intr   end0
++     */
++    static const uint8_t fcode[] = {
++        0x12, 0x0a, 'S', 'U', 'N', 'W', ',', 'D', 'B', 'R', 'I', 'e',
++        0x01, 0x14, 0x12, 0x04, 'n', 'a', 'm', 'e', 0x01, 0x10,
++        0x01, 0x02, 0x10, 0x00, 0x01, 0x00, 0x00, 0x1e,
++        0x01, 0x03, 0x10, 0x00, 0x00, 0x01, 0x00, 0x01, 0x16,
++        0x10, 0x00, 0x00, 0x00, 0x05, 0xa5, 0x01, 0x17,
++        0x00,
++    };
++
++    for (i = 0; i < DBRI_PROM_SIZE; i++) {
++        prom[i] = qtest_readb(qts, c->dbri_prom + i);
++    }
++    /* FCode header: start1, format, checksum, length */
++    g_assert_cmphex(prom[0], ==, 0xf1);
++    g_assert_cmphex(prom[1], ==, 0x08);
++    len = (uint32_t)ldl_be_p(&prom[4]);
++    g_assert_cmpuint(len, ==, 8 + sizeof(fcode));
++    for (i = 8; i < len; i++) {
++        sum += prom[i];
++    }
++    g_assert_cmphex(sum & 0xffff, ==, lduw_be_p(&prom[2]));
++    g_assert_cmpmem(&prom[8], len - 8, fcode, sizeof(fcode));
++    for (i = len; i < DBRI_PROM_SIZE; i++) {
++        g_assert_cmphex(prom[i], ==, 0);
++    }
++    /* wider reads are big-endian */
++    g_assert_cmphex(qtest_readl(qts, c->dbri_prom), ==,
++                    (uint32_t)ldl_be_p(prom));
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4m-onboard-sbus/lx/regions", test_lx_regions);
++    qtest_add_func("sun4m-onboard-sbus/ss5/unchanged", test_ss5_unchanged);
++    qtest_add_data_func("sun4m-onboard-sbus/lx/dbri-fcode", &lx,
++                        test_dbri_fcode);
++    qtest_add_data_func("sun4m-onboard-sbus/ss20/dbri-fcode", &ss20,
++                        test_dbri_fcode);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0059-hw-rtc-m48t59-keep-the-NVRAM-in-a-drive-and-leave-it.patch b/debian/patches/wsh/0059-hw-rtc-m48t59-keep-the-NVRAM-in-a-drive-and-leave-it.patch
new file mode 100644
index 0000000..c84c040
--- /dev/null
+++ b/debian/patches/wsh/0059-hw-rtc-m48t59-keep-the-NVRAM-in-a-drive-and-leave-it.patch
@@ -0,0 +1,277 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/rtc/m48t59: keep the NVRAM in a drive, and leave it on sun4m
+
+The sun4m machines write OpenBIOS's NVRAM layout (a CHRP system
+partition with the -prom-env variables, a free partition and the Sun
+IDPROM) into the M48T08 at every start. Sun's own boot PROMs (the SS-5,
+SS-20 and LX PROMs) keep their configuration in the same bytes, find
+the checksum wrong, write their defaults, set diag-switch? and so boot
+diag-device (net) and stop at "ok" on every power-on; a real machine
+keeps what "setenv diag-switch? false" or "setenv auto-boot? true"
+stored.
+
+Give the sysbus M48Txx a "drive" property for its NVRAM bytes (not
+the clock registers): the image is read at realize, and every byte the
+guest changes is written through. The image must hold at least the
+NVRAM; its first bytes are used, the rest is left alone. A read-only
+image is loaded and not written. A blank (all-zero) image leaves the
+NVRAM as before, so the board writes its default contents, which then
+go to the image; any other image is the NVRAM as the guest left it.
+
+On sun4m, nvram_init() then leaves such a restored NVRAM alone and
+writes only the IDPROM, which is the machine's identity and comes from
+the command line (machine type, the NIC's MAC address) on every start;
+the Sun PROMs' configuration checksum does not cover it. With
+-prom-env the OpenBIOS partitions are written on every start as
+before, so -prom-env applies as without an image. The M48T08 gets the
+fixed QOM path /machine/nvram, by which query-block names the device
+of its drive. Without a drive nothing changes.
+
+    -drive if=none,id=nvram0,format=raw,file=nvram.raw
+    -global sysbus-m48t08.drive=nvram0
+
+With an 8 KB blank image and the LX PROM, "setenv diag-switch? false"
+at the first start makes the next start boot the disk by itself
+(Solaris 2.6 to its login prompt), also with another MAC address.
+---
+ hw/rtc/m48t59-internal.h |   5 ++
+ hw/rtc/m48t59.c          | 101 +++++++++++++++++++++++++++++++++++++--
+ hw/sparc/sun4m.c         |  19 +++++++-
+ include/hw/rtc/m48t59.h  |   7 +++
+ 4 files changed, 125 insertions(+), 7 deletions(-)
+
+diff --git a/hw/rtc/m48t59-internal.h b/hw/rtc/m48t59-internal.h
+index cd64824..65799e4 100644
+--- a/hw/rtc/m48t59-internal.h
++++ b/hw/rtc/m48t59-internal.h
+@@ -58,6 +58,11 @@ typedef struct M48t59State {
+     /* NVRAM storage */
+     uint16_t addr;
+     uint8_t  lock;
++    /* Backing store of the NVRAM bytes (not the clock registers) */
++    BlockBackend *blk;
++    bool blk_ro;
++    /* The NVRAM bytes came from a backing store that wasn't blank */
++    bool restored;
+ } M48t59State;
+ 
+ uint32_t m48t59_read(M48t59State *NVRAM, uint32_t addr);
+diff --git a/hw/rtc/m48t59.c b/hw/rtc/m48t59.c
+index be4196b..6730479 100644
+--- a/hw/rtc/m48t59.c
++++ b/hw/rtc/m48t59.c
+@@ -26,7 +26,10 @@
+ #include "qemu/osdep.h"
+ #include "hw/core/irq.h"
+ #include "hw/core/qdev-properties.h"
++#include "hw/core/qdev-properties-system.h"
+ #include "hw/rtc/m48t59.h"
++#include "system/block-backend.h"
++#include "qemu/error-report.h"
+ #include "qemu/timer.h"
+ #include "system/runstate.h"
+ #include "system/rtc.h"
+@@ -186,6 +189,31 @@ static void set_up_watchdog(M48t59State *NVRAM, uint8_t value)
+     }
+ }
+ 
++/* The number of NVRAM bytes below the clock registers */
++static uint32_t m48t59_nvram_bytes(M48t59State *NVRAM)
++{
++    switch (NVRAM->model) {
++    case 2:
++        return 0x7f8;
++    case 8:
++        return 0x1ff8;
++    default:
++        return 0x1ff0;
++    }
++}
++
++/* Write one changed NVRAM byte through to the backing store */
++static void m48t59_store(M48t59State *NVRAM, uint32_t addr)
++{
++    if (!NVRAM->blk || NVRAM->blk_ro) {
++        return;
++    }
++    if (blk_pwrite(NVRAM->blk, addr, 1, &NVRAM->buffer[addr], 0) < 0) {
++        error_report("%s: write of NVRAM data to backing store failed",
++                     blk_name(NVRAM->blk));
++    }
++}
++
+ /* Direct access to NVRAM */
+ void m48t59_write(M48t59State *NVRAM, uint32_t addr, uint32_t val)
+ {
+@@ -195,10 +223,12 @@ void m48t59_write(M48t59State *NVRAM, uint32_t addr, uint32_t val)
+     trace_m48txx_nvram_mem_write(addr, val);
+ 
+     /* check for NVRAM access */
+-    if ((NVRAM->model == 2 && addr < 0x7f8) ||
+-        (NVRAM->model == 8 && addr < 0x1ff8) ||
+-        (NVRAM->model == 59 && addr < 0x1ff0)) {
+-        goto do_write;
++    if (addr < m48t59_nvram_bytes(NVRAM)) {
++        if (NVRAM->buffer[addr] != (val & 0xFF)) {
++            NVRAM->buffer[addr] = val & 0xFF;
++            m48t59_store(NVRAM, addr);
++        }
++        return;
+     }
+ 
+     /* TOD access */
+@@ -343,7 +373,6 @@ void m48t59_write(M48t59State *NVRAM, uint32_t addr, uint32_t val)
+             break;
+         if (addr >= 0x30 && addr <= 0x3F && (NVRAM->lock & 2))
+             break;
+-    do_write:
+         if (addr < NVRAM->size) {
+             NVRAM->buffer[addr] = val & 0xFF;
+         }
+@@ -573,6 +602,66 @@ void m48t59_realize_common(M48t59State *s, Error **errp)
+     qemu_get_timedate(&s->alarm, 0);
+ }
+ 
++/*
++ * Load the NVRAM bytes from the backing store, if there is one. The
++ * image must hold at least the NVRAM; its first bytes are used. A blank
++ * (all-zero) image leaves the NVRAM as QEMU starts it, and the board then
++ * writes its default contents, which go through to the image; any other
++ * image is the NVRAM as the guest left it (s->restored). The clock
++ * registers at the end are never loaded or stored. A read-only image is
++ * loaded but not written.
++ */
++static void m48t59_load_backing_store(M48t59State *s, Error **errp)
++{
++    uint32_t len = m48t59_nvram_bytes(s);
++    int64_t blk_len;
++    uint32_t i;
++
++    if (!s->blk) {
++        return;
++    }
++
++    s->blk_ro = !blk_supports_write_perm(s->blk);
++    if (blk_set_perm(s->blk, BLK_PERM_CONSISTENT_READ |
++                     (s->blk_ro ? 0 : BLK_PERM_WRITE),
++                     BLK_PERM_ALL, errp) < 0) {
++        return;
++    }
++
++    blk_len = blk_getlength(s->blk);
++    if (blk_len < 0) {
++        error_setg_errno(errp, -blk_len,
++                         "could not get the length of the NVRAM image");
++        return;
++    }
++    if (blk_len < s->size) {
++        error_setg(errp, "the NVRAM image has %" PRId64 " bytes, the "
++                   "NVRAM needs %" PRIu32, blk_len, s->size);
++        return;
++    }
++    if (blk_pread(s->blk, 0, len, s->buffer, 0) < 0) {
++        error_setg(errp, "could not read the NVRAM image");
++        return;
++    }
++
++    for (i = 0; i < len; i++) {
++        if (s->buffer[i]) {
++            s->restored = true;
++            break;
++        }
++    }
++}
++
++bool m48t59_nvram_restored(Nvram *nvram)
++{
++    Object *obj = OBJECT(nvram);
++
++    if (!object_dynamic_cast(obj, TYPE_M48TXX_SYS_BUS)) {
++        return false;
++    }
++    return M48TXX_SYS_BUS(obj)->state.restored;
++}
++
+ static void m48t59_init1(Object *obj)
+ {
+     M48txxSysBusDeviceClass *u = M48TXX_SYS_BUS_GET_CLASS(obj);
+@@ -598,6 +687,7 @@ static void m48t59_realize(DeviceState *dev, Error **errp)
+     sysbus_init_mmio(sbd, &s->iomem);
+     sysbus_init_mmio(sbd, &d->io);
+     m48t59_realize_common(s, errp);
++    m48t59_load_backing_store(s, errp);
+ }
+ 
+ static uint32_t m48txx_sysbus_read(Nvram *obj, uint32_t addr)
+@@ -620,6 +710,7 @@ static void m48txx_sysbus_toggle_lock(Nvram *obj, int lock)
+ 
+ static const Property m48t59_sysbus_properties[] = {
+     DEFINE_PROP_INT32("base-year", M48txxSysBusState, state.base_year, 0),
++    DEFINE_PROP_DRIVE("drive", M48txxSysBusState, state.blk),
+ };
+ 
+ static void m48txx_sysbus_class_init(ObjectClass *klass, const void *data)
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 4c9e49f..faa372c 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -155,11 +155,24 @@ static void nvram_init(Nvram *nvram, uint8_t *macaddr,
+                        int width, int height, int depth,
+                        int nvram_machine_id, const char *arch)
+ {
+-    unsigned int i;
++    unsigned int i, start;
+     int sysp_end;
+     uint8_t image[0x1ff0];
+     NvramClass *k = NVRAM_GET_CLASS(nvram);
+ 
++    /*
++     * An NVRAM kept in an image (the M48T08's "drive") that isn't blank
++     * holds what the firmware left there: a Sun PROM's own configuration,
++     * or OpenBIOS's variables. Leave it, and write only the IDPROM, the
++     * machine's identity, which comes from the command line (machine type,
++     * MAC address) on every start. With -prom-env the OpenBIOS partitions
++     * are written on every start too, as without an image.
++     */
++    start = 0;
++    if (m48t59_nvram_restored(nvram) && nb_prom_envs == 0) {
++        start = 0x1fd8;
++    }
++
+     memset(image, '\0', sizeof(image));
+ 
+     /* OpenBIOS nvram variables partition */
+@@ -171,7 +184,7 @@ static void nvram_init(Nvram *nvram, uint8_t *macaddr,
+     Sun_init_header((struct Sun_nvram *)&image[0x1fd8], macaddr,
+                     nvram_machine_id);
+ 
+-    for (i = 0; i < sizeof(image); i++) {
++    for (i = start; i < sizeof(image); i++) {
+         (k->write)(nvram, i, image[i]);
+     }
+ }
+@@ -1096,6 +1109,8 @@ static void sun4m_hw_init(MachineState *machine)
+ 
+     dev = qdev_new("sysbus-m48t08");
+     qdev_prop_set_int32(dev, "base-year", 1968);
++    /* a fixed path, by which query-block names the device of its drive */
++    object_property_add_child(OBJECT(machine), "nvram", OBJECT(dev));
+     s = SYS_BUS_DEVICE(dev);
+     sysbus_realize_and_unref(s, &error_fatal);
+     sysbus_connect_irq(s, 0, slavio_irq[0]);
+diff --git a/include/hw/rtc/m48t59.h b/include/hw/rtc/m48t59.h
+index c149374..9955d0f 100644
+--- a/include/hw/rtc/m48t59.h
++++ b/include/hw/rtc/m48t59.h
+@@ -47,4 +47,11 @@ struct NvramClass {
+     void (*toggle_lock)(Nvram *obj, int lock);
+ };
+ 
++/*
++ * True if the NVRAM of a sysbus M48Txx was loaded from a backing store
++ * (its "drive" property) that wasn't blank: the board must not write its
++ * default contents over it.
++ */
++bool m48t59_nvram_restored(Nvram *nvram);
++
+ #endif /* HW_RTC_M48T59_H */
diff --git a/debian/patches/wsh/0060-tests-qtest-test-the-sun4m-NVRAM-kept-in-a-drive.patch b/debian/patches/wsh/0060-tests-qtest-test-the-sun4m-NVRAM-kept-in-a-drive.patch
new file mode 100644
index 0000000..a8d99d3
--- /dev/null
+++ b/debian/patches/wsh/0060-tests-qtest-test-the-sun4m-NVRAM-kept-in-a-drive.patch
@@ -0,0 +1,385 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the sun4m NVRAM kept in a drive
+
+qtest sun4m-nvram-test for the patch before, on the SS-5: without a
+drive the NVRAM gets OpenBIOS's layout and the IDPROM as before; a
+blank image gets the same contents and keeps them; an image with other
+contents is left alone across two starts, the guest's writes reach it,
+the clock registers are not stored and the IDPROM follows the NIC's
+MAC address; -prom-env writes OpenBIOS's partitions over it; a larger
+image keeps the bytes past the NVRAM; the drive attached with -blockdev
+by node name works and query-block names the device /machine/nvram;
+a read-only image is loaded and not written.
+---
+ tests/qtest/meson.build        |   3 +-
+ tests/qtest/sun4m-nvram-test.c | 347 +++++++++++++++++++++++++++++++++
+ 2 files changed, 349 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-nvram-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 874f4bd..054b26b 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -211,7 +211,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-mmu-ctx-ifetch-test',
+                 'sun4m-bus-error-trap-test',
+                 'sun4m-fp-deferred-trap-test',
+-                'sun4m-onboard-sbus-test'] + \
++                'sun4m-onboard-sbus-test',
++                'sun4m-nvram-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-nvram-test.c b/tests/qtest/sun4m-nvram-test.c
+new file mode 100644
+index 0000000..070d57a
+--- /dev/null
++++ b/tests/qtest/sun4m-nvram-test.c
+@@ -0,0 +1,347 @@
++/*
++ * QTest: the sun4m NVRAM kept in an image
++ *
++ * The M48T08 of the sun4m machines takes a "drive" for its NVRAM. A blank
++ * image gets the contents QEMU writes without one (OpenBIOS's partitions
++ * and the IDPROM); an image that isn't blank is the NVRAM as the guest
++ * left it, which QEMU doesn't overwrite, except the IDPROM, which comes
++ * from the command line on every start, and OpenBIOS's partitions when
++ * -prom-env is given. The guest's writes go through to the image; the
++ * clock registers at the end are never stored.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++#include "qemu/cutils.h"
++#include "qobject/qdict.h"
++#include "qobject/qlist.h"
++
++#define NVRAM_BASE      0x71200000ULL   /* SS-5 */
++#define NVRAM_SIZE      0x2000
++#define CLOCK_REGS      0x1ff8          /* M48T08: clock from here on */
++#define IDPROM          0x1fd8
++#define IDPROM_LEN      16
++#define MAC_A           "08:00:20:12:34:56"
++#define MAC_B           "bc:24:11:00:00:07"
++
++/* Bytes a Sun PROM could leave in the NVRAM: no OpenBIOS partition */
++#define SUN_CHECKSUM    0x5a
++#define SUN_DIAG        0x1
++#define SUN_AUTO_BOOT   0x2a7
++#define SUN_BOOT_DEVICE 0x2a8
++
++static char *make_image(size_t size, const uint8_t *data)
++{
++    char *path;
++    int fd;
++
++    fd = g_file_open_tmp("sun4m-nvram-XXXXXX.raw", &path, NULL);
++    g_assert(fd >= 0);
++    if (data) {
++        g_assert_cmpint(write(fd, data, size), ==, size);
++    } else {
++        g_assert_cmpint(ftruncate(fd, size), ==, 0);
++    }
++    close(fd);
++    return path;
++}
++
++static void read_image(const char *path, uint8_t *buf)
++{
++    gchar *contents;
++    gsize len;
++
++    g_assert(g_file_get_contents(path, &contents, &len, NULL));
++    g_assert_cmpuint(len, ==, NVRAM_SIZE);
++    memcpy(buf, contents, NVRAM_SIZE);
++    g_free(contents);
++}
++
++static QTestState *start(const char *path, const char *mac, const char *extra)
++{
++    return qtest_initf("-M SS-5 -nodefaults -net nic,model=lance,macaddr=%s "
++                       "-drive if=none,id=nvram0,format=raw,file=%s "
++                       "-global sysbus-m48t08.drive=nvram0 %s",
++                       mac, path, extra ? extra : "");
++}
++
++static void read_nvram(QTestState *qts, uint8_t *buf, int start, int len)
++{
++    int i;
++
++    for (i = 0; i < len; i++) {
++        buf[i] = qtest_readb(qts, NVRAM_BASE + start + i);
++    }
++}
++
++/* The IDPROM at `idprom` is valid and carries `mac` */
++static void check_idprom(const uint8_t *idprom, const char *mac)
++{
++    uint8_t sum = 0;
++    char got[18];
++    int i;
++
++    snprintf(got, sizeof(got), "%02x:%02x:%02x:%02x:%02x:%02x",
++             idprom[2], idprom[3], idprom[4], idprom[5], idprom[6], idprom[7]);
++    g_assert_cmpstr(got, ==, mac);
++    g_assert_cmphex(idprom[0], ==, 0x01);               /* format */
++    g_assert_cmphex(idprom[1], ==, 0x80);               /* SS-5 */
++    g_assert_cmpmem(&idprom[12], 3, &idprom[5], 3);     /* host id serial */
++    for (i = 0; i < IDPROM_LEN - 1; i++) {
++        sum ^= idprom[i];
++    }
++    g_assert_cmphex(idprom[15], ==, sum);
++}
++
++/* OpenBIOS's system partition with `var` (or none) at the start of `buf` */
++static void check_openbios_layout(const uint8_t *buf, const char *var)
++{
++    g_assert_cmphex(buf[0], ==, 0x70);
++    g_assert_cmpstr((const char *)&buf[4], ==, "system");
++    if (var) {
++        g_assert_cmpstr((const char *)&buf[16], ==, var);
++    } else {
++        g_assert_cmphex(buf[16], ==, 0);
++    }
++}
++
++/* What a Sun PROM's configuration looks like after `setenv`s */
++static void sun_contents(uint8_t *buf)
++{
++    memset(buf, 0, NVRAM_SIZE);
++    buf[0] = SUN_CHECKSUM;
++    buf[SUN_DIAG] = 0x00;
++    buf[SUN_AUTO_BOOT] = 0xff;
++    buf[SUN_BOOT_DEVICE] = 4;
++    memcpy(&buf[SUN_BOOT_DEVICE + 1], "disk", 4);
++}
++
++/* A blank image gets QEMU's contents, as without one, and keeps them */
++static void test_blank(void)
++{
++    uint8_t live[NVRAM_SIZE], file[NVRAM_SIZE];
++    char *path = make_image(NVRAM_SIZE, NULL);
++    QTestState *qts;
++
++    qts = start(path, MAC_A, NULL);
++    read_nvram(qts, live, 0, CLOCK_REGS);
++    qtest_quit(qts);
++
++    check_openbios_layout(live, NULL);
++    check_idprom(&live[IDPROM], MAC_A);
++
++    read_image(path, file);
++    g_assert_cmpmem(file, CLOCK_REGS, live, CLOCK_REGS);
++    g_assert_true(buffer_is_zero(&file[CLOCK_REGS], NVRAM_SIZE - CLOCK_REGS));
++
++    unlink(path);
++    g_free(path);
++}
++
++/*
++ * What the guest wrote is there at the next start, QEMU doesn't write its
++ * contents over it, and the IDPROM follows the NIC's MAC address.
++ */
++static void test_persist(void)
++{
++    uint8_t sun[NVRAM_SIZE], live[NVRAM_SIZE], file[NVRAM_SIZE];
++    char *path;
++    QTestState *qts;
++
++    sun_contents(sun);
++    path = make_image(NVRAM_SIZE, sun);
++
++    /* first start: the Sun bytes stay, the guest changes one */
++    qts = start(path, MAC_A, NULL);
++    read_nvram(qts, live, 0, IDPROM);
++    g_assert_cmpmem(live, IDPROM, sun, IDPROM);
++    read_nvram(qts, live, IDPROM, IDPROM_LEN);
++    check_idprom(live, MAC_A);
++    qtest_writeb(qts, NVRAM_BASE + SUN_DIAG, 0xff);
++    qtest_writeb(qts, NVRAM_BASE + 0x1ff9, 0x80);       /* clock: stop */
++    qtest_quit(qts);
++
++    read_image(path, file);
++    g_assert_cmphex(file[SUN_DIAG], ==, 0xff);
++    check_idprom(&file[IDPROM], MAC_A);
++    g_assert_true(buffer_is_zero(&file[CLOCK_REGS], NVRAM_SIZE - CLOCK_REGS));
++
++    /* second start, another MAC address: only the IDPROM changes */
++    qts = start(path, MAC_B, NULL);
++    read_nvram(qts, live, 0, IDPROM);
++    sun[SUN_DIAG] = 0xff;
++    g_assert_cmpmem(live, IDPROM, sun, IDPROM);
++    read_nvram(qts, live, IDPROM, IDPROM_LEN);
++    check_idprom(live, MAC_B);
++    qtest_quit(qts);
++
++    read_image(path, file);
++    g_assert_cmpmem(file, IDPROM, sun, IDPROM);
++    check_idprom(&file[IDPROM], MAC_B);
++
++    unlink(path);
++    g_free(path);
++}
++
++/* -prom-env writes OpenBIOS's partitions on every start, image or not */
++static void test_prom_env(void)
++{
++    uint8_t sun[NVRAM_SIZE], live[NVRAM_SIZE], file[NVRAM_SIZE];
++    char *path;
++    QTestState *qts;
++
++    sun_contents(sun);
++    path = make_image(NVRAM_SIZE, sun);
++
++    qts = start(path, MAC_A, "-prom-env auto-boot?=false");
++    read_nvram(qts, live, 0, CLOCK_REGS);
++    qtest_quit(qts);
++
++    check_openbios_layout(live, "auto-boot?=false");
++    check_idprom(&live[IDPROM], MAC_A);
++    read_image(path, file);
++    g_assert_cmpmem(file, CLOCK_REGS, live, CLOCK_REGS);
++
++    unlink(path);
++    g_free(path);
++}
++
++/* A larger image: its first 8 KB are the NVRAM, the rest is left alone */
++static void test_larger_image(void)
++{
++    uint8_t *big = g_malloc0(2 * NVRAM_SIZE);
++    uint8_t live[NVRAM_SIZE];
++    gchar *contents;
++    gsize len;
++    char *path;
++    QTestState *qts;
++
++    sun_contents(big);
++    memset(&big[NVRAM_SIZE], 0xa5, NVRAM_SIZE);
++    path = make_image(2 * NVRAM_SIZE, big);
++
++    qts = start(path, MAC_A, NULL);
++    read_nvram(qts, live, 0, IDPROM);
++    g_assert_cmpmem(live, IDPROM, big, IDPROM);
++    qtest_writeb(qts, NVRAM_BASE + SUN_DIAG, 0xff);
++    qtest_quit(qts);
++
++    g_assert(g_file_get_contents(path, &contents, &len, NULL));
++    g_assert_cmpuint(len, ==, 2 * NVRAM_SIZE);
++    g_assert_cmphex((uint8_t)contents[SUN_DIAG], ==, 0xff);
++    g_assert_cmpmem(&contents[NVRAM_SIZE], NVRAM_SIZE,
++                    &big[NVRAM_SIZE], NVRAM_SIZE);
++    g_free(contents);
++
++    unlink(path);
++    g_free(path);
++    g_free(big);
++}
++
++/*
++ * Attached with -blockdev by node name (as Proxmox VE does): the guest's
++ * writes reach the image, and query-block names the device by a fixed
++ * path.
++ */
++static void test_blockdev(void)
++{
++    uint8_t sun[NVRAM_SIZE], file[NVRAM_SIZE];
++    char *path;
++    QTestState *qts;
++    QDict *resp;
++    QList *list;
++    QListEntry *e;
++    bool found = false;
++
++    sun_contents(sun);
++    path = make_image(NVRAM_SIZE, sun);
++
++    qts = qtest_initf("-M SS-5 -nodefaults -net nic,model=lance,macaddr=%s "
++                      "-blockdev driver=raw,node-name=drive-nvram0,"
++                      "file.driver=file,file.filename=%s "
++                      "-global sysbus-m48t08.drive=drive-nvram0", MAC_A, path);
++    resp = qtest_qmp(qts, "{ 'execute': 'query-block' }");
++    g_assert(qdict_haskey(resp, "return"));
++    list = qdict_get_qlist(resp, "return");
++    QLIST_FOREACH_ENTRY(list, e) {
++        QDict *info = qobject_to(QDict, qlist_entry_obj(e));
++
++        if (!g_strcmp0(qdict_get_try_str(info, "qdev"), "/machine/nvram")) {
++            QDict *inserted = qdict_get_qdict(info, "inserted");
++
++            g_assert(inserted);
++            g_assert_cmpstr(qdict_get_str(inserted, "node-name"), ==,
++                            "drive-nvram0");
++            found = true;
++        }
++    }
++    qobject_unref(resp);
++    g_assert_true(found);
++
++    qtest_writeb(qts, NVRAM_BASE + SUN_DIAG, 0xff);
++    qtest_quit(qts);
++
++    read_image(path, file);
++    g_assert_cmphex(file[SUN_DIAG], ==, 0xff);
++    g_assert_cmphex(file[0], ==, SUN_CHECKSUM);
++
++    unlink(path);
++    g_free(path);
++}
++
++/* A read-only image is loaded, and the guest's writes stay in memory */
++static void test_read_only(void)
++{
++    uint8_t sun[NVRAM_SIZE], file[NVRAM_SIZE];
++    char *path;
++    QTestState *qts;
++
++    sun_contents(sun);
++    path = make_image(NVRAM_SIZE, sun);
++
++    qts = qtest_initf("-M SS-5 -nodefaults -net nic,model=lance,macaddr=%s "
++                      "-drive if=none,id=nvram0,format=raw,readonly=on,file=%s "
++                      "-global sysbus-m48t08.drive=nvram0", MAC_B, path);
++    g_assert_cmphex(qtest_readb(qts, NVRAM_BASE + SUN_AUTO_BOOT), ==, 0xff);
++    qtest_writeb(qts, NVRAM_BASE + SUN_DIAG, 0xff);
++    g_assert_cmphex(qtest_readb(qts, NVRAM_BASE + SUN_DIAG), ==, 0xff);
++    qtest_quit(qts);
++
++    read_image(path, file);
++    g_assert_cmpmem(file, NVRAM_SIZE, sun, NVRAM_SIZE);
++
++    unlink(path);
++    g_free(path);
++}
++
++/* Without an image nothing changes: QEMU's contents on every start */
++static void test_no_image(void)
++{
++    uint8_t live[NVRAM_SIZE];
++    QTestState *qts;
++
++    qts = qtest_initf("-M SS-5 -nodefaults -net nic,model=lance,macaddr="
++                      MAC_A);
++    read_nvram(qts, live, 0, CLOCK_REGS);
++    qtest_quit(qts);
++
++    check_openbios_layout(live, NULL);
++    check_idprom(&live[IDPROM], MAC_A);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_func("sun4m-nvram/no-image", test_no_image);
++    qtest_add_func("sun4m-nvram/blank", test_blank);
++    qtest_add_func("sun4m-nvram/persist", test_persist);
++    qtest_add_func("sun4m-nvram/prom-env", test_prom_env);
++    qtest_add_func("sun4m-nvram/larger-image", test_larger_image);
++    qtest_add_func("sun4m-nvram/blockdev", test_blockdev);
++    qtest_add_func("sun4m-nvram/read-only", test_read_only);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0061-hw-dma-sparc32_dma-reset-the-lance-DMA-s-base-addres.patch b/debian/patches/wsh/0061-hw-dma-sparc32_dma-reset-the-lance-DMA-s-base-addres.patch
new file mode 100644
index 0000000..105d8c2
--- /dev/null
+++ b/debian/patches/wsh/0061-hw-dma-sparc32_dma-reset-the-lance-DMA-s-base-addres.patch
@@ -0,0 +1,54 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/dma/sparc32_dma: reset the lance DMA's base address register to 0xff
+
+The lance has 24-bit addresses; the Ethernet channel of the DMA2
+(ledma) drives the upper 8 bits of the 32-bit SBus DVMA address from
+its fourth register, E_BASE_ADDR, which "defaults to 0xff" (DMA2.txt,
+referenced at the top of the file). QEMU cleared it at reset like the
+other registers.
+
+Solaris 2.6's le driver never writes it. The SS-20 boot PROM sets it to
+0xff000000 when it probes the Ethernet with diag-switch? true; with
+diag-switch? false (the setting that lets the PROM boot by itself) it
+does not. Solaris then sets the IOMMU range to 64 MB and maps the
+lance's init block at 0xff40f000; the lance asks for 0x0040f000, which
+falls on another, invalid IOMMU entry. The IOMMU reports the error at
+level 15 and the kernel takes the interrupt again and again until its
+stack runs out: "Trap 0x29 (Data Access Error) while interrupts
+disabled" at "configuring network interfaces:".
+
+Reset the ledma's register to 0xff000000; the ESP channel's fourth
+register stays 0. Guests that write it (NetBSD, Linux, the boot PROMs)
+are unaffected.
+---
+ hw/dma/sparc32_dma.c | 10 ++++++++++
+ 1 file changed, 10 insertions(+)
+
+diff --git a/hw/dma/sparc32_dma.c b/hw/dma/sparc32_dma.c
+index a5dc35e..3d815ae 100644
+--- a/hw/dma/sparc32_dma.c
++++ b/hw/dma/sparc32_dma.c
+@@ -62,6 +62,13 @@
+ #define DMA_DRAIN_FIFO 0x40
+ #define DMA_RESET 0x80
+ 
++/*
++ * The Ethernet channel's fourth register (E_BASE_ADDR in DMA2.txt) holds
++ * the upper 8 bits of the lance's 32-bit DVMA addresses and "defaults to
++ * 0xff". Solaris 2.6's le driver never writes it.
++ */
++#define LEDMA_BASE_ADDR_RESET 0xff000000
++
+ /* XXX SCSI and ethernet should have different read-only bit masks */
+ #define DMA_CSR_RO_MASK 0xfe000007
+ 
+@@ -243,6 +250,9 @@ static void sparc32_dma_device_reset(DeviceState *d)
+ 
+     memset(s->dmaregs, 0, DMA_SIZE);
+     s->dmaregs[0] = DMA_VER;
++    if (object_dynamic_cast(OBJECT(d), TYPE_SPARC32_LEDMA_DEVICE)) {
++        s->dmaregs[3] = LEDMA_BASE_ADDR_RESET;
++    }
+ }
+ 
+ static const VMStateDescription vmstate_sparc32_dma_device = {
diff --git a/debian/patches/wsh/0062-tests-qtest-test-the-lance-DMA-s-base-address-regist.patch b/debian/patches/wsh/0062-tests-qtest-test-the-lance-DMA-s-base-address-regist.patch
new file mode 100644
index 0000000..07fe447
--- /dev/null
+++ b/debian/patches/wsh/0062-tests-qtest-test-the-lance-DMA-s-base-address-regist.patch
@@ -0,0 +1,216 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] tests/qtest: test the lance DMA's base address register on sun4m
+
+qtest sun4m-ledma-test for the patch before: the ledma's base address
+register reads 0xff000000 after start and after a system reset on the
+SS-5, SS-20 and LX, and is writable; the ESP channel's register stays
+0. On the SS-5 and SS-20 the lance reads an init block through the
+IOMMU with a 64 MB range from the page mapped at 0xff400000; with the
+register written to 0 the IOMMU reports an error at 0x00400000. The
+cases fail without the patch before.
+---
+ tests/qtest/meson.build        |   3 +-
+ tests/qtest/sun4m-ledma-test.c | 180 +++++++++++++++++++++++++++++++++
+ 2 files changed, 182 insertions(+), 1 deletion(-)
+ create mode 100644 tests/qtest/sun4m-ledma-test.c
+
+diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
+index 054b26b..f8f3c15 100644
+--- a/tests/qtest/meson.build
++++ b/tests/qtest/meson.build
+@@ -212,7 +212,8 @@ qtests_sparc = ['prom-env-test', 'm48t59-test', 'boot-serial-test',
+                 'sun4m-bus-error-trap-test',
+                 'sun4m-fp-deferred-trap-test',
+                 'sun4m-onboard-sbus-test',
+-                'sun4m-nvram-test'] + \
++                'sun4m-nvram-test',
++                'sun4m-ledma-test'] + \
+   qtests_filter
+ 
+ qtests_sparc64 = \
+diff --git a/tests/qtest/sun4m-ledma-test.c b/tests/qtest/sun4m-ledma-test.c
+new file mode 100644
+index 0000000..6558891
+--- /dev/null
++++ b/tests/qtest/sun4m-ledma-test.c
+@@ -0,0 +1,180 @@
++/*
++ * QTest: the lance DMA's base address register on sun4m
++ *
++ * The lance has 24-bit addresses; the Ethernet channel of the DMA2
++ * (ledma) adds the upper 8 bits of the 32-bit DVMA address from its
++ * fourth register, E_BASE_ADDR, which "defaults to 0xff" (DMA2.txt).
++ * QEMU reset it to 0. Solaris 2.6's le driver never writes it: it takes
++ * the default, or what a boot PROM left there (the SS-20 PROM sets it
++ * only when diag-switch? is true). With 0 and the IOMMU range of 64 MB
++ * that Solaris sets on an SS-20, the lance's init block address
++ * 0x00400000 misses the IOMMU page that Solaris mapped at 0xff400000,
++ * the IOMMU reports an error at level 15, and the kernel overflows its
++ * stack ("Trap 0x29 ... while interrupts disabled").
++ *
++ * The test checks the register after start and after a system reset,
++ * that the ESP channel's fourth register stays 0, and has the lance
++ * read an init block through the IOMMU with a 64 MB range: from the page
++ * mapped at 0xff400000 by default, and an IOMMU error with the register
++ * set to 0. Nothing runs on the CPU.
++ *
++ * SPDX-License-Identifier: GPL-2.0-or-later
++ */
++
++#include "qemu/osdep.h"
++#include "libqtest.h"
++
++typedef struct {
++    const char *machine;
++    uint64_t dma_base;          /* espdma; ledma at +0x10 */
++    uint64_t le_base;
++    uint64_t iommu_base;
++} LedmaCase;
++
++static const LedmaCase ss5 = {
++    "SS-5", 0x78400000ULL, 0x78c00000ULL, 0x10000000ULL
++};
++static const LedmaCase ss20 = {
++    "SS-20", 0xef0400000ULL, 0xef0c00000ULL, 0xfe0000000ULL
++};
++static const LedmaCase lx = {
++    "LX", 0x78400000ULL, 0x78c00000ULL, 0x10000000ULL
++};
++
++#define ESPDMA_BASE_ADDR(c)     ((c)->dma_base + 0x0c)
++#define LEDMA_BASE_ADDR(c)      ((c)->dma_base + 0x1c)
++#define LEDMA_BASE_ADDR_RESET   0xff000000
++
++/* The lance's data and address ports */
++#define LE_RDP(c)               ((c)->le_base + 0)
++#define LE_RAP(c)               ((c)->le_base + 2)
++#define CSR0_INIT               0x0001
++#define CSR0_IDON               0x0100
++
++#define IOMMU_CTRL(c)           ((c)->iommu_base + 0x0000)
++#define IOMMU_BASE(c)           ((c)->iommu_base + 0x0004)
++#define IOMMU_AFSR(c)           ((c)->iommu_base + 0x1000)
++#define IOMMU_AFAR(c)           ((c)->iommu_base + 0x1004)
++#define IOMMU_CTRL_64M_ENAB     0x9     /* range 64 MB, enable */
++#define IOMMU_AFSR_ERR          0x80000000
++#define IOPTE_WRITE             0x4
++#define IOPTE_VALID             0x2
++
++/* The IOMMU table (64 KB for 64 MB), the init block and its DVMA address */
++#define IOPT_PA                 0x100000
++#define INITBLK_PA              0x200000
++#define INITBLK_DVMA            0xff400000U
++#define DVMA_START_64M          0xfc000000U
++#define INITBLK_MODE            0x8003
++
++static QTestState *start(const LedmaCase *c)
++{
++    return qtest_initf("-M %s -m 64 -nodefaults", c->machine);
++}
++
++static void test_reset_value(const void *opaque)
++{
++    const LedmaCase *c = opaque;
++    QTestState *qts = start(c);
++
++    g_assert_cmphex(qtest_readl(qts, LEDMA_BASE_ADDR(c)), ==,
++                    LEDMA_BASE_ADDR_RESET);
++    g_assert_cmphex(qtest_readl(qts, ESPDMA_BASE_ADDR(c)), ==, 0);
++
++    /* writable, and back to the default after a reset */
++    qtest_writel(qts, LEDMA_BASE_ADDR(c), 0);
++    g_assert_cmphex(qtest_readl(qts, LEDMA_BASE_ADDR(c)), ==, 0);
++    qtest_qmp_assert_success(qts, "{ 'execute': 'system_reset' }");
++    qtest_qmp_eventwait(qts, "RESET");
++    g_assert_cmphex(qtest_readl(qts, LEDMA_BASE_ADDR(c)), ==,
++                    LEDMA_BASE_ADDR_RESET);
++
++    qtest_quit(qts);
++}
++
++static void le_csr_write(QTestState *qts, const LedmaCase *c, int csr,
++                         uint16_t val)
++{
++    qtest_writew(qts, LE_RAP(c), csr);
++    qtest_writew(qts, LE_RDP(c), val);
++}
++
++static uint16_t le_csr_read(QTestState *qts, const LedmaCase *c, int csr)
++{
++    qtest_writew(qts, LE_RAP(c), csr);
++    return qtest_readw(qts, LE_RDP(c));
++}
++
++/*
++ * Map INITBLK_DVMA to INITBLK_PA with a 64 MB IOMMU range, put a 16-bit
++ * init block there and let the lance read it from INITBLK_DVMA's lower
++ * 24 bits. Returns the IOMMU's AFSR afterwards; *mode is the mode word
++ * the lance took (CSR15).
++ */
++static uint32_t lance_init_through_iommu(QTestState *qts, const LedmaCase *c,
++                                         uint16_t *mode)
++{
++    uint32_t idx = (INITBLK_DVMA - DVMA_START_64M) >> 12;
++    int i;
++
++    qtest_writel(qts, IOMMU_BASE(c), IOPT_PA >> 4);
++    qtest_writel(qts, IOMMU_CTRL(c), IOMMU_CTRL_64M_ENAB);
++    qtest_writel(qts, IOPT_PA + idx * 4,
++                 (INITBLK_PA >> 4) | IOPTE_WRITE | IOPTE_VALID);
++    /* AFSR and AFAR clear */
++    qtest_readl(qts, IOMMU_AFSR(c));
++
++    /* mode, then the MAC address, filter and ring pointers (zero) */
++    qtest_writew(qts, INITBLK_PA, INITBLK_MODE);
++    for (i = 2; i < 24; i += 2) {
++        qtest_writew(qts, INITBLK_PA + i, 0);
++    }
++
++    le_csr_write(qts, c, 1, INITBLK_DVMA & 0xffff);
++    le_csr_write(qts, c, 2, (INITBLK_DVMA >> 16) & 0xff);
++    le_csr_write(qts, c, 0, CSR0_INIT);
++    g_assert_cmphex(le_csr_read(qts, c, 0) & CSR0_IDON, ==, CSR0_IDON);
++    *mode = le_csr_read(qts, c, 15);
++    return qtest_readl(qts, IOMMU_AFSR(c));
++}
++
++static void test_lance_dvma(const void *opaque)
++{
++    const LedmaCase *c = opaque;
++    QTestState *qts = start(c);
++    uint16_t mode;
++    uint32_t afsr;
++
++    /* the default: the init block comes from 0xff400000 */
++    afsr = lance_init_through_iommu(qts, c, &mode);
++    g_assert_cmphex(afsr & IOMMU_AFSR_ERR, ==, 0);
++    g_assert_cmphex(mode, ==, INITBLK_MODE);
++    qtest_quit(qts);
++
++    /* E_BASE_ADDR 0: the lance asks for 0x00400000, which isn't mapped */
++    qts = start(c);
++    qtest_writel(qts, LEDMA_BASE_ADDR(c), 0);
++    afsr = lance_init_through_iommu(qts, c, &mode);
++    g_assert_cmphex(afsr & IOMMU_AFSR_ERR, ==, IOMMU_AFSR_ERR);
++    g_assert_cmphex(qtest_readl(qts, IOMMU_AFAR(c)), ==,
++                    INITBLK_DVMA & 0x00ffffff);
++    qtest_quit(qts);
++}
++
++int main(int argc, char **argv)
++{
++    g_test_init(&argc, &argv, NULL);
++
++    qtest_add_data_func("/sun4m/ledma/reset-value/ss5", &ss5,
++                        test_reset_value);
++    qtest_add_data_func("/sun4m/ledma/reset-value/ss20", &ss20,
++                        test_reset_value);
++    qtest_add_data_func("/sun4m/ledma/reset-value/lx", &lx,
++                        test_reset_value);
++    qtest_add_data_func("/sun4m/ledma/lance-dvma/ss5", &ss5,
++                        test_lance_dvma);
++    qtest_add_data_func("/sun4m/ledma/lance-dvma/ss20", &ss20,
++                        test_lance_dvma);
++
++    return g_test_run();
++}
diff --git a/debian/patches/wsh/0063-hw-sparc-sun4m-map-the-SPARCserver-600MP-s-VMEbus-in.patch b/debian/patches/wsh/0063-hw-sparc-sun4m-map-the-SPARCserver-600MP-s-VMEbus-in.patch
new file mode 100644
index 0000000..e505bf4
--- /dev/null
+++ b/debian/patches/wsh/0063-hw-sparc-sun4m-map-the-SPARCserver-600MP-s-VMEbus-in.patch
@@ -0,0 +1,61 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: map the SPARCserver 600MP's VMEbus interface
+ registers
+
+SunOS 4.1.2 on -M SS-600MP stops before its banner ("Unhandled
+Exception 0x00000029" in OpenBIOS's trap handler, pc 0xf80a6054): the
+kernel's early setup for the 600MP clears the memory controller's and
+the SBus's fault registers and then sets up the VMEbus interface,
+reading and writing its registers at physical 0xf.df01_0000 (offsets
+0, 4 and 8: control, AFSR and AFAR) through the MMU bypass ASI 0x2f.
+QEMU has nothing there, and a bypass load that hits nothing takes the
+data access error (trap 0x29), which the kernel hasn't caught yet.
+
+Map an unimplemented device (reads 0, writes ignored) over that page on
+the SS-600MP only. There is no VMEbus model: the VMEbus spaces stay
+empty, so the kernel's probes for VME devices (with its fault catcher
+armed) find none, as on a machine with nothing in its VME slots. With
+it the 4.1.2 CD's kernel prints its banner and gets to its installer
+menu; the other sun4m machines are unchanged.
+---
+ hw/sparc/sun4m.c | 13 +++++++++++++
+ 1 file changed, 13 insertions(+)
+
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index faa372c..769ce73 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -101,6 +101,7 @@ struct sun4m_hwdef {
+     hwaddr afx_base, idreg_base, dma_base, esp_base, le_base;
+     hwaddr tcx_base, cs_base, apc_base, aux1_base, aux2_base;
+     hwaddr bpp_base, dbri_base, sx_base, cg6_base;
++    hwaddr vme_base;
+     struct {
+         hwaddr reg_base, vram_base;
+     } vsimm[MAX_VSIMMS];
+@@ -1225,6 +1226,17 @@ static void sun4m_hw_init(MachineState *machine)
+         create_unimplemented_device("sun-cgsix", hwdef->cg6_base, 0x1000000);
+     }
+ 
++    if (hwdef->vme_base) {
++        /*
++         * The SPARCserver 600MP's VMEbus interface registers (control,
++         * AFSR, AFAR), which SunOS 4.1.2 sets up through the MMU bypass
++         * before its banner. No VMEbus model: reads 0, writes ignored, and
++         * the VMEbus spaces themselves stay empty, so the kernel's probes
++         * for VME devices find none.
++         */
++        create_unimplemented_device("sun-vme", hwdef->vme_base, 0x1000);
++    }
++
+     if (hwdef->bpp_base) {
+         /* parallel port */
+         create_unimplemented_device("sun-bpp", hwdef->bpp_base, 0x20);
+@@ -1417,6 +1429,7 @@ static void ss600mp_class_init(ObjectClass *oc, const void *data)
+         .aux2_base    = 0xff1a01000ULL, /* XXX should not exist */
+         .ecc_base     = 0xf00000000ULL,
+         .ecc_version  = 0x00000000, /* version 0, implementation 0 */
++        .vme_base     = 0xfdf010000ULL,
+         .nvram_machine_id = 0x71,
+         .machine_id = ss600mp_id,
+         .iommu_version = 0x01000000,
diff --git a/debian/patches/wsh/0064-hw-sparc-sun4m-give-the-SPARCserver-600MP-s-lance-it.patch b/debian/patches/wsh/0064-hw-sparc-sun4m-give-the-SPARCserver-600MP-s-lance-it.patch
new file mode 100644
index 0000000..9301a26
--- /dev/null
+++ b/debian/patches/wsh/0064-hw-sparc-sun4m-give-the-SPARCserver-600MP-s-lance-it.patch
@@ -0,0 +1,287 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc/sun4m: give the SPARCserver 600MP's lance its own
+ buffer memory
+
+The SPARCserver 600MP's lance doesn't use a DMA engine: it works in a
+buffer memory of its own below its registers, the "lebuffer" in SBus
+slot f at offset 0x40000 (128 KB, up to the lance at 0x60000), in which
+its 24-bit addresses are offsets, and it interrupts by itself. QEMU
+gave the SS-600MP the SS-10's arrangement, an "ledma" DMA engine and
+DVMA through the IOMMU. SunOS 4.1.2, the first release for the 600MP,
+knows the lebuffer and no ledma: with the lance under "ledma" it finds
+no network interface, and a lance directly on the SBus it refuses
+("le0: not used - unsupported SBus card for this architecture!").
+
+Add a property "lebuffer-size" to the sparc32 DMA device. When it is
+set, the lance's reads and writes go to a RAM region of that size (the
+address taken modulo the size) in an address space of its own, and its
+interrupt goes straight to the board instead of through the ledma's
+interrupt enable. The board maps the region, as MMIO region 1 of the
+device, through an alias (a region that roots an address space and is
+also mapped elsewhere would be seen at its offset there). The ledma's
+registers stay where they were and do nothing for the lance.
+
+The SS-600MP sets it, with the buffer at 0xe.f004_0000. OpenBIOS makes
+the node "lebuffer" for the machine (openbios patch 0028). SunOS 4.1.2
+then attaches "lebuffer0 at SBus slot f 0x40000" and "le0 at SBus slot
+f 0x60000", and an installed system answers ping over user networking.
+The other sun4m machines keep the ledma and DVMA.
+---
+ hw/dma/sparc32_dma.c           | 74 +++++++++++++++++++++++++++++-----
+ hw/sparc/sun4m.c               | 16 ++++++--
+ include/hw/sparc/sparc32_dma.h | 10 +++++
+ 3 files changed, 86 insertions(+), 14 deletions(-)
+
+diff --git a/hw/dma/sparc32_dma.c b/hw/dma/sparc32_dma.c
+index a5dc35e..f3132d9 100644
+--- a/hw/dma/sparc32_dma.c
++++ b/hw/dma/sparc32_dma.c
+@@ -35,6 +35,7 @@
+ #include "system/dma.h"
+ #include "qapi/error.h"
+ #include "qemu/module.h"
++#include "qemu/host-utils.h"
+ #include "trace.h"
+ 
+ /*
+@@ -71,21 +72,37 @@ enum {
+ };
+ 
+ /* Note: on sparc, the lance 16 bit bus is swapped */
++/*
++ * Where the lance's 24-bit address goes: the lebuffer, when there is one,
++ * or DVMA through the IOMMU, with the upper byte from the DMA engine.
++ */
++static AddressSpace *ledma_target(DMADeviceState *s, hwaddr *addr)
++{
++    LEDMADeviceState *ls = SPARC32_LEDMA_DEVICE(s);
++    IOMMUState *is = (IOMMUState *)s->iommu;
++
++    if (ls->lebuffer_size) {
++        *addr &= ls->lebuffer_size - 1;
++        return &ls->lebuffer_as;
++    }
++    *addr |= s->dmaregs[3];
++    return &is->iommu_as;
++}
++
+ void ledma_memory_read(void *opaque, hwaddr addr,
+                        uint8_t *buf, int len, int do_bswap)
+ {
+     DMADeviceState *s = opaque;
+-    IOMMUState *is = (IOMMUState *)s->iommu;
++    AddressSpace *as = ledma_target(s, &addr);
+     int i;
+ 
+-    addr |= s->dmaregs[3];
+     trace_ledma_memory_read(addr, len);
+     if (do_bswap) {
+-        dma_memory_read(&is->iommu_as, addr, buf, len, MEMTXATTRS_UNSPECIFIED);
++        dma_memory_read(as, addr, buf, len, MEMTXATTRS_UNSPECIFIED);
+     } else {
+         addr &= ~1;
+         len &= ~1;
+-        dma_memory_read(&is->iommu_as, addr, buf, len, MEMTXATTRS_UNSPECIFIED);
++        dma_memory_read(as, addr, buf, len, MEMTXATTRS_UNSPECIFIED);
+         for(i = 0; i < len; i += 2) {
+             bswap16s((uint16_t *)(buf + i));
+         }
+@@ -96,15 +113,13 @@ void ledma_memory_write(void *opaque, hwaddr addr,
+                         uint8_t *buf, int len, int do_bswap)
+ {
+     DMADeviceState *s = opaque;
+-    IOMMUState *is = (IOMMUState *)s->iommu;
++    AddressSpace *as = ledma_target(s, &addr);
+     int l, i;
+     uint16_t tmp_buf[32];
+ 
+-    addr |= s->dmaregs[3];
+     trace_ledma_memory_write(addr, len);
+     if (do_bswap) {
+-        dma_memory_write(&is->iommu_as, addr, buf, len,
+-                         MEMTXATTRS_UNSPECIFIED);
++        dma_memory_write(as, addr, buf, len, MEMTXATTRS_UNSPECIFIED);
+     } else {
+         addr &= ~1;
+         len &= ~1;
+@@ -115,8 +130,7 @@ void ledma_memory_write(void *opaque, hwaddr addr,
+             for(i = 0; i < l; i += 2) {
+                 tmp_buf[i >> 1] = bswap16(*(uint16_t *)(buf + i));
+             }
+-            dma_memory_write(&is->iommu_as, addr, tmp_buf, l,
+-                             MEMTXATTRS_UNSPECIFIED);
++            dma_memory_write(as, addr, tmp_buf, l, MEMTXATTRS_UNSPECIFIED);
+             len -= l;
+             buf += l;
+             addr += l;
+@@ -127,6 +141,14 @@ void ledma_memory_write(void *opaque, hwaddr addr,
+ static void dma_set_irq(void *opaque, int irq, int level)
+ {
+     DMADeviceState *s = opaque;
++    LEDMADeviceState *ls = (LEDMADeviceState *)
++        object_dynamic_cast(OBJECT(s), TYPE_SPARC32_LEDMA_DEVICE);
++
++    if (ls && ls->lebuffer_size) {
++        /* no DMA engine in the way: the lance interrupts by itself */
++        qemu_set_irq(s->irq, level);
++        return;
++    }
+     if (level) {
+         s->dmaregs[0] |= DMA_INTR;
+         if (s->dmaregs[0] & DMA_INTREN) {
+@@ -348,6 +370,23 @@ static void sparc32_ledma_device_realize(DeviceState *dev, Error **errp)
+     LEDMADeviceState *s = SPARC32_LEDMA_DEVICE(dev);
+     SysBusPCNetState *lance = SYSBUS_PCNET(&s->lance);
+ 
++    if (s->lebuffer_size) {
++        if (!is_power_of_2(s->lebuffer_size) ||
++            s->lebuffer_size > 0x1000000) {
++            error_setg(errp, "lebuffer-size must be a power of 2 up to 16 MB");
++            return;
++        }
++        if (!memory_region_init_ram(&s->lebuffer, OBJECT(dev), "lebuffer",
++                                    s->lebuffer_size, errp)) {
++            return;
++        }
++        address_space_init(&s->lebuffer_as, &s->lebuffer, "lebuffer");
++        /* the CPU's view of it: an alias, as the region roots that space */
++        memory_region_init_alias(&s->lebuffer_alias, OBJECT(dev),
++                                 "lebuffer-alias", &s->lebuffer, 0,
++                                 s->lebuffer_size);
++    }
++
+     object_property_set_link(OBJECT(lance), "dma", OBJECT(dev), &error_abort);
+     sysbus_realize(SYS_BUS_DEVICE(lance), &error_fatal);
+ }
+@@ -397,7 +436,10 @@ static void sparc32_dma_realize(DeviceState *dev, Error **errp)
+ 
+     ledma = DEVICE(&s->ledma);
+     object_property_set_link(OBJECT(ledma), "iommu", iommu, &error_abort);
+-    sysbus_realize(SYS_BUS_DEVICE(ledma), &error_fatal);
++    s->ledma.lebuffer_size = s->lebuffer_size;
++    if (!sysbus_realize(SYS_BUS_DEVICE(ledma), errp)) {
++        return;
++    }
+ 
+     lance = DEVICE(object_resolve_path_component(OBJECT(ledma), "lance"));
+     sbd = SYS_BUS_DEVICE(lance);
+@@ -407,6 +449,10 @@ static void sparc32_dma_realize(DeviceState *dev, Error **errp)
+     sbd = SYS_BUS_DEVICE(ledma);
+     memory_region_add_subregion(&s->dmamem, 0x10,
+                                 sysbus_mmio_get_region(sbd, 0));
++    if (s->ledma.lebuffer_size) {
++        /* the lebuffer: MMIO region 1, for the board to map */
++        sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->ledma.lebuffer_alias);
++    }
+ 
+     /* Add ledma alias to handle SunOS 5.7 - Solaris 9 invalid access bug */
+     memory_region_init_alias(&s->ledma_alias, OBJECT(dev), "ledma-alias",
+@@ -428,11 +474,17 @@ static void sparc32_dma_init(Object *obj)
+                             TYPE_SPARC32_LEDMA_DEVICE);
+ }
+ 
++static const Property sparc32_dma_properties[] = {
++    /* the size of the lance's buffer memory (lebuffer); 0: none, DVMA */
++    DEFINE_PROP_UINT32("lebuffer-size", SPARC32DMAState, lebuffer_size, 0),
++};
++
+ static void sparc32_dma_class_init(ObjectClass *klass, const void *data)
+ {
+     DeviceClass *dc = DEVICE_CLASS(klass);
+ 
+     dc->realize = sparc32_dma_realize;
++    device_class_set_props(dc, sparc32_dma_properties);
+ }
+ 
+ static const TypeInfo sparc32_dma_info = {
+diff --git a/hw/sparc/sun4m.c b/hw/sparc/sun4m.c
+index 769ce73..0b619b1 100644
+--- a/hw/sparc/sun4m.c
++++ b/hw/sparc/sun4m.c
+@@ -87,6 +87,8 @@
+ #define MAX_CPUS 16
+ #define MAX_PILS 16
+ #define MAX_VSIMMS 4
++/* the SPARCserver 600MP's on-board lance buffer: 128 KB below the lance */
++#define SUN4M_LEBUFFER_SIZE 0x20000
+ 
+ /* A real cg3 has 1 MB of video RAM; its SBus slot has room for 8 MB */
+ #define CG3_VRAM_SIZE        (1 * MiB)
+@@ -101,7 +103,7 @@ struct sun4m_hwdef {
+     hwaddr afx_base, idreg_base, dma_base, esp_base, le_base;
+     hwaddr tcx_base, cs_base, apc_base, aux1_base, aux2_base;
+     hwaddr bpp_base, dbri_base, sx_base, cg6_base;
+-    hwaddr vme_base;
++    hwaddr vme_base, lebuffer_base;
+     struct {
+         hwaddr reg_base, vram_base;
+     } vsimm[MAX_VSIMMS];
+@@ -313,7 +315,7 @@ static void *iommu_init(hwaddr addr, uint32_t version, qemu_irq irq)
+ static void *sparc32_dma_init(hwaddr dma_base,
+                               hwaddr esp_base, qemu_irq espdma_irq,
+                               hwaddr le_base, qemu_irq ledma_irq,
+-                              MACAddr *mac)
++                              hwaddr lebuffer_base, MACAddr *mac)
+ {
+     DeviceState *dma;
+     ESPDMADeviceState *espdma;
+@@ -342,7 +344,13 @@ static void *sparc32_dma_init(hwaddr dma_base,
+         qdev_prop_set_macaddr(DEVICE(lance), "mac", mac->a);
+     }
+ 
++    if (lebuffer_base) {
++        qdev_prop_set_uint32(dma, "lebuffer-size", SUN4M_LEBUFFER_SIZE);
++    }
+     sysbus_realize_and_unref(SYS_BUS_DEVICE(dma), &error_fatal);
++    if (lebuffer_base) {
++        sysbus_mmio_map(SYS_BUS_DEVICE(dma), 1, lebuffer_base);
++    }
+ 
+     sysbus_connect_irq(SYS_BUS_DEVICE(espdma), 0, espdma_irq);
+ 
+@@ -1032,7 +1040,8 @@ static void sun4m_hw_init(MachineState *machine)
+ 
+     sparc32_dma_init(hwdef->dma_base,
+                      hwdef->esp_base, slavio_irq[18],
+-                     hwdef->le_base, slavio_irq[16], &hostid);
++                     hwdef->le_base, slavio_irq[16],
++                     hwdef->lebuffer_base, &hostid);
+ 
+     if (!graphic_width) {
+         graphic_width = 1024;
+@@ -1430,6 +1439,7 @@ static void ss600mp_class_init(ObjectClass *oc, const void *data)
+         .ecc_base     = 0xf00000000ULL,
+         .ecc_version  = 0x00000000, /* version 0, implementation 0 */
+         .vme_base     = 0xfdf010000ULL,
++        .lebuffer_base = 0xef0040000ULL,
+         .nvram_machine_id = 0x71,
+         .machine_id = ss600mp_id,
+         .iommu_version = 0x01000000,
+diff --git a/include/hw/sparc/sparc32_dma.h b/include/hw/sparc/sparc32_dma.h
+index 3181c17..ccf2c74 100644
+--- a/include/hw/sparc/sparc32_dma.h
++++ b/include/hw/sparc/sparc32_dma.h
+@@ -38,6 +38,15 @@ struct LEDMADeviceState {
+     DMADeviceState parent_obj;
+ 
+     SysBusPCNetState lance;
++    /*
++     * lebuffer_size > 0: the lance works in a buffer memory of its own (an
++     * "lebuffer", as on the SPARCserver 600MP), not through the DMA engine
++     * and the IOMMU.
++     */
++    uint32_t lebuffer_size;
++    MemoryRegion lebuffer;
++    MemoryRegion lebuffer_alias;    /* what the board maps */
++    AddressSpace lebuffer_as;
+ };
+ 
+ #define TYPE_SPARC32_DMA "sparc32-dma"
+@@ -50,6 +59,7 @@ struct SPARC32DMAState {
+     MemoryRegion ledma_alias;
