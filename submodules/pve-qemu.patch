@@ -0,0 +1,57 @@
+From: Hans Christian Winther-Sorensen <hc@wsh.no>
+Subject: [PATCH] hw/sparc64/sun4u: add the idle-halt option, on by default
+
+It halts the CPU while a known guest kernel is idle, see
+target/sparc/sparc64_idle.c. -M sun4u,idle-halt=off lets the idle loop
+spin as before. sun4u has one CPU, so unlike sun4m's options it needs
+no exception for more than one. sun4v doesn't get it: its guests idle
+through hypervisor calls, which QEMU doesn't implement.
+---
+ hw/sparc64/sun4u.c | 20 ++++++++++++++++++++
+ 1 file changed, 20 insertions(+)
+
+diff --git a/hw/sparc64/sun4u.c b/hw/sparc64/sun4u.c
+index 42540f3dbc..ca52e1a667 100644
+--- a/hw/sparc64/sun4u.c
++++ b/hw/sparc64/sun4u.c
+@@ -590,6 +590,19 @@ static const TypeInfo ram_info = {
+     .class_init    = ram_class_init,
+ };
+ 
++/* Halt the CPU in the guest's idle loop, see target/sparc/sparc64_idle.c */
++static bool sun4u_idle_halt = true;
++
++static bool sun4u_get_idle_halt(Object *obj, Error **errp)
++{
++    return sun4u_idle_halt;
++}
++
++static void sun4u_set_idle_halt(Object *obj, bool value, Error **errp)
++{
++    sun4u_idle_halt = value;
++}
++
+ static void sun4uv_init(MemoryRegion *address_space_mem,
+                         MachineState *machine,
+                         const struct hwdef *hwdef)
+@@ -858,6 +871,7 @@ static const struct hwdef hwdefs[] = {
+ static void sun4u_init(MachineState *machine)
+ {
+     sun4uv_init(get_system_memory(), machine, &hwdefs[0]);
++    SPARC_CPU(first_cpu)->env.idle_halt = sun4u_idle_halt;
+ }
+ 
+ /* Sun4v hardware initialisation */
+@@ -890,6 +904,12 @@ static void sun4u_class_init(ObjectClass *oc, const void *data)
+     mc->no_parallel = !module_object_class_by_name(TYPE_ISA_PARALLEL);
+     fwc->get_dev_path = sun4u_fw_dev_path;
+     compat_props_add(mc->compat_props, hw_compat_sparc64, hw_compat_sparc64_len);
++
++    object_class_property_add_bool(oc, "idle-halt", sun4u_get_idle_halt,
++                                   sun4u_set_idle_halt);
++    object_class_property_set_description(oc, "idle-halt",
++        "Halt the CPU while a known guest kernel (NetBSD, OpenBSD, Solaris, "
++        "illumos) is idle, instead of spinning (default: on)");
+ }
+ 
+ static const TypeInfo sun4u_type = {
diff --git a/debian/patches/wsh/0044-tests-qtest-test-the-idle-halt-on-sun4u.patch b/debian/patches/wsh/0044-tests-qtest-test-the-idle-halt-on-sun4u.patch
