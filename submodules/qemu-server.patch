+=cut
+
+sub sparc32_esp_global {
+    my ($conf) = @_;
+
+    my $machine_conf = parse_machine($conf->{machine}) or return;
+    my $latency = $machine_conf->{'esp-irq-latency'} or return;
+    return "sysbus-esp.irq-latency-us=$latency";
+}
+
+# The sparc64 (arch: sparc64) profile: the one layout that was tested to boot (wsh-pve
+# submodules/SPARC.md, "sparc64 (sun4u)"). sun4u with OpenBIOS and the machine's default CPU, one CPU,
+# disks and CD-ROMs on the built-in IDE (OpenBIOS can't boot from SCSI or virtio), NICs on PCI bus B.
+# pve-manager mirrors it in PVE.qemu.Architecture.sparc64Profile (www/manager6/qemu/Architecture.js).
+our $SPARC64_PROFILE = {
+    machine => 'sun4u',
+    firmware => 'openbios-sparc64',
+    # needs OpenBIOS patches 0013-0015 (pve-qemu-kvm 11.1.3-2+wsh16): without them 4096 MB panics
+    # NetBSD and 8192 MB stops OpenBIOS. 8192 MB is the largest size tested (NetBSD, Solaris 10).
+    'max-memory' => 8192,
+    vga => [qw(std serial0 none)],
+    nic => [qw(sunhme virtio e1000 rtl8139 ne2k_pci)],
+    # pciB has four slots; qemu-server puts every NIC there
+    'max-nics' => 4,
+};
+
+=head3 assert_sparc64_profile
+
+    assert_sparc64_profile($conf);
+
+Dies with a message naming the allowed values if the sparc64 VM config C<$conf> doesn't match
+C<$SPARC64_PROFILE>. Callers check C<arch> first.
+
+=cut
+
+sub assert_sparc64_profile {
+    my ($conf) = @_;
+
+    my $p = $SPARC64_PROFILE;
+
+    my $machine_conf = eval { parse_machine($conf->{machine}) } // {};
+    my $machine = $machine_conf->{type} // $p->{machine};
+    $machine =~ s/\+pve\d+$//; # a snapshot's runningmachine
+    die "sparc64: machine '$machine' is not supported, use $p->{machine}\n"
+        if $machine ne $p->{machine};
+
+    my $bios = $conf->{bios} // $p->{firmware};
+    die "sparc64: firmware (bios) '$bios' is not supported, use $p->{firmware}\n"
+        if $bios ne $p->{firmware};
+
+    my $memory = PVE::QemuServer::Memory::get_current_memory($conf->{memory});
+    die "sparc64: $machine takes at most $p->{'max-memory'} MB of memory, not $memory\n"
+        if $memory > $p->{'max-memory'};
+
+    my $cpus = ($conf->{sockets} // 1) * ($conf->{cores} // 1);
+    die "sparc64: only one CPU is supported (sockets 1, cores 1), not $cpus\n" if $cpus != 1;
+
+    die "sparc64: 'cpu' can't be set, the machine's default CPU is used\n"
+        if defined($conf->{cpu});
+
+    # the type is the default key; 'memory=16' alone keeps the default type
+    if (defined($conf->{vga}) && $conf->{vga} =~ m/^(?:type=)?([^,=]+)(?:,|$)/) {
+        my $vga = $1;
+        die "sparc64: display (vga) '$vga' is not supported, use one of: "
+            . join(', ', $p->{vga}->@*) . "\n"
+            if !grep { $_ eq $vga } $p->{vga}->@*;
+    }
+
+    for my $opt (qw(serial2 serial3)) {
+        die "sparc64: $opt is not supported, the machine has two serial ports (serial0, serial1)\n"
+            if defined($conf->{$opt});
+    }
+
+    die "sparc64: the QEMU guest agent is not supported\n"
+        if PVE::QemuServer::Agent::parse_guest_agent($conf->{agent})->{enabled};
+
+    die "sparc64: audio0 is not supported, no sound device was tested on sun4u\n"
+        if defined($conf->{audio0});
+
+    my @drives = grep { m/^(?:scsi|virtio|sata|efidisk|tpmstate|floppy)\d+$/ && defined($conf->{$_}) }
+        sort keys $conf->%*;
+    die "sparc64: " . join(', ', @drives) . " can't be used, disks and CD-ROMs go on the"
+        . " built-in IDE (ide0 to ide3)\n"
+        if @drives;
+
+    my @nets = map { "net$_" } sort { $a <=> $b }
+        map { m/^net(\d+)$/ && defined($conf->{$_}) ? ($1) : () } keys $conf->%*;
+    die "sparc64: at most $p->{'max-nics'} network devices fit on PCI bus B, not "
+        . scalar(@nets) . " (" . join(', ', @nets) . ")\n"
+        if scalar(@nets) > $p->{'max-nics'};
+    for my $opt (@nets) {
+        my $net = PVE::QemuServer::Network::parse_net($conf->{$opt}, 1)
+            or die "sparc64: unable to parse $opt\n";
+        die "sparc64: network device model '$net->{model}' is not supported, use one of: "
+            . join(', ', $p->{nic}->@*) . "\n"
+            if !grep { $_ eq $net->{model} } $p->{nic}->@*;
+    }
+
+    return;
+}
+
+=head3 sparc64_boot_device
+
+    my $letter = sparc64_boot_device($conf, $bootorder);
+
+The device OpenBIOS boots, as the letter for QEMU's C<-boot order=>: the first drive of the boot
+order C<$bootorder> (device name to boot index, from C<device_bootorder>) that holds something, C<d>
+for a CD-ROM with a medium and C<c> for a disk. CD-ROMs without a medium, cloud-init drives and NICs
+are skipped (network boot isn't supported). Undef if there is none (QEMU's default, the disk).
+
+OpenBIOS can't follow C<bootindex> on sun4u (the paths QEMU hands it don't exist in its device tree),
+so a sparc64 VM gets the boot device this way instead.
+
+=cut
+
+sub sparc64_boot_device {
+    my ($conf, $bootorder) = @_;
+
+    for my $dev (sort { $bootorder->{$a} <=> $bootorder->{$b} } keys $bootorder->%*) {
+        next if $dev !~ m/^ide\d+$/ || !defined($conf->{$dev});
+        my $drive = PVE::QemuServer::Drive::parse_drive($dev, $conf->{$dev}) or next;
+        next if PVE::QemuServer::Drive::drive_is_cloudinit($drive);
+        if (PVE::QemuServer::Drive::drive_is_cdrom($drive)) {
+            next if $drive->{file} eq 'none';
+            return 'd';
+        }
+        return 'c';
+    }
+
+    return;
+}
