+# The sparc32 (arch: sparc) profiles: the machine, firmware, CPU and RAM combinations that were tested
+# to run (wsh-pve submodules/SPARC.md, "Supported profiles"). Validation and the QEMU command are both
+# derived from this table. Per machine: the most RAM in MB and the firmware it runs, each with the
+# '-cpu' it needs (none: the machine's default CPU) and the most CPUs (sockets x cores) it takes.
+# More than one CPU needs pve-qemu-kvm with wsh patch 0019 (11.1.3-2+wsh10): Solaris hangs without it.
+# pve-manager mirrors this table in PVE.qemu.Architecture.sparc32Profiles (www/manager6/qemu/Architecture.js).
+our $SPARC32_PROFILES = {
+    'SS-5' => {
+        'max-memory' => 256,
+        # QEMU's SS-5 has one CPU
+        firmware => {
+            'openbios-sparc32' => { 'max-cpus' => 1 },
+            'ss5.bin' => { 'max-cpus' => 1 },
+        },
+    },
+    'SS-10' => {
+        'max-memory' => 512,
+        # QEMU's limit for the machine
+        firmware => { 'openbios-sparc32' => { 'max-cpus' => 4 } },
+    },
+    'SS-20' => {
+        'max-memory' => 512,
+        firmware => {
+            'openbios-sparc32' => { 'max-cpus' => 4 },
+            # the Sun PROM doesn't start with the machine's default CPU (SuperSPARC-II), and it
+            # starts only CPU 0: another vCPU would only keep a host core busy
+            'ss20_v2.25_rom' => { cpu => 'TI-SuperSparc-50', 'max-cpus' => 1 },
+        },
+    },
+};
+our $SPARC32_DEFAULT_FIRMWARE = 'openbios-sparc32';
+our $SPARC32_DEFAULT_VGA = 'cg3';
+my $sparc32_vga_types = [qw(cg3 tcx none serial0 serial1)]; # two serial ports, ttya and ttyb
+
+my sub sparc32_machine_type {
+    my ($conf) = @_;
+    my $machine_conf = eval { parse_machine($conf->{machine}) } // {};
+    my $type = $machine_conf->{type} // $default_machines->{sparc};
+    $type =~ s/\+pve\d+$//; # a snapshot's runningmachine
+    return $type;
