+my $vga_retrace_types = qr/^(?:std|cirrus|vmware|qxl[234]?|virtio|virtio-gl)$/;
+
+=head3 assert_vga_retrace
+
+    assert_vga_retrace($conf);
+
+Dies if the C<vga> property of C<$conf> sets C<retrace> on anything but x86_64, or with a display
+type whose QEMU device has no VGA core (C<none>, C<serial*>, C<tcx>, C<cg3>).
+
+=cut
+
+sub assert_vga_retrace {
+    my ($conf) = @_;
+
+    my $vga = parse_vga($conf->{vga});
+    return if !$vga || !defined($vga->{retrace});
+    my $arch = PVE::QemuServer::Helpers::get_vm_arch($conf);
+    die "vga: 'retrace' is only supported on x86_64, not on $arch\n" if $arch ne 'x86_64';
+    my $type = $vga->{type} // 'std';
+    die "vga: 'retrace' needs a VGA-compatible type (std, cirrus, vmware, qxl, virtio),"
+        . " not '$type'\n"
+        if $type !~ $vga_retrace_types;
+
+    return;
+}
+
+=head3 assert_vga_mesa_display
+
+    assert_vga_mesa_display($conf);
+
+Dies if the C<vga> property of C<$conf> sets C<mesa-display> to a GL display without the 3dfx
+binary (C<mesa=1> on the host's architecture), with the SDL display of a C<server>, or with a
+display type that has no VNC console (C<none>, C<serial*>).
+
+=cut
+
+sub assert_vga_mesa_display {
+    my ($conf) = @_;
+
+    my $vga = parse_vga($conf->{vga});
+    my $display = $vga->{'mesa-display'} // 'none';
+    return if $display eq 'none';
+
+    my $arch = PVE::QemuServer::Helpers::get_vm_arch($conf);
+    die "vga: 'mesa-display=$display' needs 'mesa=1' on a VM of the host's architecture
+"
+        if !PVE::QemuServer::Helpers::is_qemu_3dfx_binary(
+            PVE::QemuServer::Helpers::get_command_for_arch($arch, $vga),
+        );
+    die "vga: 'mesa-display=$display' can't be used with 'server' (the SDL display)
+"
+        if defined($vga->{server}) && $vga->{server} ne '';
+    my $type = $vga->{type} // 'std';
+    die "vga: 'mesa-display=$display' needs a graphic card with a VNC console, not '$type'
+"
+        if $type eq 'none' || $type =~ m/^serial\d+$/;
