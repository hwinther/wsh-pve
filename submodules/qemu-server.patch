+=head3 get_machine_version
+
+    my $version = get_machine_version($machine_type, $vmid);
+
+The version (C<major.minor+pveN>) that C<$machine_type> runs at, for the checks that depend on it.
+QEMU's sparc machines (sun4m's C<SS-5>, C<SS-10>, C<SS-20> and C<LX>, and C<sun4u>) have no
+versioned variants: they run at the version of the QEMU binary, which is also what
+C<config_to_command> uses for them. For those this is the version of the QEMU that runs VM C<$vmid> (QMP C<query-version>), or of the
+installed QEMU when no VMID is given. Dies if there is no version, rather than letting C<min_version>
+take the next argument as the version string.
+
+=cut
+
+sub get_machine_version {
+    my ($machine_type, $vmid) = @_;
+
+    my $qemu_version;
+    if (defined($machine_type) && $machine_type =~ m/^(?:SS-\d+|sun4[a-z]|LX)(?:\+pve\d+)?$/) {
+        if (defined($vmid)) {
+            my $res = PVE::QemuServer::Monitor::mon_cmd($vmid, 'query-version');
+            $qemu_version = "$res->{qemu}->{major}.$res->{qemu}->{minor}.$res->{qemu}->{micro}";
+        } else {
+            $qemu_version = PVE::QemuServer::Helpers::kvm_user_version();
+        }
+    }
+
+    my $version = extract_version($machine_type, $qemu_version);
+    die "unable to determine the version of machine type '" . ($machine_type // '') . "'\n"
+        if !defined($version);
+
+    return $version;
+}
