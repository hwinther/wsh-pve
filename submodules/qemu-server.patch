+=head3 sparc32_esp_global
+
+    my $global = sparc32_esp_global($conf); # 'sysbus-esp.irq-latency-us=500' or undef
+
+The C<-global> value for the ESP interrupt latency that the C<machine> property of the sparc32 VM
+config C<$conf> asks for, or undef when it asks for none (0 or unset, QEMU's default).
