+=cut
+
+sub assert_sparc32_profile {
+    my ($conf) = @_;
+
+    my $join = sub { join(', ', sort { $a cmp $b } @_) };
+
+    my $machine = sparc32_machine_type($conf);
+    my $profile = $SPARC32_PROFILES->{$machine}
+        or die "sparc: machine '$machine' is not supported, use one of: "
+        . $join->(keys $SPARC32_PROFILES->%*) . "\n";
+
+    my $bios = $conf->{bios} // $SPARC32_DEFAULT_FIRMWARE;
+    if (!exists($profile->{firmware}->{$bios})) {
+        my $hint = '';
+        $hint = " (the SS-10 PROM doesn't run on QEMU's SS-10; ss20_v2.25_rom runs on SS-20)"
+            if $bios eq 'ss10_v2.25_rom';
+        die "sparc: firmware (bios) '$bios' is not supported on $machine$hint, use one of: "
+            . $join->(keys $profile->{firmware}->%*) . "\n";
+    }
+
+    my $memory = PVE::QemuServer::Memory::get_current_memory($conf->{memory});
+    die "sparc: $machine takes at most $profile->{'max-memory'} MB of memory, not $memory\n"
+        if $memory > $profile->{'max-memory'};
+
+    # Any sockets x cores up to the profile's most: sun4m has no CPU topology, the guest sees every
+    # vCPU as a CPU module of its own.
+    my $cpus = ($conf->{sockets} // 1) * ($conf->{cores} // 1);
+    my $max_cpus = $profile->{firmware}->{$bios}->{'max-cpus'};
+    if ($cpus > $max_cpus) {
+        my $openbios_max = $profile->{firmware}->{$SPARC32_DEFAULT_FIRMWARE}->{'max-cpus'};
+        my $hint = '';
+        $hint = " (the Sun PROM starts only the first CPU; $SPARC32_DEFAULT_FIRMWARE takes up to"
+            . " $openbios_max)"
+            if $bios ne $SPARC32_DEFAULT_FIRMWARE && $openbios_max > $max_cpus;
+        die "sparc: $machine with firmware $bios takes at most $max_cpus "
+            . ($max_cpus == 1 ? 'CPU' : 'CPUs')
+            . " (sockets x cores), not $cpus$hint\n";
+    }
+    # no CPU hotplug: QEMU's sun4m starts every CPU it has at boot
+    die "sparc: 'vcpus' must be the number of CPUs (sockets x cores, $cpus), not $conf->{vcpus};"
+        . " CPU hotplug is not supported\n"
+        if $conf->{vcpus} && $conf->{vcpus} != $cpus;
+    die "sparc: CPU hotplug is not supported, remove 'cpu' from 'hotplug'\n"
+        if $cpus > 1 && grep { $_ eq 'cpu' } PVE::Tools::split_list($conf->{hotplug} // '');
