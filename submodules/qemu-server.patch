diff --git a/src/test/run_machine_version_tests.pl b/src/test/run_machine_version_tests.pl
new file mode 100644
index 00000000..049450bd
--- /dev/null
+++ b/src/test/run_machine_version_tests.pl
@@ -0,0 +1,96 @@
+#!/usr/bin/perl
+
+# The version a machine type runs at (PVE::QemuServer::Machine::get_machine_version) and the checks
+# built on it. A running VM's machine type comes from QMP 'query-machines': the sparc machines
+# (sun4m's SS-5/SS-10/SS-20, sun4u) have no version in it, they run at the QEMU version.
+
+use strict;
+use warnings;
+
+use lib qw(..);
+
+use Test::MockModule;
+use Test::More;
+
+use PVE::QemuServer::Helpers;
+use PVE::QemuServer::Machine;
+use PVE::QemuServer::Monitor;
+
+my $installed_version = '11.1.3';
+my $helpers_module = Test::MockModule->new('PVE::QemuServer::Helpers');
+$helpers_module->mock(kvm_user_version => sub { return $installed_version; });
+
+# VM 100 still runs an older QEMU than the installed one
+my $monitor_module = Test::MockModule->new('PVE::QemuServer::Monitor');
+$monitor_module->mock(
+    mon_cmd => sub {
+        my ($vmid, $cmd) = @_;
+        die "unexpected monitor command '$cmd'\n" if $cmd ne 'query-version';
+        die "VM $vmid not running\n" if $vmid != 100;
+        return { qemu => { major => 10, minor => 1, micro => 2 } };
+    },
+);
+
+my $version_tests = [
+    # machine type, VMID, expected version (undef: dies)
+    ['pc-i440fx-10.0+pve1', undef, '10.0+pve1'],
+    ['pc-i440fx-10.0+pve1', 100, '10.0+pve1'],
+    ['pc-q35-9.2', undef, '9.2'],
+    ['virt-10.0+pve0', undef, '10.0'],
+    ['SS-5+pve0', undef, '11.1+pve0'],
+    ['SS-5+pve0', 100, '10.1+pve0'],
+    ['SS-5', undef, '11.1+pve0'],
+    ['SS-20+pve0', undef, '11.1+pve0'],
+    ['sun4u+pve0', undef, '11.1+pve0'],
+    ['sun4u+pve0', 100, '10.1+pve0'],
+    ['pc', undef, undef],
+    ['q35', undef, undef],
+    [undef, undef, undef],
+];
+
+for my $test ($version_tests->@*) {
+    my ($machine_type, $vmid, $expected) = $test->@*;
+    my $name = ($machine_type // 'undef') . (defined($vmid) ? " (VM $vmid)" : '');
+
+    my $got = eval { PVE::QemuServer::Machine::get_machine_version($machine_type, $vmid) };
+    if (defined($expected)) {
+        is($got, $expected, "version of $name");
+    } else {
+        like(
+            $@,
+            qr/^unable to determine the version of machine type/,
+            "no version for $name",
+        );
+    }
+}
+
+my $at_least_tests = [
+    # machine type, major, minor, pve, expected
+    ['SS-5+pve0', 10, 0, undef, 1],
+    ['SS-5+pve0', 10, 1, undef, 1],
+    ['SS-5+pve0', 12, 0, undef, 0],
+    ['sun4u+pve0', 10, 0, undef, 1],
+    ['pc-i440fx-9.2+pve1', 10, 0, undef, 0],
+    ['pc-i440fx-10.0+pve1', 10, 0, undef, 1],
+    ['pc-i440fx-10.0+pve1', 10, 0, 2, 0],
+    ['virt-10.0+pve0', 10, 1, undef, 0],
+];
+
+for my $test ($at_least_tests->@*) {
+    my ($machine_type, $major, $minor, $pve, $expected) = $test->@*;
+    my $want = "$major.$minor" . (defined($pve) ? "+pve$pve" : '');
+    is(
+        PVE::QemuServer::Machine::is_machine_version_at_least($machine_type, $major, $minor, $pve)
+            ? 1
+            : 0,
+        $expected,
+        "$machine_type at least $want",
+    );
+}
+
+# an installed QEMU whose version can't be read gives an error, not a shifted min_version call
+$installed_version = 'unknown';
+eval { PVE::QemuServer::Machine::is_machine_version_at_least('SS-5+pve0', 10, 0) };
+is($@, "unable to determine the version of machine type 'SS-5+pve0'\n", 'unknown QEMU version');
+
+done_testing();
diff --git a/src/test/run_qemu_3dfx_env_tests.pl b/src/test/run_qemu_3dfx_env_tests.pl
new file mode 100755
index 00000000..0d1db726
--- /dev/null
+++ b/src/test/run_qemu_3dfx_env_tests.pl
@@ -0,0 +1,87 @@
+#!/usr/bin/perl
+
+# prepare_qemu_3dfx_env(): the 3dfx binary gets OPENGLIDE_DIR, a per-VM directory (root, 0700) for
+# OpenGLide's OpenGLid.ini and logs; any other binary gets no OPENGLIDE_DIR (not even one left in
+# %ENV by an earlier start in the same process).
+# assert_qemu_3dfx_gl_display_host(): a VM with 'mesa-display=egl-headless' doesn't start on a node
+# with neither a GPU's render node nor /dev/udmabuf (QEMU's EGL display would stop it).
+
+use strict;
+use warnings;
+
+use lib qw(..);
+
+use File::Path qw(make_path);
+use File::Temp qw(tempdir);
+use Test::More;
+use Test::MockModule;
+
+use PVE::QemuServer::Helpers;
+
+my $base = tempdir(CLEANUP => 1);
+my $helpers = Test::MockModule->new('PVE::QemuServer::Helpers');
+$helpers->redefine(qemu_3dfx_dir => sub { return "$base/run/qemu-server/$_[0]-3dfx" });
+$helpers->redefine(get_host_arch => sub { return 'x86_64' });
+
+is(
+    PVE::QemuServer::Helpers::get_command_for_arch('x86_64', { mesa => 1 }),
+    '/usr/bin/qemu-system-x86_64-3dfx',
+    'mesa=1 on the host arch: the 3dfx binary',
+);
+
+$ENV{OPENGLIDE_DIR} = '/left/over';
+is(PVE::QemuServer::Helpers::prepare_qemu_3dfx_env(100, '/usr/bin/kvm'), undef, 'kvm: no directory');
+ok(!exists($ENV{OPENGLIDE_DIR}), 'kvm: no OPENGLIDE_DIR, a left-over one removed');
+ok(!-e "$base/run/qemu-server/100-3dfx", 'kvm: nothing created');
+
+my $dir = "$base/run/qemu-server/101-3dfx";
+is(
+    PVE::QemuServer::Helpers::prepare_qemu_3dfx_env(101, '/usr/bin/qemu-system-x86_64-3dfx'),
+    $dir,
+    '3dfx: the VM\'s directory',
+);
+is($ENV{OPENGLIDE_DIR}, $dir, '3dfx: OPENGLIDE_DIR is the VM\'s directory');
+ok(-d $dir, '3dfx: directory created, with its parents');
+is((stat($dir))[2] & 07777, 0700, '3dfx: mode 0700');
+
+open(my $fh, '>', "$dir/OpenGLid.ini") or die "$!\n";
+close($fh);
+is(PVE::QemuServer::Helpers::prepare_qemu_3dfx_env(101, '/usr/bin/qemu-system-x86_64-3dfx'),
+    $dir, '3dfx again: the same directory');
+ok(-e "$dir/OpenGLid.ini", '3dfx again: the files in it are kept');
+
+open($fh, '>', "$base/run/qemu-server/102-3dfx") or die "$!\n"; # a file where the directory goes
+close($fh);
+eval { PVE::QemuServer::Helpers::prepare_qemu_3dfx_env(102, '/usr/bin/qemu-system-x86_64-3dfx') };
+like($@, qr/^unable to create directory '\Q$base\E\/run\/qemu-server\/102-3dfx'/, '3dfx: dies when it can\'t');
+
+# vga: mesa-display=egl-headless, the GL display: refused only without a render node and without
+# /dev/udmabuf (/dev/null stands in for a character device that is there)
+my $dri = "$base/dev/dri";
+make_path($dri);
+my $udmabuf = "$base/dev/udmabuf"; # not there
+$helpers->redefine(qemu_3dfx_render_node_dir => sub { return $dri });
+$helpers->redefine(qemu_3dfx_udmabuf_path => sub { return $udmabuf });
+my $egl = { type => 'std', mesa => 1, 'mesa-display' => 'egl-headless' };
+my $gl_host = sub { eval { PVE::QemuServer::Helpers::assert_qemu_3dfx_gl_display_host(@_) }; return $@ };
+is($gl_host->(undef), '', 'no vga: no refusal');
+is($gl_host->({ type => 'std', mesa => 1 }), '', 'mesa-display unset: no refusal');
+is($gl_host->({ %$egl, 'mesa-display' => 'none' }), '', 'mesa-display=none: no refusal');
+is($gl_host->({ %$egl, mesa => 0 }), '', 'mesa=0: no refusal (the API refuses that config)');
+is(
+    $gl_host->($egl),
+    "vga: mesa-display=egl-headless needs a GPU render node ($dri/renderD*) or $udmabuf on the node,"
+        . " for Mesa's software renderer (load the module: modprobe udmabuf)\n",
+    'egl-headless, no render node, no udmabuf: refused',
+);
+open($fh, '>', "$dri/card0") or die "$!\n"; # a card without a render node doesn't count
+close($fh);
+like($gl_host->($egl), qr/^vga: mesa-display=egl-headless needs/, 'egl-headless, only card0: refused');
+$helpers->redefine(qemu_3dfx_udmabuf_path => sub { return '/dev/null' });
+is($gl_host->($egl), '', 'egl-headless, udmabuf: no refusal');
+$helpers->redefine(qemu_3dfx_udmabuf_path => sub { return $udmabuf });
+open($fh, '>', "$dri/renderD128") or die "$!\n";
+close($fh);
+is($gl_host->($egl), '', 'egl-headless, a render node: no refusal');
+
+done_testing();
