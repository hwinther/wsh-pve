+    my $profile = $SPARC32_PROFILES->{ sparc32_machine_type($conf) } or return;
+    my $firmware = $profile->{firmware}->{ $conf->{bios} // $SPARC32_DEFAULT_FIRMWARE } or return;
+    return $firmware->{cpu};
