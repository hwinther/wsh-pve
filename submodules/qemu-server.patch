+        . " built-in IDE (ide0 to ide3)\n"
+        if @drives;
+
+    my @nets = map { "net$_" } sort { $a <=> $b }
+        map { m/^net(\d+)$/ && defined($conf->{$_}) ? ($1) : () } keys $conf->%*;
+    die "sparc64: at most $p->{'max-nics'} network devices fit on PCI bus B, not "
+        . scalar(@nets) . " (" . join(', ', @nets) . ")\n"
+        if scalar(@nets) > $p->{'max-nics'};
+    for my $opt (@nets) {
+        my $net = PVE::QemuServer::Network::parse_net($conf->{$opt}, 1)
+            or die "sparc64: unable to parse $opt\n";
+        die "sparc64: network device model '$net->{model}' is not supported, use one of: "
+            . join(', ', $p->{nic}->@*) . "\n"
