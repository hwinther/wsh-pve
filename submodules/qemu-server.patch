+    for my $opt (qw(serial2 serial3)) {
+        die "sparc: $opt is not supported, the machine has two serial ports (serial0, serial1)\n"
+            if defined($conf->{$opt});
+    }
+
+    die "sparc: the QEMU guest agent is not supported\n"
+        if PVE::QemuServer::Agent::parse_guest_agent($conf->{agent})->{enabled};
+
+    my @nets = grep { m/^net\d+$/ && defined($conf->{$_}) } sort keys $conf->%*;
+    die "sparc: only one network device is supported (the built-in lance), not "
+        . join(', ', @nets) . "\n"
+        if scalar(@nets) > 1;
+    for my $opt (@nets) {
+        my $net = PVE::QemuServer::Network::parse_net($conf->{$opt}, 1)
