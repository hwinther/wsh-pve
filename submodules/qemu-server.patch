+# The config as it is once an update is applied: the current values, the pending changes and the
+# update itself (deletions included). Snapshots and the pending section are left out.
+my sub config_after_update {
+    my ($conf, $param, $delete) = @_;
+
+    my $res = { map { $_ => $conf->{$_} } grep { !ref($conf->{$_}) } keys $conf->%* };
+    my $pending = $conf->{pending} // {};
+    for my $opt (keys $pending->%*) {
+        $res->{$opt} = $pending->{$opt} if $opt ne 'delete';
+    }
+    my $pending_delete = PVE::QemuConfig->parse_pending_delete($pending->{delete});
+    delete $res->{$_} for keys $pending_delete->%*, $delete->@*;
+    $res->{$_} = $param->{$_} for keys $param->%*;
+
+    return $res;
+}
+
+# The architecture is chosen on create (it picks the QEMU binary and with it every device) and can't
+# be changed later, from any architecture to any other.
+my sub assert_arch_unchanged {
+    my ($conf, $param, $delete) = @_;
+
+    return if !defined($param->{arch}) && !grep { $_ eq 'arch' } $delete->@*;
+
+    my $current = PVE::QemuServer::Helpers::get_vm_arch($conf);
+    my $new = PVE::QemuServer::Helpers::get_vm_arch(config_after_update($conf, $param, $delete));
+    raise_param_exc({
+        arch => "the architecture of an existing VM can't be changed (it is '$current')",
+    })
+        if $new ne $current;
+}
