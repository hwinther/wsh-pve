diff --git a/www/manager6/qemu/NvramEdit.js b/www/manager6/qemu/NvramEdit.js
new file mode 100644
index 00000000..547000bb
--- /dev/null
+++ b/www/manager6/qemu/NvramEdit.js
@@ -0,0 +1,80 @@
+// sparc32 only: a volume that keeps the machine's NVRAM (the sun4m M48T08) across starts, so the
+// settings of a Sun boot PROM (setenv diag-switch? false, auto-boot?, boot-device) last
+Ext.define('PVE.qemu.NvramInputPanel', {
+    extend: 'Proxmox.panel.InputPanel',
+    alias: 'widget.pveNvramInputPanel',
+
+    onGetValues: function (values) {
+        let drive = {};
+        if (values.hdimage) {
+            drive.file = values.hdimage;
+        } else {
+            // the size is fixed (qemu-server allocates 4 MiB), so just use 1
+            drive.file = values.hdstorage + ':1';
+        }
+        drive.format = values.diskformat;
+
+        return { nvram0: PVE.Parser.printQemuDrive(drive) };
+    },
+
+    setNodename: function (nodename) {
+        let me = this;
+        me.down('#hdstorage').setNodename(nodename);
+        me.down('#hdimage').setStorage(undefined, nodename);
+    },
+
+    initComponent: function () {
+        let me = this;
+
+        me.items = [
+            {
+                xtype: 'pveDiskStorageSelector',
+                name: 'nvram0',
+                storageLabel: gettext('Storage'),
+                storageContent: 'images',
+                nodename: me.nodename,
+                hideSize: true,
+                autoSelect: true,
+            },
+            {
+                xtype: 'displayfield',
+                userCls: 'pmx-hint',
+                value: gettext(
+                    'Keeps the NVRAM across starts, so what a Sun boot PROM stores with setenv' +
+                        ' (diag-switch?, auto-boot?, boot-device) lasts. Takes effect at the next' +
+                        ' start.',
+                ),
+            },
+        ];
+
+        me.callParent();
+    },
+});
+
+Ext.define('PVE.qemu.NvramEdit', {
+    extend: 'Proxmox.window.Edit',
+
+    isAdd: true,
+    isCreate: true,
+    subject: gettext('NVRAM'),
+
+    width: 450,
+    initComponent: function () {
+        let me = this;
+
+        let nodename = me.pveSelNode.data.node;
+        if (!nodename) {
+            throw 'no node name specified';
+        }
+
+        me.items = [
+            {
+                xtype: 'pveNvramInputPanel',
+                nodename: nodename,
+                isCreate: true,
+            },
+        ];
+
+        me.callParent();
+    },
+});
