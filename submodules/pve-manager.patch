diff --git a/www/manager6/window/MediaVolumeEdit.js b/www/manager6/window/MediaVolumeEdit.js
new file mode 100644
index 00000000..95f53ff4
--- /dev/null
+++ b/www/manager6/window/MediaVolumeEdit.js
@@ -0,0 +1,347 @@
+// The ISO and floppy tabs of a mirror storage (reference/mirror): rename a volume in place (a link
+// or a file, never a link's target) and link a volume of another storage in under a folder name.
+// The folders are kept in the volume's name, joined with '__' (PVE.Utils.media_volume_name).
+
+// The folder and file name fields of both windows and the resulting volume name.
+Ext.define('PVE.panel.MediaVolumeName', {
+    extend: 'Ext.container.Container',
+    alias: 'widget.pveMediaVolumeName',
+
+    layout: 'anchor',
+    defaults: {
+        anchor: '100%',
+        labelWidth: 120,
+    },
+
+    // storage and content of the new volume, and its current name (rename) to refuse unchanged
+    storage: undefined,
+    content: 'iso',
+    currentName: undefined,
+
+    // the new volume's name, or undefined while the fields don't make a valid one
+    getName: function () {
+        let me = this;
+        let { name, error } = me.compute();
+        return error ? undefined : name;
+    },
+
+    compute: function () {
+        let me = this;
+        let result = PVE.Utils.media_volume_name(
+            me.down('[name=folder]').getValue(),
+            me.down('[name=file]').getValue(),
+            me.content,
+        );
+        if (!result.error && me.currentName !== undefined && result.name === me.currentName) {
+            result.error = gettext('That is the current name');
+        }
+        return result;
+    },
+
+    setNameParts: function (folder, file) {
+        let me = this;
+        me.down('[name=folder]').setValue(folder);
+        me.down('[name=file]').setValue(file);
+    },
+
+    update: function () {
+        let me = this;
+        let { name, error } = me.compute();
+        let volid = `${me.storage}:${me.content}/${name}`;
+        me.down('#volume').setValue(
+            error
+                ? `<span class="pmx-hint">${Ext.htmlEncode(error)}</span>`
+                : Ext.htmlEncode(volid),
+        );
+        me.down('[name=file]').validate();
+        me.fireEvent('namechange', me, error ? undefined : name);
+    },
+
+    initComponent: function () {
+        let me = this;
+        let changed = () => me.update();
+        me.items = [
+            {
+                xtype: 'textfield',
+                name: 'folder',
+                fieldLabel: gettext('Folder'),
+                emptyText: gettext('Top level, or e.g. Solaris / 2.6'),
+                listeners: { change: changed },
+            },
+            {
+                xtype: 'textfield',
+                name: 'file',
+                fieldLabel: gettext('File name'),
+                allowBlank: false,
+                validator: () => me.compute().error || true,
+                listeners: { change: changed },
+            },
+            {
+                xtype: 'displayfield',
+                itemId: 'volume',
+                htmlEncode: false,
+                fieldLabel: gettext('Volume'),
+                value: '',
+            },
+        ];
+        me.callParent();
+    },
+});
+
+Ext.define('PVE.window.MediaRename', {
+    extend: 'Proxmox.window.Edit',
+    alias: 'widget.pveMediaRename',
+
+    isCreate: true,
+    method: 'PUT',
+    title: gettext('Rename'),
+    submitText: gettext('Rename'),
+    width: 600,
+
+    // nodename, storage, content ('iso' or 'floppy') and the volid to rename
+    nodename: undefined,
+    storage: undefined,
+    content: 'iso',
+    volid: undefined,
+
+    getValues: function () {
+        return { rename: this.down('pveMediaVolumeName').getName() };
+    },
+
+    // The VMs (that this user may see) whose config uses the volume: a rename leaves them with
+    // the old volume ID.
+    findUsers: function () {
+        let me = this;
+        let hint = me.down('#usedBy');
+        Proxmox.Utils.API2Request({
+            url: '/cluster/resources',
+            params: { type: 'vm' },
+            method: 'GET',
+            failure: () => hint.setValue(gettext('Could not check which VMs use it.')),
+            success: function (response) {
+                let vms = (response.result.data || []).filter((vm) => vm.type === 'qemu');
+                if (vms.length > 200) {
+                    hint.setValue(gettext('Too many VMs to check which ones use it.'));
+                    return;
+                }
+                let users = [];
+                let pending = vms.length;
+                let done = () => {
+                    if (me.destroyed || --pending > 0) {
+                        return;
+                    }
+                    users.sort((a, b) => a.vmid - b.vmid);
+                    hint.setValue(
+                        users.length
+                            ? Ext.String.format(
+                                  gettext('Used by: {0}'),
+                                  users
+                                      .map((vm) =>
+                                          Ext.htmlEncode(
+                                              vm.name ? `${vm.vmid} (${vm.name})` : `${vm.vmid}`,
+                                          ),
+                                      )
+                                      .join(', '),
+                              )
+                            : gettext('No VM you can see uses it.'),
+                    );
+                    me.down('#usedByIcon').setHidden(!users.length);
+                };
+                if (!pending) {
+                    pending = 1;
+                    done();
+                    return;
+                }
+                for (const vm of vms) {
+                    Proxmox.Utils.API2Request({
+                        url: `/nodes/${vm.node}/qemu/${vm.vmid}/config`,
+                        method: 'GET',
+                        failure: done,
+                        success: function (res) {
+                            let config = res.result.data || {};
+                            let uses = Object.values(config).some(
+                                (value) =>
+                                    typeof value === 'string' && value.split(',')[0] === me.volid,
+                            );
+                            if (uses) {
+                                // the config's name: the resource list's can lag behind
+                                users.push({ vmid: vm.vmid, name: config.name });
+                            }
+                            done();
+                        },
+                    });
+                }
+            },
+        });
+    },
+
+    initComponent: function () {
+        let me = this;
+        if (!me.nodename || !me.storage || !me.volid) {
+            throw 'nodename, storage and volid are needed';
+        }
+        me.url = `/nodes/${me.nodename}/storage/${me.storage}/content/${me.volid}`;
+        let parts = PVE.Utils.volume_path_parts({ volid: me.volid, content: me.content });
+        let currentName = parts.join(PVE.Utils.mirrorSeparator);
+        let file = parts.pop();
+
+        me.items = [
+            {
+                xtype: 'displayfield',
+                fieldLabel: gettext('Current volume'),
+                labelWidth: 120,
+                htmlEncode: false,
+                value: Ext.htmlEncode(me.volid),
+            },
+            {
+                xtype: 'pveMediaVolumeName',
+                storage: me.storage,
+                content: me.content,
+                currentName,
+            },
+            {
+                xtype: 'container',
+                layout: 'hbox',
+                margin: '5 0 0 0',
+                items: [
+                    {
+                        xtype: 'box',
+                        itemId: 'usedByIcon',
+                        hidden: true,
+                        html: '<i class="fa fa-exclamation-triangle warning"></i>',
+                        margin: '0 5 0 0',
+                    },
+                    {
+                        xtype: 'displayfield',
+                        itemId: 'usedBy',
+                        htmlEncode: false,
+                        flex: 1,
+                        value: gettext('Checking which VMs use it...'),
+                    },
+                ],
+            },
+            {
+                xtype: 'displayfield',
+                userCls: 'pmx-hint',
+                value: gettext(
+                    'Renaming changes the volume ID. VMs whose CD/DVD or floppy drive uses it keep the old ID and fail to start until the drive is set to the new one.',
+                ),
+            },
+        ];
+
+        me.callParent();
+
+        let names = me.down('pveMediaVolumeName');
+        names.setNameParts(parts.join(' / '), file);
+        me.findUsers();
+    },
+});
+
+Ext.define('PVE.window.MediaLink', {
+    extend: 'Proxmox.window.Edit',
+    alias: 'widget.pveMediaLink',
+
+    isCreate: true,
+    method: 'POST',
+    title: gettext('Add link from storage'),
+    submitText: gettext('Add link'),
+    width: 640,
+
+    // nodename, storage (the one the link goes into) and content ('iso' or 'floppy')
+    nodename: undefined,
+    storage: undefined,
+    content: 'iso',
+
+    getValues: function () {
+        let me = this;
+        let volid = me.down('#source').getValue() || '';
+        let [, sourceStorage, volume] = volid.match(/^([^:]+):(.*)$/) || [];
+        return {
+            'source-storage': sourceStorage,
+            volume,
+            filename: me.down('pveMediaVolumeName').getName(),
+            content: me.content,
+        };
+    },
+
+    initComponent: function () {
+        let me = this;
+        if (!me.nodename || !me.storage) {
+            throw 'nodename and storage are needed';
+        }
+        me.url = `/nodes/${me.nodename}/storage/${me.storage}/link-volume`;
+
+        me.items = [
+            {
+                xtype: 'fieldset',
+                title: gettext('Source'),
+                items: [
+                    {
+                        // the selector of the CD/DVD and floppy editors, with its search field
+                        xtype: me.content === 'floppy' ? 'pveFloppySelector' : 'pveIsoSelector',
+                        itemId: 'source',
+                        nodename: me.nodename,
+                        labelWidth: 120,
+                        labelAlign: 'left',
+                        listeners: {
+                            change: (selector) => me.sourceChanged(selector.getValue()),
+                        },
+                    },
+                ],
+            },
+            {
+                xtype: 'fieldset',
+                title: Ext.String.format(gettext('Link in {0}'), me.storage),
+                items: [
+                    {
+                        xtype: 'pveMediaVolumeName',
+                        storage: me.storage,
+                        content: me.content,
+                    },
+                ],
+            },
+            {
+                xtype: 'displayfield',
+                userCls: 'pmx-hint',
+                value: gettext(
+                    'The link points at the volume, relative when both are on one file system. On a node where the source is not reachable the link is listed as unavailable.',
+                ),
+            },
+        ];
+
+        me.callParent();
+
+        // the source can't be in the storage the link goes into
+        let storageSelector = me.down('#source').lookup('storage');
+        storageSelector.getStore().addFilter({
+            id: 'pve-media-link-other-storage',
+            filterFn: (rec) => rec.data.storage !== me.storage,
+        });
+    },
+
+    // a new source: the link's folder and file name from the source's name, until edited
+    sourceChanged: function (volid) {
+        let me = this;
+        let names = me.down('pveMediaVolumeName');
+        if (!volid) {
+            return;
+        }
+        let parts = PVE.Utils.volume_path_parts({ volid, content: me.content });
+        let file = parts.pop();
+        if (!me.nameEdited) {
+            me.settingName = true;
+            names.setNameParts(parts.join(' / '), file);
+            me.settingName = false;
+        }
+    },
+
+    afterRender: function () {
+        let me = this;
+        me.callParent(arguments);
+        me.down('pveMediaVolumeName').on('namechange', () => {
+            if (!me.settingName) {
+                me.nameEdited = true;
+            }
+        });
+    },
+});
