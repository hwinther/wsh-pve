diff --git a/src/test/media_volume_test.pm b/src/test/media_volume_test.pm
new file mode 100644
index 0000000..eee6e25
--- /dev/null
+++ b/src/test/media_volume_test.pm
@@ -0,0 +1,260 @@
+package PVE::Storage::TestMediaVolume;
+
+# wsh: renaming iso/floppy volumes in place, linking a volume of another storage into a mirror
+# storage, and the listing of a link whose target isn't reachable (reference/mirror).
+
+use strict;
+use warnings;
+
+use lib qw(..);
+
+use File::Path qw(make_path);
+use File::Temp;
+use PVE::Storage;
+use PVE::Tools qw(file_set_contents);
+use Test::MockModule;
+use Test::More;
+
+my $base = File::Temp->newdir();
+my $mirror = "$base/mirror";
+my $nas = "$base/nas";
+my $plain = "$base/plain";
+my $described = "$base/described";
+make_path(
+    "$mirror/template/iso",
+    "$mirror/template/floppy",
+    "$nas/template/iso",
+    "$nas/template/floppy",
+    "$plain/template/iso",
+    "$described/template/iso",
+);
+
+my $cfg = {
+    ids => {
+        mirror => { type => 'dir', path => $mirror, content => { iso => 1, floppy => 1 } },
+        nas => { type => 'dir', path => $nas, content => { iso => 1, floppy => 1 } },
+        plain => { type => 'dir', path => $plain, content => { iso => 1 } },
+        described => { type => 'dir', path => $described, content => { iso => 1 } },
+        shared => {
+            type => 'dir',
+            path => "$base/shared",
+            shared => 1,
+            content => { iso => 1 },
+        },
+        lvm => { type => 'lvm', vgname => 'pve', content => { images => 1 } },
+    },
+};
+
+# no pmxcfs, no storage activation in a unit test
+my $mock_plugin = Test::MockModule->new('PVE::Storage::Plugin');
+$mock_plugin->redefine(cluster_lock_storage => sub { my ($class, $id, $shared, $t, $f) = @_; $f->() });
+my $mock_storage = Test::MockModule->new('PVE::Storage');
+$mock_storage->redefine(activate_storage => sub { });
+my $mock_cluster = Test::MockModule->new('PVE::Cluster');
+$mock_cluster->redefine(get_vmlist => sub { return { ids => {} } });
+
+sub put { file_set_contents($_[0], $_[1] // 'x') }
+
+sub dies_like {
+    my ($code, $re, $what) = @_;
+    eval { $code->() };
+    like($@ // '', $re, $what);
+}
+
+# names
+for my $ok (
+    ['Solaris__2.6__solaris_2.6_598_sparc.iso', 'iso'],
+    ['plain.ISO', 'iso'],
+    ['big.img', 'iso'],
+    ['DOS__6.22__disk1.img', 'floppy'],
+    ['a___b.vfd', 'floppy'],
+) {
+    eval { PVE::Storage::check_media_volume_name(@$ok) };
+    is($@, '', "name '$ok->[0]' is a good $ok->[1] name");
+}
+for my $bad (
+    ['Solaris/2.6/x.iso', 'iso', qr/without '\/'/],
+    ['with space.iso', 'iso', qr/only A-Z/],
+    ['comma,x.iso', 'iso', qr/only A-Z/],
+    ['.hidden.iso', 'iso', qr/doesn't start with '\.'/],
+    ['disk.ima', 'iso', qr/end in \.iso or \.img/],
+    ['cd.iso', 'floppy', qr/end in \.img, \.ima or \.vfd/],
+    ['.iso', 'iso', qr/doesn't start/],
+    ['__a.iso', 'iso', qr/empty folder/],
+    ['a____b.iso', 'iso', qr/empty folder/],
+    ['', 'iso', qr/no name/],
+) {
+    dies_like(sub { PVE::Storage::check_media_volume_name($bad->[0], $bad->[1]) },
+        $bad->[2], "name '$bad->[0]' is refused for $bad->[1]");
+}
+
+# rename: a regular file
+put("$plain/template/iso/old.iso");
+is(
+    PVE::Storage::rename_media_volume($cfg, 'plain:iso/old.iso', 'Folder__new.iso'),
+    'plain:iso/Folder__new.iso',
+    'rename returns the new volume ID',
+);
+ok(-f "$plain/template/iso/Folder__new.iso" && !-e "$plain/template/iso/old.iso",
+    'rename moved the file');
+
+# rename: a link is renamed, not its target
+put("$nas/template/iso/target.iso", 'target');
+symlink('/no/such/place/elsewhere.iso', "$mirror/template/iso/Dangling__x.iso");
+symlink("$nas/template/iso/target.iso", "$mirror/template/iso/link.iso");
+PVE::Storage::rename_media_volume($cfg, 'mirror:iso/link.iso', 'Sun__Solaris__link.iso');
+is(readlink("$mirror/template/iso/Sun__Solaris__link.iso"),
+    "$nas/template/iso/target.iso", 'the renamed link keeps its target');
+ok(-f "$nas/template/iso/target.iso", 'the target is still there');
+ok(!-l "$mirror/template/iso/link.iso", 'the old link name is gone');
+
+# rename: a dangling link can be renamed too
+PVE::Storage::rename_media_volume($cfg, 'mirror:iso/Dangling__x.iso', 'Gone__x.iso');
+ok(-l "$mirror/template/iso/Gone__x.iso", 'a dangling link can be renamed');
+
+# rename: floppy
+put("$mirror/template/floppy/disk1.img", 'f');
+is(PVE::Storage::rename_media_volume($cfg, 'mirror:floppy/disk1.img', 'DOS__disk1.img'),
+    'mirror:floppy/DOS__disk1.img', 'a floppy volume is renamed');
+
+# rename: refusals
+put("$mirror/template/iso/taken.iso");
+dies_like(
+    sub {
+        PVE::Storage::rename_media_volume($cfg, 'mirror:iso/Sun__Solaris__link.iso', 'taken.iso');
+    },
+    qr/already exists/,
+    'rename refuses a name that exists',
+);
+dies_like(
+    sub {
+        PVE::Storage::rename_media_volume($cfg, 'mirror:iso/Sun__Solaris__link.iso', 'Gone__x.iso');
+    },
+    qr/already exists/,
+    'rename refuses the name of a dangling link',
+);
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'mirror:iso/taken.iso', 'a/b.iso') },
+    qr/without '\/'/, 'rename refuses a name with a slash');
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'mirror:iso/taken.iso', 'taken.vfd') },
+    qr/end in \.iso or \.img/, 'rename refuses an extension of another content type');
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'mirror:iso/missing.iso', 'x.iso') },
+    qr/does not exist/, 'rename refuses a volume that does not exist');
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'mirror:iso/taken.iso', 'taken.iso') },
+    qr/already has the name/, 'rename refuses the same name');
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'lvm:vm-100-disk-0', 'x.iso') },
+    qr/only iso and floppy/, 'rename refuses other volume types');
+put("$described/wsh-mirror.yaml", "version: 1\n");
+put("$described/template/iso/d.iso");
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'described:iso/d.iso', 'e.iso') },
+    qr/description file .*wsh-mirror\.yaml.*wsh-lab mirror apply/,
+    'rename refuses a storage with a description file',
+);
+ok(-e "$described/template/iso/d.iso", '... and leaves the volume');
+unlink("$described/wsh-mirror.yaml");
+put("$described/.wsh-mirror-state.json", "{}\n");
+dies_like(
+    sub { PVE::Storage::rename_media_volume($cfg, 'described:iso/d.iso', 'e.iso') },
+    qr/description file .*\.wsh-mirror-state\.json/,
+    'rename refuses a storage whose links apply keeps (state file, description elsewhere)',
+);
+
+# link: relative on one file system, inside its mount
+is(
+    PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'mirror', 'NAS__target.iso'),
+    'mirror:iso/NAS__target.iso',
+    'link returns the new volume ID',
+);
+my $text = readlink("$mirror/template/iso/NAS__target.iso");
+unlike($text, qr{^/}, "a link on the same file system is relative ($text)");
+is(PVE::Tools::file_get_contents("$mirror/template/iso/NAS__target.iso"),
+    'target', 'the link leads to the source volume');
+
+# link: absolute to another file system
+is(PVE::Storage::media_link_text('/proc/version', "$mirror/template/iso"),
+    '/proc/version', 'a link to another file system is absolute');
+
+# link: content type of the link
+put("$nas/template/iso/boot.img", 'b');
+is(
+    PVE::Storage::link_media_volume(
+        $cfg, 'nas:iso/boot.img', 'mirror', 'Boot__boot.img', 'floppy',
+    ),
+    'mirror:floppy/Boot__boot.img',
+    'an .img ISO can be linked as a floppy',
+);
+ok(-l "$mirror/template/floppy/Boot__boot.img", '... in the floppy directory');
+
+# link: refusals
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'mirror', 'taken.iso') },
+    qr/already exists/, 'link refuses a name that exists');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'mirror', 'Sub/x.iso') },
+    qr/without '\/'/, 'link refuses a name with a slash');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'mirror', 'x.vfd') },
+    qr/end in \.iso or \.img/, 'link refuses an extension of another content type');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'mirror:iso/taken.iso', 'mirror', 'x.iso') },
+    qr/rename the volume instead/, 'link refuses a source in the same storage');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/missing.iso', 'mirror', 'x.iso') },
+    qr/isn't a file on this node/, 'link refuses a source that is not there');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'shared', 'x.iso') },
+    qr/shared and 'nas' isn't/, 'link refuses a link in a shared storage to a local volume');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'lvm', 'x.iso') },
+    qr/of type 'lvm'/, 'link refuses a storage type that cannot hold links');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'plain', 'x.img', 'floppy') },
+    qr/no 'floppy' content/, 'link refuses a content type the storage does not have');
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg, 'nas:iso/target.iso', 'described', 'x.iso') },
+    qr/description file/, 'link refuses a storage with a description file');
+
+# a shared source restricted to fewer nodes than the shared mirror
+my $cfg2 = {
+    ids => {
+        %{ $cfg->{ids} },
+        nas2 => {
+            type => 'dir',
+            path => $nas,
+            shared => 1,
+            nodes => { a => 1 },
+            content => { iso => 1 },
+        },
+        shared2 => {
+            type => 'dir',
+            path => "$base/shared2",
+            shared => 1,
+            nodes => { a => 1, b => 1 },
+            content => { iso => 1 },
+        },
+    },
+};
+dies_like(
+    sub { PVE::Storage::link_media_volume($cfg2, 'nas2:iso/target.iso', 'shared2', 'x.iso') },
+    qr/restricted to fewer nodes .*\(b\)/,
+    'link refuses a source storage on fewer nodes than the shared mirror',
+);
+
+# listing: a link whose target is gone is listed with size 0, flagged unavailable
+my $list = PVE::Storage::DirPlugin->list_volumes('mirror', $cfg->{ids}->{mirror}, undef, ['iso']);
+my ($gone) = grep { $_->{volid} eq 'mirror:iso/Gone__x.iso' } @$list;
+ok($gone, 'a dangling ISO link is listed');
+is($gone->{size}, 0, '... with size 0');
+ok($gone->{unavailable}, '... flagged unavailable');
+my ($fine) = grep { $_->{volid} eq 'mirror:iso/NAS__target.iso' } @$list;
+is($fine->{size}, 6, "a link that leads somewhere has its target's size");
+ok(!$fine->{unavailable}, '... and is not flagged');
+
+done_testing();
+
+1;
