+# wsh: mirror storages (ISO and floppy images as files or symlinks, the folders in the name joined
+# with '__'): rename an iso or floppy volume in place, and link a volume of another storage into one
+# under a name of its own. Only storage types whose ISO and floppy directories are plain directories
+# that can hold symlinks; the same list as `wsh-lab mirror` (e2e/sparc/mirror.py, MIRROR_TYPES).
+our @MEDIA_LINK_STORAGE_TYPES = qw(dir btrfs nfs cephfs cifs);
+
+# Files at a storage's root that mean `wsh-lab mirror` keeps its links from a description file: the
+# file itself, and the state `apply` writes there even when the file is elsewhere (--config).
+our @MIRROR_DESCRIPTION_FILES = ('wsh-mirror.yaml', '.wsh-mirror-state.json');
+
+my $MEDIA_EXT_RE = {
+    iso => $ISO_EXT_RE_0,
+    floppy => $FLOPPY_EXT_RE_0,
+};
+
+# Dies unless $name is a good name for a new $vtype ('iso' or 'floppy') volume: one file name (no
+# '/'), only the characters an upload keeps (A-Z a-z 0-9 _ . -), not hidden, an extension of the
+# content type, and no empty part between '__' separators (the UI wouldn't show its folders).
+sub check_media_volume_name {
+    my ($name, $vtype) = @_;
+
+    my $ext_re = $MEDIA_EXT_RE->{$vtype} // die "'$vtype' isn't an iso or floppy content type\n";
+
+    die "no name given\n" if !defined($name) || $name eq '';
+    die "'$name': a volume name is one file name, without '/' (folders are joined with '__')\n"
+        if $name =~ m!/!;
+    die "'$name': only A-Z a-z 0-9 _ . - in a volume name\n" if $name !~ m/^[A-Za-z0-9_.-]+$/;
+    die "'$name': a volume name doesn't start with '.'\n" if $name =~ m/^\./;
+    my $exts = $vtype eq 'iso' ? '.iso or .img' : '.img, .ima or .vfd';
+    die "'$name': $vtype volumes end in $exts\n" if $name !~ m/^.+$ext_re$/;
+    die "'$name': an empty folder between '__' separators\n"
+        if grep { $_ eq '' } split(/__/, $name, -1);
+
+    return;
+}
+
+# The description file (or apply's state) at the root of a storage that `wsh-lab mirror` manages, or
+# undef.
+sub mirror_description_file {
+    my ($scfg) = @_;
+
+    my $root = $scfg->{path} // return undef;
+    for my $name (@MIRROR_DESCRIPTION_FILES) {
+        return "$root/$name" if -e "$root/$name";
+    }
+    return undef;
+}
+
+# The config of a storage that may get renamed or linked $vtype volumes; dies with the reason when it
+# can't.
+my sub media_link_storage {
+    my ($cfg, $storeid, $vtype) = @_;
+
+    my $scfg = storage_config($cfg, $storeid);
+
+    die "storage '$storeid' is of type '$scfg->{type}': volumes can be renamed and linked in "
+        . join(', ', @MEDIA_LINK_STORAGE_TYPES)
+        . " storages only\n"
+        if !grep { $_ eq $scfg->{type} } @MEDIA_LINK_STORAGE_TYPES;
+    die "storage '$storeid' has no '$vtype' content\n" if !$scfg->{content}->{$vtype};
+
+    if (my $file = mirror_description_file($scfg)) {
+        die "storage '$storeid' keeps its links in a description file ($file): edit its"
+            . " entries and run `wsh-lab mirror apply`, which would otherwise undo the change\n";
+    }
+
+    return $scfg;
+}
+
+# The topmost directory above $dir (a real path) on the same file system: its mount point, as
+# `wsh-lab mirror` finds it (a bind mount of the same file system doesn't count).
+my sub mount_point_of {
+    my ($dir) = @_;
+
+    my $dev = (stat($dir))[0];
+    while ($dir ne '/') {
+        my $parent = dirname($dir);
+        my $pdev = (stat($parent))[0];
+        last if !defined($pdev) || $pdev != $dev;
+        $dir = $parent;
+    }
+    return $dir;
+}
+
+# What a link in $link_dir to $target holds: relative when the target is on the link directory's
+# file system, inside its mount (an NFS export that holds both, so any mount path of the export
+# finds it), the absolute path otherwise. The rule of `wsh-lab mirror` with `links: auto`.
+sub media_link_text {
+    my ($target, $link_dir) = @_;
+
+    my $real_dir = abs_path($link_dir);
+    my $real_target_dir = abs_path(dirname($target));
+    return $target if !defined($real_dir) || !defined($real_target_dir);
+    my $real_target = ($real_target_dir eq '/' ? '' : $real_target_dir) . '/' . basename($target);
+
+    my $dir_dev = (stat($real_dir))[0];
+    my $target_dev = (stat($real_target_dir))[0];
+    return $target if !defined($dir_dev) || !defined($target_dev) || $dir_dev != $target_dev;
+
+    my $mount = mount_point_of($real_dir);
+    my $inside = $mount eq '/' ? 1 : index($real_target, "$mount/") == 0;
+    return $target if !$inside;
+
+    return File::Spec->abs2rel($real_target, $real_dir);
+}
+
+=head3 rename_media_volume
+
+    my $new_volid = PVE::Storage::rename_media_volume($cfg, $volid, $new_name);
+
+wsh: Renames the C<iso> or C<floppy> volume C<$volid> to C<$new_name> (a file name, folders joined
+with C<__>) in the same storage. A symlink is renamed itself, never its target. Refuses a name that
+exists (a dangling link included), a bad name (C<check_media_volume_name>), a storage type that
+isn't in C<@MEDIA_LINK_STORAGE_TYPES>, and a storage whose links C<wsh-lab mirror> keeps from a
+description file. Returns the new volume ID.
+
+=cut
+
+sub rename_media_volume {
+    my ($cfg, $volid, $new_name) = @_;
+
+    my ($storeid, $volname) = parse_volume_id($volid);
+    my $scfg = storage_config($cfg, $storeid);
+    my $plugin = PVE::Storage::Plugin->lookup($scfg->{type});
+    my ($vtype, $name) = $plugin->parse_volname($volname);
+
+    die "only iso and floppy volumes can be renamed here, not '$vtype'\n"
+        if $vtype ne 'iso' && $vtype ne 'floppy';
+    media_link_storage($cfg, $storeid, $vtype);
+    check_media_volume_name($new_name, $vtype);
+    die "volume '$volid' already has the name '$new_name'\n" if $new_name eq $name;
+
+    activate_storage($cfg, $storeid);
+
+    my $dir = $plugin->get_subdir($scfg, $vtype);
+    my $old_path = "$dir/$name";
+    my $new_path = "$dir/$new_name";
+    my $new_volid = "$storeid:$vtype/$new_name";
+
+    $plugin->cluster_lock_storage(
+        $storeid,
+        $scfg->{shared},
+        undef,
+        sub {
+            die "volume '$volid' does not exist\n" if !lstat($old_path);
+            die "'$old_path' is a directory, not a volume\n" if !-l $old_path && -d _;
+            # lstat: a dangling link of that name is taken too
+            die "volume '$new_volid' already exists\n" if lstat($new_path);
+            rename($old_path, $new_path)
+                || die "rename '$old_path' to '$new_path' failed - $!\n";
+        },
+    );
+
+    return $new_volid;
+}
+
+=head3 link_media_volume
+
+    my $volid = PVE::Storage::link_media_volume($cfg, $source_volid, $storeid, $name, $vtype);
+
+wsh: Creates C<$storeid:$vtype/$name>, a symlink to the C<iso> or C<floppy> volume C<$source_volid>
+of another storage (C<$vtype> defaults to the source's type). The link is relative when the source
+is on the target directory's file system inside its mount, absolute otherwise
+(C<media_link_text>). Refuses what C<rename_media_volume> refuses, a source in the same storage, a
+source that isn't a file on this node, and a link in a shared storage to a volume that not every
+node of that storage has (a source storage that isn't shared, or is restricted to fewer nodes).
+Returns the new volume ID.
+
+=cut
+
+sub link_media_volume {
+    my ($cfg, $source_volid, $storeid, $name, $vtype) = @_;
+
+    my ($source_storeid, $source_volname) = parse_volume_id($source_volid);
+    die "the source is in storage '$storeid' itself: rename the volume instead\n"
+        if $source_storeid eq $storeid;
+
+    my $source_scfg = storage_config($cfg, $source_storeid);
+    my $source_plugin = PVE::Storage::Plugin->lookup($source_scfg->{type});
+    my ($source_vtype) = $source_plugin->parse_volname($source_volname);
+    die "only iso and floppy volumes can be linked, not '$source_vtype'\n"
+        if $source_vtype ne 'iso' && $source_vtype ne 'floppy';
+    $vtype //= $source_vtype;
+
+    my $scfg = media_link_storage($cfg, $storeid, $vtype);
+    check_media_volume_name($name, $vtype);
+
+    # A link in a shared storage is seen by every node of that storage: it must lead to something
+    # every one of them has (PVE mounts a shared storage at the same path on each of its nodes).
+    if ($scfg->{shared}) {
+        die "storage '$storeid' is shared and '$source_storeid' isn't: the link would lead"
+            . " nowhere on the other nodes\n"
+            if !$source_scfg->{shared};
+        if (my $source_nodes = $source_scfg->{nodes}) {
+            my @missing =
+                $scfg->{nodes}
+                ? grep { !$source_nodes->{$_} } sort keys %{ $scfg->{nodes} }
+                : ('(all nodes)');
+            die "storage '$source_storeid' is restricted to fewer nodes than '$storeid' ("
+                . join(', ', @missing)
+                . "): the link would lead nowhere there\n"
+                if @missing;
+        }
+    }
+
+    activate_storage($cfg, $source_storeid);
+    activate_storage($cfg, $storeid);
+
+    my $source_path = path($cfg, $source_volid);
+    die "volume '$source_volid' isn't a file on this node ($source_path)\n" if !-f $source_path;
+
+    my $plugin = PVE::Storage::Plugin->lookup($scfg->{type});
+    my $dir = $plugin->get_subdir($scfg, $vtype);
+    File::Path::make_path($dir) if !-d $dir;
+    my $dest = "$dir/$name";
+    my $volid = "$storeid:$vtype/$name";
+    # the link's text comes from paths read from the file system (abs_path): untaint it for the API
+    # daemons, which run with -T
+    my ($text) = media_link_text($source_path, $dir) =~ m/^([^\0\n]+)$/
+        or die "unexpected link target for '$source_path'\n";
+
+    $plugin->cluster_lock_storage(
+        $storeid,
+        $scfg->{shared},
+        undef,
+        sub {
+            die "volume '$volid' already exists\n" if lstat($dest);
+            symlink($text, $dest) || die "symlink '$dest' -> '$text' failed - $!\n";
+        },
+    );
+
+    return $volid;
+}
+
 sub volume_qemu_snapshot_method {
     my ($cfg, $volid) = @_;
 
