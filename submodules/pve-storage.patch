+# wsh: a mirror storage's link to an ISO or floppy volume of another storage (reference/mirror).
+# Beside upload and download-url, the other ways a file gets into a storage's ISO and floppy
+# directories: the content/{volume} path takes the whole rest of the URL as the volume ID, so it
+# has no sub-paths for it.
+__PACKAGE__->register_method({
+    name => 'link_volume',
+    path => '{storage}/link-volume',
+    method => 'POST',
+    description => "Link an ISO or floppy volume of another storage into this storage under a"
+        . " name of its own (a symlink; folders in the name joined with '__'). (wsh-pve)",
+    proxyto => 'node',
+    permissions => {
+        description => "Requires 'Datastore.Allocate' on this storage and on the source volume's"
+            . " storage: the link makes the source volume usable by everyone who may use this"
+            . " storage.",
+        check => [
+            'and',
+            ['perm', '/storage/{storage}', ['Datastore.Allocate']],
+            ['perm', '/storage/{source-storage}', ['Datastore.Allocate']],
+        ],
+    },
+    protected => 1,
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            storage => get_standard_option(
+                'pve-storage-id',
+                {
+                    description => "The storage the link is created in.",
+                    completion => \&PVE::Storage::complete_storage_enabled,
+                },
+            ),
+            'source-storage' => get_standard_option(
+                'pve-storage-id',
+                {
+                    description => "The storage of the volume to link.",
+                    completion => \&PVE::Storage::complete_storage_enabled,
+                },
+            ),
+            volume => {
+                description => "The volume to link: its volume ID in the source storage"
+                    . " ('iso/name.iso' or 'source-storage:iso/name.iso').",
+                type => 'string',
+                maxLength => 512,
+            },
+            filename => {
+                description => "The link's name: one file name, folders joined with '__'"
+                    . " (e.g. 'Solaris__2.6__solaris.iso'), with an extension of the content type.",
+                type => 'string',
+                maxLength => 255,
+            },
+            content => {
+                description => "Content type of the link. Default: the source volume's.",
+                type => 'string',
+                enum => ['iso', 'floppy'],
+                optional => 1,
+            },
+        },
+    },
+    returns => {
+        description => "The new volume ID.",
+        type => 'string',
+    },
+    code => sub {
+        my ($param) = @_;
+
+        my $source_storeid = $param->{'source-storage'};
+        my $source_volid = $param->{volume};
+        if ($source_volid =~ m/^([^:]+):/) {
+            raise_param_exc({ volume => "volume isn't in storage '$source_storeid'" })
+                if $1 ne $source_storeid;
+        } else {
+            $source_volid = "$source_storeid:$source_volid";
+        }
+
+        my $cfg = PVE::Storage::config();
+
+        return PVE::Storage::link_media_volume(
+            $cfg, $source_volid, $param->{storage}, $param->{filename}, $param->{content},
+        );
+    },
+});
