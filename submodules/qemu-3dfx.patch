+static void egl_reset_ramp(void)
+{
+    for (int i = 0; i < 0x100; i++) {
+        e.ramp.r[i] = (uint16_t)((i << 8) | i);
+        e.ramp.g[i] = (uint16_t)((i << 8) | i);
+        e.ramp.b[i] = (uint16_t)((i << 8) | i);
+    }
+    if (e.fx)
+        fxdisp_gamma(e.fx, NULL, NULL, NULL);
+}
