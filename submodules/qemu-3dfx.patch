+static struct {
+    int active;             /* chosen at the guest's DLL attach, until its detach */
+    int failed;             /* no EGL: the guest's pixel format and contexts fail */
+    int cfg_ok;             /* the "window" (pbuffer) exists */
+    int wnd_ready;
+    EGLDisplay dpy;
+    EGLConfig cfg, pbcfg;
+    EGLSurface surf;        /* the guest's window */
+    int w, h;
