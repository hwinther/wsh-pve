+/*
+ * Without an SDL window (-display vnc, none, egl-headless, dbus, gtk, or sdl,gl=on), the Glide
+ * library (wsh-openglide's EGL platform: setConfig(WRAPPER_FLAG_OFFSCREEN)) and the MESA GL
+ * pass-through (hw/mesa/mglcntx_egl.c) render offscreen, and every frame is shown in the first
+ * graphic console, which VNC (PVE's noVNC console), screendump and any other display then show
+ * like the VGA's output. While a Glide window or a GL context is open and its 3D output is
+ * selected, the console is in pass-through (the VGA's updates are skipped, ui/console.c); when it
+ * closes or its 3D output is switched off, the VGA redraws.
+ *
+ * A frame reaches the console in one of two ways:
+ *
+ *  - dmabuf scanout, when the display has GL (-display egl-headless, -display dbus,gl=on) and the
+ *    user can export a buffer as a dmabuf (fxdisp_dmabuf(); wsh-openglide's getOffscreenDmabufAt,
+ *    mesapt's egl_export in hw/mesa/mglcntx_egl.c):
+ *    two buffers are exported when the window opens, each frame is copied into one on the GPU and
+ *    finished on the vCPU thread, and a bottom half on the main loop hands it to the console
+ *    (qemu_console_gl_scanout_dmabuf when the buffer changes, qemu_console_gl_update for each
+ *    frame). The display imports them into its own EGL context: no copy through system memory.
+ *    The frames go into the buffer the console has while the display is done with it
+ *    (egl-headless reads it within its update); while the console is gl-blocked (a D-Bus client
+ *    still reads the last frame) they go into the other one, each replacing the one waiting
+ *    there, and the newest goes to the console as soon as the client is done (polled every
+ *    FXDISP_UNBLOCK_MS): the guest never waits, and never overwrites what the display reads. A user with one buffer (a wsh-openglide before 0.8, which has only
+ *    getOffscreenDmabuf) isn't copied into while the console is gl-blocked; its newest frame
+ *    follows FXDISP_STALE_MS later. Everything that touches the console's GL state runs on the
+ *    main loop, where the display's context is current; the vCPU thread has the pass-through's
+ *    context.
+ *  - readback otherwise (no GL display, as PVE's VNC console; no export, as for a multisampled
+ *    MESA GL window; QEMU_3DFX_DMABUF=0) and for the frames the user can't copy into the buffer
+ *    (a gamma ramp: wsh-openglide and mesapt copy through it with a shader, and read back only
+ *    when that shader can't be built, as a wsh-openglide before 0.6 always does):
+ *    the frame is read with glReadPixels on the vCPU thread, and the bottom half copies it into a
+ *    console surface of fxdisp's own (flipping it, OpenGL's rows are bottom up, and applying the
+ *    guest's gamma ramp when it set one) and marks the console updated.
+ *
+ * Each user (Glide, MESA GL) has an FxDisp with a read function. The frame is taken on the thread
+ * that drives the GL context (the vCPU's, in the pass-through's MMIO handler, with the BQL held):
+ * after every swap, and, where the user asks for it (Glide's front-buffer rendering and LFB
+ * writes), after any other call when no frame was taken for FXDISP_STALE_MS. A frame drawn without
+ * a swap and followed by no further call is taken FXDISP_STALE_MS later on the same vCPU thread
+ * (async_run_on_cpu from a main-loop timer). QEMU_3DFX_OFFSCREEN=1 in the environment renders
+ * offscreen even with an SDL window (the frames then show in it as the console's 2D surface).
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "qapi/qapi-commands-ui.h"
+#include "hw/core/cpu.h"
+#include "ui/console.h"
+#include "standard-headers/drm/drm_fourcc.h"
+
+#include "fxdisp.h"
+
+#define FXDISP_STALE_MS 50
+#define FXDISP_UNBLOCK_MS 1
+
+/* What fxdisp_read left for the bottom half */
+enum { FXDISP_NONE, FXDISP_PIXELS, FXDISP_DMABUF };
+
+struct FxDisp {
+    const char *tag;        /* "glidept", "mesapt": QEMU's messages */
+    FxDispRead read;
+    FxDispExport export_buf;
+    FxDispScanout scanout;
+    int nbuf_max;           /* buffers the user can export: 1, or 2 */
+    void *opaque;
+    int open;               /* an offscreen window (Glide) or context (MESA GL) is open */
+    int shown;              /* 3D output selected */
+    int ready;              /* FXDISP_PIXELS: a frame in pix, FXDISP_DMABUF: in dmabuf[ready_buf] */
+    int ready_buf;
+    int dirty;              /* calls since the last frame, none of them a swap (or it was held) */
+    int stale_armed;        /* the stale timer is pending */
+    int gamma;              /* lut is not the identity */
+    int w, h;
+    uint8_t *pix;           /* w x h, 4 bytes per pixel (x8r8g8b8), rows bottom up */
+    uint8_t lut[3][256];    /* r, g, b */
+    QemuConsole *con;
+    DisplaySurface *surface; /* ours, while the console has it */
+    QemuDmaBuf *dmabuf[2];  /* the frames' buffers, while frames go as a dmabuf */
+    int nbuf;               /* of them exported: 0 (frames read back), 1 or 2 */
+    int disp_buf;           /* the buffer last handed to the console (-1: none yet) */
+    QemuDmaBuf *scanned;    /* the dmabuf the console scans out (main loop's) */
+    GSList *dead;           /* dmabufs of closed windows, released by release_bh */
+    int handback;           /* release_bh gives the console back to the VGA */
+    QemuConsole *last_con;  /* the console of the last window */
+    QEMUBH *bh, *release_bh;
+    QEMUTimer *stale, *unblock;
+    CPUState *cpu;          /* the vCPU whose thread made the last call */
+    int64_t last_read, opened, scheduled;
+    uint64_t swaps, reads, read_ns, shown_frames, bh_ns, stale_reads;
+    uint64_t scanouts, scanout_ns, held, readback_frames, update_ns, replaced;
+};
+
+/* Offscreen unless the display is SDL without GL (the window qemu-3dfx's SDL code renders into,
+ * where anything else would end QEMU in sdl_display_valid()) */
+int fxdisp_choose(void)
+{
+    const char *env = g_getenv("QEMU_3DFX_OFFSCREEN");
+    DisplayOptions *o = qmp_query_display_options(NULL);
+    int sdl = o && (o->type == DISPLAY_TYPE_SDL) &&
+        (!o->has_gl || (o->gl == DISPLAY_GL_MODE_OFF));
+
+    qapi_free_DisplayOptions(o);
+    return (!sdl || (env && !strcmp(env, "1")))? 1:0;
+}
+
+static void fxdisp_copy_pixels(FxDisp *fx)
+{
+    DisplaySurface *ds = fx->surface;
+    int stride = surface_stride(ds);
+
+    for (int y = 0; y < fx->h; y++) {
+        const uint8_t *src = fx->pix + (size_t)(fx->h - 1 - y) * fx->w * 4;
+        uint8_t *dst = (uint8_t *)surface_data(ds) + (size_t)y * stride;
+        if (!fx->gamma) {
+            memcpy(dst, src, fx->w * 4);
+            continue;
+        }
+        /* x8r8g8b8 in host order: B G R X in memory on a little-endian host */
+        for (int x = 0; x < fx->w * 4; x += 4) {
+            dst[x] = fx->lut[2][src[x]];
+            dst[x + 1] = fx->lut[1][src[x + 1]];
+            dst[x + 2] = fx->lut[0][src[x + 2]];
+            dst[x + 3] = src[x + 3];
+        }
+    }
+}
+
+/* Main loop: the console scans a surface (of the frame's size) again, which the VGA can replace;
+ * every device's update expects one (vga_update_display() reads it), and a GL scanout has none */
+static void fxdisp_unscan(FxDisp *fx, QemuConsole *con)
+{
+    qemu_console_gl_scanout_disable(con);
+    fx->scanned = NULL;
+    fx->surface = qemu_create_displaysurface(fx->w, fx->h);
+    qemu_console_set_surface(con, fx->surface);
+}
+
+/* Main loop */
+static void fxdisp_bh(void *opaque)
+{
+    FxDisp *fx = opaque;
+    int ready = fx->ready;
+    DisplaySurface *cur;
+    int64_t t;
+
+    if (!fx->open || !ready || !fx->shown || !fx->con)
+        return;
+    /* Double-buffered: the frame waits in its buffer until the display is done with the last one
+     * (a D-Bus client's reply) */
+    if ((ready == FXDISP_DMABUF) && qemu_console_is_gl_blocked(fx->con)) {
+        timer_mod(fx->unblock, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + FXDISP_UNBLOCK_MS);
+        return;
+    }
+    fx->ready = FXDISP_NONE;
+    fx->bh_ns += get_clock() - fx->scheduled;
+    /* A frame read back (a gamma ramp) while the console scans the dmabuf out: back to a
+     * surface */
+    if ((ready == FXDISP_PIXELS) && fx->scanned)
+        fxdisp_unscan(fx, fx->con);
+    /* A surface of our own: the VGA's may be its video memory. With a dmabuf it is where
+     * egl-headless reads the frame for VNC, so it has the frame's size. While the console scans
+     * our dmabuf out it reports no surface (qemu_console_surface() is NULL for a GL scanout);
+     * any other surface there is the VGA's */
+    cur = qemu_console_surface(fx->con);
+    if (!fx->surface || ((cur != fx->surface) && (cur || !fx->scanned))) {
+        fx->surface = qemu_create_displaysurface(fx->w, fx->h);
+        qemu_console_set_surface(fx->con, fx->surface);
+        fx->scanned = NULL;
+    }
+    if ((ready == FXDISP_DMABUF) && fx->dmabuf[fx->ready_buf]) {
+        QemuDmaBuf *d = fx->dmabuf[fx->ready_buf];
+        if (fx->scanned != d) {
+            qemu_console_gl_scanout_dmabuf(fx->con, d);
+            fx->scanned = d;
+        }
+        fx->disp_buf = fx->ready_buf;
+        /* the display's work for the frame (egl-headless: a blit and a read into the surface
+         * for VNC; dbus,gl=on: passing it on) */
+        t = get_clock();
+        qemu_console_gl_update(fx->con, 0, 0, fx->w, fx->h);
+        fx->update_ns += get_clock() - t;
+        fx->shown_frames++;
+        return;
+    }
+    if (ready != FXDISP_PIXELS)
+        return;
+    fxdisp_copy_pixels(fx);
+    qemu_console_update(fx->con, 0, 0, fx->w, fx->h);
+    fx->shown_frames++;
+    fx->readback_frames++;
+}
+
+/* Main loop: the console back to the VGA after a dmabuf window closed or its 3D output was
+ * switched off (unless it is shown again by now), and the dmabufs of closed (or resized) windows
+ * released once the console has let go of them */
+static void fxdisp_release_bh(void *opaque)
+{
+    FxDisp *fx = opaque;
+    QemuConsole *con = fx->last_con;
+    GSList *dead = fx->dead;
+
+    if (!con)
+        return;
+    if (fx->handback) {
+        fx->handback = 0;
+        if (!fx->open || !fx->shown) {
+            if (fx->scanned)
+                fxdisp_unscan(fx, con);
+            graphic_hw_passthrough(con, false);
+            /* the VGA replaces (and frees) the surface on its next update */
+            qemu_console_hw_invalidate(con);
+        }
+    }
+    fx->dead = NULL;
+    for (GSList *l = dead; l; l = l->next) {
+        QemuDmaBuf *d = l->data;
+        /* still scanned out (a window opened since shows no frame yet) */
+        if (fx->scanned == d)
+            fxdisp_unscan(fx, con);
+        qemu_console_gl_release_dmabuf(con, d);
+        qemu_dmabuf_close(d);
+        qemu_dmabuf_free(d);
+    }
+    g_slist_free(dead);
+}
+
+/* Main loop: a frame waits in its buffer while the console is gl-blocked; it goes once the
+ * display is done with the last one */
+static void fxdisp_unblock_timer(void *opaque)
+{
+    fxdisp_bh(opaque);
+}
+
+/* vCPU thread, BQL held: the dmabufs go, the console lets go of them on the main loop */
+static void fxdisp_drop_dmabuf(FxDisp *fx)
+{
+    if (!fx->nbuf)
+        return;
+    for (int i = 0; i < fx->nbuf; i++)
+        fx->dead = g_slist_prepend(fx->dead, fx->dmabuf[i]);
+    fx->dmabuf[0] = fx->dmabuf[1] = NULL;
+    fx->nbuf = 0;
+    fx->disp_buf = -1;
+    if (fx->ready == FXDISP_DMABUF)
+        fx->ready = FXDISP_NONE;
+    timer_del(fx->unblock);
+    qemu_bh_schedule(fx->release_bh);
+}
+
+/* vCPU thread, BQL held: hand the console back to the VGA; with a dmabuf on the main loop, after
+ * the console scans a surface again */
+static void fxdisp_handback(FxDisp *fx, int dmabuf)
+{
+    if (dmabuf) {
+        fx->handback = 1;
+        qemu_bh_schedule(fx->release_bh);
+        return;
+    }
+    graphic_hw_passthrough(fx->con, false);
+    /* the VGA replaces (and frees) our surface on its next update */
+    qemu_console_hw_invalidate(fx->con);
+}
+
+/* vCPU thread, the user's context current: frames as a dmabuf from now on, or NULL with the
+ * reason they are read back */
+static const char *fxdisp_try_dmabuf(FxDisp *fx)
+{
+    const char *env = g_getenv("QEMU_3DFX_DMABUF");
+    uint32_t fourcc, offset, stride;
+    int32_t fd;
+
+    if (!fx->export_buf)
+        return "this renderer exports no dmabuf";
+    if (env && !strcmp(env, "0"))
+        return "QEMU_3DFX_DMABUF=0";
+    if (!qemu_console_has_gl(fx->con))
+        return "the display has no GL; egl-headless or dbus,gl=on take a dmabuf";
+    for (int i = 0; i < fx->nbuf_max; i++) {
+        FxDispDmabuf b = { .fd = -1 };
+        if (!fx->export_buf(fx->opaque, i, &b) || (b.fd < 0)) {
+            if (!i)
+                return "the renderer can't export a dmabuf, see above";
+            break;
+        }
+        /* The alpha channel of a frame means nothing to a display */
+        fourcc = b.fourcc;
+        if (fourcc == DRM_FORMAT_ABGR8888)
+            fourcc = DRM_FORMAT_XBGR8888;
+        else if (fourcc == DRM_FORMAT_ARGB8888)
+            fourcc = DRM_FORMAT_XRGB8888;
+        offset = b.offset;
+        stride = b.stride;
+        fd = b.fd;
+        /* rows bottom up, as OpenGL renders them: y0_top (the display flips) */
+        fx->dmabuf[i] = qemu_dmabuf_new(fx->w, fx->h, &offset, &stride, 0, 0, fx->w, fx->h,
+                                        fourcc, b.modifier, &fd, 1, false, true);
+        fx->nbuf = i + 1;
+        if (!i)
+            fprintf(stderr, "%s: dmabuf scanout: fourcc %.4s, modifier 0x%" PRIx64 ", stride %u\n",
+                fx->tag, (const char *)&fourcc, b.modifier, stride);
+    }
+    fx->disp_buf = -1;
+    fprintf(stderr, "%s: dmabuf scanout: %s\n", fx->tag, (fx->nbuf > 1)?
+        "double-buffered (the frame the display reads is never written to)":
+        "one buffer (frames wait while the display reads it)");
+    return NULL;
+}
+
+static void fxdisp_arm_stale(FxDisp *fx)
+{
+    fx->dirty = 1;
+    if (!fx->stale_armed) {
+        fx->stale_armed = 1;
+        timer_mod(fx->stale, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + FXDISP_STALE_MS);
+    }
+}
+
+/* swap: the frame of a swap, not one taken later (FXDISP_STALE_MS) */
+static void fxdisp_read(FxDisp *fx, int swap)
+{
+    int64_t t;
+
+    fx->dirty = 0;
+    fx->last_read = get_clock();
+    if (!fx->con || !fx->shown)
+        return;
+    t = get_clock();
+    if (fx->nbuf) {
+        int blocked = qemu_console_is_gl_blocked(fx->con), b = 0;
+        if (fx->nbuf > 1) {
+            /* The buffer the display has, as long as it doesn't read it any more (egl-headless
+             * reads it within its update; a buffer switch costs the display a new import, and a
+             * D-Bus client a new file descriptor). While it still reads the last frame (a D-Bus
+             * client) the other one, where the new frame waits, replacing any before it */
+            b = (fx->disp_buf > 0)? 1:0;
+            if (blocked) {
+                b = (fx->disp_buf == 0)? 1:0;
+                fx->held++;
+                if (fx->ready == FXDISP_DMABUF)
+                    fx->replaced++;
+            }
+        } else if (blocked) {
+            /* One buffer, which the display still reads: the newest frame later */
+            fx->held++;
+            fxdisp_arm_stale(fx);
+            return;
+        }
+        if (fx->scanout(fx->opaque, b)) {
+            fx->ready = FXDISP_DMABUF;
+            fx->ready_buf = b;
+            fx->scheduled = get_clock();
+            qemu_bh_schedule(fx->bh);
+            fx->scanout_ns += fx->scheduled - t;
+            fx->scanouts++;
+            return;
+        }
+        /* not this frame (a gamma ramp, and no shader for it): read back */
+    }
+    if (fx->read(fx->opaque, fx->pix, fx->w, fx->h, fx->w * 4)) {
+        fx->ready = FXDISP_PIXELS;
+        fx->scheduled = get_clock();
+        qemu_bh_schedule(fx->bh);
+    }
+    fx->read_ns += get_clock() - t;
+    fx->reads++;
+}
+
+/* On the vCPU thread that made the last call (its GL context is current there), BQL held */
+static void fxdisp_stale_work(CPUState *cpu, run_on_cpu_data data)
+{
+    FxDisp *fx = data.host_ptr;
+
+    if (fx->open && fx->dirty && (fx->cpu == cpu)) {
+        fx->stale_reads++;
+        fxdisp_read(fx, 0);
+    }
+}
+
+/* Main loop: a frame drawn without a swap (or held back while the console was gl-blocked), and
+ * no call since that took it */
+static void fxdisp_stale_timer(void *opaque)
+{
+    FxDisp *fx = opaque;
+
+    fx->stale_armed = 0;
+    if (fx->open && fx->dirty && fx->cpu)
+        async_run_on_cpu(fx->cpu, fxdisp_stale_work, RUN_ON_CPU_HOST_PTR(fx));
+}
+
+FxDisp *fxdisp_new(const char *tag, FxDispRead read, void *opaque)
+{
+    FxDisp *fx = g_new0(FxDisp, 1);
+
+    fx->tag = tag;
+    fx->read = read;
+    fx->opaque = opaque;
+    fx->bh = qemu_bh_new(fxdisp_bh, fx);
+    fx->release_bh = qemu_bh_new(fxdisp_release_bh, fx);
+    fx->stale = timer_new_ms(QEMU_CLOCK_REALTIME, fxdisp_stale_timer, fx);
+    fx->unblock = timer_new_ms(QEMU_CLOCK_REALTIME, fxdisp_unblock_timer, fx);
+    fx->disp_buf = -1;
+    fxdisp_gamma(fx, NULL, NULL, NULL);
+    return fx;
+}
+
+/* The user can hand its frames over as a dmabuf, in nbuf buffers (1, or 2: double-buffered; both
+ * functions on the thread of its context) */
+void fxdisp_dmabuf(FxDisp *fx, FxDispExport export_buf, FxDispScanout scanout, int nbuf)
+{
+    fx->export_buf = (export_buf && scanout)? export_buf:NULL;
+    fx->scanout = scanout;
+    fx->nbuf_max = (nbuf > 1)? 2:1;
+}
+
+int fxdisp_is_open(FxDisp *fx)
+{
+    return fx && fx->open;
+}
+
+int fxdisp_shown(FxDisp *fx)
+{
+    return fx && fx->open && fx->shown;
+}
+
+/* An offscreen window w x h; shown: its frames replace the VGA's at once, else from
+ * fxdisp_renderer(fx, 1) on. On the thread of the user's context (the vCPU's), BQL held */
+void fxdisp_open(FxDisp *fx, int w, int h, int shown)
+{
+    QemuConsole *con = qemu_console_lookup_by_index(0);
+    const char *why = NULL;
+    g_autofree char *to = NULL;
+
+    fx->w = w;
+    fx->h = h;
+    g_free(fx->pix);
+    fx->pix = g_malloc0((size_t)w * h * 4);
+    fx->con = (con && qemu_console_is_graphic(con))? con:NULL;
+    if (fx->con)
+        fx->last_con = fx->con;
+    fx->surface = NULL;
+    fx->open = 1;
+    fx->shown = !!shown;
+    fx->ready = FXDISP_NONE;
+    fx->dirty = 0;
+    fx->cpu = NULL;
+    fx->swaps = fx->reads = fx->read_ns = fx->shown_frames = fx->bh_ns = fx->stale_reads = 0;
+    fx->scanouts = fx->scanout_ns = fx->held = fx->readback_frames = fx->update_ns = 0;
+    fx->replaced = 0;
+    fx->opened = fx->last_read = get_clock();
+    fxdisp_drop_dmabuf(fx);
+    if (fx->con)
+        why = fxdisp_try_dmabuf(fx);
+    if (fx->con && fx->shown)
+        graphic_hw_passthrough(fx->con, true);
+    if (!fx->con)
+        to = g_strdup("nowhere (no graphic console)");
+    else if (fx->nbuf)
+        to = g_strdup("the graphic console as a dmabuf (no readback)");
+    else
+        to = g_strdup_printf("the graphic console, read back (%s)", why);
+    fprintf(stderr, "%s: offscreen %dx%d, frames to %s\n", fx->tag, w, h, to);
+}
+
+/* A new size for an open window, e.g. a resized pbuffer (the next frame shows it); on the thread
+ * of the user's context */
+void fxdisp_resize(FxDisp *fx, int w, int h)
+{
+    int had_dmabuf;
+
+    if (!fx->open || ((fx->w == w) && (fx->h == h)))
+        return;
+    had_dmabuf = !!fx->nbuf;
+    fx->w = w;
+    fx->h = h;
+    fx->ready = FXDISP_NONE;
+    g_free(fx->pix);
+    fx->pix = g_malloc0((size_t)w * h * 4);
+    fx->surface = NULL;
+    fxdisp_drop_dmabuf(fx);
+    if (had_dmabuf && fx->con)
+        fxdisp_try_dmabuf(fx);
+    fprintf(stderr, "%s: offscreen now %dx%d%s\n", fx->tag, w, h,
+        (had_dmabuf && !fx->nbuf)? ", read back from now on":"");
+}
+
+/* After a call (vCPU thread, BQL held): take the frame after a swap; with stale set, also when
+ * the last one is older than FXDISP_STALE_MS, and FXDISP_STALE_MS after the last call otherwise */
+void fxdisp_frame(FxDisp *fx, int swap, int stale)
+{
+    int64_t now;
+
+    if (!fx || !fx->open)
+        return;
+    fx->cpu = current_cpu;
+    if (swap) {
+        fx->swaps++;
+        fxdisp_read(fx, 1);
+        return;
+    }
+    if (!stale)
+        return;
+    now = get_clock();
+    if ((now - fx->last_read) >= (FXDISP_STALE_MS * SCALE_MS)) {
+        fxdisp_read(fx, 0);
+        return;
+    }
+    fxdisp_arm_stale(fx);
+}
+
+/* 3D output on (the frames) or off (the VGA's), as SDL's glide_renderer_stat() */
+void fxdisp_renderer(FxDisp *fx, int activate)
+{
+    if (!fx || !fx->open || !fx->con || (fx->shown == !!activate))
+        return;
+    fx->shown = !!activate;
+    if (fx->shown) {
+        graphic_hw_passthrough(fx->con, true);
+        fx->last_read = 0;
+    } else {
+        fx->ready = FXDISP_NONE;
+        fxdisp_handback(fx, !!fx->nbuf);
+    }
+}
+
+/* The guest's gamma ramp (16 bits per entry, as WGL's and Glide's), applied when a frame is
+ * copied into the console; NULL for the identity */
+void fxdisp_gamma(FxDisp *fx, const uint16_t *r, const uint16_t *g, const uint16_t *b)
+{
+    const uint16_t *ramp[3] = { r, g, b };
+
+    fx->gamma = 0;
+    for (int c = 0; c < 3; c++) {
+        for (int i = 0; i < 256; i++) {
+            fx->lut[c][i] = (ramp[c])? (ramp[c][i] >> 8):i;
+            fx->gamma |= (fx->lut[c][i] != i);
+        }
+    }
+}
+
+void fxdisp_close(FxDisp *fx)
+{
+    double secs;
+    int had_dmabuf;
+
+    if (!fx || !fx->open)
+        return;
+    secs = (get_clock() - fx->opened) / 1e9;
+    fprintf(stderr, "%s: offscreen closed after %.1f s: %" PRIu64 " swaps (%.1f per s), "
+        "%" PRIu64 " reads of %.2f ms average (%" PRIu64 " after the last call), "
+        "%" PRIu64 " frames to the console, %.2f ms after their read on average\n",
+        fx->tag, secs, fx->swaps, (secs > 0)? fx->swaps / secs:0, fx->reads,
+        (fx->reads)? (fx->read_ns / 1e6) / fx->reads:0, fx->stale_reads, fx->shown_frames,
+        (fx->shown_frames)? (fx->bh_ns / 1e6) / fx->shown_frames:0);
+    if (fx->nbuf || fx->scanouts) {
+        uint64_t dmabuf_frames = fx->shown_frames - fx->readback_frames;
+        fprintf(stderr, "%s: dmabuf scanout: %" PRIu64 " frames copied to the dmabuf in %.2f ms "
+            "average, the display's update %.2f ms a frame, %" PRIu64 " held while the display "
+            "was busy, %" PRIu64 " frames read back instead\n", fx->tag, fx->scanouts,
+            (fx->scanouts)? (fx->scanout_ns / 1e6) / fx->scanouts:0,
+            (dmabuf_frames)? (fx->update_ns / 1e6) / dmabuf_frames:0, fx->held,
+            fx->readback_frames);
+        if (fx->nbuf > 1)
+            fprintf(stderr, "%s: dmabuf scanout: double-buffered, %" PRIu64 " of the held frames "
+                "replaced by a newer one before they went\n", fx->tag, fx->replaced);
+    }
+    fx->open = 0;
+    fx->ready = FXDISP_NONE;
+    fx->dirty = 0;
+    fx->stale_armed = 0;
+    timer_del(fx->stale);
+    timer_del(fx->unblock);
+    qemu_bh_cancel(fx->bh);
+    had_dmabuf = !!fx->nbuf;
+    fxdisp_drop_dmabuf(fx);
+    if (fx->con)
+        fxdisp_handback(fx, had_dmabuf);
+    fx->surface = NULL;
+    fx->con = NULL;
+    fx->cpu = NULL;
+    g_free(fx->pix);
+    fx->pix = NULL;
+}
