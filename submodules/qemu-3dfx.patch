index 0000000..93f1193
--- /dev/null
+++ b/qemu-0/hw/3dfx/fxdisp.c
@@ -0,0 +1,312 @@
+/*
+ * QEMU 3Dfx Glide and MESA GL Pass-Through: offscreen display
+ *
+ *  Copyright (c) 2026 WsHosting ENK
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this library;
+ * if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Without an SDL window (-display vnc, none, egl-headless, dbus, gtk, or sdl,gl=on), the Glide
+ * library (wsh-openglide's EGL platform: setConfig(WRAPPER_FLAG_OFFSCREEN)) and the MESA GL
+ * pass-through (hw/mesa/mglcntx_egl.c) render offscreen, and every frame is read back into the
+ * first graphic console's own surface, which VNC (PVE's noVNC console), screendump and any other
+ * display then show like the VGA's output. While a Glide window or a GL context is open and its 3D
+ * output is selected, the console is in pass-through (the VGA's updates are skipped,
+ * ui/console.c); when it closes or its 3D output is switched off, the VGA redraws.
+ *
+ * Each user (Glide, MESA GL) has an FxDisp with a read function. The frame is read on the thread
+ * that drives the GL context (the vCPU's, in the pass-through's MMIO handler, with the BQL held):
+ * after every swap, and, where the user asks for it (Glide's front-buffer rendering and LFB
+ * writes), after any other call when no frame was read for FXDISP_STALE_MS. A frame drawn without
+ * a swap and followed by no further call is read FXDISP_STALE_MS later on the same vCPU thread
+ * (async_run_on_cpu from a main-loop timer). A bottom half on the main loop copies the frame into
+ * the console surface (flipping it, OpenGL's rows are bottom up, and applying the guest's gamma
+ * ramp when it set one) and marks the console updated. QEMU_3DFX_OFFSCREEN=1 in the environment
+ * renders offscreen even with an SDL window (the frames then show in it as the console's 2D
+ * surface).
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "qapi/qapi-commands-ui.h"
+#include "hw/core/cpu.h"
+#include "ui/console.h"
+
+#include "fxdisp.h"
+
+#define FXDISP_STALE_MS 50
+
+struct FxDisp {
+    const char *tag;        /* "glidept", "mesapt": QEMU's messages */
+    FxDispRead read;
+    void *opaque;
+    int open;               /* an offscreen window (Glide) or context (MESA GL) is open */
+    int shown;              /* 3D output selected */
+    int ready;              /* a frame in pix waits for the bottom half */
+    int dirty;              /* calls since the last read, none of them a swap */
+    int stale_armed;        /* the stale timer is pending */
+    int gamma;              /* lut is not the identity */
+    int w, h;
+    uint8_t *pix;           /* w x h, 4 bytes per pixel (x8r8g8b8), rows bottom up */
+    uint8_t lut[3][256];    /* r, g, b */
+    QemuConsole *con;
+    DisplaySurface *surface; /* ours, while the console has it */
+    QEMUBH *bh;
+    QEMUTimer *stale;
+    CPUState *cpu;          /* the vCPU whose thread made the last call */
+    int64_t last_read, opened, scheduled;
+    uint64_t swaps, reads, read_ns, shown_frames, bh_ns, stale_reads;
+};
+
+/* Offscreen unless the display is SDL without GL (the window qemu-3dfx's SDL code renders into,
+ * where anything else would end QEMU in sdl_display_valid()) */
+int fxdisp_choose(void)
+{
+    const char *env = g_getenv("QEMU_3DFX_OFFSCREEN");
+    DisplayOptions *o = qmp_query_display_options(NULL);
+    int sdl = o && (o->type == DISPLAY_TYPE_SDL) &&
+        (!o->has_gl || (o->gl == DISPLAY_GL_MODE_OFF));
+
+    qapi_free_DisplayOptions(o);
+    return (!sdl || (env && !strcmp(env, "1")))? 1:0;
+}
+
+static void fxdisp_bh(void *opaque)
+{
+    FxDisp *fx = opaque;
+    DisplaySurface *ds;
+    int stride;
+
+    if (!fx->open || !fx->ready || !fx->shown || !fx->con)
+        return;
+    fx->ready = 0;
+    fx->bh_ns += get_clock() - fx->scheduled;
+    /* A surface of our own: the VGA's may be its video memory */
+    if (!fx->surface || (qemu_console_surface(fx->con) != fx->surface)) {
+        fx->surface = qemu_create_displaysurface(fx->w, fx->h);
+        qemu_console_set_surface(fx->con, fx->surface);
+    }
+    ds = fx->surface;
+    stride = surface_stride(ds);
+    for (int y = 0; y < fx->h; y++) {
+        const uint8_t *src = fx->pix + (size_t)(fx->h - 1 - y) * fx->w * 4;
+        uint8_t *dst = (uint8_t *)surface_data(ds) + (size_t)y * stride;
+        if (!fx->gamma) {
+            memcpy(dst, src, fx->w * 4);
+            continue;
+        }
+        /* x8r8g8b8 in host order: B G R X in memory on a little-endian host */
+        for (int x = 0; x < fx->w * 4; x += 4) {
+            dst[x] = fx->lut[2][src[x]];
+            dst[x + 1] = fx->lut[1][src[x + 1]];
+            dst[x + 2] = fx->lut[0][src[x + 2]];
+            dst[x + 3] = src[x + 3];
+        }
+    }
+    qemu_console_update(fx->con, 0, 0, fx->w, fx->h);
+    fx->shown_frames++;
+}
+
+static void fxdisp_read(FxDisp *fx)
+{
+    int64_t t;
+
+    fx->dirty = 0;
+    fx->last_read = get_clock();
+    if (!fx->con || !fx->shown)
+        return;
+    t = get_clock();
+    if (fx->read(fx->opaque, fx->pix, fx->w, fx->h, fx->w * 4)) {
+        fx->ready = 1;
+        fx->scheduled = get_clock();
+        qemu_bh_schedule(fx->bh);
+    }
+    fx->read_ns += get_clock() - t;
+    fx->reads++;
+}
+
+/* On the vCPU thread that made the last call (its GL context is current there), BQL held */
+static void fxdisp_stale_work(CPUState *cpu, run_on_cpu_data data)
+{
+    FxDisp *fx = data.host_ptr;
+
+    if (fx->open && fx->dirty && (fx->cpu == cpu)) {
+        fx->stale_reads++;
+        fxdisp_read(fx);
+    }
+}
+
+/* Main loop: a frame drawn without a swap, and no call since that read it */
+static void fxdisp_stale_timer(void *opaque)
+{
+    FxDisp *fx = opaque;
+
+    fx->stale_armed = 0;
+    if (fx->open && fx->dirty && fx->cpu)
+        async_run_on_cpu(fx->cpu, fxdisp_stale_work, RUN_ON_CPU_HOST_PTR(fx));
+}
+
+FxDisp *fxdisp_new(const char *tag, FxDispRead read, void *opaque)
+{
+    FxDisp *fx = g_new0(FxDisp, 1);
+
+    fx->tag = tag;
+    fx->read = read;
+    fx->opaque = opaque;
+    fx->bh = qemu_bh_new(fxdisp_bh, fx);
+    fx->stale = timer_new_ms(QEMU_CLOCK_REALTIME, fxdisp_stale_timer, fx);
+    fxdisp_gamma(fx, NULL, NULL, NULL);
+    return fx;
+}
+
+int fxdisp_is_open(FxDisp *fx)
+{
+    return fx && fx->open;
+}
+
+int fxdisp_shown(FxDisp *fx)
+{
+    return fx && fx->open && fx->shown;
+}
+
+/* An offscreen window w x h; shown: its frames replace the VGA's at once, else from
+ * fxdisp_renderer(fx, 1) on */
+void fxdisp_open(FxDisp *fx, int w, int h, int shown)
+{
+    QemuConsole *con = qemu_console_lookup_by_index(0);
+
+    fx->w = w;
+    fx->h = h;
+    g_free(fx->pix);
+    fx->pix = g_malloc0((size_t)w * h * 4);
+    fx->con = (con && qemu_console_is_graphic(con))? con:NULL;
+    fx->surface = NULL;
+    fx->open = 1;
+    fx->shown = !!shown;
+    fx->ready = 0;
+    fx->dirty = 0;
+    fx->cpu = NULL;
+    fx->swaps = fx->reads = fx->read_ns = fx->shown_frames = fx->bh_ns = fx->stale_reads = 0;
+    fx->opened = fx->last_read = get_clock();
+    if (fx->con && fx->shown)
+        graphic_hw_passthrough(fx->con, true);
+    fprintf(stderr, "%s: offscreen %dx%d, frames to %s\n", fx->tag, w, h,
+        (fx->con)? "the graphic console":"nowhere (no graphic console)");
+}
+
+/* A new size for an open window, e.g. a resized pbuffer (the next frame shows it) */
+void fxdisp_resize(FxDisp *fx, int w, int h)
+{
+    if (!fx->open || ((fx->w == w) && (fx->h == h)))
+        return;
+    fx->w = w;
+    fx->h = h;
+    fx->ready = 0;
+    g_free(fx->pix);
+    fx->pix = g_malloc0((size_t)w * h * 4);
+    fx->surface = NULL;
+    fprintf(stderr, "%s: offscreen now %dx%d\n", fx->tag, w, h);
+}
+
+/* After a call (vCPU thread, BQL held): read the frame after a swap; with stale set, also when the
+ * last read is older than FXDISP_STALE_MS, and FXDISP_STALE_MS after the last call otherwise */
+void fxdisp_frame(FxDisp *fx, int swap, int stale)
+{
+    int64_t now;
+
+    if (!fx || !fx->open)
+        return;
+    fx->cpu = current_cpu;
+    if (swap) {
+        fx->swaps++;
+        fxdisp_read(fx);
+        return;
+    }
+    if (!stale)
+        return;
+    now = get_clock();
+    if ((now - fx->last_read) >= (FXDISP_STALE_MS * SCALE_MS)) {
+        fxdisp_read(fx);
+        return;
+    }
+    fx->dirty = 1;
+    if (!fx->stale_armed) {
+        fx->stale_armed = 1;
+        timer_mod(fx->stale, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + FXDISP_STALE_MS);
+    }
+}
+
+/* 3D output on (the frames) or off (the VGA's), as SDL's glide_renderer_stat() */
+void fxdisp_renderer(FxDisp *fx, int activate)
+{
+    if (!fx || !fx->open || !fx->con || (fx->shown == !!activate))
+        return;
+    fx->shown = !!activate;
+    graphic_hw_passthrough(fx->con, fx->shown);
+    if (fx->shown)
+        fx->last_read = 0;
+    else {
+        fx->ready = 0;
+        qemu_console_hw_invalidate(fx->con);
+    }
+}
+
+/* The guest's gamma ramp (16 bits per entry, as WGL's and Glide's), applied when a frame is
+ * copied into the console; NULL for the identity */
+void fxdisp_gamma(FxDisp *fx, const uint16_t *r, const uint16_t *g, const uint16_t *b)
+{
+    const uint16_t *ramp[3] = { r, g, b };
+
+    fx->gamma = 0;
+    for (int c = 0; c < 3; c++) {
+        for (int i = 0; i < 256; i++) {
+            fx->lut[c][i] = (ramp[c])? (ramp[c][i] >> 8):i;
+            fx->gamma |= (fx->lut[c][i] != i);
+        }
+    }
+}
+
+void fxdisp_close(FxDisp *fx)
+{
+    double secs;
+
+    if (!fx || !fx->open)
+        return;
+    secs = (get_clock() - fx->opened) / 1e9;
+    fprintf(stderr, "%s: offscreen closed after %.1f s: %" PRIu64 " swaps (%.1f per s), "
+        "%" PRIu64 " reads of %.2f ms average (%" PRIu64 " after the last call), "
+        "%" PRIu64 " frames to the console, %.2f ms after their read on average\n",
+        fx->tag, secs, fx->swaps, (secs > 0)? fx->swaps / secs:0, fx->reads,
+        (fx->reads)? (fx->read_ns / 1e6) / fx->reads:0, fx->stale_reads, fx->shown_frames,
+        (fx->shown_frames)? (fx->bh_ns / 1e6) / fx->shown_frames:0);
+    fx->open = 0;
+    fx->ready = 0;
+    fx->dirty = 0;
+    fx->stale_armed = 0;
+    timer_del(fx->stale);
+    qemu_bh_cancel(fx->bh);
+    if (fx->con) {
+        graphic_hw_passthrough(fx->con, false);
+        /* the VGA replaces (and frees) our surface on its next update */
+        qemu_console_hw_invalidate(fx->con);
+    }
+    fx->surface = NULL;
+    fx->con = NULL;
+    fx->cpu = NULL;
+    g_free(fx->pix);
+    fx->pix = NULL;
+}
