+#ifndef FXDISP_H
+#define FXDISP_H
+
+typedef struct FxDisp FxDisp;
+/* Reads the frame on the thread whose GL context renders it: w x h pixels, 4 bytes each (B G R X
+ * in memory), rows bottom up, stride bytes apart; returns 0 when there is nothing to show */
+typedef int (*FxDispRead)(void *opaque, void *pix, int w, int h, int stride);
+
+int fxdisp_choose(void);
+FxDisp *fxdisp_new(const char *, FxDispRead, void *);
+int fxdisp_is_open(FxDisp *);
+void fxdisp_open(FxDisp *, int, int, int);
+int fxdisp_shown(FxDisp *);
+void fxdisp_resize(FxDisp *, int, int);
+void fxdisp_frame(FxDisp *, int, int);
+void fxdisp_renderer(FxDisp *, int);
+void fxdisp_gamma(FxDisp *, const uint16_t *, const uint16_t *, const uint16_t *);
+void fxdisp_close(FxDisp *);
+
+#endif // FXDISP_H
