+
+#ifndef FXDISP_H
+#define FXDISP_H
+
+typedef struct FxDisp FxDisp;
+/* Reads the frame on the thread whose GL context renders it: w x h pixels, 4 bytes each (B G R X
+ * in memory), rows bottom up, stride bytes apart; returns 0 when there is nothing to show */
+typedef int (*FxDispRead)(void *opaque, void *pix, int w, int h, int stride);
+/* dmabuf scanout (fxdisp_dmabuf): the buffers the frames go into, one plane of the window's size
+ * each with its rows bottom up (OpenGL's order); fd is the caller's to close */
+typedef struct FxDispDmabuf {
+    int fd;
+    int stride, offset;
+    uint32_t fourcc;
+    uint64_t modifier;
+} FxDispDmabuf;
+/* Exports buffer i (0, or 1 for a user with two), on the thread of the user's GL context while its
+ * window is open: 1, or 0 when it can't (the frames are then read back) */
+typedef int (*FxDispExport)(void *opaque, int i, FxDispDmabuf *buf);
+/* Copies the current frame into buffer i and finishes the GL work: 1, or 0 to have this frame read
+ * back instead */
+typedef int (*FxDispScanout)(void *opaque, int i);
+
+int fxdisp_choose(void);
+FxDisp *fxdisp_new(const char *, FxDispRead, void *);
+void fxdisp_dmabuf(FxDisp *, FxDispExport, FxDispScanout, int);
+int fxdisp_is_open(FxDisp *);
+void fxdisp_open(FxDisp *, int, int, int);
+int fxdisp_shown(FxDisp *);
+void fxdisp_resize(FxDisp *, int, int);
+void fxdisp_frame(FxDisp *, int, int);
+void fxdisp_renderer(FxDisp *, int);
+void fxdisp_gamma(FxDisp *, const uint16_t *, const uint16_t *, const uint16_t *);
+void fxdisp_close(FxDisp *);
+
+#endif // FXDISP_H
