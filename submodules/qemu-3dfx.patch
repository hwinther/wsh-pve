+int MGLEglActive(void) { return e.active; }
+int MGLEglWndReady(void) { return qatomic_read(&e.wnd_ready); }
+void *MGLEglGetProc(const char *proc)
+{
+    return (egl.GetProcAddress)? (void *)egl.GetProcAddress(proc):NULL;
+}
+
+static int has_ext(const char *list, const char *ext)
+{
+    size_t n = strlen(ext);
+    for (const char *p = list; p && (p = strstr(p, ext)); p += n)
+        if (((p == list) || (p[-1] == ' ')) && ((p[n] == ' ') || (p[n] == '\0')))
+            return 1;
+    return 0;
+}
+
+static int egl_load(void)
+{
+    if (egl.lib)
+        return 1;
+    egl.lib = dlopen("libEGL.so.1", RTLD_NOW | RTLD_GLOBAL);
+    if (!egl.lib) {
+        DPRINTF("no SDL window, and no libEGL.so.1 to render offscreen (%s)", dlerror());
+        return 0;
+    }
+#define EGL_LOAD(ret, name, args) \
+    egl.name = (ret (*) args) dlsym(egl.lib, "egl" #name); \
+    if (!egl.name) { DPRINTF("libEGL.so.1 has no egl%s", #name); dlclose(egl.lib); egl.lib = 0; return 0; }
+    EGL_FUNCS(EGL_LOAD)
+    return 1;
+}
+
+static EGLDisplay egl_display(const char **which)
+{
+    const char *cext = egl.QueryString(EGL_NO_DISPLAY, EGL_EXTENSIONS);
+    PFNEGLGETPLATFORMDISPLAYEXTPROC getPlatformDisplay = NULL;
+    EGLDisplay d = EGL_NO_DISPLAY;
+
+    if (has_ext(cext, "EGL_EXT_platform_base"))
+        getPlatformDisplay = (PFNEGLGETPLATFORMDISPLAYEXTPROC)
+            egl.GetProcAddress("eglGetPlatformDisplayEXT");
+    if (getPlatformDisplay && has_ext(cext, "EGL_MESA_platform_surfaceless")) {
+        d = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, NULL);
+        *which = "surfaceless";
+    }
+    if ((d == EGL_NO_DISPLAY) && getPlatformDisplay && has_ext(cext, "EGL_EXT_platform_device")) {
+        PFNEGLQUERYDEVICESEXTPROC queryDevices =
+            (PFNEGLQUERYDEVICESEXTPROC) egl.GetProcAddress("eglQueryDevicesEXT");
+        EGLDeviceEXT dev;
+        EGLint n = 0;
+        if (queryDevices && queryDevices(1, &dev, &n) && (n > 0)) {
+            d = getPlatformDisplay(EGL_PLATFORM_DEVICE_EXT, dev, NULL);
+            *which = "device";
+        }
+    }
+    if (d == EGL_NO_DISPLAY) {
+        d = egl.GetDisplay(EGL_DEFAULT_DISPLAY);
+        *which = "default";
+    }
+    return d;
+}
+
+static void egl_reset_ramp(void)
+{
+    for (int i = 0; i < 0x100; i++) {
+        e.ramp.r[i] = (uint16_t)((i << 8) | i);
+        e.ramp.g[i] = (uint16_t)((i << 8) | i);
+        e.ramp.b[i] = (uint16_t)((i << 8) | i);
+    }
+    e.gamma = 0;
+    if (e.fx)
+        fxdisp_gamma(e.fx, NULL, NULL, NULL);
+}
+
+/* The frame, on the vCPU thread with the guest's context current: framebuffer 0 of the window's
+ * pbuffer (its back buffer, or the front one when it is single-buffered); a multisampled pbuffer
+ * is resolved by the read. The guest's read and pack state is put back afterwards. */
+static int egl_read(void *opaque, void *pix, int w, int h, int stride)
+{
+    MESA_PFN(PFNGLBINDBUFFERPROC,      glBindBuffer);
+    MESA_PFN(PFNGLBINDFRAMEBUFFERPROC, glBindFramebuffer);
+    MESA_PFN(PFNGLGETBOOLEANVPROC,     glGetBooleanv);
+    MESA_PFN(PFNGLGETINTEGERVPROC,     glGetIntegerv);
+    MESA_PFN(PFNGLPIXELSTOREIPROC,     glPixelStorei);
+    MESA_PFN(PFNGLREADBUFFERPROC,      glReadBuffer);
+    MESA_PFN(PFNGLREADPIXELSPROC,      glReadPixels);
+    static const GLenum pack[] = {
+        GL_PACK_SWAP_BYTES, GL_PACK_LSB_FIRST, GL_PACK_ROW_LENGTH, GL_PACK_IMAGE_HEIGHT,
+        GL_PACK_SKIP_ROWS, GL_PACK_SKIP_PIXELS, GL_PACK_SKIP_IMAGES, GL_PACK_ALIGNMENT,
+    };
+    GLint saved[ARRAY_SIZE(pack)], read_fb = 0, pack_buf = 0, read_buf;
+    GLboolean dbl = GL_TRUE;
+
+    if (!e.surf || (w != e.w) || (h != e.h) || !p_glReadPixels || !p_glGetIntegerv ||
+        (egl.GetCurrentSurface(EGL_DRAW) != e.surf))
+        return 0;
+    if (p_glBindFramebuffer) {
+        p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fb);
+        if (read_fb)
+            p_glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    }
+    if (p_glBindBuffer) {
+        p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buf);
+        if (pack_buf)
+            p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    }
+    for (int i = 0; i < ARRAY_SIZE(pack); i++) {
+        p_glGetIntegerv(pack[i], &saved[i]);
+        p_glPixelStorei(pack[i], (pack[i] == GL_PACK_ALIGNMENT)? 4:
+            ((pack[i] == GL_PACK_ROW_LENGTH)? (stride / 4):0));
+    }
+    p_glGetIntegerv(GL_READ_BUFFER, &read_buf);
+    if (p_glGetBooleanv)
+        p_glGetBooleanv(GL_DOUBLEBUFFER, &dbl);
+    p_glReadBuffer((dbl)? GL_BACK:GL_FRONT);
+    p_glReadPixels(0, 0, w, h, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, pix);
+    p_glReadBuffer(read_buf);
+    for (int i = 0; i < ARRAY_SIZE(pack); i++)
+        p_glPixelStorei(pack[i], saved[i]);
+    if (pack_buf)
+        p_glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buf);
+    if (read_fb)
+        p_glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fb);
+    return 1;
+}
+
+/*
+ * dmabuf scanout (fxdisp_dmabuf), with a GL display: each frame is copied into one of two
+ * renderbuffers, each exported once as a dmabuf (EGL_MESA_image_dma_buf_export; llvmpipe exports
+ * through /dev/udmabuf, a GPU driver through its render node), which the display imports. fxdisp
+ * picks the one the display doesn't have (double buffering).
+ *
+ * The copy runs in a context of our own (scan.ctx), made current on the guest's window pbuffer
+ * for it, not in the guest's context: it reads the pbuffer's framebuffer 0 directly, so it shares
+ * nothing with the guest's contexts. In the guest's context the framebuffer and renderbuffer
+ * would be names in the guest's namespace, which the guest may fill with names it never had from
+ * glGen* (legacy GL allows that), and the blit depends on state the guest owns (scissor test,
+ * read buffer, read and draw framebuffer bindings, GL_FRAMEBUFFER_SRGB), all of which would have
+ * to be saved and put back every frame. The price is two eglMakeCurrent and a wait for the
+ * guest's rendering per frame (it must be done before another context reads it): an EGL fence
+ * in the guest's context, waited on (scan_finish), or glFinish without EGL_KHR_fence_sync.
+ *
+ * The copy is a framebuffer blit of the back buffer (the front one when single-buffered),
+ * unscaled and unflipped (llvmpipe copies memory), so its rows are bottom up, as fxdisp tells the
+ * display (y0_top). With a gamma ramp it is two passes instead: the frame into a texture, then
+ * drawn into the renderbuffer through a 256-entry lookup per channel, the same lookup as fxdisp
+ * applies to a frame read back. Read back instead: a multisampled pbuffer (a resolving blit needs
+ * identical formats, and Mesa's software renderers never get one here, egl_msaa_works, so it is
+ * untested), and frames with a gamma ramp when the shader can't be built.
+ *
+ * While the display still reads the last frame (a D-Bus client), the copy goes into the other
+ * buffer all the same, at the swap, so the frame needs no copy of its own before the guest draws
+ * the next one into the same back buffer (the hold copy of before).
+ */
+typedef struct {
+    EGLContext ctx;
+    EGLSurface draw, read;
+} EglCurrent;
+
+static struct {
+    EGLContext ctx;         /* ours: current on e.surf only during the copy */
+    EGLImageKHR img[2];     /* the exported renderbuffers */
+    GLuint fbo[2], rb[2];
+    int w, h;
+    GLuint prog, tex, lut;  /* gamma: the program, the frame's copy, the lookup (256 x 1) */
+    int tex_w, tex_h, lut_dirty, gamma_failed;
+    int fence;              /* scan_finish: 0 not decided yet, 1 an EGL fence, -1 glFinish */
+    int wait_sync;          /* scan_begin: scan.ctx waits for the guest's frame in its GL stream */
+    PFNEGLCREATESYNCKHRPROC create_sync;
+    PFNEGLCLIENTWAITSYNCKHRPROC client_wait;
+    PFNEGLDESTROYSYNCKHRPROC destroy_sync;
+    PFNEGLWAITSYNCKHRPROC server_wait;
+} scan;
+
+static void egl_current_save(EglCurrent *c)
+{
+    c->ctx = egl.GetCurrentContext();
+    c->draw = egl.GetCurrentSurface(EGL_DRAW);
+    c->read = egl.GetCurrentSurface(EGL_READ);
+}
+
+static void egl_current_restore(const EglCurrent *c)
+{
+    egl.MakeCurrent(e.dpy, c->draw, c->read, c->ctx);
+}
+
+static void scan_destroy_image(void)
+{
+    PFNEGLDESTROYIMAGEKHRPROC destroyImage =
+        (PFNEGLDESTROYIMAGEKHRPROC) egl.GetProcAddress("eglDestroyImageKHR");
+
+    for (int i = 0; i < 2; i++) {
+        if (scan.img[i] && destroyImage)
+            destroyImage(e.dpy, scan.img[i]);
+        scan.img[i] = EGL_NO_IMAGE_KHR;
+    }
+}
+
+/* The buffer's GL objects, with scan.ctx current */
+static void scan_free_buffer(void)
+{
+    MESA_PFN(PFNGLDELETEFRAMEBUFFERSPROC,  glDeleteFramebuffers);
+    MESA_PFN(PFNGLDELETERENDERBUFFERSPROC, glDeleteRenderbuffers);
+
+    scan_destroy_image();
+    if (p_glDeleteFramebuffers)
+        p_glDeleteFramebuffers(2, scan.fbo);
+    if (p_glDeleteRenderbuffers)
+        p_glDeleteRenderbuffers(2, scan.rb);
+    memset(scan.fbo, 0, sizeof(scan.fbo));
+    memset(scan.rb, 0, sizeof(scan.rb));
+    scan.w = scan.h = 0;
+}
+
+/* Window gone: the context takes its objects with it */
+static void scan_destroy(void)
+{
+    scan_destroy_image();
+    if (scan.ctx)
+        egl.DestroyContext(e.dpy, scan.ctx);
+    memset(&scan, 0, sizeof(scan));
+}
+
+/* fxdisp's export, on the vCPU thread, when the window opens or changes size: renderbuffer i (0
+ * makes both anew) of the window's size, exported as a dmabuf */
+static int egl_export(void *opaque, int i, FxDispDmabuf *b)
+{
+    MESA_PFN(PFNGLBINDFRAMEBUFFERPROC,         glBindFramebuffer);
+    MESA_PFN(PFNGLBINDRENDERBUFFERPROC,        glBindRenderbuffer);
+    MESA_PFN(PFNGLBLITFRAMEBUFFERPROC,         glBlitFramebuffer);
+    MESA_PFN(PFNGLCHECKFRAMEBUFFERSTATUSPROC,  glCheckFramebufferStatus);
+    MESA_PFN(PFNGLCLEARCOLORPROC,              glClearColor);
+    MESA_PFN(PFNGLCLEARPROC,                   glClear);
+    MESA_PFN(PFNGLFINISHPROC,                  glFinish);
+    MESA_PFN(PFNGLFRAMEBUFFERRENDERBUFFERPROC, glFramebufferRenderbuffer);
+    MESA_PFN(PFNGLGENFRAMEBUFFERSPROC,         glGenFramebuffers);
+    MESA_PFN(PFNGLGENRENDERBUFFERSPROC,        glGenRenderbuffers);
+    MESA_PFN(PFNGLGETBOOLEANVPROC,             glGetBooleanv);
+    MESA_PFN(PFNGLREADBUFFERPROC,              glReadBuffer);
+    MESA_PFN(PFNGLRENDERBUFFERSTORAGEPROC,     glRenderbufferStorage);
+    PFNEGLCREATEIMAGEKHRPROC createImage =
+        (PFNEGLCREATEIMAGEKHRPROC) egl.GetProcAddress("eglCreateImageKHR");
+    PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC exportQuery =
+        (PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC) egl.GetProcAddress("eglExportDMABUFImageQueryMESA");
+    PFNEGLEXPORTDMABUFIMAGEMESAPROC exportImage =
+        (PFNEGLEXPORTDMABUFIMAGEMESAPROC) egl.GetProcAddress("eglExportDMABUFImageMESA");
+    const char *ext = egl.QueryString(e.dpy, EGL_EXTENSIONS);
+    int fourcc = 0, planes = 0, fd = -1, ok = 0;
+    EGLuint64KHR modifier = 0;
+    EGLint stride = 0, offset = 0;
+    GLboolean dbl = GL_TRUE;
+    GLenum status;
+    EglCurrent cur;
+
+    if (!e.surf || (i < 0) || (i > 1) || (i && ((scan.w != e.w) || (scan.h != e.h))))
+        return 0;
+    if (e.cSampleBuf[0]) {
+        DPRINTF("dmabuf scanout: the window is multisampled, its frames are read back");
+        return 0;
+    }
+    if (!has_ext(ext, "EGL_MESA_image_dma_buf_export") ||
+        !has_ext(ext, "EGL_KHR_gl_renderbuffer_image")) {
+        DPRINTF("dmabuf scanout: this EGL display exports no dmabuf "
+            "(EGL_MESA_image_dma_buf_export; llvmpipe needs /dev/udmabuf)");
+        return 0;
+    }
+    if (!createImage || !exportQuery || !exportImage || !p_glBindFramebuffer ||
+        !p_glBindRenderbuffer || !p_glBlitFramebuffer || !p_glCheckFramebufferStatus ||
+        !p_glClearColor || !p_glClear || !p_glFinish || !p_glFramebufferRenderbuffer ||
+        !p_glGenFramebuffers || !p_glGenRenderbuffers || !p_glGetBooleanv || !p_glReadBuffer ||
+        !p_glRenderbufferStorage)
+        return 0;
+    egl_current_save(&cur);
+    if (!scan.ctx)
+        scan.ctx = egl.CreateContext(e.dpy, e.cfg, EGL_NO_CONTEXT, NULL);
+    if (!scan.ctx || !egl.MakeCurrent(e.dpy, e.surf, e.surf, scan.ctx)) {
+        DPRINTF("dmabuf scanout: no context for the copy (0x%04x)", egl.GetError());
+        goto out;
+    }
+    if (!i)
+        scan_free_buffer();
+    p_glGenRenderbuffers(1, &scan.rb[i]);
+    p_glBindRenderbuffer(GL_RENDERBUFFER, scan.rb[i]);
+    p_glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, e.w, e.h);
+    p_glBindRenderbuffer(GL_RENDERBUFFER, 0);
+    p_glGenFramebuffers(1, &scan.fbo[i]);
+    p_glBindFramebuffer(GL_FRAMEBUFFER, scan.fbo[i]);
+    p_glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, scan.rb[i]);
+    status = p_glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    if (status != GL_FRAMEBUFFER_COMPLETE) {
+        DPRINTF("dmabuf scanout: framebuffer incomplete (0x%04x)", status);
+        goto out;
+    }
+    p_glClearColor(0, 0, 0, 0);
+    p_glClear(GL_COLOR_BUFFER_BIT);
+    /* From now on: draw into the renderbuffer, read the window's frame */
+    p_glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    p_glGetBooleanv(GL_DOUBLEBUFFER, &dbl);
+    p_glReadBuffer((dbl)? GL_BACK:GL_FRONT);
+    p_glFinish();
+    scan.img[i] = createImage(e.dpy, scan.ctx, EGL_GL_RENDERBUFFER_KHR,
+                              (EGLClientBuffer)(uintptr_t)scan.rb[i], NULL);
+    if (scan.img[i] == EGL_NO_IMAGE_KHR) {
+        DPRINTF("dmabuf scanout: eglCreateImage 0x%04x", egl.GetError());
+        goto out;
+    }
+    if (!exportQuery(e.dpy, scan.img[i], &fourcc, &planes, &modifier) || (planes != 1) ||
+        !exportImage(e.dpy, scan.img[i], &fd, &stride, &offset) || (fd < 0)) {
+        DPRINTF("dmabuf scanout: the buffer can't be exported (planes %d, fd %d, 0x%04x)",
+            planes, fd, egl.GetError());
+        if (fd >= 0)
+            close(fd);
+        goto out;
+    }
+    b->fd = fd;
+    b->stride = stride;
+    b->offset = offset;
+    b->fourcc = (uint32_t)fourcc;
+    b->modifier = modifier;
+    scan.w = e.w;
+    scan.h = e.h;
+    scan.lut_dirty = 1;
+    ok = 1;
+out:
+    /* the second buffer failed: only its own objects go, the first is fxdisp's already */
+    if (!ok && i && scan.ctx && (egl.GetCurrentContext() == scan.ctx)) {
+        PFNEGLDESTROYIMAGEKHRPROC destroyImage =
+            (PFNEGLDESTROYIMAGEKHRPROC) egl.GetProcAddress("eglDestroyImageKHR");
+        MESA_PFN(PFNGLDELETEFRAMEBUFFERSPROC,  glDeleteFramebuffers);
+        MESA_PFN(PFNGLDELETERENDERBUFFERSPROC, glDeleteRenderbuffers);
+        if (scan.img[1] && destroyImage)
+            destroyImage(e.dpy, scan.img[1]);
+        scan.img[1] = EGL_NO_IMAGE_KHR;
+        if (p_glDeleteFramebuffers)
+            p_glDeleteFramebuffers(1, &scan.fbo[1]);
+        if (p_glDeleteRenderbuffers)
+            p_glDeleteRenderbuffers(1, &scan.rb[1]);
+        scan.fbo[1] = scan.rb[1] = 0;
+    } else if (!ok && scan.ctx && (egl.GetCurrentContext() == scan.ctx))
+        scan_free_buffer();
+    egl_current_restore(&cur);
+    return ok;
+}
+
+/* The gamma pass's program and textures, with scan.ctx current; 0 when they can't be had */
+static int scan_gamma_init(void)
+{
+    MESA_PFN(PFNGLACTIVETEXTUREPROC,            glActiveTexture);
+    MESA_PFN(PFNGLATTACHSHADERPROC,             glAttachShader);
+    MESA_PFN(PFNGLBINDATTRIBLOCATIONPROC,       glBindAttribLocation);
+    MESA_PFN(PFNGLBINDTEXTUREPROC,              glBindTexture);
+    MESA_PFN(PFNGLCOMPILESHADERPROC,            glCompileShader);
+    MESA_PFN(PFNGLCREATEPROGRAMPROC,            glCreateProgram);
+    MESA_PFN(PFNGLCREATESHADERPROC,             glCreateShader);
+    MESA_PFN(PFNGLDELETESHADERPROC,             glDeleteShader);
+    MESA_PFN(PFNGLENABLEVERTEXATTRIBARRAYPROC,  glEnableVertexAttribArray);
+    MESA_PFN(PFNGLGENTEXTURESPROC,              glGenTextures);
+    MESA_PFN(PFNGLGETPROGRAMIVPROC,             glGetProgramiv);
+    MESA_PFN(PFNGLGETUNIFORMLOCATIONPROC,       glGetUniformLocation);
+    MESA_PFN(PFNGLLINKPROGRAMPROC,              glLinkProgram);
+    MESA_PFN(PFNGLSHADERSOURCEPROC,             glShaderSource);
+    MESA_PFN(PFNGLTEXIMAGE2DPROC,               glTexImage2D);
+    MESA_PFN(PFNGLTEXPARAMETERIPROC,            glTexParameteri);
+    MESA_PFN(PFNGLUNIFORM1IPROC,                glUniform1i);
+    MESA_PFN(PFNGLUSEPROGRAMPROC,               glUseProgram);
+    MESA_PFN(PFNGLVERTEXATTRIBPOINTERPROC,      glVertexAttribPointer);
+    /* a triangle over the whole viewport; t: the texel centres of the frame, unflipped */
+    static const char *vs =
+        "#version 120\n"
+        "attribute vec2 p;\n"
+        "varying vec2 t;\n"
+        "void main() { t = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }\n";
+    /* an 8-bit channel value v as the centre of lut's texel v */
+    static const char *fs =
+        "#version 120\n"
+        "uniform sampler2D frame, lut;\n"
+        "varying vec2 t;\n"
+        "void main() {\n"
+        "    vec3 c = texture2D(frame, t).rgb * (255.0 / 256.0) + (0.5 / 256.0);\n"
+        "    gl_FragColor = vec4(texture2D(lut, vec2(c.r, 0.5)).r,\n"
+        "        texture2D(lut, vec2(c.g, 0.5)).g, texture2D(lut, vec2(c.b, 0.5)).b, 1.0);\n"
+        "}\n";
+    static const GLfloat tri[] = { -1, -1, 3, -1, -1, 3 };
+    GLuint sh[2], tex[2];
+    GLint linked = 0;
+
+    if (!p_glActiveTexture || !p_glAttachShader || !p_glBindAttribLocation || !p_glBindTexture ||
+        !p_glCompileShader || !p_glCreateProgram || !p_glCreateShader || !p_glDeleteShader ||
+        !p_glEnableVertexAttribArray || !p_glGenTextures || !p_glGetProgramiv ||
+        !p_glGetUniformLocation || !p_glLinkProgram || !p_glShaderSource || !p_glTexImage2D ||
+        !p_glTexParameteri || !p_glUniform1i || !p_glUseProgram || !p_glVertexAttribPointer)
+        return 0;
+    scan.prog = p_glCreateProgram();
+    sh[0] = p_glCreateShader(GL_VERTEX_SHADER);
+    sh[1] = p_glCreateShader(GL_FRAGMENT_SHADER);
+    p_glShaderSource(sh[0], 1, &vs, NULL);
+    p_glShaderSource(sh[1], 1, &fs, NULL);
+    for (int i = 0; i < 2; i++) {
+        p_glCompileShader(sh[i]);
+        p_glAttachShader(scan.prog, sh[i]);
+        p_glDeleteShader(sh[i]);
+    }
+    p_glBindAttribLocation(scan.prog, 0, "p");
+    p_glLinkProgram(scan.prog);
+    p_glGetProgramiv(scan.prog, GL_LINK_STATUS, &linked);
+    if (!linked)
+        return 0;
+    /* the program, the textures and the triangle stay bound: nothing else draws in scan.ctx */
+    p_glUseProgram(scan.prog);
+    p_glUniform1i(p_glGetUniformLocation(scan.prog, "frame"), 0);
+    p_glUniform1i(p_glGetUniformLocation(scan.prog, "lut"), 1);
+    p_glGenTextures(2, tex);
+    scan.tex = tex[0];
+    scan.lut = tex[1];
+    for (int i = 0; i < 2; i++) {
+        p_glActiveTexture(GL_TEXTURE0 + i);
+        p_glBindTexture(GL_TEXTURE_2D, tex[i]);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+    p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 256, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    p_glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, tri);
+    p_glEnableVertexAttribArray(0);
+    scan.lut_dirty = 1;
+    scan.tex_w = scan.tex_h = 0;
+    return 1;
+}
+
+/* The frame into the bound draw framebuffer (a renderbuffer of ours) through the guest's gamma
+ * ramp, with scan.ctx current */
+static int scan_gamma(void)
+{
+    MESA_PFN(PFNGLACTIVETEXTUREPROC,     glActiveTexture);
+    MESA_PFN(PFNGLCOPYTEXSUBIMAGE2DPROC, glCopyTexSubImage2D);
+    MESA_PFN(PFNGLDRAWARRAYSPROC,        glDrawArrays);
+    MESA_PFN(PFNGLTEXIMAGE2DPROC,        glTexImage2D);
+    MESA_PFN(PFNGLTEXSUBIMAGE2DPROC,     glTexSubImage2D);
+    MESA_PFN(PFNGLVIEWPORTPROC,          glViewport);
+
+    if (scan.gamma_failed || !p_glActiveTexture || !p_glCopyTexSubImage2D || !p_glDrawArrays ||
+        !p_glTexImage2D || !p_glTexSubImage2D || !p_glViewport)
+        return 0;
+    if (!scan.prog && !scan_gamma_init()) {
+        DPRINTF("dmabuf scanout: no shader for the gamma ramp, frames with one are read back");
+        scan.gamma_failed = 1;
+        return 0;
+    }
+    if (scan.lut_dirty) {
+        uint8_t lut[256 * 4];
+        for (int i = 0; i < 256; i++) {
+            lut[i * 4] = e.ramp.r[i] >> 8;
+            lut[i * 4 + 1] = e.ramp.g[i] >> 8;
+            lut[i * 4 + 2] = e.ramp.b[i] >> 8;
+            lut[i * 4 + 3] = 0xff;
+        }
+        p_glActiveTexture(GL_TEXTURE1);
+        p_glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 256, 1, GL_RGBA, GL_UNSIGNED_BYTE, lut);
+        scan.lut_dirty = 0;
+    }
+    p_glActiveTexture(GL_TEXTURE0);
+    if ((scan.tex_w != scan.w) || (scan.tex_h != scan.h)) {
+        p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, scan.w, scan.h, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+                       NULL);
+        scan.tex_w = scan.w;
+        scan.tex_h = scan.h;
+    }
+    p_glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, scan.w, scan.h);
+    p_glViewport(0, 0, scan.w, scan.h);
+    p_glDrawArrays(GL_TRIANGLES, 0, 3);
+    return 1;
+}
+
+/* How the copies are synchronised, decided at the first (the guest's context current): an EGL fence
+ * (EGL_KHR_fence_sync) or glFinish; and whether scan.ctx waits for the guest's frame in its own GL
+ * stream (EGL_KHR_wait_sync, eglWaitSyncKHR) instead of the CPU waiting for it: on a GPU, not with
+ * Mesa's software renderers (which don't all wait in the stream); QEMU_3DFX_WAIT_SYNC=1 or 0 in
+ * the environment decides instead */
+static void scan_sync_init(void)
+{
+    MESA_PFN(PFNGLGETSTRINGPROC, glGetString);
+    const char *ext = egl.QueryString(e.dpy, EGL_EXTENSIONS), *env = g_getenv("QEMU_3DFX_WAIT_SYNC");
+    const char *r = (p_glGetString)? (const char *)p_glGetString(GL_RENDERER):NULL;
+    int soft = !r || strstr(r, "llvmpipe") || strstr(r, "softpipe");
+
+    if (has_ext(ext, "EGL_KHR_fence_sync")) {
+        scan.create_sync = (PFNEGLCREATESYNCKHRPROC) egl.GetProcAddress("eglCreateSyncKHR");
+        scan.client_wait = (PFNEGLCLIENTWAITSYNCKHRPROC) egl.GetProcAddress("eglClientWaitSyncKHR");
+        scan.destroy_sync = (PFNEGLDESTROYSYNCKHRPROC) egl.GetProcAddress("eglDestroySyncKHR");
+    }
+    scan.fence = (scan.create_sync && scan.client_wait && scan.destroy_sync)? 1:-1;
+    if ((scan.fence > 0) && has_ext(ext, "EGL_KHR_wait_sync"))
+        scan.server_wait = (PFNEGLWAITSYNCKHRPROC) egl.GetProcAddress("eglWaitSyncKHR");
+    scan.wait_sync = scan.server_wait && ((env)? !strcmp(env, "1"):!soft);
+    DPRINTF("dmabuf scanout: the guest's frames and the copies are finished with %s%s",
+        (scan.fence > 0)? "an EGL fence (EGL_KHR_fence_sync)":"glFinish (no EGL_KHR_fence_sync)",
+        (scan.wait_sync)? "; the copy waits for the guest's frame in the GL stream (EGL_KHR_wait_sync)":"");
+}
+
+/* The GL work so far in the current context finished, before another context or the display reads
+ * what it rendered: an EGL fence (EGL_KHR_fence_sync) waited on, else glFinish. A wait on the CPU
+ * (eglClientWaitSyncKHR): the display reads the copy from a context of its own at once */
+static void scan_finish(void)
+{
+    MESA_PFN(PFNGLFINISHPROC, glFinish);
+
+    if (!scan.fence)
+        scan_sync_init();
+    if (scan.fence > 0) {
+        EGLSyncKHR sync = scan.create_sync(e.dpy, EGL_SYNC_FENCE_KHR, NULL);
+        if (sync != EGL_NO_SYNC_KHR) {
+            EGLint r = scan.client_wait(e.dpy, sync, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, EGL_FOREVER_KHR);
+            scan.destroy_sync(e.dpy, sync);
+            if (r == EGL_CONDITION_SATISFIED_KHR)
+                return;
+        }
+    }
+    if (p_glFinish)
+        p_glFinish();
+}
+
+/* Makes scan.ctx current for a copy of the guest's frame, the guest's rendering done (another
+ * context reads it); 0, with nothing changed, when the guest's window isn't current */
+static int scan_begin(EglCurrent *cur)
+{
+    MESA_PFN(PFNGLFINISHPROC, glFinish);
+    MESA_PFN(PFNGLFLUSHPROC, glFlush);
+    EGLSyncKHR sync = EGL_NO_SYNC_KHR;
+
+    egl_current_save(cur);
+    if ((cur->draw != e.surf) || !p_glFinish)
+        return 0;
+    if (!scan.fence)
+        scan_sync_init();
+    /* A fence after the guest's frame, flushed, which scan.ctx's GL stream waits for; else the
+     * CPU waits for the frame */
+    if (scan.wait_sync && p_glFlush) {
+        sync = scan.create_sync(e.dpy, EGL_SYNC_FENCE_KHR, NULL);
+        if (sync != EGL_NO_SYNC_KHR)
+            p_glFlush();
+    }
+    if (sync == EGL_NO_SYNC_KHR)
+        scan_finish();
+    if (!egl.MakeCurrent(e.dpy, e.surf, e.surf, scan.ctx)) {
+        if (sync != EGL_NO_SYNC_KHR)
+            scan.destroy_sync(e.dpy, sync);
+        egl_current_restore(cur);
+        return 0;
+    }
+    if (sync != EGL_NO_SYNC_KHR) {
+        if (scan.server_wait(e.dpy, sync, 0) != EGL_TRUE)
+            scan.client_wait(e.dpy, sync, 0, EGL_FOREVER_KHR);
+        scan.destroy_sync(e.dpy, sync);
+    }
+    return 1;
+}
+
+/* The copy finished (the guest's next frame may overwrite its source, the display read its
+ * destination), the guest's context back */
+static void scan_end(const EglCurrent *cur)
+{
+    scan_finish();
+    egl_current_restore(cur);
+}
+
+/* fxdisp's scanout, on the vCPU thread after a swap: the frame into dmabuf i, finished; 0 to have
+ * it read back */
+static int egl_scanout(void *opaque, int i)
+{
+    MESA_PFN(PFNGLBINDFRAMEBUFFERPROC, glBindFramebuffer);
+    MESA_PFN(PFNGLBLITFRAMEBUFFERPROC, glBlitFramebuffer);
+    EglCurrent cur;
+    int ok;
+
+    if ((i < 0) || (i > 1) || !scan.img[i] || (scan.w != e.w) || (scan.h != e.h) ||
+        !p_glBindFramebuffer || !p_glBlitFramebuffer || (e.gamma && scan.gamma_failed) ||
+        !scan_begin(&cur))
+        return 0;
+    p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, scan.fbo[i]);
+    if (e.gamma)
+        ok = scan_gamma();
+    else {
+        p_glBlitFramebuffer(0, 0, scan.w, scan.h, 0, 0, scan.w, scan.h, GL_COLOR_BUFFER_BIT,
+                            GL_NEAREST);
+        ok = 1;
+    }
+    scan_end(&cur);
+    return ok;
+}
+
+/* The guest's display mode: the first graphic console's size, brought up to date (the VGA isn't
+ * redrawn while the console shows frames of ours) */
+static void egl_display_size(int *w, int *h)
+{
+    QemuConsole *con = qemu_console_lookup_by_index(0);
+    DisplaySurface *ds;
+
+    *w = 640;
+    *h = 480;
+    if (!con || !qemu_console_is_graphic(con))
+        return;
+    qemu_console_hw_update(con);
+    ds = qemu_console_surface(con);
+    if (ds && (surface_width(ds) > 0) && (surface_height(ds) > 0)) {
+        *w = surface_width(ds);
+        *h = surface_height(ds);
+    }
+}
+
+static EGLSurface egl_pbuffer(EGLConfig cfg, int w, int h)
+{
+    const EGLint attr[] = { EGL_WIDTH, w, EGL_HEIGHT, h, EGL_NONE };
+    return egl.CreatePbufferSurface(e.dpy, cfg, attr);
+}
+
+/* DLL attach: offscreen unless the display is SDL without GL. Returns 1 when this backend takes
+ * the guest (even when EGL fails: its GL then fails), 0 for GLX on the SDL window. */
+int MGLEglAttach(void)
+{
+    const char *which = "";
+    EGLint major, minor;
+
+    if (e.active)
+        MGLEglWndRelease();
+    e.active = fxdisp_choose();
+    if (!e.active)
+        return 0;
+    e.failed = 1;
+    e.cfg_ok = 0;
+    if (!egl_load())
+        return 1;
+    e.dpy = egl_display(&which);
+    if ((e.dpy == EGL_NO_DISPLAY) || !egl.Initialize(e.dpy, &major, &minor)) {
+        DPRINTF("no SDL window, and no EGL display to render offscreen (%s, 0x%04x); "
+            "the guest's OpenGL fails", which, egl.GetError());
+        e.dpy = EGL_NO_DISPLAY;
+        return 1;
+    }
+    if (!egl.BindAPI(EGL_OPENGL_API)) {
+        DPRINTF("the %s EGL display has no desktop OpenGL; the guest's OpenGL fails", which);
+        e.dpy = EGL_NO_DISPLAY;
+        return 1;
+    }
+    e.failed = 0;
+    if (!e.fx)
+        e.fx = fxdisp_new("mesapt", egl_read, NULL);
+    fxdisp_dmabuf(e.fx, egl_export, egl_scanout, 2);
+    egl_reset_ramp();
+    DPRINTF("no SDL window: rendering offscreen, EGL %d.%d on the %s display (%s)", major, minor,
+        which, egl.QueryString(e.dpy, EGL_VENDOR));
+    return 1;
+}
+
+static int egl_choose(EGLConfig *cfg, int msaa, int alpha)
+{
+    const EGLint attr[] = {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, (alpha)? 8:0,
+        EGL_DEPTH_SIZE, 24, EGL_STENCIL_SIZE, 8,
+        EGL_SAMPLE_BUFFERS, (msaa)? 1:0, EGL_SAMPLES, msaa,
+        EGL_NONE
+    };
+    EGLint n = 0;
+    return egl.ChooseConfig(e.dpy, attr, cfg, 1, &n) && (n > 0);
+}
+
+/* Does a pbuffer of this multisampled config give its frame back to egl_read? Mesa's llvmpipe
+ * doesn't (glReadPixels fails with GL_INVALID_OPERATION, a resolving blit returns black): a clear
+ * on a small one, read back the way egl_read reads, on a context of its own (the guest's current
+ * context, if any, is put back) */
+static int egl_msaa_works(EGLConfig cfg)
+{
+    MESA_PFN(PFNGLCLEARCOLORPROC,   glClearColor);
+    MESA_PFN(PFNGLCLEARPROC,        glClear);
+    MESA_PFN(PFNGLFINISHPROC,       glFinish);
+    MESA_PFN(PFNGLGETBOOLEANVPROC,  glGetBooleanv);
+    MESA_PFN(PFNGLGETERRORPROC,     glGetError);
+    MESA_PFN(PFNGLREADBUFFERPROC,   glReadBuffer);
+    MESA_PFN(PFNGLREADPIXELSPROC,   glReadPixels);
+    EGLContext prev_ctx = egl.GetCurrentContext(), ctx;
+    EGLSurface prev_draw = egl.GetCurrentSurface(EGL_DRAW),
+               prev_read = egl.GetCurrentSurface(EGL_READ), surf;
+    uint8_t px[4] = { 0, 0, 0, 0 };
+    GLboolean dbl = GL_TRUE;
+    int ok = 0;
+
+    if (!p_glClearColor || !p_glClear || !p_glFinish || !p_glGetBooleanv || !p_glGetError ||
+        !p_glReadBuffer || !p_glReadPixels)
+        return 0;
+    surf = egl_pbuffer(cfg, 4, 4);
+    ctx = (surf)? egl.CreateContext(e.dpy, cfg, EGL_NO_CONTEXT, NULL):EGL_NO_CONTEXT;
+    if (ctx && egl.MakeCurrent(e.dpy, surf, surf, ctx)) {
+        p_glClearColor(0, 1, 0, 1);
+        p_glClear(GL_COLOR_BUFFER_BIT);
+        p_glFinish();
+        p_glGetBooleanv(GL_DOUBLEBUFFER, &dbl);
+        p_glReadBuffer((dbl)? GL_BACK:GL_FRONT);
+        p_glReadPixels(1, 1, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, px);
+        ok = (p_glGetError() == GL_NO_ERROR) && (px[1] > 0xf0) && (px[0] < 0x10);
+    }
+    egl.MakeCurrent(e.dpy, prev_draw, prev_read, prev_ctx);
+    if (ctx)
+        egl.DestroyContext(e.dpy, ctx);
+    if (surf)
+        egl.DestroySurface(e.dpy, surf);
+    return ok;
+}
+
+/* The guest's first wglChoosePixelFormat/wglSetPixelFormat/wglDescribePixelFormat: the "window" */
+static int MGLEglPreset(void)
+{
+    int msaa;
+
+    qatomic_set(&e.wnd_ready, 0);
+    ImplMesaGLReset();
+    if (e.failed) {
+        qatomic_set(&e.wnd_ready, 1);
+        return 0;
+    }
+    msaa = GetContextMSAA();
+    if (msaa && egl_choose(&e.cfg, msaa, 1) && !egl_msaa_works(e.cfg)) {
+        DPRINTF("%dx multisampling: this EGL driver doesn't return a multisampled pbuffer's "
+            "frame, rendering without", msaa);
+        msaa = 0;
+    }
+    if (!egl_choose(&e.cfg, msaa, 1)) {
+        if (msaa)
+            DPRINTF("no EGL config with %dx multisampling, rendering without", msaa);
+        if (!(msaa && egl_choose(&e.cfg, 0, 1)) && !egl_choose(&e.cfg, 0, 0)) {
+            DPRINTF("no EGL pbuffer config for desktop OpenGL; the guest's OpenGL fails");
+            e.failed = 1;
+            qatomic_set(&e.wnd_ready, 1);
+            return 0;
+        }
+    }
+    if (!egl_choose(&e.pbcfg, 0, 1))
+        e.pbcfg = e.cfg;
+    egl.GetConfigAttrib(e.dpy, e.cfg, EGL_ALPHA_SIZE, &e.cAlphaBits);
+    egl.GetConfigAttrib(e.dpy, e.cfg, EGL_DEPTH_SIZE, &e.cDepthBits);
+    egl.GetConfigAttrib(e.dpy, e.cfg, EGL_STENCIL_SIZE, &e.cStencilBits);
+    egl.GetConfigAttrib(e.dpy, e.cfg, EGL_SAMPLE_BUFFERS, &e.cSampleBuf[0]);
+    egl.GetConfigAttrib(e.dpy, e.cfg, EGL_SAMPLES, &e.cSampleBuf[1]);
+    e.cAuxBuffers = 0;
+    egl_display_size(&e.w, &e.h);
+    e.surf = egl_pbuffer(e.cfg, e.w, e.h);
+    if (e.surf == EGL_NO_SURFACE) {
+        DPRINTF("eglCreatePbufferSurface %dx%d 0x%04x; the guest's OpenGL fails",
+            e.w, e.h, egl.GetError());
+        e.failed = 1;
+        qatomic_set(&e.wnd_ready, 1);
+        return 0;
+    }
+    e.cfg_ok = 1;
+    fxdisp_open(e.fx, e.w, e.h, 0);
+    DPRINTF("offscreen window %dx%d, alpha %d depth %d stencil %d samples %d %d%s", e.w, e.h,
+        e.cAlphaBits, e.cDepthBits, e.cStencilBits, e.cSampleBuf[0], e.cSampleBuf[1],
+        (GetContextMSAA() && !e.cSampleBuf[0])? " (multisampling not available)":"");
+    qatomic_set(&e.wnd_ready, 1);
+    return 1;
+}
+
+int MGLEglChoosePixelFormat(void)
+{
+    if (!e.cfg_ok)
+        return MGLEglPreset();
+    return 1;
+}
+
+int MGLEglSetPixelFormat(int fmt, const void *p)
+{
+    int ret = (e.cfg_ok)? 1:MGLEglPreset();
+    DPRINTF("SetPixelFormat() ret %d", ret);
+    return ret;
+}
+
+int MGLEglDescribePixelFormat(int fmt, unsigned int sz, void *p)
+{
+    if (!e.cfg_ok && !MGLEglPreset())
+        return 0;
+    memcpy(p, &pfd, sizeof(PFD));
+    ((PFD *)p)->cDepthBits = e.cDepthBits;
+    ((PFD *)p)->cStencilBits = e.cStencilBits;
+    ((PFD *)p)->cAuxBuffers = e.cAuxBuffers;
+    return 1;
+}
+
+static void egl_destroy_levels(int from)
+{
+    for (int i = MAX_LVLCNTX; i > from;) {
+        if (e.ctx[--i]) {
+            egl.DestroyContext(e.dpy, e.ctx[i]);
+            e.ctx[i] = 0;
+        }
+    }
+}
+
+void MGLEglDeleteContext(int level)
+{
+    int n = (level)? ((level % MAX_LVLCNTX)? (level % MAX_LVLCNTX):1):level;
+    if (!e.cfg_ok)
+        return;
+    egl.MakeCurrent(e.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (n) {
+        if (e.ctx[n])
+            egl.DestroyContext(e.dpy, e.ctx[n]);
+        e.ctx[n] = 0;
+    }
+    else {
+        egl_destroy_levels(1);
+        MesaBlitFree();
+        MGLActivateHandler(0, 0);
+    }
+}
+
+/* DLL detach: everything goes, the console shows the VGA */
+void MGLEglWndRelease(void)
+{
+    if (!e.active)
+        return;
+    /* a detach without wglDeleteContext leaves the window active: deactivate it (the next
+     * attach's MGLActivateHandler(1) must show its frames again) */
+    MGLActivateHandler(0, 0);
+    deactivateCancel();
+    if (e.dpy != EGL_NO_DISPLAY) {
+        egl.MakeCurrent(e.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        egl_destroy_levels(0);
+        for (int i = 0; i < MAX_PBUFFER; i++) {
+            if (e.PBRC[i])
+                egl.DestroyContext(e.dpy, e.PBRC[i]);
+            if (e.PBDC[i])
+                egl.DestroySurface(e.dpy, e.PBDC[i]);
+        }
+        scan_destroy();
+        if (e.surf)
+            egl.DestroySurface(e.dpy, e.surf);
+        /* No eglTerminate: the display is the process's one (an EGL platform display is the
+         * same handle for every caller), shared with Glide's (wsh-openglide) and with QEMU's own
+         * egl-headless or dbus,gl=on display on Mesa's surfaceless platform; terminating it
+         * would destroy their contexts */
+    }
+    fxdisp_close(e.fx);
+    egl_reset_ramp();
+    CompareAttribArray(NULL);
+    memset(e.PBRC, 0, sizeof(e.PBRC));
+    memset(e.PBDC, 0, sizeof(e.PBDC));
+    memset(e.hPbuffer, 0, sizeof(e.hPbuffer));
+    e.surf = EGL_NO_SURFACE;
+    e.dpy = EGL_NO_DISPLAY;
+    e.cfg_ok = 0;
+    e.failed = 0;
+    e.active = 0;
+    qatomic_set(&e.wnd_ready, 0);
+}
+
+int MGLEglCreateContext(uint32_t gDC)
+{
+    int i = gDC & (MAX_PBUFFER - 1);
+    if (gDC == ((MESAGL_HPBDC & 0xFFFFFFF0U) | i))
+        return 0;
+    if (!e.cfg_ok)
+        return 1;
+    egl.MakeCurrent(e.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    egl_destroy_levels(1);
+    if (!e.ctx[0]) {
+        e.ctx[0] = egl.CreateContext(e.dpy, e.cfg, EGL_NO_CONTEXT, NULL);
+        if (!e.ctx[0])
+            DPRINTF("eglCreateContext 0x%04x; the guest's OpenGL fails", egl.GetError());
+    }
+    return (e.ctx[0])? 0:1;
+}
+
+/* A new display mode since the window was made (only while its frames aren't shown, as an SDL
+ * window follows the VGA only then): a pbuffer of the new size */
+static void egl_follow_display(void)
+{
+    int w, h;
+    EGLSurface surf;
+
+    egl_display_size(&w, &h);
+    if ((w == e.w) && (h == e.h))
+        return;
+    surf = egl_pbuffer(e.cfg, w, h);
+    if (surf == EGL_NO_SURFACE)
+        return;
+    egl.MakeCurrent(e.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    egl.DestroySurface(e.dpy, e.surf);
+    e.surf = surf;
+    e.w = w;
+    e.h = h;
+    fxdisp_resize(e.fx, w, h);
+}
+
+int MGLEglMakeCurrent(uint32_t cntxRC, int level)
+{
+    int n = (level)? ((level % MAX_LVLCNTX)? (level % MAX_LVLCNTX):1):level;
+    uint32_t i = cntxRC & (MAX_PBUFFER - 1);
+    if (!e.cfg_ok)
+        return (cntxRC)? 1:0;
+    if (cntxRC == (MESAGL_MAGIC - n)) {
+        if (!n && !fxdisp_shown(e.fx))
+            egl_follow_display();
+        if (!e.ctx[n] || !egl.MakeCurrent(e.dpy, e.surf, e.surf, e.ctx[n])) {
+            DPRINTF("eglMakeCurrent level %d 0x%04x", n, egl.GetError());
+            return 1;
+        }
+        InitMesaGLExt();
+        wrContextSRGB(ContextUseSRGB());
+        if (!n)
+            MGLActivateHandler(1, 0);
+    }
+    if (cntxRC == (((MESAGL_MAGIC & 0xFFFFFFFU) << 4) | i))
+        egl.MakeCurrent(e.dpy, e.PBDC[i], e.PBDC[i], e.PBRC[i]);
+    return 0;
+}
+
+int MGLEglSwapBuffers(void)
+{
+    MGLActivateHandler(1, 0);
+    /* A pbuffer has no swap: its frame is read now, before the guest draws the next one */
+    fxdisp_frame(e.fx, 1, 0);
+    return 1;
+}
+
+int MGLEglNumPbuffer(void)
+{
+    int c = 0;
+    for (int i = 0; i < MAX_PBUFFER; i++)
+        if (e.hPbuffer[i].width)
+            c++;
+    return c;
+}
+
+int MGLEglDrawableContext(void)
+{
+    return e.ctx[0] && (e.ctx[0] == egl.GetCurrentContext());
+}
+
+int MGLGuiFullscreen(int *v)
+{
+    if (!e.active)
+        return mesa_gui_fullscreen(v);
+    if (v) {
+        v[0] = e.w;
+        v[1] = e.h;
+        v[2] = e.w;
+        v[3] = e.h;
+    }
+    return 0;
+}
+
+void MGLRendererStat(const int activate)
+{
+    if (!e.active)
+        mesa_renderer_stat(activate);
+    else
+        fxdisp_renderer(e.fx, activate);
+}
+
+static int PbufferGLBinding(const int target)
+{
+    switch (target) {
+        case WGL_TEXTURE_2D_ARB:
+            return GL_TEXTURE_BINDING_2D;
+        case WGL_TEXTURE_RECTANGLE_NV:
+            return GL_TEXTURE_BINDING_RECTANGLE;
+        default:
+            return 0;
+    }
+}
+static int PbufferGLAttrib(const int attr)
+{
+    switch (attr) {
+        case WGL_TEXTURE_2D_ARB:
+            return GL_TEXTURE_2D;
+        case WGL_TEXTURE_RECTANGLE_NV:
+            return GL_TEXTURE_RECTANGLE;
+        case WGL_TEXTURE_RGB_ARB:
+            return GL_RGB;
+        case WGL_TEXTURE_RGBA_ARB:
+            return GL_RGBA;
+        default:
+            return 0;
+    }
+}
+static int LookupAttribArray(const int *attrib, const int attr)
+{
+    for (int i = 0; attrib[i]; i+=2) {
+        if (attrib[i] == attr) {
+            switch (attr) {
+                case WGL_DEPTH_BITS_ARB:
+                    return e.cDepthBits;
+                case WGL_STENCIL_BITS_ARB:
+                    return e.cStencilBits;
+                case WGL_AUX_BUFFERS_ARB:
+                    return e.cAuxBuffers;
+                case WGL_SAMPLE_BUFFERS_ARB:
+                    return e.cSampleBuf[0];
+                case WGL_SAMPLES_ARB:
+                    return e.cSampleBuf[1];
+                default:
+                    return attrib[i+1];
+            }
+        }
+    }
+    return 0;
+}
+
+/* WGL_ARB_create_context's attributes as EGL_KHR_create_context's (same bits) */
+static void egl_context_attribs(const int *wgl, EGLint *out, int max)
+{
+    int n = 0;
+    for (int i = 0; wgl[i] && (n + 2) < max; i += 2) {
+        switch (wgl[i]) {
+            case WGL_CONTEXT_MAJOR_VERSION_ARB:
+                out[n++] = EGL_CONTEXT_MAJOR_VERSION_KHR;
+                break;
+            case WGL_CONTEXT_MINOR_VERSION_ARB:
+                out[n++] = EGL_CONTEXT_MINOR_VERSION_KHR;
+                break;
+            case WGL_CONTEXT_FLAGS_ARB:
+                out[n++] = EGL_CONTEXT_FLAGS_KHR;
+                break;
+            case WGL_CONTEXT_PROFILE_MASK_ARB:
+                out[n++] = EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR;
+                break;
+            default:
+                continue;
+        }
+        out[n++] = wgl[i + 1];
+    }
+    out[n] = EGL_NONE;
+}
+
+void MGLEglFuncHandler(const char *name)
+{
+    char fname[64];
+    uint32_t *argsp = (uint32_t *)(name + ALIGNED((strnlen(name, sizeof(fname))+1)));
+    strncpy(fname, name, sizeof(fname)-1);
+    fname[sizeof(fname)-1] = 0;
+
+#define FUNCP_HANDLER(a) \
+    if (!memcmp(fname, a, sizeof(a)))
+
+    FUNCP_HANDLER("wglShareLists") {
+        uint32_t i = argsp[1] & (MAX_PBUFFER - 1), ret = 0;
+        if ((argsp[0] == MESAGL_MAGIC) && (argsp[1] == ((MESAGL_MAGIC & 0xFFFFFFFU) << 4 | i)))
+            ret = 1;
+        else
+            DPRINTF("  *WARN* ShareLists called with unknown contexts, %x %x", argsp[0], argsp[1]);
+        argsp[0] = ret;
+        return;
+    }
+    FUNCP_HANDLER("wglUseFontBitmapsA") {
+        fgFontGenList(argsp[1], argsp[2], argsp[3]);
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglSwapIntervalEXT") {
+        /* nothing waits for a vertical blank offscreen */
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglGetSwapIntervalEXT") {
+        argsp[0] = 0;
+        return;
+    }
+    FUNCP_HANDLER("wglGetExtensionsStringARB") {
+        const char wglext[] = "WGL_3DFX_gamma_control "
+            "WGL_ARB_create_context "
+            "WGL_ARB_create_context_profile "
+            "WGL_ARB_extensions_string "
+            "WGL_ARB_multisample "
+            "WGL_ARB_pixel_format "
+            "WGL_ARB_pbuffer WGL_ARB_render_texture WGL_NV_render_texture_rectangle "
+            "WGL_EXT_extensions_string "
+            "WGL_EXT_swap_control "
+            ;
+        memcpy((char *)name, wglext, sizeof(wglext));
+        *((char *)name + sizeof(wglext) - 2) = '\0';
+        return;
+    }
+    FUNCP_HANDLER("wglCreateContextAttribsARB") {
+        uint32_t i, ret = 0;
+        EGLint attr[32];
+        if (!e.cfg_ok) {
+            argsp[0] = 0;
+            return;
+        }
+        egl_context_attribs((const int *)&argsp[2], attr, ARRAY_SIZE(attr));
+        for (i = 0; ((i < MAX_LVLCNTX) && e.ctx[i]); i++);
+        argsp[1] = (argsp[0])? i:0;
+        if (argsp[1] == 0) {
+            egl.MakeCurrent(e.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            if (CompareAttribArray((const int *)&argsp[2])) {
+                egl_destroy_levels(0);
+                MGLActivateHandler(0, 0);
+                e.ctx[0] = egl.CreateContext(e.dpy, e.cfg, EGL_NO_CONTEXT, attr);
+                if (!e.ctx[0])
+                    DPRINTF("eglCreateContext (attribs) 0x%04x", egl.GetError());
+            }
+            ret = (e.ctx[0])? 1:0;
+        }
+        else {
+            if (i == MAX_LVLCNTX) {
+                egl.DestroyContext(e.dpy, e.ctx[1]);
+                for (i = 1; i < (MAX_LVLCNTX - 1); i++)
+                    e.ctx[i] = e.ctx[i + 1];
+                argsp[1] = i;
+            }
+            e.ctx[i] = egl.CreateContext(e.dpy, e.cfg, e.ctx[i-1], attr);
+            ret = (e.ctx[i])? 1:0;
+        }
+        argsp[0] = ret;
+        return;
+    }
+    FUNCP_HANDLER("wglGetPixelFormatAttribfvARB") {
+        const int *ia = (const int *)&argsp[4], n = MIN(argsp[2], 64);
+        float pf[64];
+        for (int i = 0; i < n; i++)
+            pf[i] = (float)LookupAttribArray(iAttribs, ia[i]);
+        memcpy(&argsp[2], pf, n*sizeof(float));
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglGetPixelFormatAttribivARB") {
+        const int *ia = (const int *)&argsp[4], n = MIN(argsp[2], 64);
+        int pi[64];
+        for (int i = 0; i < n; i++)
+            pi[i] = LookupAttribArray(iAttribs, ia[i]);
+        memcpy(&argsp[2], pi, n*sizeof(int));
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglChoosePixelFormatARB") {
+        const int *ia = (const int *)argsp;
+        if (LookupAttribArray(ia, WGL_DRAW_TO_PBUFFER_ARB))
+            argsp[1] = 0x02;
+        else
+            argsp[1] = MGLEglChoosePixelFormat();
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglBindTexImageARB") {
+        MESA_PFN(PFNGLBINDTEXTUREPROC,     glBindTexture);
+        MESA_PFN(PFNGLCOPYTEXIMAGE2DPROC,  glCopyTexImage2D);
+        MESA_PFN(PFNGLGETINTEGERVPROC,     glGetIntegerv);
+        uint32_t i = argsp[0] & (MAX_PBUFFER - 1);
+        if (PbufferGLBinding(e.hPbuffer[i].target) && PbufferGLAttrib(e.hPbuffer[i].format) &&
+            e.PBRC[i]) {
+            int prev_binded_texture = 0;
+            EGLContext prev_context = egl.GetCurrentContext();
+            EGLSurface prev_draw = egl.GetCurrentSurface(EGL_DRAW),
+                       prev_read = egl.GetCurrentSurface(EGL_READ);
+            PFN_CALL(glGetIntegerv(PbufferGLBinding(e.hPbuffer[i].target), &prev_binded_texture));
+            egl.MakeCurrent(e.dpy, e.PBDC[i], e.PBDC[i], e.PBRC[i]);
+            PFN_CALL(glBindTexture(PbufferGLAttrib(e.hPbuffer[i].target), prev_binded_texture));
+            PFN_CALL(glCopyTexImage2D(PbufferGLAttrib(e.hPbuffer[i].target), e.hPbuffer[i].level,
+                PbufferGLAttrib(e.hPbuffer[i].format), 0, 0, e.hPbuffer[i].width, e.hPbuffer[i].height, 0));
+            egl.MakeCurrent(e.dpy, prev_draw, prev_read, prev_context);
+        }
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglReleaseTexImageARB") {
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglCreatePbufferARB") {
+        uint32_t i;
+        for (i = 0; ((i < MAX_PBUFFER) && e.hPbuffer[i].width); i++);
+        if ((MAX_PBUFFER == i) || !e.cfg_ok) {
+            DPRINTF("wglCreatePbufferARB: %s", (e.cfg_ok)? "MAX_PBUFFER reached":"no EGL");
+            argsp[0] = 0;
+            return;
+        }
+        const int *pattr = (const int *)&argsp[4];
+        e.hPbuffer[i].width = argsp[1];
+        e.hPbuffer[i].height = argsp[2];
+        e.hPbuffer[i].target = LookupAttribArray(pattr, WGL_TEXTURE_TARGET_ARB);
+        e.hPbuffer[i].format = LookupAttribArray(pattr, WGL_TEXTURE_FORMAT_ARB);
+        e.hPbuffer[i].level = LookupAttribArray(pattr, WGL_MIPMAP_LEVEL_ARB);
+        e.PBDC[i] = egl_pbuffer(e.pbcfg, e.hPbuffer[i].width, e.hPbuffer[i].height);
+        e.PBRC[i] = (e.PBDC[i])? egl.CreateContext(e.dpy, e.pbcfg, egl.GetCurrentContext(), NULL):0;
+        if (!e.PBDC[i] || !e.PBRC[i]) {
+            DPRINTF("wglCreatePbufferARB %dx%d: EGL 0x%04x", argsp[1], argsp[2], egl.GetError());
+            if (e.PBDC[i])
+                egl.DestroySurface(e.dpy, e.PBDC[i]);
+            e.PBDC[i] = 0;
+            e.PBRC[i] = 0;
+            memset(&e.hPbuffer[i], 0, sizeof(PbufferARB));
+            argsp[0] = 0;
+        }
+        else
+            argsp[0] = 1;
+        argsp[1] = i;
+        return;
+    }
+    FUNCP_HANDLER("wglDestroyPbufferARB") {
+        uint32_t i = argsp[0] & (MAX_PBUFFER - 1);
+        if (e.PBRC[i])
+            egl.DestroyContext(e.dpy, e.PBRC[i]);
+        if (e.PBDC[i])
+            egl.DestroySurface(e.dpy, e.PBDC[i]);
+        e.PBRC[i] = 0;
+        e.PBDC[i] = 0;
+        memset(&e.hPbuffer[i], 0, sizeof(PbufferARB));
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglQueryPbufferARB") {
+        uint32_t i = argsp[0] & (MAX_PBUFFER - 1);
+        switch(argsp[1]) {
+            case WGL_PBUFFER_WIDTH_ARB:
+                argsp[2] = e.hPbuffer[i].width;
+                break;
+            case WGL_PBUFFER_HEIGHT_ARB:
+                argsp[2] = e.hPbuffer[i].height;
+                break;
+            case WGL_TEXTURE_TARGET_ARB:
+                argsp[2] = e.hPbuffer[i].target;
+                break;
+            case WGL_TEXTURE_FORMAT_ARB:
+                argsp[2] = e.hPbuffer[i].format;
+                break;
+            case WGL_MIPMAP_LEVEL_ARB:
+                argsp[2] = e.hPbuffer[i].level;
+                break;
+            default:
+                argsp[0] = 0;
+                return;
+        }
+        argsp[0] = 1;
+        return;
+    }
+    /* Gamma: no X server to take the ramp, it is applied to the frames offscreen (fxdisp) */
+    FUNCP_HANDLER("wglGetDeviceGammaRamp3DFX") {
+        if (ContextUseSRGB()) {
+            argsp[0] = 0;
+            return;
+        }
+        memcpy(&argsp[2], &e.ramp, sizeof(e.ramp));
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglSetDeviceGammaRamp3DFX") {
+        if (ContextUseSRGB()) {
+            argsp[0] = 0;
+            return;
+        }
+        memcpy(&e.ramp, &argsp[0], sizeof(e.ramp));
+        fxdisp_gamma(e.fx, e.ramp.r, e.ramp.g, e.ramp.b);
+        e.gamma = 0;
+        for (int i = 0; i < 0x100; i++)
+            e.gamma |= ((e.ramp.r[i] >> 8) != i) || ((e.ramp.g[i] >> 8) != i) ||
+                ((e.ramp.b[i] >> 8) != i);
+        scan.lut_dirty = 1;
+        argsp[0] = 1;
+        return;
+    }
+    FUNCP_HANDLER("wglSetDeviceCursor3DFX") {
+        return;
+    }
+
+    DPRINTF("  *WARN* Unhandled GLFunc %s", name);
+    argsp[0] = 0;
+}
+
+#else /* !CONFIG_LINUX: the SDL window's code only */
+
+int MGLEglActive(void) { return 0; }
+
+int MGLGuiFullscreen(int *v)
+{
+    return mesa_gui_fullscreen(v);
+}
+
+void MGLRendererStat(const int activate)
+{
+    mesa_renderer_stat(activate);
+}
+
+#endif /* CONFIG_LINUX */
