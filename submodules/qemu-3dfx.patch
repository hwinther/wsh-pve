diff --git a/qemu-0/hw/3dfx/fxdisp.c b/qemu-0/hw/3dfx/fxdisp.c
new file mode 100644
index 0000000..1a36205
--- /dev/null
+++ b/qemu-0/hw/3dfx/fxdisp.c
@@ -0,0 +1,191 @@
+/*
+ * QEMU 3Dfx Glide Pass-Through: offscreen display
+ *
+ *  Copyright (c) 2026 WsHosting ENK
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this library;
+ * if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Without an SDL window (-display vnc, none, egl-headless, dbus, gtk, or sdl,gl=on), the Glide
+ * library renders offscreen (wsh-openglide's EGL platform: setConfig(WRAPPER_FLAG_OFFSCREEN)) and
+ * every frame is read back into the first graphic console's own surface, which VNC (PVE's noVNC
+ * console), screendump and any other display then show like the VGA's output. While the Glide
+ * window is open and 3D output is selected, the console is in pass-through (the VGA's updates are
+ * skipped, ui/console.c); when it closes, the VGA redraws.
+ *
+ * The frame is read on the thread that drives the Glide library (the vCPU's, in the glidept MMIO
+ * handler, with the BQL held): after every grBufferSwap, and after any other Glide call when no
+ * frame was read for FXDISP_STALE_MS (front-buffer rendering, LFB writes). A bottom half on the
+ * main loop copies it into the console surface (flipping it: OpenGL's rows are bottom up) and
+ * marks the console updated. QEMU_3DFX_OFFSCREEN=1 in the environment renders offscreen even with
+ * an SDL window (the frames then show in it as the console's 2D surface).
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "qapi/qapi-commands-ui.h"
+#include "ui/console.h"
+
+#include "glide2x_impl.h"
+#include "fxdisp.h"
+
+#define FXDISP_STALE_MS 50
+
+static struct {
+    int offscreen;          /* chosen for the open (or last) Glide window */
+    int open;               /* an offscreen Glide window is open */
+    int shown;              /* 3D output selected (grSstControl, GR_PASSTHRU) */
+    int ready;              /* a frame in pix waits for the bottom half */
+    int w, h;
+    uint8_t *pix;           /* w x h, 4 bytes per pixel (x8r8g8b8), rows bottom up */
+    QemuConsole *con;
+    DisplaySurface *surface; /* ours, while the console has it */
+    QEMUBH *bh;
+    int64_t last_read, opened, scheduled;
+    uint64_t swaps, reads, read_ns, shown_frames, bh_ns;
+} fx;
+
+int fxdisp_offscreen(void)
+{
+    return fx.offscreen;
+}
+
+/* Offscreen unless the display is SDL without GL (the window qemu-3dfx's SDL code renders into,
+ * where anything else would end QEMU in sdl_display_valid()) */
+int fxdisp_choose(void)
+{
+    const char *env = g_getenv("QEMU_3DFX_OFFSCREEN");
+    DisplayOptions *o = qmp_query_display_options(NULL);
+    int sdl = o && (o->type == DISPLAY_TYPE_SDL) &&
+        (!o->has_gl || (o->gl == DISPLAY_GL_MODE_OFF));
+
+    qapi_free_DisplayOptions(o);
+    fx.offscreen = (!sdl || (env && !strcmp(env, "1")))? 1:0;
+    return fx.offscreen;
+}
+
+static void fxdisp_bh(void *opaque)
+{
+    DisplaySurface *ds;
+    int stride;
+
+    if (!fx.open || !fx.ready || !fx.shown || !fx.con)
+        return;
+    fx.ready = 0;
+    fx.bh_ns += get_clock() - fx.scheduled;
+    /* A surface of our own: the VGA's may be its video memory */
+    if (!fx.surface || (qemu_console_surface(fx.con) != fx.surface)) {
+        fx.surface = qemu_create_displaysurface(fx.w, fx.h);
+        qemu_console_set_surface(fx.con, fx.surface);
+    }
+    ds = fx.surface;
+    stride = surface_stride(ds);
+    for (int y = 0; y < fx.h; y++)
+        memcpy((uint8_t *)surface_data(ds) + (size_t)y * stride,
+            fx.pix + (size_t)(fx.h - 1 - y) * fx.w * 4, fx.w * 4);
+    qemu_console_update(fx.con, 0, 0, fx.w, fx.h);
+    fx.shown_frames++;
+}
+
+void fxdisp_open(int w, int h)
+{
+    QemuConsole *con = qemu_console_lookup_by_index(0);
+
+    fx.w = w;
+    fx.h = h;
+    g_free(fx.pix);
+    fx.pix = g_malloc0((size_t)w * h * 4);
+    fx.con = (con && qemu_console_is_graphic(con))? con:NULL;
+    fx.surface = NULL;
+    if (!fx.bh)
+        fx.bh = qemu_bh_new(fxdisp_bh, NULL);
+    fx.open = 1;
+    fx.shown = 1;
+    fx.ready = 0;
+    fx.swaps = fx.reads = fx.read_ns = fx.shown_frames = fx.bh_ns = 0;
+    fx.opened = fx.last_read = get_clock();
+    if (fx.con)
+        graphic_hw_passthrough(fx.con, true);
+    fprintf(stderr, "glidept: offscreen %dx%d, frames to %s\n", w, h,
+        (fx.con)? "the graphic console":"nowhere (no graphic console)");
+}
+
+/* After each Glide call (vCPU thread, BQL held): read the frame after a swap, or when the
+ * last read is older than FXDISP_STALE_MS */
+void fxdisp_frame(int swap)
+{
+    int64_t now, t;
+
+    if (!fx.open)
+        return;
+    now = get_clock();
+    if (swap)
+        fx.swaps++;
+    else if ((now - fx.last_read) < (FXDISP_STALE_MS * SCALE_MS))
+        return;
+    fx.last_read = now;
+    if (!fx.con || !fx.shown || !glide_offscreen_frame)
+        return;
+    t = get_clock();
+    if (glide_offscreen_frame(fx.pix, fx.w, fx.h, fx.w * 4)) {
+        fx.ready = 1;
+        fx.scheduled = get_clock();
+        qemu_bh_schedule(fx.bh);
+    }
+    fx.read_ns += get_clock() - t;
+    fx.reads++;
+}
+
+/* 3D output on (the Glide frames) or off (the VGA's), as SDL's glide_renderer_stat() */
+void fxdisp_renderer(int activate)
+{
+    if (!fx.open || !fx.con || (fx.shown == !!activate))
+        return;
+    fx.shown = !!activate;
+    graphic_hw_passthrough(fx.con, fx.shown);
+    if (fx.shown)
+        fx.last_read = 0;
+    else
+        qemu_console_hw_invalidate(fx.con);
+}
+
+void fxdisp_close(void)
+{
+    double secs;
+
+    if (!fx.open)
+        return;
+    secs = (get_clock() - fx.opened) / 1e9;
+    fprintf(stderr, "glidept: offscreen closed after %.1f s: %" PRIu64 " swaps (%.1f per s), "
+        "%" PRIu64 " reads of %.2f ms average, %" PRIu64 " frames to the console, "
+        "%.2f ms after their read on average\n",
+        secs, fx.swaps, (secs > 0)? fx.swaps / secs:0, fx.reads,
+        (fx.reads)? (fx.read_ns / 1e6) / fx.reads:0, fx.shown_frames,
+        (fx.shown_frames)? (fx.bh_ns / 1e6) / fx.shown_frames:0);
+    fx.open = 0;
+    fx.ready = 0;
+    qemu_bh_cancel(fx.bh);
+    if (fx.con) {
+        graphic_hw_passthrough(fx.con, false);
+        /* the VGA replaces (and frees) our surface on its next update */
+        qemu_console_hw_invalidate(fx.con);
+    }
+    fx.surface = NULL;
+    fx.con = NULL;
+    g_free(fx.pix);
+    fx.pix = NULL;
+}
