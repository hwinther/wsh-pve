The qemu-3dfx guest drivers (wrappers/) for a Pentium-class guest. Upstream builds the MinGW parts
(glide*.dll, opengl32.dll, instdrv.exe, wglinfo.exe) with -march=x86-64-v2 -mfpmath=sse, so they use
SSE2 to SSE4.2 and POPCNT and a guest CPU without them (cpu: pentium3 under TCG) takes an invalid
opcode fault on the first Glide call. Here every compiled part targets the Pentium (i586: x87 math,
no CMOV, MMX or SSE): -march=pentium for MinGW and DJGPP (the DXEs, whose default is i686), -5s for
Open Watcom (the OVL). Applied by `make 3dfx-drivers`, which reverts it afterwards and checks the
result with scripts/check-3dfx-drivers-isa.sh.

diff --git a/wrappers/3dfx/drv/Makefile b/wrappers/3dfx/drv/Makefile
index c7d12a0..5de73d9 100644
--- a/wrappers/3dfx/drv/Makefile
+++ b/wrappers/3dfx/drv/Makefile
@@ -1,7 +1,7 @@
 FXLIB=../../fxlib
 CROSS?=
 CC=$(CROSS)gcc
-CFLAGS=-march=x86-64-v2 -mtune=generic -mfpmath=sse
+CFLAGS=-march=pentium -mtune=generic
 CFLAGS+=-pipe -I$(FXLIB) -Wall -Wextra -Werror
 OUTDIR?=build
 
diff --git a/wrappers/3dfx/dxe/Makefile b/wrappers/3dfx/dxe/Makefile
index c5783f1..f0329e9 100644
--- a/wrappers/3dfx/dxe/Makefile
+++ b/wrappers/3dfx/dxe/Makefile
@@ -3,7 +3,7 @@ GIT=$(shell git rev-parse --short HEAD | sed "s/\(.*\)/\1\-/")
 X86?=i686
 CROSS=$(X86)-pc-msdosdjgpp-
 CC=$(CROSS)gcc
-CFLAGS=-I$(QEMU_SRC_DIR)/hw/3dfx -D__REV__=\"$(GIT)\" -Wall -Werror -O3 -fomit-frame-pointer
+CFLAGS=-march=pentium -I$(QEMU_SRC_DIR)/hw/3dfx -D__REV__=\"$(GIT)\" -Wall -Werror -O3 -fomit-frame-pointer
 DXEGEN=dxe3gen
 OUTDIR?=build
 
diff --git a/wrappers/3dfx/ovl/Makefile b/wrappers/3dfx/ovl/Makefile
index d1a3806..e10654b 100644
--- a/wrappers/3dfx/ovl/Makefile
+++ b/wrappers/3dfx/ovl/Makefile
@@ -3,7 +3,7 @@ WCC=$(WATCOM_PATH)/wcc386
 WLD=$(WATCOM_PATH)/wlink
 QEMU_SRC_DIR=../../../qemu-0
 INCLUDES=-I$(QEMU_SRC_DIR)/hw/3dfx -I../src
-CFLAGS=-zq -we -6s -ohtx -bd -fpi87
+CFLAGS=-zq -we -5s -ohtx -bd -fpi87
 OUTDIR?=build
 
 all: glide2x.ovl
diff --git a/wrappers/3dfx/src/Makefile.in b/wrappers/3dfx/src/Makefile.in
index 4f107e4..ae2437b 100644
--- a/wrappers/3dfx/src/Makefile.in
+++ b/wrappers/3dfx/src/Makefile.in
@@ -6,7 +6,7 @@ CC=$(CROSS)gcc
 RC=windres
 DLLTOOL=dlltool
 STRIP=strip
-CFLAGS=-march=x86-64-v2 -mtune=generic -mfpmath=sse -O3
+CFLAGS=-march=pentium -mtune=generic -O3
 CFLAGS+=-pipe -I$(QEMU_SRC_DIR)/hw/3dfx -I$(FXLIB) -D__REV__=\"$(GIT)\" -Wall -Werror -fomit-frame-pointer
 CFLAGS+=-fuse-linker-plugin -flto=auto
 LDFLAGS=-static-libgcc
